  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Точка входа сервера. Порядок: сервисы -> карта -> игроки.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.DataService)
local MapBuilder = require(script.MapBuilder)
local PlotService = require(script.PlotService)
local StealService = require(script.StealService)
local ConveyorService = require(script.ConveyorService)
local EventService = require(script.EventService)
local ShopService = require(script.ShopService)
local RewardService = require(script.RewardService)
local LeaderboardService = require(script.LeaderboardService)
local ItemService = require(script.ItemService)
local QuestService = require(script.QuestService)
local AdminEventService = require(script.AdminEventService)
local TradeService = require(script.TradeService)
local DefenseService = require(script.DefenseService)
local EmoteService = require(script.EmoteService)
local SocialService = require(script.SocialService)
local AnalyticsService = require(script.AnalyticsService)
local Grant = require(script.Grant)
local BattlePassService = require(script.BattlePassService)
local SpinService = require(script.SpinService)
local SkinService = require(script.SkinService)
local WeeklyService = require(script.WeeklyService)
local Remotes = require(script.Remotes)

-- Сезон по дате (UTC): от него зависят ночные мемы, мутации, декор и цвет монстра
local today = os.date("!*t")
ReplicatedStorage:SetAttribute("Season", Config.SeasonFor(today.month, today.day))

DataService.Start()
local world = MapBuilder.Build(ReplicatedStorage:GetAttribute("Season"))
PlotService.Start(world.Plots)
StealService.Start()
ItemService.Start()
ConveyorService.Start(MapBuilder.CarpetStart, MapBuilder.CarpetEnd)
EventService.Start(MapBuilder.HALF_X, MapBuilder.HALF_Z)
RewardService.Start()
QuestService.Start()
-- Колбэк нужен до Start: если сервер стартует посреди слота расписания, ивент запускается сразу
AdminEventService.OnSpawnRarity = ConveyorService.SpawnRarity
AdminEventService.Start()
TradeService.Start()
DefenseService.Start()
EmoteService.Start()
SocialService.Start()
AnalyticsService.Start()
BattlePassService.Start()
SpinService.Start()
SkinService.Start()
WeeklyService.Start()
LeaderboardService.Start(world.Leaderboards)

-- Связи между сервисами (без циклических require)
ItemService.OnMonsterHit = EventService.HitMonster
ShopService.OnSummonGod = function()
	ConveyorService.SummonGod()
end
-- Геймпассы предметов (золотой тапок, конфетти-пушка) и предмет из календаря — перевыдаём рюкзак
ShopService.OnToolsChanged = ItemService.RefreshPasses
RewardService.OnItemGranted = ItemService.RefreshPasses
Grant.OnItemGranted = ItemService.RefreshPasses
Grant.OnSkinGranted = SkinService.Refresh
SkinService.OnSlipperChanged = ItemService.GiveTools
ShopService.OnSpins = SpinService.AddSpins
ShopService.OnPassLevels = BattlePassService.AddLevels
ShopService.OnBattlePass = BattlePassService.Sync
ShopService.OnMemeRain = function(player)
	return AdminEventService.StartEvent("MemeRain", Config.AdminEvents.MemeRainDuration, player)
end
ShopService.Start()

-- Каждый новый персонаж (данные уже загружены): тапок и перенос на свою базу
local function setupCharacter(player: Player, character: Model)
	task.spawn(StealService.OnCharacter, player, character)
	ItemService.OnCharacter(player, character)
	local plot = PlotService.GetPlot(player)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if plot and root and character.Parent then
		task.wait() -- даём движку закончить появление, иначе позиция перезапишется точкой спавна
		character:PivotTo(PlotService.SpawnPoint(plot))
	end
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		if player:GetAttribute("DataLoaded") then
			setupCharacter(player, character)
		end
	end)

	PlotService.Assign(player)
	ShopService.CheckPasses(player) -- до загрузки базы: от геймпассов зависят слоты и доход
	DataService.Load(player)
	if not player.Parent or not DataService.IsLoaded(player) then
		return
	end
	PlotService.LoadPlayer(player)
	SocialService.OnLoaded(player)
	AnalyticsService.OnLoaded(player)
	SkinService.OnLoaded(player) -- до выдачи тапка: ставит атрибут SlipperSkin
	BattlePassService.OnLoaded(player)
	SpinService.OnLoaded(player)
	RewardService.OnLoaded(player)
	ItemService.OnLoaded(player)
	QuestService.OnLoaded(player)
	DefenseService.OnLoaded(player)
	player:SetAttribute("DataLoaded", true)

	-- Персонаж мог появиться раньше, чем загрузились данные.
	if player.Character then
		setupCharacter(player, player.Character)
	end
end

Remotes.TutorialDone.OnServerEvent:Connect(function(player)
	if DataService.IsLoaded(player) and DataService.Get(player, "TutorialDone") == 0 then
		DataService.Set(player, "TutorialDone", 1)
	end
end)

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	-- Сначала возвращаем всё «в пути» по местам, потом освобождаем базу и сохраняем.
	-- База освобождается ДО сохранения: Save ждёт DataStore, и за это время вор успел бы
	-- начать новую кражу с базы уходящего игрока (а его данные потом пропадут из памяти).
	StealService.OnPlayerRemoving(player)
	EventService.OnPlayerRemoving(player)
	ItemService.OnPlayerRemoving(player)
	TradeService.OnPlayerRemoving(player)
	DefenseService.OnPlayerRemoving(player)
	EmoteService.OnPlayerRemoving(player)
	SocialService.OnPlayerRemoving(player)
	AnalyticsService.OnPlayerRemoving(player)
	SkinService.OnPlayerRemoving(player)
	PlotService.Release(player)
	DataService.Release(player)
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">AdminEventService</string>
          <string name="Source"><![CDATA[-- Админ-ивенты: по выходным по расписанию (UTC) на всех серверах сразу, вручную — командой в чате
-- "/event <Id> [минуты]" / "/event stop" (создатель игры, Config.AdminEvents.Admins, в Studio — все)
-- и за Robux (Мем-дождь, вызывает ShopService через AdminEventService.StartEvent).
-- Состояние — атрибуты ReplicatedStorage (см. CONTRACT.md): AdminEvent, AdminEventEndsAt, NextAdminEventAt
-- и множители EventIncomeMult / EventLuckMult / EventSpawnMult / EventMutationChance, их читают другие сервисы.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)

local AdminEventService = {}

-- Ивент «Секретный дроп» просит выложить мема редкости на дорожку (init.server связывает с ConveyorService)
AdminEventService.OnSpawnRarity = nil :: ((string) -> ())?

local SECONDS_PER_DAY = 86400
local SCHEDULE_TICK = 15
local SECRET_DROP_INTERVAL = 20
local SCAN_DAYS = 8
local MAX_MINUTES = 120

local running: string? = nil
local token = 0 -- номер текущего запуска: отложенные задачи старого ивента не трогают новый
local lastScheduledSlot = 0 -- начало слота расписания, который уже запускали на этом сервере

-- os.time() (UTC) -> время сервера для клиента
local function toServerTime(unixTime: number): number
	return workspace:GetServerTimeNow() + (unixTime - os.time())
end

local function isEventDay(day: number): boolean
	local wday = (os.date("!*t", day * SECONDS_PER_DAY) :: any).wday
	return table.find(Config.AdminEvents.Days, wday) ~= nil
end

-- Слот расписания, который идёт прямо сейчас: (начало, Id ивента) или nil
local function currentSlot(): (number?, string?)
	local now = os.time()
	local day = now // SECONDS_PER_DAY
	if not isEventDay(day) then
		return nil, nil
	end
	for _, hour in Config.AdminEvents.Hours do
		local slotStart = day * SECONDS_PER_DAY + hour * 3600
		if now >= slotStart and now < slotStart + Config.AdminEvents.Duration then
			-- Тип ивента зависит только от слота — на всех серверах он одинаковый
			local yday = (os.date("!*t", slotStart) :: any).yday
			local types = Config.AdminEvents.Types
			return slotStart, types[(yday * 24 + hour) % #types + 1].Id
		end
	end
	return nil, nil
end

-- Начало ближайшего будущего слота (os.time) или 0
local function nextSlotStart(): number
	local now = os.time()
	local today = now // SECONDS_PER_DAY
	local hours = table.clone(Config.AdminEvents.Hours)
	table.sort(hours)
	for day = today, today + SCAN_DAYS do
		if isEventDay(day) then
			for _, hour in hours do
				local slotStart = day * SECONDS_PER_DAY + hour * 3600
				if slotStart > now then
					return slotStart
				end
			end
		end
	end
	return 0
end

local function updateNext()
	local slotStart = nextSlotStart()
	ReplicatedStorage:SetAttribute("NextAdminEventAt", if slotStart > 0 then toServerTime(slotStart) else 0)
end

local function setMultipliers(event: any?)
	ReplicatedStorage:SetAttribute("EventIncomeMult", event and event.IncomeMult or 1)
	ReplicatedStorage:SetAttribute("EventLuckMult", event and event.LuckMult or 1)
	ReplicatedStorage:SetAttribute("EventSpawnMult", event and event.SpawnMult or 1)
	ReplicatedStorage:SetAttribute("EventMutationChance", event and event.MutationChance or 0)
	-- Доход зависит от EventIncomeMult — пересчитываем атрибут Income у всех
	PlotService.RefreshAllIncome()
end

-- Запустить ивент (идущий ивент заменяется). duration в секундах, по умолчанию Config.AdminEvents.Duration.
function AdminEventService.StartEvent(id: string, duration: number?, byPlayer: Player?): boolean
	local event = if type(id) == "string" then Config.GetAdminEvent(id) else nil
	if not event then
		return false
	end
	local seconds = Config.AdminEvents.Duration
	if type(duration) == "number" and duration == duration and duration > 0 then
		seconds = math.min(duration, MAX_MINUTES * 60)
	end

	token += 1
	local myToken = token
	running = event.Id
	setMultipliers(event)
	ReplicatedStorage:SetAttribute("AdminEvent", event.Id)
	ReplicatedStorage:SetAttribute("AdminEventEndsAt", workspace:GetServerTimeNow() + seconds)

	Remotes.Fx:FireAllClients("AdminEvent", { Id = event.Id })
	Remotes.Notify:FireAllClients("AdminEventStart_" .. event.Id, { Player = byPlayer and byPlayer.DisplayName or nil }, "info")

	if event.SecretDrops then
		task.spawn(function()
			for _ = 1, event.SecretDrops do
				if token ~= myToken then
					return
				end
				local callback = AdminEventService.OnSpawnRarity
				if callback then
					task.spawn(callback, "Secret")
				end
				task.wait(SECRET_DROP_INTERVAL)
			end
		end)
	end

	task.delay(seconds, function()
		if token == myToken then
			AdminEventService.Stop()
		end
	end)
	return true
end

-- Остановить текущий ивент (если идёт)
function AdminEventService.Stop()
	if not running then
		return
	end
	local id = running
	running = nil
	token += 1
	setMultipliers(nil)
	ReplicatedStorage:SetAttribute("AdminEvent", "")
	ReplicatedStorage:SetAttribute("AdminEventEndsAt", 0)
	Remotes.Notify:FireAllClients("AdminEventEnd_" .. id, nil, "info")
	updateNext()
end

-- ===== Чат-команда =====

local adminCache: { [Player]: boolean } = {}

local function isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if adminCache[player] ~= nil then
		return adminCache[player]
	end
	local result = table.find(Config.AdminEvents.Admins, player.UserId) ~= nil
	if game.CreatorType == Enum.CreatorType.User then
		result = result or player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		result = result or (ok and rank >= 254)
	end
	adminCache[player] = result
	return result
end

local function findEventId(name: string): string?
	for _, event in Config.AdminEvents.Types do
		if string.lower(event.Id) == string.lower(name) then
			return event.Id
		end
	end
	return nil
end

local function onChatted(player: Player, message: string)
	if type(message) ~= "string" or string.sub(message, 1, 6) ~= "/event" then
		return
	end
	if not isAdmin(player) then
		return
	end
	local words = string.split(message, " ")
	if words[1] ~= "/event" then
		return -- "/events", "/eventX" и т.п. — не наша команда
	end
	local name = words[2] or ""
	if string.lower(name) == "stop" then
		AdminEventService.Stop()
		return
	end
	local id = findEventId(name)
	if not id then
		Remotes.Notify:FireClient(player, "AdminEventUnknown", { Name = name }, "error")
		return
	end
	local minutes = tonumber(words[3])
	local duration = if minutes and minutes > 0 then math.min(minutes, MAX_MINUTES) * 60 else nil
	AdminEventService.StartEvent(id, duration, player)
end

local function watchPlayer(player: Player)
	player.Chatted:Connect(function(message)
		onChatted(player, message)
	end)
end

function AdminEventService.Start()
	ReplicatedStorage:SetAttribute("AdminEvent", "")
	ReplicatedStorage:SetAttribute("AdminEventEndsAt", 0)
	ReplicatedStorage:SetAttribute("EventIncomeMult", 1)
	ReplicatedStorage:SetAttribute("EventLuckMult", 1)
	ReplicatedStorage:SetAttribute("EventSpawnMult", 1)
	ReplicatedStorage:SetAttribute("EventMutationChance", 0)
	updateNext()

	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	-- В новом чате (TextChatService) сообщения со «/» — это команды, и Player.Chatted до них
	-- может не дойти, поэтому регистрируем /event как TextChatCommand.
	local TextChatService = game:GetService("TextChatService")
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local command = Instance.new("TextChatCommand")
		command.Name = "AdminEventCommand"
		command.PrimaryAlias = "/event"
		command.Triggered:Connect(function(source: TextSource, text: string)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player then
				onChatted(player, text)
			end
		end)
		command.Parent = TextChatService
	end
	Players.PlayerRemoving:Connect(function(player)
		adminCache[player] = nil
	end)

	-- Расписание: каждые SCHEDULE_TICK секунд смотрим, не начался ли слот
	task.spawn(function()
		while true do
			local slotStart, id = currentSlot()
			if slotStart and id and slotStart ~= lastScheduledSlot and not running then
				lastScheduledSlot = slotStart
				-- Конец по расписанию, а не «от старта»: серверы, подключившиеся позже, закончат одновременно
				local left = slotStart + Config.AdminEvents.Duration - os.time()
				AdminEventService.StartEvent(id, left)
			end
			updateNext()
			task.wait(SCHEDULE_TICK)
		end
	end)
end

return AdminEventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">AnalyticsService</string>
          <string name="Source"><![CDATA[-- Аналитика Roblox (Creator Hub → Analytics): воронка новичка, экономика монет, свои события.
-- Все вызовы обёрнуты в pcall: сбой аналитики не должен ломать игру.
-- Зависит только от DataService/Hooks/Config — его можно подключать из любого сервиса без циклов.
--   AnalyticsService.Economy(player, "Sink", price, "Shop", memeId)  -- после списания/начисления монет
--   AnalyticsService.Custom(player, "RobuxPurchase", 1, productKey)
local Players = game:GetService("Players")
local RobloxAnalytics = game:GetService("AnalyticsService")

local DataService = require(script.Parent.DataService)
local Hooks = require(script.Parent.Hooks)

local AnalyticsService = {}

-- Игровые события из Hooks, которые копим и отправляем пачкой (Earn/Play — слишком частые, не шлём)
local COUNTED = { Steal = true, Merge = true, Defend = true }
local FLUSH_INTERVAL = 60

-- Шаги воронки новичка
local STEPS = {
	Joined = 1,
	FirstBuy = 2,
	FirstSteal = 3,
	TutorialDone = 4,
	FirstRebirth = 5,
}

local counts: { [Player]: { [string]: number } } = {}
local onboarding: { [Player]: { [string]: boolean } } = {} -- только у новых игроков: какие шаги уже отправлены
local connections: { [Player]: { RBXScriptConnection } } = {}

local function warnFail(what: string, err: any)
	warn("[AnalyticsService]", what, err)
end

local function customFields(field: string?): { [string]: string }?
	if field == nil then
		return nil
	end
	return { [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = field }
end

-- Своё событие (value — число, field — необязательная метка, например ключ продукта)
function AnalyticsService.Custom(player: Player, eventName: string, value: number?, field: string?)
	local ok, err = pcall(function()
		RobloxAnalytics:LogCustomEvent(player, eventName, value or 1, customFields(field))
	end)
	if not ok then
		warnFail("LogCustomEvent", err)
	end
end

-- Движение монет. flowType: "Source" | "Sink"; transactionType: имя Enum.AnalyticsEconomyTransactionType
-- ("Shop", "Gameplay", "IAP", "Onboarding", "TimedReward", "ContextualPurchase") или своё.
-- Вызывать ПОСЛЕ изменения баланса: конечный баланс берётся из DataService.
function AnalyticsService.Economy(player: Player, flowType: string, amount: number, transactionType: string, itemSku: string?)
	if not DataService.IsLoaded(player) or type(amount) ~= "number" or amount <= 0 or amount ~= amount then
		return
	end
	local flow = if flowType == "Source"
		then Enum.AnalyticsEconomyFlowType.Source
		else Enum.AnalyticsEconomyFlowType.Sink
	local ok, err = pcall(function()
		RobloxAnalytics:LogEconomyEvent(
			player,
			flow,
			"Coins",
			math.floor(amount),
			math.floor(DataService.Get(player, "Coins")),
			transactionType,
			itemSku
		)
	end)
	if not ok then
		warnFail("LogEconomyEvent", err)
	end
end

-- Шаг воронки новичка: только для новых игроков и только один раз за сессию
local function step(player: Player, name: string)
	local done = onboarding[player]
	if not done or done[name] then
		return
	end
	done[name] = true
	local ok, err = pcall(function()
		RobloxAnalytics:LogOnboardingStepEvent(player, STEPS[name], name)
	end)
	if not ok then
		warnFail("LogOnboardingStepEvent", err)
	end
end

local function flush(player: Player)
	local pending = counts[player]
	if not pending then
		return
	end
	counts[player] = {}
	for stat, amount in pending do
		if amount > 0 then
			AnalyticsService.Custom(player, stat, amount)
		end
	end
end

function AnalyticsService.OnLoaded(player: Player)
	counts[player] = {}
	if not DataService.IsNew(player) then
		return
	end
	onboarding[player] = {}
	step(player, "Joined")

	local list = {}
	local function onTutorial()
		if (player:GetAttribute("TutorialDone") or 0) >= 1 then
			step(player, "TutorialDone")
		end
	end
	local function onRebirths()
		if (player:GetAttribute("Rebirths") or 0) >= 1 then
			step(player, "FirstRebirth")
		end
	end
	table.insert(list, player:GetAttributeChangedSignal("TutorialDone"):Connect(onTutorial))
	table.insert(list, player:GetAttributeChangedSignal("Rebirths"):Connect(onRebirths))
	connections[player] = list
end

function AnalyticsService.OnPlayerRemoving(player: Player)
	flush(player)
	counts[player] = nil
	onboarding[player] = nil
	for _, connection in connections[player] or {} do
		connection:Disconnect()
	end
	connections[player] = nil
end

function AnalyticsService.Start()
	Hooks.Connect(function(player, stat, amount)
		if stat == "Buy" then
			step(player, "FirstBuy")
		elseif stat == "Steal" then
			step(player, "FirstSteal")
		end
		local pending = counts[player]
		if COUNTED[stat] and pending then
			pending[stat] = (pending[stat] or 0) + amount
		end
	end)
	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)
			for _, player in Players:GetPlayers() do
				flush(player)
			end
		end
	end)
end

return AnalyticsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">BattlePassService</string>
          <string name="Source"><![CDATA[-- Мем-пропуск (боевой пропуск сезона): XP за игровые события (Hooks), уровни, награды Free/Premium.
-- Данные: DataService.GetTable(player, "BattlePass") = { Season, Xp, Free = { [level] = true }, Premium = { [level] = true } }.
-- Ключи уровней в Free/Premium хранятся строками ("1", "5"): разреженный массив с числовыми ключами
-- не переживёт сохранение в DataStore (JSON). Наружу (BPJson) уходят обычные массивы чисел.
-- Клиент читает атрибут BPJson и просит награду через Remotes.ClaimPass(level, "Free" | "Premium").
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Grant = require(script.Parent.Grant)
local Hooks = require(script.Parent.Hooks)
local Remotes = require(script.Parent.Remotes)

local BattlePassService = {}

local PASS = Config.BattlePass
local SYNC_INTERVAL = 1 -- не чаще раза в секунду обновляем BPJson
local PLAY_SECONDS = 60 -- Xp.Play даётся за каждую полную минуту в игре
local TRACKS = { Free = true, Premium = true }

local playSeconds: { [Player]: number } = {}
local lastSync: { [Player]: number } = {}
local pendingSync: { [Player]: boolean } = {}

local function maxXp(): number
	return #PASS.Levels * PASS.XpPerLevel
end

local function levelOf(xp: number): number
	return math.min(#PASS.Levels, xp // PASS.XpPerLevel)
end

-- Сезон ещё идёт (после EndsAt XP не копится, но заработанное можно забрать)
local function isActive(): boolean
	return os.time() < PASS.EndsAt
end

local function isReady(player: Player): boolean
	return player.Parent ~= nil and player:GetAttribute("DataLoaded") == true and DataService.IsLoaded(player)
end

-- Таблица забранных уровней: оставляем только корректные ключи "1".."N"
local function cleanClaims(saved: any): { [string]: boolean }
	local result = {}
	if type(saved) ~= "table" then
		return result
	end
	for key, value in saved do
		local level = tonumber(key)
		if value == true and level and level % 1 == 0 and level >= 1 and level <= #PASS.Levels then
			result[tostring(level)] = true
		end
	end
	return result
end

-- Данные пропуска текущего сезона; чужой сезон или испорченные данные — сброс
local function ensure(player: Player): { [string]: any }
	local data = DataService.GetTable(player, "BattlePass")
	if data.Season ~= PASS.Season then
		table.clear(data)
		data.Season = PASS.Season
		data.Xp = 0
		data.Free = {}
		data.Premium = {}
		return data
	end
	if type(data.Xp) ~= "number" or data.Xp ~= data.Xp then
		data.Xp = 0
	end
	data.Xp = math.clamp(math.floor(data.Xp), 0, maxXp())
	data.Free = cleanClaims(data.Free)
	data.Premium = cleanClaims(data.Premium)
	return data
end

local function claimedList(claims: { [string]: boolean }): { number }
	local list = {}
	for key in claims do
		table.insert(list, tonumber(key) :: number)
	end
	table.sort(list)
	return list
end

-- Сразу записать BPJson (ShopService зовёт после покупки премиума)
function BattlePassService.Sync(player: Player)
	if not DataService.IsLoaded(player) then
		return
	end
	local data = ensure(player)
	local level = levelOf(data.Xp)
	lastSync[player] = os.clock()
	player:SetAttribute("BPJson", HttpService:JSONEncode({
		Season = data.Season,
		Xp = data.Xp,
		Level = level,
		XpInLevel = data.Xp - level * PASS.XpPerLevel,
		Free = claimedList(data.Free),
		Premium = claimedList(data.Premium),
		EndsAt = PASS.EndsAt,
	}))
end

-- Синхронизация с ограничением частоты: лишние вызовы склеиваются в один отложенный
local function requestSync(player: Player)
	if pendingSync[player] then
		return
	end
	local waitTime = if lastSync[player] then lastSync[player] + SYNC_INTERVAL - os.clock() else 0
	if waitTime <= 0 then
		BattlePassService.Sync(player)
		return
	end
	pendingSync[player] = true
	task.delay(waitTime, function()
		pendingSync[player] = nil
		if player.Parent and DataService.IsLoaded(player) then
			BattlePassService.Sync(player)
		end
	end)
end

local function giveXp(player: Player, amount: number, ignoreSeason: boolean?)
	if not DataService.IsLoaded(player) or (not ignoreSeason and not isActive()) then
		return
	end
	local data = ensure(player)
	if data.Xp >= maxXp() then
		return
	end
	local oldLevel = levelOf(data.Xp)
	data.Xp = math.min(maxXp(), data.Xp + amount)
	local newLevel = levelOf(data.Xp)
	if newLevel > oldLevel then
		Remotes.Notify:FireClient(player, "PassLevelUp", { Level = newLevel }, "success")
	end
	requestSync(player)
end

-- XP пропуска (например, за забранный квест: Config.BattlePass.Xp.Quest)
function BattlePassService.AddXp(player: Player, amount: number)
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	giveXp(player, math.floor(amount))
end

-- Купленные за Robux уровни (продукт PassLevels). Работает и после конца сезона.
-- Возвращает false, только если данные игрока не загружены (покупку стоит повторить позже).
function BattlePassService.AddLevels(player: Player, n: number): boolean
	if not DataService.IsLoaded(player) then
		return false
	end
	if type(n) == "number" and n == n and n >= 1 then
		giveXp(player, math.floor(n) * PASS.XpPerLevel, true)
	end
	return true
end

local function onStat(player: Player, stat: string, amount: number)
	if not isReady(player) or not isActive() or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return
	end
	if stat == "Play" then
		-- Время приходит кусками по 5 сек: копим и платим за каждую полную минуту
		local total = (playSeconds[player] or 0) + amount
		local minutes = total // PLAY_SECONDS
		playSeconds[player] = total - minutes * PLAY_SECONDS
		if minutes > 0 then
			giveXp(player, minutes * (PASS.Xp.Play or 0))
		end
		return
	end
	local perUnit = PASS.Xp[stat]
	if perUnit and perUnit > 0 then
		giveXp(player, math.floor(perUnit * amount))
	end
end

local function claim(player: Player, level: any, track: any): (boolean, string)
	if not isReady(player) then
		return false, "PassNotReady"
	end
	if type(level) ~= "number" or level ~= level or level % 1 ~= 0 or level < 1 or level > #PASS.Levels then
		return false, "PassInvalid"
	end
	if type(track) ~= "string" or not TRACKS[track] then
		return false, "PassInvalid"
	end
	local data = ensure(player)
	if levelOf(data.Xp) < level then
		return false, "PassLocked"
	end
	if track == "Premium" and player:GetAttribute("Pass_BattlePass") ~= true then
		return false, "PassPremiumOnly"
	end
	local claims = data[track]
	local key = tostring(level)
	if claims[key] then
		return false, "PassAlreadyClaimed"
	end
	-- Сначала отмечаем, потом выдаём: повторный запрос не получит награду дважды
	claims[key] = true
	local result = Grant.Give(player, PASS.Levels[level][track])
	result.Level = level
	result.Track = track
	requestSync(player)
	Remotes.Popup:FireClient(player, "Pass", result)
	return true, "PassClaimed"
end

-- Вызывается из init.server после загрузки данных
function BattlePassService.OnLoaded(player: Player)
	BattlePassService.Sync(player)
end

function BattlePassService.Start()
	Hooks.Connect(onStat)

	Remotes.ClaimPass.OnServerInvoke = function(player: Player, level: any, track: any)
		local ok, result, key = pcall(claim, player, level, track)
		if not ok then
			warn("[BattlePassService] Ошибка выдачи награды пропуска:", result)
			return false, "PassNotReady"
		end
		return result, key
	end

	Players.PlayerRemoving:Connect(function(player)
		playSeconds[player] = nil
		lastSync[player] = nil
		pendingSync[player] = nil
	end)
end

return BattlePassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ConveyorService</string>
          <string name="Source"><![CDATA[-- «Красная дорожка»: мемы появляются из портала, идут по дорожке, их можно купить.
-- Редкость и мутация выбираются на сервере; Удача сервера и Ночь Смайлика меняют шансы.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local MemeFactory = require(script.Parent.MemeFactory)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)
local Hooks = require(script.Parent.Hooks)
local AnalyticsService = require(script.Parent.AnalyticsService)

local ConveyorService = {}

local carpetStart: Vector3
local carpetEnd: Vector3
local folder: Folder
local walking: { [Model]: number } = {} -- модель -> пройденное расстояние
local random = Random.new()

local LUCKY_RARITIES = { Legendary = true, Mythic = true, God = true, Secret = true }

local function weightedPick<T>(items: { T }, weightOf: (T) -> number): T
	local total = 0
	for _, item in items do
		total += weightOf(item)
	end
	local roll = random:NextNumber() * total
	for _, item in items do
		roll -= weightOf(item)
		if roll <= 0 then
			return item
		end
	end
	return items[#items]
end

local function isLucky(): boolean
	return (ReplicatedStorage:GetAttribute("LuckEndsAt") or 0) > workspace:GetServerTimeNow()
end

local function rollCreature(): string
	local night = ReplicatedStorage:GetAttribute("NightActive") == true
	local season = ReplicatedStorage:GetAttribute("Season")
	local seasonal = {}
	for _, creature in Config.Creatures do
		if creature.Event and creature.Season == season then
			table.insert(seasonal, creature)
		end
	end
	if night and #seasonal > 0 and random:NextNumber() < Config.Conveyor.EventChance then
		return weightedPick(seasonal, function(creature)
			return creature.EventWeight or 1
		end).Id
	end

	-- Лимитированный мем недели (WeeklyService) — редкий гость на дорожке
	local weekly = ReplicatedStorage:GetAttribute("WeeklyMeme")
	if type(weekly) == "string" and Config.GetCreature(weekly) and random:NextNumber() < Config.Weekly.Chance then
		return weekly
	end

	-- Удача: покупка «Удача сервера» и множитель админ-ивента складываются
	local luck = (if isLucky() then Config.Conveyor.LuckMult else 1) * (ReplicatedStorage:GetAttribute("EventLuckMult") or 1)
	local rarity = weightedPick(Config.Rarities, function(r)
		return r.Weight * (if LUCKY_RARITIES[r.Id] then luck else 1)
	end)
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarity.Id and not creature.Event and not creature.Limited and not creature.Exclusive then
			table.insert(pool, creature)
		end
	end
	if #pool == 0 then
		return Config.Creatures[1].Id
	end
	return pool[random:NextInteger(1, #pool)].Id
end

local function rollMutation(): string
	local night = ReplicatedStorage:GetAttribute("NightActive") == true
	local season = ReplicatedStorage:GetAttribute("Season")
	local pool = {}
	for _, mutation in Config.Mutations do
		if not mutation.Event or (night and mutation.Season == season) then
			table.insert(pool, mutation)
		end
	end
	-- Шторм мутаций (админ-ивент): с этим шансом мутация гарантирована
	local forceMutation = random:NextNumber() < (ReplicatedStorage:GetAttribute("EventMutationChance") or 0)
	return weightedPick(pool, function(m)
		if forceMutation and m.Id == "None" then
			return 0
		end
		return m.Weight
	end).Id
end

local function carpetCFrame(distance: number, model: Model): CFrame
	local direction = (carpetEnd - carpetStart).Unit
	local position = carpetStart + direction * distance
	-- Лёгкое покачивание «шаг-шаг»
	local bob = math.abs(math.sin(distance * 0.9)) * 0.5
	return CFrame.lookAt(position, position + direction) * CFrame.new(0, MemeFactory.BodyOffset(model) + bob, 0)
end

local function tryBuy(player: Player, model: Model)
	if not DataService.IsLoaded(player) or not walking[model] or model:GetAttribute("State") ~= "Carpet" then
		Remotes.Notify:FireClient(player, "AlreadyTaken", nil, "error")
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - model:GetPivot().Position).Magnitude > 20 then
		return
	end
	local id = model:GetAttribute("CreatureId")
	local mutationId = model:GetAttribute("Mutation")
	local price = model:GetAttribute("Price")
	if DataService.Get(player, "Coins") < price then
		Remotes.Notify:FireClient(player, "NotEnoughCash", { Price = price }, "error")
		return
	end
	if not PlotService.FreeSlot(player) then
		Remotes.Notify:FireClient(player, "BaseFull", nil, "error")
		return
	end

	-- Сначала забираем мема с дорожки, потом списываем деньги и выдаём
	walking[model] = nil
	model:SetAttribute("State", "Walking")
	local from = model:GetPivot()
	model:Destroy()

	DataService.Increment(player, "Coins", -price)
	AnalyticsService.Economy(player, "Sink", price, "Shop", id)
	PlotService.AddMeme(player, id, mutationId, false, from)
	Remotes.Fx:FireAllClients("Bought", { Position = from.Position, Rarity = Config.GetCreature(id).Rarity })
	Remotes.Notify:FireClient(player, "Bought", { Meme = id }, "success")
	Hooks.Fire(player, "Buy", 1)
end

function ConveyorService.Spawn(forcedId: string?, forcedMutation: string?): Model?
	local count = 0
	for _ in walking do
		count += 1
	end
	local cap = Config.Conveyor.MaxOnCarpet * math.min(ReplicatedStorage:GetAttribute("EventSpawnMult") or 1, 2)
	if count >= cap and not forcedId then
		return nil
	end

	local id = forcedId or rollCreature()
	local mutationId = forcedMutation or rollMutation()
	local model = MemeFactory.Create(id, mutationId, false, CFrame.new(carpetStart))
	model:SetAttribute("State", "Carpet")
	model:SetAttribute("Price", Config.PriceOf(id, mutationId))
	model:PivotTo(carpetCFrame(0, model))

	local prompt = MemeFactory.AddPrompt(model, "BuyPrompt", "Buy", 0)
	prompt.MaxActivationDistance = 14
	prompt.Triggered:Connect(function(player)
		tryBuy(player, model)
	end)

	walking[model] = 0
	model.Parent = folder
	return model
end

-- Призыв Мем-Бога (покупка за Robux): случайный мем редкости God на дорожке
-- Случайный мем нужной редкости на дорожку (Секретный дроп админ-ивента и т.п.)
function ConveyorService.SpawnRarity(rarityId: string)
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarityId and not creature.Event then
			table.insert(pool, creature.Id)
		end
	end
	if #pool > 0 then
		ConveyorService.Spawn(pool[random:NextInteger(1, #pool)])
	end
end

function ConveyorService.SummonGod()
	local gods = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == "God" then
			table.insert(gods, creature.Id)
		end
	end
	if #gods > 0 then
		ConveyorService.Spawn(gods[random:NextInteger(1, #gods)])
	end
end

function ConveyorService.Start(startPosition: Vector3, endPosition: Vector3)
	carpetStart = startPosition
	carpetEnd = endPosition
	folder = Instance.new("Folder")
	folder.Name = "CarpetMemes"
	folder.Parent = workspace

	local length = (carpetEnd - carpetStart).Magnitude

	RunService.Heartbeat:Connect(function(dt)
		for model, distance in walking do
			if not model.Parent then
				walking[model] = nil
				continue
			end
			distance += Config.Conveyor.Speed * dt
			if distance >= length then
				walking[model] = nil
				model:Destroy()
				continue
			end
			walking[model] = distance
			model:PivotTo(carpetCFrame(distance, model))
		end
	end)

	task.spawn(function()
		while true do
			ConveyorService.Spawn()
			-- Мем-дождь (админ-ивент) ускоряет появление
			task.wait(Config.Conveyor.SpawnInterval / math.max(ReplicatedStorage:GetAttribute("EventSpawnMult") or 1, 0.1))
		end
	end)
end

return ConveyorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Прогресс игроков: загрузка/сохранение в DataStore, leaderstats и зеркало чисел в атрибутах игрока,
-- чтобы клиентский UI читал значения через player:GetAttribute без лишних remotes.
-- Числовые поля — через Get/Set/Increment; таблицы (мемы на базе, Индекс, чеки покупок) — через GetTable.
local DataStoreService = game:GetService("DataStoreService")

local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
local Remotes = require(script.Parent.Remotes)

local DataService = {}

local STORE_NAME = "StealAMeme_v1" -- смена версии = чистый старт для всех
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 100

-- Числовые поля и значения по умолчанию
local DEFAULT_NUMBERS: { [string]: number } = {
	Coins = Config.StartCoins,
	Rebirths = 0,
	Stolen = 0,
	TotalEarned = 0,
	GuardLevel = 0,
	LastSeen = 0,
	DailyStreak = 0,
	LastDailyDay = 0,
	TutorialDone = 0,
	GiftDay = 0, -- день (os.time() // 86400), к которому относятся PlayedToday и GiftsClaimed
	GiftsClaimed = 0,
	PlayedToday = 0, -- секунд сыграно за день (для подарков за время)
	TurretLevel = 0, -- уровень турели на базе (Config.Defense.Turret)
	LaserLevel = 0, -- уровень лазерных ворот (Config.Defense.LaserGate)
	Spins = 0, -- купленные/выигранные вращения колеса
	LastFreeSpinDay = 0, -- UTC-день последнего бесплатного вращения
}

-- Табличные поля:
--   Memes    — массив { Id, Mut, Viral, Slot } (мемы на базе)
--   Index    — { ["Id|Mut"] = true } (открытые записи Индекса)
--   Receipts — массив PurchaseId обработанных покупок за Robux (защита от двойной выдачи)
--   Items    — { [itemId] = true } купленные предметы (Config.Items)
--   Quests   — { Day, List = { { Id, Goal, Progress, Claimed } }, AllClaimed } ежедневные квесты (проверяет QuestService)
--   BattlePass — { Season, Xp, Free = { [level] = true }, Premium = { [level] = true } } (BattlePassService)
--   Skins    — { Owned = { [skinId] = true }, Base = id, Slipper = id } (SkinService)
--   Codes    — { [CODE] = true } введённые коды (SocialService)
local TABLE_KEYS = { "Memes", "Index", "Receipts", "Items", "Quests", "BattlePass", "Skins", "Codes" }
-- Таблицы, которые хранятся как есть (проверяют их сами сервисы)
local FREEFORM_TABLES = { "Quests", "BattlePass", "Skins", "Codes" }

-- Блокировка сессии: пока игрок на одном сервере, другой сервер не загрузит его данные
-- (иначе при быстром переходе между серверами можно задублировать мемов).
local LOCK_STALE_AFTER = 300 -- сек: блокировку упавшего сервера считаем протухшей
local LOCK_RETRIES = 6
local LOCK_RETRY_DELAY = 4

-- Поля в таблице игроков: ключ данных -> подпись
local LEADERSTATS: { { Key: string, Label: string } } = {
	{ Key = "Coins", Label = "Cash" },
	{ Key = "Stolen", Label = "Steals" },
}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore недоступен:", result)
	end
end

type Profile = { Data: { [string]: any }, CanSave: boolean, IsNew: boolean }
local profiles: { [Player]: Profile } = {}

local changedEvent = Instance.new("BindableEvent")
DataService.Changed = changedEvent.Event -- (player, key, value)

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function withRetries(callback: () -> any): (boolean, any)
	local lastError
	for attempt = 1, 3 do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		if attempt < 3 then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

local function syncAttribute(player: Player, key: string, value: number)
	player:SetAttribute(key, value)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		for _, stat in LEADERSTATS do
			if stat.Key == key then
				(leaderstats:FindFirstChild(stat.Label) :: IntValue).Value = math.floor(value)
			end
		end
	end
end

local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	for _, stat in LEADERSTATS do
		local value = Instance.new("IntValue")
		value.Name = stat.Label
		value.Parent = leaderstats
	end
	leaderstats.Parent = player
end

local function sanitizeMemes(saved: any): { any }
	local result = {}
	local usedSlots = {}
	if type(saved) ~= "table" then
		return result
	end
	for _, entry in saved do
		if type(entry) == "table" and type(entry.Id) == "string" and Config.GetCreature(entry.Id)
			and type(entry.Slot) == "number" and entry.Slot >= 1 and entry.Slot <= Config.AbsoluteMaxSlots
			and not usedSlots[entry.Slot] then
			usedSlots[entry.Slot] = true
			table.insert(result, {
				Id = entry.Id,
				Mut = if type(entry.Mut) == "string" then Config.GetMutation(entry.Mut).Id else "None",
				Viral = entry.Viral == true,
				Slot = math.floor(entry.Slot),
			})
		end
	end
	return result
end

local function sanitize(saved: any): ({ [string]: any }, boolean)
	local data: { [string]: any } = table.clone(DEFAULT_NUMBERS)
	local isNew = type(saved) ~= "table"
	if not isNew then
		for key, default in DEFAULT_NUMBERS do
			if type(saved[key]) == type(default) then
				data[key] = saved[key]
			end
		end
	end
	local savedTable = if isNew then {} else saved
	data.Memes = sanitizeMemes(savedTable.Memes)
	data.Index = {}
	if type(savedTable.Index) == "table" then
		for key, value in savedTable.Index do
			if type(key) == "string" and value == true then
				data.Index[key] = true
			end
		end
	end
	data.Items = {}
	if type(savedTable.Items) == "table" then
		for key, value in savedTable.Items do
			if type(key) == "string" and value == true and Config.GetItem(key) then
				data.Items[key] = true
			end
		end
	end
	for _, key in FREEFORM_TABLES do
		data[key] = if type(savedTable[key]) == "table" then savedTable[key] else {}
	end
	-- Старые сохранения (до туториала) — туториал не показываем
	if not isNew and saved.TutorialDone == nil then
		data.TutorialDone = 1
	end
	data.Receipts = {}
	if type(savedTable.Receipts) == "table" then
		for _, id in savedTable.Receipts do
			if type(id) == "string" then
				table.insert(data.Receipts, id)
			end
		end
	end
	return data, isNew
end

function DataService.Load(player: Player)
	local saved = nil
	local canSave = store ~= nil

	if store then
		local loaded = false
		for attempt = 1, LOCK_RETRIES do
			local lockedElsewhere = false
			local ok, result = withRetries(function()
				return (store :: DataStore):UpdateAsync(keyFor(player), function(old)
					lockedElsewhere = false
					local session = type(old) == "table" and old.Session
					if type(session) == "table" and session.JobId ~= game.JobId
						and os.time() - (tonumber(session.Time) or 0) < LOCK_STALE_AFTER
						and attempt < LOCK_RETRIES then
						lockedElsewhere = true
						return nil -- не трогаем: данные ещё держит другой сервер
					end
					local value = if type(old) == "table" then old else {}
					value.Session = { JobId = game.JobId, Time = os.time() }
					return value, { player.UserId }
				end)
			end)
			if not ok then
				warn("[DataService] Не удалось загрузить данные", player.Name, result)
				break
			end
			if not lockedElsewhere then
				saved = result
				loaded = true
				break
			end
			-- Прошлый сервер ещё сохраняет игрока — подождём
			task.wait(LOCK_RETRY_DELAY)
			if not player.Parent then
				return
			end
		end
		if not loaded then
			-- Не сохраняем поверх, иначе пустые данные затрут настоящий прогресс.
			canSave = false
		elseif type(saved) == "table" and next(saved) and saved.Coins == nil then
			saved = nil -- в хранилище только блокировка, данных ещё не было
		end
	end

	if not player.Parent then
		-- Игрок ушёл, пока грузились данные: снимаем свою блокировку, иначе следующий сервер
		-- будет ждать её протухания
		if store and canSave then
			pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if type(old) == "table" and type(old.Session) == "table" and old.Session.JobId == game.JobId then
						old.Session = nil
						return old, { player.UserId }
					end
					return nil
				end)
			end)
		end
		return
	end

	local data, isNew = sanitize(saved)
	profiles[player] = { Data = data, CanSave = canSave, IsNew = isNew }

	createLeaderstats(player)
	for key in DEFAULT_NUMBERS do
		syncAttribute(player, key, data[key])
	end

	if not canSave then
		Remotes.Notify:FireClient(player, "SaveDisabled", nil, "error")
	end
end

function DataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

-- Новый игрок (сохранения ещё не было)
function DataService.IsNew(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.IsNew
end

function DataService.Get(player: Player, key: string): number
	local profile = profiles[player]
	assert(profile, "Данные игрока ещё не загружены")
	return profile.Data[key]
end

function DataService.Set(player: Player, key: string, value: number)
	local profile = profiles[player]
	assert(profile, "Данные игрока ещё не загружены")
	assert(DEFAULT_NUMBERS[key] ~= nil, "Неизвестное числовое поле: " .. key)
	profile.Data[key] = value
	syncAttribute(player, key, value)
	changedEvent:Fire(player, key, value)
end

function DataService.Increment(player: Player, key: string, delta: number): number
	local value = DataService.Get(player, key) + delta
	DataService.Set(player, key, value)
	return value
end

-- Возвращает саму таблицу (не копию): меняйте её на месте.
function DataService.GetTable(player: Player, key: string): any
	local profile = profiles[player]
	assert(profile, "Данные игрока ещё не загружены")
	assert(table.find(TABLE_KEYS, key), "Неизвестное табличное поле: " .. key)
	return profile.Data[key]
end

function DataService.HasReceipt(player: Player, purchaseId: string): boolean
	return table.find(DataService.GetTable(player, "Receipts"), purchaseId) ~= nil
end

function DataService.AddReceipt(player: Player, purchaseId: string)
	local receipts = DataService.GetTable(player, "Receipts")
	table.insert(receipts, purchaseId)
	while #receipts > MAX_RECEIPTS do
		table.remove(receipts, 1)
	end
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, inner in value do
		result[key] = deepCopy(inner)
	end
	return result
end

local function snapshot(data: { [string]: any }): { [string]: any }
	local copy = table.clone(data)
	copy.Memes = {}
	for _, entry in data.Memes do
		table.insert(copy.Memes, { Id = entry.Id, Mut = entry.Mut, Viral = entry.Viral, Slot = entry.Slot })
	end
	copy.Index = table.clone(data.Index)
	copy.Receipts = table.clone(data.Receipts)
	copy.Items = table.clone(data.Items)
	for _, key in FREEFORM_TABLES do
		copy[key] = deepCopy(data[key])
	end
	return copy
end

-- release = true снимает блокировку сессии (игрок уходит с сервера)
function DataService.Save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return false
	end

	profile.Data.LastSeen = os.time()
	local copy = snapshot(profile.Data)
	copy.Session = if release then nil else { JobId = game.JobId, Time = os.time() }
	local lostLock = false
	local ok, err = withRetries(function()
		return (store :: DataStore):UpdateAsync(keyFor(player), function(old)
			lostLock = false
			local session = type(old) == "table" and old.Session
			if type(session) == "table" and session.JobId ~= game.JobId then
				-- Данные уже забрал другой сервер — не затираем их устаревшей копией
				lostLock = true
				return nil
			end
			-- UserIds (для запросов GDPR) передаются вторым значением из функции, а не аргументом UpdateAsync
			return copy, { player.UserId }
		end)
	end)
	if lostLock then
		warn("[DataService] Сессия игрока открыта на другом сервере, сохранение пропущено", player.Name)
		profile.CanSave = false
		return false
	end
	if not ok then
		warn("[DataService] Не удалось сохранить", player.Name, err)
	end
	return ok
end

-- Вызывается из init.server после того, как другие сервисы отработали выход игрока
-- (например, вернули украденного мема хозяину), чтобы сохранить итоговое состояние.
function DataService.Release(player: Player)
	DataService.Save(player, true)
	profiles[player] = nil
end

function DataService.Start()
	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.Save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">DefenseService</string>
          <string name="Source"><![CDATA[-- Защита базы: турель и лазерные ворота (Config.Defense), покупаются за монеты, уровни навсегда.
-- Уровни — числа TurretLevel / LaserLevel в DataService (зеркалятся в атрибуты игрока).
-- Турель стреляет в воров с мемами хозяина и в чужаков, которые стоят на базе; лазер на входе
-- сбивает вора с мемом хозяина. Сбитый вор роняет мема (StealService.Knock).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local StealService = require(script.Parent.StealService)
local Remotes = require(script.Parent.Remotes)

local DefenseService = {}

local TICK = 0.2
local INTRUDER_DELAY = 2 -- сколько секунд чужак должен простоять на базе, чтобы турель выстрелила
local LASER_DISTANCE = 4 -- насколько близко к линии входа вор задевает лазер
local TURRET_POWER = 60
local LASER_POWER = 50

-- kind -> поле данных
local LEVEL_FIELD = {
	Turret = "TurretLevel",
	LaserGate = "LaserLevel",
}

local lastTurretShot: { [Model]: number } = {} -- база -> время последнего выстрела (os.clock)
local lastLaserHit: { [Model]: number } = {}
local intruderSince: { [Model]: { [Player]: number } } = {}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return (character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function floorOf(plot: Model): BasePart
	return plot:FindFirstChild("Floor") :: BasePart
end

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

-- ===== Визуал =====

local function destroyVisuals(plot: Model)
	for _, name in { "Turret", "LaserGate" } do
		local existing = plot:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end
	lastTurretShot[plot] = nil
	lastLaserHit[plot] = nil
	intruderSince[plot] = nil
end

-- Турель: угол базы у входа, напротив стража (страж стоит в -X углу)
local function buildTurret(plot: Model, level: number)
	local floor = floorOf(plot)
	local size = floor.Size
	-- X = край - 4: при «- 8» тумба задевала слот 25 (центр x = 28, радиус 4) и стоящего на нём мема
	local base = floor.CFrame * CFrame.new(size.X / 2 - 4, size.Y / 2, -size.Z / 2 + 16)

	local model = Instance.new("Model")
	model.Name = "Turret"
	model:SetAttribute("Level", level)

	local stand = part({
		Name = "Stand",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 3.5, 3.5),
		CFrame = base * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 60, 70),
		Material = Enum.Material.Metal,
		CanCollide = true,
		Parent = model,
	})
	model.PrimaryPart = stand
	local headCFrame = base * CFrame.new(0, 4, 0)
	part({
		Name = "Head",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		CFrame = headCFrame,
		Color = Color3.fromRGB(90, 95, 110),
		Material = Enum.Material.DiamondPlate,
		Parent = model,
	})
	part({
		Name = "Barrel",
		Size = Vector3.new(0.7, 0.7, 3),
		CFrame = headCFrame * CFrame.new(0, 0, -2),
		Color = Color3.fromRGB(35, 35, 40),
		Material = Enum.Material.Metal,
		Parent = model,
	})
	-- Огонёк уровня: чем выше уровень, тем «горячее» цвет
	local lightColors = { Color3.fromRGB(90, 255, 120), Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 70, 70) }
	part({
		Name = "Light",
		Size = Vector3.new(0.6, 0.6, 0.6),
		CFrame = headCFrame * CFrame.new(0, 1.5, 0),
		Color = lightColors[level] or lightColors[#lightColors],
		Material = Enum.Material.Neon,
		Parent = model,
	})
	model.Parent = plot
end

local LASER_TRANSPARENCY = 0.55

-- Лазер: тонкая красная полоса по линии входа, чуть внутри базы
local function buildLaser(plot: Model, level: number)
	local floor = floorOf(plot)
	local size = floor.Size
	local laser = part({
		Name = "LaserGate",
		Size = Vector3.new(size.X - 2, 0.3 + level * 0.1, 0.3),
		CFrame = floor.CFrame * CFrame.new(0, size.Y / 2 + 3, -size.Z / 2 + 1.5),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = LASER_TRANSPARENCY,
	})
	laser:SetAttribute("Level", level)
	laser.Parent = plot
end

-- Перерисовать защиту базы игрока по его уровням
function DefenseService.Refresh(player: Player)
	local plot = PlotService.GetPlot(player)
	if not plot then
		return
	end
	destroyVisuals(plot)
	if not DataService.IsLoaded(player) then
		return
	end
	local turretLevel = DataService.Get(player, "TurretLevel")
	if turretLevel > 0 then
		buildTurret(plot, turretLevel)
	end
	local laserLevel = DataService.Get(player, "LaserLevel")
	if laserLevel > 0 then
		buildLaser(plot, laserLevel)
	end
end

-- ===== Покупка =====

function DefenseService.Upgrade(player: Player, kind: unknown): (boolean, string)
	if typeof(kind) ~= "string" or not LEVEL_FIELD[kind] then
		return false, "BadRequest"
	end
	if not DataService.IsLoaded(player) or not PlotService.GetPlot(player) then
		return false, "NotLoaded"
	end
	local field = LEVEL_FIELD[kind]
	local level = DataService.Get(player, field)
	local nextLevel = Config.Defense[kind][level + 1]
	if not nextLevel then
		Remotes.Notify:FireClient(player, "DefenseMax", nil, "error")
		return false, "DefenseMax"
	end
	if DataService.Get(player, "Coins") < nextLevel.Price then
		Remotes.Notify:FireClient(player, "NotEnoughCash", { Price = nextLevel.Price }, "error")
		return false, "NotEnoughCash"
	end
	DataService.Increment(player, "Coins", -nextLevel.Price)
	DataService.Set(player, field, level + 1)
	DefenseService.Refresh(player)
	local key = if kind == "Turret" then "TurretUpgraded" else "LaserUpgraded"
	Remotes.Notify:FireClient(player, key, { Level = level + 1 }, "success")
	return true, key
end

-- ===== Логика =====

local function aimTurret(turret: Model, target: Vector3): Vector3
	local head = turret:FindFirstChild("Head") :: BasePart
	local barrel = turret:FindFirstChild("Barrel") :: BasePart
	local from = head.Position
	local look = CFrame.lookAt(from, target)
	head.CFrame = look
	barrel.CFrame = look * CFrame.new(0, 0, -2)
	return (look * CFrame.new(0, 0, -3.5)).Position
end

local function turretStep(plot: Model, owner: Player, t: number)
	local turret = plot:FindFirstChild("Turret") :: Model?
	local intruders = intruderSince[plot]
	if not intruders then
		intruders = {}
		intruderSince[plot] = intruders
	end
	-- Чужаки на базе: запоминаем, с какого момента стоят (нужно и без турели — чтобы не стрелять сразу после покупки)
	local clock = os.clock()
	for _, other in Players:GetPlayers() do
		local root = if other ~= owner then rootOf(other) else nil
		if root and PlotService.InPlot(plot, root.Position) then
			intruders[other] = intruders[other] or clock
		else
			intruders[other] = nil
		end
	end
	for other in intruders do
		if not other.Parent then
			intruders[other] = nil
		end
	end

	if not turret then
		return
	end
	local stats = Config.Defense.Turret[DataService.Get(owner, "TurretLevel")]
	if not stats or t - (lastTurretShot[plot] or -math.huge) < stats.Cooldown then
		return
	end
	local head = turret:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local origin = head.Position

	local best: Player? = nil
	local bestDistance = stats.Range
	local function consider(candidate: Player)
		local root = rootOf(candidate)
		if not root then
			return
		end
		local distance = (root.Position - origin).Magnitude
		if distance <= bestDistance then
			best = candidate
			bestDistance = distance
		end
	end
	for thief, carry in StealService.GetCarries() do
		if carry.Owner == owner and thief ~= owner then
			consider(thief)
		end
	end
	for other, since in intruders do
		if clock - since >= INTRUDER_DELAY then
			consider(other)
		end
	end
	if not best then
		return
	end
	local targetRoot = rootOf(best :: Player)
	if not targetRoot then
		return
	end
	lastTurretShot[plot] = t
	local barrelEnd = aimTurret(turret, targetRoot.Position)
	Remotes.Fx:FireAllClients("Turret", { From = barrelEnd, To = targetRoot.Position })
	StealService.Knock(best :: Player, origin, TURRET_POWER, stats.Stun)
	Remotes.Notify:FireClient(best :: Player, "TurretHit", nil, "error")
	-- Чужак получает заряд и заново «копит» время на базе
	intruders[best :: Player] = clock
end

local function flashLaser(laser: BasePart)
	laser.Transparency = 0
	laser.Color = Color3.fromRGB(255, 160, 160)
	task.delay(0.35, function()
		if laser.Parent then
			laser.Transparency = LASER_TRANSPARENCY
			laser.Color = Color3.fromRGB(255, 40, 40)
		end
	end)
end

local function laserStep(plot: Model, owner: Player, t: number)
	local laser = plot:FindFirstChild("LaserGate") :: BasePart?
	if not laser then
		return
	end
	local stats = Config.Defense.LaserGate[DataService.Get(owner, "LaserLevel")]
	if not stats or t - (lastLaserHit[plot] or -math.huge) < stats.Cooldown then
		return
	end
	local floor = floorOf(plot)
	local size = floor.Size
	for thief, carry in StealService.GetCarries() do
		if carry.Owner ~= owner or thief == owner then
			continue
		end
		local root = rootOf(thief)
		if not root then
			continue
		end
		-- Координаты относительно пола: вход — край -Z
		local localPos = floor.CFrame:PointToObjectSpace(root.Position)
		local nearGate = math.abs(localPos.Z + size.Z / 2) <= LASER_DISTANCE
		if nearGate and math.abs(localPos.X) <= size.X / 2 and localPos.Y > -5 and localPos.Y < 20 then
			lastLaserHit[plot] = t
			flashLaser(laser)
			Remotes.Fx:FireAllClients("Laser", { Position = root.Position })
			StealService.Knock(thief, laser.Position, LASER_POWER, stats.Stun)
			Remotes.Notify:FireClient(thief, "LaserHit", nil, "error")
			break
		end
	end
end

local function step()
	local t = os.clock()
	for _, plot in PlotService.AllPlots() do
		local owner = PlotService.GetOwner(plot)
		if not owner or not DataService.IsLoaded(owner) then
			continue
		end
		turretStep(plot, owner, t)
		laserStep(plot, owner, t)
	end
end

-- ===== Жизненный цикл =====

function DefenseService.OnLoaded(player: Player)
	DefenseService.Refresh(player)
end

-- Вызывать ДО PlotService.Release: убирает турель и лазер с базы уходящего игрока
function DefenseService.OnPlayerRemoving(player: Player)
	local plot = PlotService.GetPlot(player)
	if plot then
		destroyVisuals(plot)
	end
	for _, intruders in intruderSince do
		intruders[player] = nil
	end
end

function DefenseService.Start()
	Remotes.UpgradeDefense.OnServerInvoke = function(player, kind)
		return DefenseService.Upgrade(player, kind)
	end

	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(step)
			if not ok then
				warn("[DefenseService]", err)
			end
		end
	end)
end

return DefenseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">EmoteService</string>
          <string name="Source"><![CDATA[-- Эмоции: клиент просит сыграть эмоцию, сервер проверяет и рассылает всем Fx "Emote".
-- Саму анимацию (процедурную, Config.Emotes[*].Proc) и эмодзи над головой рисует каждый клиент.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)

local EmoteService = {}

local lastEmoteAt: { [Player]: number } = {}

local function onEmote(player: Player, emoteId: unknown)
	if typeof(emoteId) ~= "string" or #emoteId > 50 then
		return
	end
	local emote = Config.GetEmote(emoteId)
	if not emote or not DataService.IsLoaded(player) then
		return
	end
	if emote.Pass and player:GetAttribute("Pass_" .. emote.Pass) ~= true then
		return
	end
	local t = os.clock()
	-- Небольшой допуск: клиент считает ту же перезарядку по своим часам, и запрос
	-- «ровно через EmoteCooldown» из-за пинга не должен молча теряться
	if t - (lastEmoteAt[player] or -math.huge) < Config.EmoteCooldown - 0.3 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not (character :: Model):FindFirstChild("HumanoidRootPart") then
		return
	end
	lastEmoteAt[player] = t
	Remotes.Fx:FireAllClients("Emote", { UserId = player.UserId, Emote = emoteId })
end

function EmoteService.OnPlayerRemoving(player: Player)
	lastEmoteAt[player] = nil
end

function EmoteService.Start()
	Remotes.Emote.OnServerEvent:Connect(onEmote)
end

return EmoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- Серверные ивенты: «В ТРЕНДЕ» (один вид мема даёт ×3) и Ночь Смайлика — темнеет, по карте
-- ходит жёлтый смайлик-монстр и утаскивает мемов с открытых баз; игроки отбиваются тапками.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local MemeFactory = require(script.Parent.MemeFactory)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)
local Hooks = require(script.Parent.Hooks)

local EventService = {}

local random = Random.new()
local mapHalfX = 230
local mapHalfZ = 130

local function now(): number
	return workspace:GetServerTimeNow()
end

-- ===== В ТРЕНДЕ =====

local function pickTrend(): string
	local present = {}
	for _, player in Players:GetPlayers() do
		if PlotService.GetPlot(player) then
			local ok, entries = pcall(PlotService.GetEntries, player)
			if ok then
				for _, entry in entries do
					if not table.find(present, entry.Id) then
						table.insert(present, entry.Id)
					end
				end
			end
		end
	end
	-- Чаще выбираем то, что уже есть на базах — тогда начинается охота за этим мемом
	if #present > 0 and random:NextNumber() < 0.75 then
		return present[random:NextInteger(1, #present)]
	end
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == "Common" or creature.Rarity == "Rare" or creature.Rarity == "Epic" then
			table.insert(pool, creature.Id)
		end
	end
	return pool[random:NextInteger(1, #pool)]
end

local function startTrend()
	local previous = ReplicatedStorage:GetAttribute("TrendingId")
	local id = pickTrend()
	for _ = 1, 5 do
		if id ~= previous then
			break
		end
		id = pickTrend()
	end
	ReplicatedStorage:SetAttribute("TrendingId", id)
	ReplicatedStorage:SetAttribute("TrendEndsAt", now() + Config.Trend.Interval)
	PlotService.RefreshAllIncome()
	Remotes.Notify:FireAllClients("TrendNow", { Meme = id, Mult = Config.Trend.Mult }, "info")
end

-- ===== Смайлик =====

type MonsterState = {
	Model: Model,
	Hp: number,
	Damage: { [Player]: number },
	Carry: { Owner: Player, Slot: number, Model: Model, Id: string }?,
	Defeated: boolean,
}
local monster: MonsterState? = nil

local function buildMonster(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "Smiley"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(8, 8, 8)
	body.Color = Color3.fromRGB(255, 220, 30)
	for _, season in Config.Seasons do
		if season.Id == ReplicatedStorage:GetAttribute("Season") then
			body.Color = season.MonsterColor
		end
	end
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = true
	body.CanCollide = false
	body.CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0))
	body.Parent = model
	model.PrimaryPart = body

	local gui = Instance.new("SurfaceGui")
	gui.Name = "FaceGui"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.CanvasSize = Vector2.new(200, 200)
	gui.Parent = body
	local face = Instance.new("TextLabel")
	face.Name = "Face"
	face.Size = UDim2.fromScale(1, 1)
	face.BackgroundTransparency = 1
	face.TextScaled = true
	face.Font = Enum.Font.GothamBlack
	face.TextColor3 = Color3.fromRGB(20, 20, 20)
	face.Text = ":)"
	face.Parent = gui

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 230, 80)
	light.Range = 30
	light.Brightness = 2
	light.Parent = body

	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	game:GetService("CollectionService"):AddTag(model, "Monster")
	model.Parent = workspace
	return model
end

local function setFace(state: MonsterState, text: string)
	local gui = (state.Model.PrimaryPart :: BasePart):FindFirstChild("FaceGui")
	if gui then
		(gui:FindFirstChild("Face") :: TextLabel).Text = text
	end
end

local function returnCarried(state: MonsterState)
	local carry = state.Carry
	if not carry then
		return
	end
	state.Carry = nil
	state.Model:SetAttribute("Carrying", "")
	setFace(state, ":)")
	if carry.Owner.Parent and PlotService.GetPlot(carry.Owner) and DataService.IsLoaded(carry.Owner)
		and PlotService.GetEntry(carry.Owner, carry.Slot) then
		PlotService.ReturnModel(carry.Owner, carry.Slot, carry.Model)
		PlotService.SetAway(carry.Owner, carry.Slot, false)
		Remotes.Notify:FireClient(carry.Owner, "MemeReturned", { Meme = carry.Id }, "success")
	else
		carry.Model:Destroy()
	end
end

local function despawnMonster()
	local state = monster
	if not state then
		return
	end
	monster = nil
	returnCarried(state)
	state.Model:Destroy()
end

local function rewardBest(state: MonsterState)
	local best: Player? = nil
	local bestDamage = 0
	for player, damage in state.Damage do
		-- Награду кладём в данные игрока — без загруженных данных (или базы) выдать её нельзя
		if player.Parent and DataService.IsLoaded(player) and damage > bestDamage then
			best, bestDamage = player, damage
		end
	end
	if not best then
		return
	end
	Remotes.Notify:FireAllClients("MonsterDefeated", { Player = best.DisplayName }, "success")

	local night = Config.Night
	local total = 0
	for _, weight in night.RewardWeights do
		total += weight
	end
	local roll = random:NextNumber() * total
	local rarity = night.RewardRarities[1]
	for i, weight in night.RewardWeights do
		roll -= weight
		if roll <= 0 then
			rarity = night.RewardRarities[i]
			break
		end
	end
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarity and not creature.Event then
			table.insert(pool, creature.Id)
		end
	end
	if #pool == 0 then
		return
	end
	local id = pool[random:NextInteger(1, #pool)]
	if PlotService.AddMeme(best, id, "None", false) then
		Remotes.Notify:FireClient(best, "NightReward", { Meme = id }, "success")
	else
		local coins = math.floor(Config.PriceOf(id, "None") * 0.5)
		PlotService.AddCoins(best, coins)
		Remotes.Notify:FireClient(best, "NightRewardCoins", { Coins = coins }, "success")
	end
end

-- Удар тапком по Смайлику. Возвращает true, если попал.
function EventService.HitMonster(player: Player, origin: Vector3, range: number): boolean
	local state = monster
	if not state or state.Defeated then
		return false
	end
	local position = state.Model:GetPivot().Position
	if (position - origin).Magnitude > range + 4 then
		return false
	end
	state.Hp -= 1
	state.Damage[player] = (state.Damage[player] or 0) + 1
	Hooks.Fire(player, "MonsterHit", 1)
	state.Model:SetAttribute("Hp", state.Hp)
	Remotes.Fx:FireAllClients("MonsterHit", { Position = position })
	if state.Hp <= 0 then
		state.Defeated = true
		rewardBest(state)
		despawnMonster()
	end
	return true
end

-- Монстр шагает к точке. Возвращает false, если по дороге его победили/убрали.
local function walkTo(state: MonsterState, target: Vector3, shouldAbort: (() -> boolean)?): boolean
	while monster == state and not state.Defeated do
		local pivot = state.Model:GetPivot()
		local flatTarget = Vector3.new(target.X, pivot.Position.Y, target.Z)
		local offset = flatTarget - pivot.Position
		if offset.Magnitude < 1.5 then
			return true
		end
		if shouldAbort and shouldAbort() then
			return false
		end
		local dt = RunService.Heartbeat:Wait()
		local step = math.min(Config.Night.MonsterSpeed * dt, offset.Magnitude)
		local nextPosition = pivot.Position + offset.Unit * step
		state.Model:PivotTo(CFrame.lookAt(nextPosition, nextPosition + offset.Unit))
	end
	return false
end

local function pickTarget(): (Player?, number?)
	local candidates = {}
	for _, player in Players:GetPlayers() do
		local plot = PlotService.GetPlot(player)
		if plot and not PlotService.IsLocked(plot) then
			local ok, entries = pcall(PlotService.GetEntries, player)
			if ok then
				for _, entry in entries do
					if PlotService.GetModel(player, entry.Slot) and not PlotService.IsBusy(player, entry.Slot) then
						table.insert(candidates, { player, entry.Slot })
					end
				end
			end
		end
	end
	if #candidates == 0 then
		return nil, nil
	end
	local pick = candidates[random:NextInteger(1, #candidates)]
	return pick[1], pick[2]
end

local function nearestEdge(position: Vector3): Vector3
	local options = {
		Vector3.new(mapHalfX - 4, position.Y, position.Z),
		Vector3.new(-mapHalfX + 4, position.Y, position.Z),
		Vector3.new(position.X, position.Y, mapHalfZ - 4),
		Vector3.new(position.X, position.Y, -mapHalfZ + 4),
	}
	local best, bestDistance = options[1], math.huge
	for _, option in options do
		local distance = (option - position).Magnitude
		if distance < bestDistance then
			best, bestDistance = option, distance
		end
	end
	return best
end

local function monsterBrain(state: MonsterState)
	while monster == state and not state.Defeated do
		task.wait() -- страховка: ни одна ветка ниже не должна крутить цикл без паузы
		if monster ~= state or state.Defeated then
			break
		end
		local owner, slot = pickTarget()
		if not owner or not slot then
			-- Все базы закрыты — бродим по дорожке
			local wander = Vector3.new(random:NextNumber(-150, 150), 0, random:NextNumber(-10, 10))
			walkTo(state, wander)
			task.wait(1)
			continue
		end
		local plot = PlotService.GetPlot(owner) :: Model
		local function abort(): boolean
			return not owner.Parent or PlotService.GetPlot(owner) ~= plot or PlotService.IsLocked(plot)
				or PlotService.GetModel(owner, slot) == nil
		end
		if not walkTo(state, PlotService.OutsidePoint(plot).Position, abort) then
			continue
		end
		local target = PlotService.GetModel(owner, slot)
		if not target or not walkTo(state, target:GetPivot().Position, abort) then
			continue
		end
		-- Пауза «ворую...» — шанс отбить мема тапками
		setFace(state, ">:)")
		local deadline = os.clock() + Config.Night.MonsterStealPause
		while os.clock() < deadline and monster == state and not abort() do
			task.wait(0.1)
		end
		if monster ~= state or abort() then
			setFace(state, ":)")
			continue
		end

		local model = PlotService.DetachModel(owner, slot) :: Model
		PlotService.SetAway(owner, slot, true)
		for _, child in (model.PrimaryPart :: BasePart):GetChildren() do
			if child:IsA("ProximityPrompt") then
				child:Destroy()
			end
		end
		model:SetAttribute("State", "Carried")
		local body = state.Model.PrimaryPart :: BasePart
		MemeFactory.AttachTo(model, body, CFrame.new(0, body.Size.Y / 2 + (model.PrimaryPart :: BasePart).Size.Y / 2 + 1, 0))
		model.Parent = workspace
		local id = model:GetAttribute("CreatureId")
		state.Carry = { Owner = owner, Slot = slot, Model = model, Id = id }
		state.Model:SetAttribute("Carrying", id)
		Remotes.Notify:FireAllClients("MonsterStole", { Meme = id, Player = owner.DisplayName }, "error")

		local escaped = walkTo(state, nearestEdge(state.Model:GetPivot().Position))
		if escaped and monster == state and state.Carry then
			local carry = state.Carry :: { Owner: Player, Slot: number, Model: Model, Id: string }
			state.Carry = nil
			state.Model:SetAttribute("Carrying", "")
			carry.Model:Destroy()
			if carry.Owner.Parent and PlotService.GetPlot(carry.Owner) and DataService.IsLoaded(carry.Owner) then
				PlotService.RemoveEntry(carry.Owner, carry.Slot)
				Remotes.Notify:FireClient(carry.Owner, "MonsterEscaped", { Meme = carry.Id }, "error")
			end
			setFace(state, ":)")
		end
	end
end

local function spawnMonster()
	despawnMonster()
	local playerCount = math.max(#Players:GetPlayers(), 1)
	local hp = Config.Night.MonsterHpPerPlayer * playerCount
	local model = buildMonster(Vector3.new(-200, 0.5, 0))
	model:SetAttribute("Hp", hp)
	model:SetAttribute("MaxHp", hp)
	model:SetAttribute("Carrying", "")
	local state: MonsterState = { Model = model, Hp = hp, Damage = {}, Carry = nil, Defeated = false }
	monster = state
	task.spawn(monsterBrain, state)
end

-- Хозяин выходит — Смайлик бросает его мема (мем остаётся в сохранении хозяина)
function EventService.OnPlayerRemoving(player: Player)
	local state = monster
	if state and state.Carry and state.Carry.Owner == player then
		state.Carry.Model:Destroy()
		state.Carry = nil
		state.Model:SetAttribute("Carrying", "")
		setFace(state, ":)")
	end
	if state then
		state.Damage[player] = nil
	end
end

-- ===== Ночь =====

local savedLighting: { [string]: any } = {}

local function setNight(active: boolean)
	ReplicatedStorage:SetAttribute("NightActive", active)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if active then
		savedLighting = {
			ClockTime = Lighting.ClockTime,
			Brightness = Lighting.Brightness,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			AtmosphereColor = atmosphere and atmosphere.Color,
			AtmosphereDensity = atmosphere and atmosphere.Density,
		}
		Lighting.ClockTime = 0
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.fromRGB(60, 30, 80)
		Lighting.OutdoorAmbient = Color3.fromRGB(70, 40, 100)
		if atmosphere then
			atmosphere.Color = Color3.fromRGB(120, 60, 160)
			atmosphere.Density = 0.45
		end
	elseif savedLighting.ClockTime then
		Lighting.ClockTime = savedLighting.ClockTime
		Lighting.Brightness = savedLighting.Brightness
		Lighting.Ambient = savedLighting.Ambient
		Lighting.OutdoorAmbient = savedLighting.OutdoorAmbient
		if atmosphere and savedLighting.AtmosphereColor then
			atmosphere.Color = savedLighting.AtmosphereColor
			atmosphere.Density = savedLighting.AtmosphereDensity
		end
	end
end

function EventService.Start(halfX: number, halfZ: number)
	mapHalfX, mapHalfZ = halfX, halfZ
	ReplicatedStorage:SetAttribute("TrendingId", "")
	ReplicatedStorage:SetAttribute("TrendEndsAt", 0)
	ReplicatedStorage:SetAttribute("NightActive", false)
	ReplicatedStorage:SetAttribute("NightEndsAt", 0)
	ReplicatedStorage:SetAttribute("LuckEndsAt", 0)

	task.spawn(function()
		task.wait(20)
		while true do
			startTrend()
			task.wait(Config.Trend.Interval)
		end
	end)

	task.spawn(function()
		while true do
			ReplicatedStorage:SetAttribute("NextNightAt", now() + Config.Night.Interval)
			task.wait(Config.Night.Interval)
			ReplicatedStorage:SetAttribute("NightEndsAt", now() + Config.Night.Duration)
			setNight(true)
			Remotes.Notify:FireAllClients("NightStart", nil, "info")
			spawnMonster()
			task.wait(Config.Night.Duration)
			despawnMonster()
			setNight(false)
			Remotes.Notify:FireAllClients("NightEnd", nil, "info")
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Grant</string>
          <string name="Source"><![CDATA[-- Выдача награды по описанию из конфига (коды, колесо удачи, Мем-пропуск, календарь).
-- reward = { Kind = "Coins" | "Meme" | "Spins" | "Item" | "Skin", ... } — см. Config.Codes.
-- Возвращает таблицу для Popup: { Coins?, Meme?, Spins?, Item?, Skin? }.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

local Grant = {}

-- Колбэки из init.server: предмет выдан (перевыдать рюкзак), скин выдан (обновить SkinsJson)
Grant.OnItemGranted = nil :: ((Player) -> ())?
Grant.OnSkinGranted = nil :: ((Player) -> ())?

local function incomeCoins(player: Player, incomeSeconds: number?, minCoins: number?): number
	return math.max(minCoins or 0, math.floor(PlotService.IncomeOf(player) * (incomeSeconds or 0)))
end

local function coins(player: Player, amount: number, result: { [string]: any })
	PlotService.AddCoins(player, amount)
	result.Coins = (result.Coins or 0) + amount
end

-- Случайный обычный мем редкости (без сезонных, лимитированных и эксклюзивов)
function Grant.RandomMeme(rarity: string): string?
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarity and not creature.Event and not creature.Limited and not creature.Exclusive then
			table.insert(pool, creature.Id)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

function Grant.Give(player: Player, reward: any): { [string]: any }
	local result: { [string]: any } = {}
	if not DataService.IsLoaded(player) or type(reward) ~= "table" then
		return result
	end
	local kind = reward.Kind
	if kind == "Coins" then
		coins(player, incomeCoins(player, reward.IncomeSeconds, reward.MinCoins), result)
	elseif kind == "Spins" then
		DataService.Increment(player, "Spins", reward.Amount or 1)
		result.Spins = reward.Amount or 1
	elseif kind == "Meme" then
		local id = reward.Id or Grant.RandomMeme(reward.Rarity)
		if id and Config.GetCreature(id) then
			if PlotService.AddMeme(player, id, "None", false) then
				result.Meme = id
			else
				-- База заполнена — половина цены мема деньгами
				coins(player, math.max(1, math.floor(Config.PriceOf(id, "None") * 0.5)), result)
			end
		end
	elseif kind == "Item" then
		local item = Config.GetItem(reward.ItemId)
		local items = DataService.GetTable(player, "Items")
		if item and not item.Pass and not items[item.Id] then
			items[item.Id] = true
			result.Item = item.Id
			if Grant.OnItemGranted then
				task.spawn(Grant.OnItemGranted, player)
			end
		else
			coins(player, incomeCoins(player, 600, 2500), result)
		end
	elseif kind == "Skin" then
		local skin = Config.GetSkin(reward.SkinId)
		local skins = DataService.GetTable(player, "Skins")
		skins.Owned = skins.Owned or {}
		if skin and not skins.Owned[skin.Id] then
			skins.Owned[skin.Id] = true
			result.Skin = skin.Id
			if Grant.OnSkinGranted then
				task.spawn(Grant.OnSkinGranted, player)
			end
		else
			coins(player, incomeCoins(player, 600, 2500), result)
		end
	end
	return result
end

return Grant
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Hooks</string>
          <string name="Source"><![CDATA[-- Игровые события для квестов и статистики: другие сервисы сообщают «что произошло»,
-- а QuestService (и кто угодно ещё) подписывается. Так сервисы не зависят друг от друга.
--   Hooks.Fire(player, "Steal", 1)
--   Hooks.Connect(function(player, stat, amount) ... end)
-- Stat: Buy, Steal, Slap, MonsterHit, Merge, Lock, Earn, Play, Defend (см. Config.Quests).
local Hooks = {}

local listeners: { (Player, string, number) -> () } = {}

function Hooks.Connect(callback: (Player, string, number) -> ())
	table.insert(listeners, callback)
end

function Hooks.Fire(player: Player, stat: string, amount: number?)
	for _, callback in listeners do
		task.spawn(callback, player, stat, amount or 1)
	end
end

return Hooks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Предметы из Config.Items: оружие (тапок, бита, сковородка, бан-молот) и гаджеты
-- (энергетик, банановая кожура, шапка-невидимка). Покупка за монеты навсегда, выдача в рюкзак,
-- вся логика ударов и перезарядок — на сервере.
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)
local StealService = require(script.Parent.StealService)
local Hooks = require(script.Parent.Hooks)
local AnalyticsService = require(script.Parent.AnalyticsService)

local ItemService = {}

-- Колбэк удара по монстру (выставляет init.server): (player, origin, range) -> boolean
ItemService.OnMonsterHit = nil :: ((player: Player, origin: Vector3, range: number) -> boolean)?

local cooldowns: { [Player]: { [string]: number } } = {} -- игрок -> предмет -> os.clock() конца перезарядки
local bananas: { [Player]: { BasePart } } = {}
local invisibleToken: { [Player]: number } = {}
local bananaFolder: Folder

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function aliveHumanoid(player: Player): Humanoid?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

-- ===== Владение =====

function ItemService.Owns(player: Player, id: string): boolean
	if id == "Slipper" then
		return true
	end
	local item = Config.GetItem(id)
	if item and item.Pass then
		return player:GetAttribute("Pass_" .. item.Pass) == true
	end
	return DataService.IsLoaded(player) and DataService.GetTable(player, "Items")[id] == true
end

local function syncItems(player: Player)
	local owned = {}
	for _, item in Config.Items do
		if ItemService.Owns(player, item.Id) then
			table.insert(owned, item.Id)
		end
	end
	player:SetAttribute("ItemsJson", HttpService:JSONEncode(owned))
end

-- Изменились геймпассы (куплен предмет за Robux, золотой тапок) — обновить список и рюкзак
function ItemService.RefreshPasses(player: Player)
	if DataService.IsLoaded(player) then
		syncItems(player)
		ItemService.GiveTools(player)
	end
end

-- ===== Внешний вид (детали из примитивов) =====

local function addPart(tool: Tool, handle: BasePart, props: { [string]: any }, offset: CFrame)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = p
	weld.Parent = p
	p.Parent = tool
end

local function buildTool(item: any, gold: boolean, skin: any?): Tool
	local tool = Instance.new("Tool")
	tool.Name = item.Id
	tool.ToolTip = item.Face .. " " .. item.Name
	tool.CanBeDropped = false
	tool:SetAttribute("ItemId", item.Id)
	tool:SetAttribute("CooldownEndsAt", 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.CanCollide = false
	handle.Massless = true
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle.Parent = tool

	local id = item.Id
	if id == "Slipper" then
		handle.Size = Vector3.new(1.2, 2.6, 0.35)
		handle.Color = if gold then Color3.fromRGB(255, 205, 50) else Color3.fromRGB(70, 90, 200)
		handle.Material = if gold then Enum.Material.Foil else Enum.Material.Fabric
		-- Скин тапка (SkinService) поверх золотого/обычного
		if skin and skin.Color then
			handle.Color = skin.Color
			handle.Material = (Enum.Material :: any)[skin.Material or "SmoothPlastic"]
			if skin.Rainbow then
				local sparkles = Instance.new("ParticleEmitter")
				sparkles.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 255, 120)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 120, 255)),
				})
				sparkles.LightEmission = 1
				sparkles.Size = NumberSequence.new(0.25, 0)
				sparkles.Rate = 12
				sparkles.Lifetime = NumberRange.new(0.5, 0.8)
				sparkles.Speed = NumberRange.new(1, 2)
				sparkles.Parent = handle
			end
		end
		tool.Grip = CFrame.new(0, -0.9, 0) * CFrame.Angles(0, math.rad(90), 0)
		addPart(tool, handle, { Size = Vector3.new(1.25, 0.35, 0.5), Color = Color3.fromRGB(240, 240, 240) }, CFrame.new(0, 0.6, -0.3))
	elseif id == "Bat" then
		handle.Size = Vector3.new(0.5, 4.5, 0.5)
		handle.Color = Color3.fromRGB(170, 120, 70)
		handle.Material = Enum.Material.Wood
		tool.Grip = CFrame.new(0, -1.6, 0)
		addPart(tool, handle, { Size = Vector3.new(0.9, 1.8, 0.9), Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.Wood }, CFrame.new(0, 1.6, 0))
	elseif id == "Pan" then
		handle.Size = Vector3.new(0.35, 2.2, 0.35)
		handle.Color = Color3.fromRGB(40, 40, 45)
		tool.Grip = CFrame.new(0, -0.8, 0)
		addPart(tool, handle, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 2.6, 2.6),
			Color = Color3.fromRGB(30, 30, 35),
			Material = Enum.Material.Metal,
		}, CFrame.new(0, 2.2, 0) * CFrame.Angles(0, math.rad(90), 0))
	elseif id == "BanHammer" then
		handle.Size = Vector3.new(0.5, 4.5, 0.5)
		handle.Color = Color3.fromRGB(60, 40, 30)
		handle.Material = Enum.Material.Wood
		tool.Grip = CFrame.new(0, -1.6, 0)
		addPart(tool, handle, { Size = Vector3.new(3.2, 1.8, 1.8), Color = Color3.fromRGB(230, 40, 50), Material = Enum.Material.Neon }, CFrame.new(0, 2.4, 0))
	elseif id == "Energy" then
		handle.Shape = Enum.PartType.Cylinder
		handle.Size = Vector3.new(1.4, 0.8, 0.8)
		handle.Color = Color3.fromRGB(70, 220, 90)
		handle.Material = Enum.Material.Metal
		tool.Grip = CFrame.Angles(0, 0, math.rad(90))
	elseif id == "Banana" then
		handle.Size = Vector3.new(0.6, 1.8, 0.4)
		handle.Color = Color3.fromRGB(255, 225, 60)
		tool.Grip = CFrame.new(0, -0.4, 0)
	elseif id == "RubberChicken" then
		handle.Size = Vector3.new(0.6, 2.8, 0.6)
		handle.Color = Color3.fromRGB(255, 230, 90)
		tool.Grip = CFrame.new(0, -1, 0)
		addPart(tool, handle, { Size = Vector3.new(0.5, 0.4, 0.7), Color = Color3.fromRGB(255, 140, 40) }, CFrame.new(0, 1.5, -0.4))
		addPart(tool, handle, { Size = Vector3.new(0.4, 0.5, 0.2), Color = Color3.fromRGB(230, 40, 40) }, CFrame.new(0, 1.7, 0))
	elseif id == "Snowball" or id == "ConfettiCannon" then
		local confetti = id == "ConfettiCannon"
		handle.Size = Vector3.new(0.8, 1.2, 0.8)
		handle.Color = if confetti then Color3.fromRGB(255, 90, 200) else Color3.fromRGB(120, 180, 230)
		tool.Grip = CFrame.new(0, -0.3, 0.6)
		addPart(tool, handle, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3, 1, 1),
			Color = if confetti then Color3.fromRGB(255, 220, 60) else Color3.fromRGB(230, 245, 255),
			Material = if confetti then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		}, CFrame.new(0, 0.5, -1.4) * CFrame.Angles(0, math.rad(90), 0))
	elseif id == "RocketBoots" then
		handle.Size = Vector3.new(1, 1, 1.6)
		handle.Color = Color3.fromRGB(200, 40, 40)
		addPart(tool, handle, { Size = Vector3.new(0.6, 0.6, 0.4), Color = Color3.fromRGB(255, 170, 40), Material = Enum.Material.Neon }, CFrame.new(0, 0, 0.9))
	elseif id == "FreezeBomb" then
		handle.Shape = Enum.PartType.Ball
		handle.Size = Vector3.one * 1.3
		handle.Color = Color3.fromRGB(140, 220, 255)
		handle.Material = Enum.Material.Ice
	elseif id == "InvisHat" then
		handle.Shape = Enum.PartType.Cylinder
		handle.Size = Vector3.new(1.4, 1.3, 1.3)
		handle.Color = Color3.fromRGB(25, 25, 30)
		tool.Grip = CFrame.Angles(0, 0, math.rad(90))
		addPart(tool, handle, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 2.2, 2.2),
			Color = Color3.fromRGB(25, 25, 30),
		}, CFrame.new(-0.65, 0, 0))
		addPart(tool, handle, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 1.35, 1.35),
			Color = Color3.fromRGB(150, 60, 255),
			Material = Enum.Material.Neon,
		}, CFrame.new(-0.3, 0, 0))
	end
	return tool
end

-- ===== Перезарядка =====

local function ready(player: Player, item: any, tool: Tool): boolean
	-- Срабатывает только предмет в руках своего персонажа
	if tool.Parent ~= player.Character then
		return false
	end
	local list = cooldowns[player]
	if not list then
		list = {}
		cooldowns[player] = list
	end
	local t = os.clock()
	if (list[item.Id] or 0) > t then
		return false
	end
	list[item.Id] = t + item.Cooldown
	tool:SetAttribute("CooldownEndsAt", now() + item.Cooldown)
	return true
end

-- ===== Невидимость =====

local function setInvisible(player: Player, invisible: boolean)
	local character = player.Character
	if not character then
		return
	end
	if (character:GetAttribute("Invisible") == true) == invisible then
		return
	end
	character:SetAttribute("Invisible", invisible)
	-- Рюкзак тоже: предмет, надетый во время невидимости, не должен выдавать игрока,
	-- а снятый — остаться прозрачным навсегда
	local descendants = character:GetDescendants()
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, descendant in backpack:GetDescendants() do
			table.insert(descendants, descendant)
		end
	end
	for _, descendant in descendants do
		if descendant:IsA("BasePart") or descendant:IsA("Decal") then
			if invisible then
				if descendant:GetAttribute("OrigTransparency") == nil then
					descendant:SetAttribute("OrigTransparency", descendant.Transparency)
				end
				descendant.Transparency = 1
			else
				local original = descendant:GetAttribute("OrigTransparency")
				if original ~= nil then
					descendant.Transparency = original
					descendant:SetAttribute("OrigTransparency", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if invisible then Enum.HumanoidDisplayDistanceType.None else Enum.HumanoidDisplayDistanceType.Viewer
	end
	local root = rootOf(player)
	if root then
		Remotes.Fx:FireAllClients("Invisible", { Position = root.Position })
	end
end

-- Снять невидимость (начал кражу или ударил)
function ItemService.BreakInvisibility(player: Player)
	invisibleToken[player] = nil
	setInvisible(player, false)
end

-- ===== Оружие =====

local function swing(tool: Tool)
	local baseGrip = tool:GetAttribute("BaseGrip") or tool.Grip
	tool:SetAttribute("BaseGrip", baseGrip)
	tool.Grip = baseGrip * CFrame.Angles(math.rad(-80), 0, 0)
	task.delay(0.15, function()
		if tool.Parent then
			tool.Grip = baseGrip
		end
	end)
end

local function attack(player: Player, item: any, tool: Tool)
	local root = rootOf(player)
	if not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	ItemService.BreakInvisibility(player)
	swing(tool)

	local gold = item.Id == "Slipper" and player:GetAttribute("Pass_GoldSlipper") == true
	local range = if gold then Config.Slap.GoldRange else item.Range
	local power = if gold then Config.Slap.GoldKnockback else item.Knockback
	local look = root.CFrame.LookVector

	local targets: { Player } = {}
	local best: Player? = nil
	local bestDistance = range
	for _, other in Players:GetPlayers() do
		if other == player or not aliveHumanoid(other) then
			continue
		end
		local otherRoot = rootOf(other)
		if not otherRoot then
			continue
		end
		local offset = otherRoot.Position - root.Position
		local distance = offset.Magnitude
		if item.Area then
			if distance <= range then
				table.insert(targets, other)
			end
		elseif distance <= bestDistance and (distance < 3 or offset.Unit:Dot(look) > 0.2) then
			best, bestDistance = other, distance
		end
	end
	if best then
		table.insert(targets, best)
	end

	for _, target in targets do
		local targetRoot = rootOf(target) :: BasePart
		StealService.Knock(target, root.Position, power, item.Stun)
		Remotes.Fx:FireAllClients("Slap", { Position = targetRoot.Position })
	end
	if #targets > 0 then
		Hooks.Fire(player, "Slap", #targets)
	end
	if (#targets == 0 or item.Area) and ItemService.OnMonsterHit then
		ItemService.OnMonsterHit(player, root.Position, range + 4)
	end
end

-- ===== Гаджеты =====

local function useEnergy(player: Player, item: any, tool: Tool)
	local character = player.Character
	local root = rootOf(player)
	if not character or not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	character:SetAttribute("BoostUntil", now() + item.Duration)
	character:SetAttribute("BoostSpeed", item.Speed)
	StealService.UpdateSpeed(player)
	Remotes.Fx:FireAllClients("Energy", { Position = root.Position })
	task.delay(item.Duration + 0.05, function()
		if player.Parent and player.Character == character then
			StealService.UpdateSpeed(player)
		end
	end)
end

local function placeBanana(player: Player, item: any, tool: Tool)
	local root = rootOf(player)
	if not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	-- Кладём под ноги чуть позади: ловушка для того, кто бежит следом
	local origin = root.Position - root.CFrame.LookVector * 3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Model, bananaFolder }
	local hit = workspace:Raycast(origin, Vector3.new(0, -12, 0), params)
	local groundY = if hit then hit.Position.Y else root.Position.Y - 3

	local banana = Instance.new("Part")
	banana.Name = "Banana"
	banana.Size = Vector3.new(2, 0.3, 1.2)
	banana.Color = Color3.fromRGB(255, 225, 60)
	banana.Material = Enum.Material.SmoothPlastic
	banana.Anchored = true
	banana.CanCollide = false
	banana.CFrame = CFrame.new(origin.X, groundY + 0.15, origin.Z) * CFrame.Angles(0, math.rad(math.random(0, 360)), 0)
	banana:SetAttribute("OwnerUserId", player.UserId)
	CollectionService:AddTag(banana, "Banana")

	local list = bananas[player] or {}
	bananas[player] = list
	table.insert(list, banana)
	while #list > item.MaxActive do
		local old = table.remove(list, 1)
		if old then
			old:Destroy()
		end
	end

	local used = false
	banana.Touched:Connect(function(other)
		if used then
			return
		end
		local victim = Players:GetPlayerFromCharacter(other.Parent)
		if not victim or victim == player or not aliveHumanoid(victim) then
			return
		end
		used = true
		local position = banana.Position
		banana:Destroy()
		local current = bananas[player]
		local index = current and table.find(current, banana)
		if current and index then
			table.remove(current, index)
		end
		StealService.Knock(victim, position - Vector3.new(0, 1, 0), 25, item.Stun)
		Remotes.Fx:FireAllClients("Banana", { Position = position })
	end)
	banana.Parent = bananaFolder

	task.delay(item.Duration, function()
		if banana.Parent then
			banana:Destroy()
		end
		local current = bananas[player]
		if current then
			local index = table.find(current, banana)
			if index then
				table.remove(current, index)
			end
		end
	end)
end

local function useInvisHat(player: Player, item: any, tool: Tool)
	if not aliveHumanoid(player) or StealService.IsCarrying(player) or not ready(player, item, tool) then
		return
	end
	local token = (invisibleToken[player] or 0) + 1
	invisibleToken[player] = token
	setInvisible(player, true)
	task.delay(item.Duration, function()
		if invisibleToken[player] == token then
			invisibleToken[player] = nil
			setInvisible(player, false)
		end
	end)
end

-- Дальний бой: первый враг в узком конусе перед персонажем, если его не закрывает стена
local function shoot(player: Player, item: any, tool: Tool)
	local root = rootOf(player)
	if not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	ItemService.BreakInvisibility(player)
	local look = root.CFrame.LookVector
	local origin = root.Position + Vector3.new(0, 1.5, 0)

	local best: Player? = nil
	local bestDistance = item.Range
	for _, other in Players:GetPlayers() do
		if other == player or not aliveHumanoid(other) then
			continue
		end
		local otherRoot = rootOf(other)
		if not otherRoot then
			continue
		end
		local offset = otherRoot.Position - root.Position
		local distance = offset.Magnitude
		if distance <= bestDistance and distance > 0.1 and offset.Unit:Dot(look) > 0.93 then
			best, bestDistance = other, distance
		end
	end

	local hitPosition = origin + look * item.Range
	if best then
		local targetRoot = rootOf(best) :: BasePart
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore: { Instance } = { player.Character :: Model, best.Character :: Model, bananaFolder }
		local carpet = workspace:FindFirstChild("CarpetMemes")
		if carpet then
			table.insert(ignore, carpet)
		end
		params.FilterDescendantsInstances = ignore
		local blocked = workspace:Raycast(origin, targetRoot.Position - origin, params)
		if blocked and blocked.Instance.CanCollide then
			hitPosition = blocked.Position
		else
			hitPosition = targetRoot.Position
			StealService.Knock(best, root.Position, item.Knockback, item.Stun)
			Hooks.Fire(player, "Slap", 1)
		end
	end
	Remotes.Fx:FireAllClients("Shot", { From = origin, To = hitPosition, Item = item.Id })
	if not best and ItemService.OnMonsterHit then
		-- По монстру дальнобой бьёт, если тот стоит в пределах дальности перед игроком
		ItemService.OnMonsterHit(player, root.Position + look * math.min(item.Range, 30), 18)
	end
end

local function useRocket(player: Player, item: any, tool: Tool)
	local root = rootOf(player)
	if not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	local look = root.CFrame.LookVector
	-- Толчок делает клиент владельца (персонажем управляет он), stun = 0 — без падения.
	-- MoveGraceUntil: анти-чит переноски не считает этот рывок телепортом.
	(player.Character :: Model):SetAttribute("MoveGraceUntil", now() + 3)
	Remotes.Knockback:FireClient(player, Vector3.new(look.X, 0, look.Z) * item.Forward + Vector3.new(0, item.Jump, 0), 0)
	Remotes.Fx:FireAllClients("Rocket", { Position = root.Position })
end

local function useFreeze(player: Player, item: any, tool: Tool)
	local root = rootOf(player)
	if not root or not aliveHumanoid(player) or not ready(player, item, tool) then
		return
	end
	ItemService.BreakInvisibility(player)
	local hits = 0
	for _, other in Players:GetPlayers() do
		local otherRoot = rootOf(other)
		if other ~= player and otherRoot and aliveHumanoid(other) and (otherRoot.Position - root.Position).Magnitude <= item.Range then
			StealService.Knock(other, root.Position, 8, item.Stun)
			hits += 1
		end
	end
	if hits > 0 then
		Hooks.Fire(player, "Slap", hits)
	end
	Remotes.Fx:FireAllClients("Freeze", { Position = root.Position, Radius = item.Range })
end

local USE = {
	Energy = useEnergy,
	Banana = placeBanana,
	InvisHat = useInvisHat,
	RocketBoots = useRocket,
	FreezeBomb = useFreeze,
}

-- ===== Выдача =====

function ItemService.GiveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack then
		return
	end
	for _, container in { backpack, player.Character } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("ItemId") then
					child:Destroy()
				end
			end
		end
	end
	local gold = player:GetAttribute("Pass_GoldSlipper") == true
	local slipperSkin = Config.GetSkin(player:GetAttribute("SlipperSkin") or "")
	for _, item in Config.Items do
		if not ItemService.Owns(player, item.Id) then
			continue
		end
		local tool = buildTool(item, gold, if item.Id == "Slipper" then slipperSkin else nil)
		-- Перезарядка переживает респавн
		local endsAt = cooldowns[player] and cooldowns[player][item.Id]
		if endsAt and endsAt > os.clock() then
			tool:SetAttribute("CooldownEndsAt", now() + (endsAt - os.clock()))
		end
		tool.Activated:Connect(function()
			if item.Kind == "Weapon" and item.Ranged then
				shoot(player, item, tool)
			elseif item.Kind == "Weapon" then
				attack(player, item, tool)
			else
				local use = USE[item.Id]
				if use then
					use(player, item, tool)
				end
			end
		end)
		tool.Parent = backpack
	end
end

function ItemService.Buy(player: Player, id: unknown): (boolean, string)
	if type(id) ~= "string" or not DataService.IsLoaded(player) then
		return false, "NotLoaded"
	end
	local item = Config.GetItem(id)
	if not item then
		return false, "NotLoaded"
	end
	if ItemService.Owns(player, id) then
		return false, "ItemOwned"
	end
	if item.Pass then
		return false, "PassOnly" -- такие предметы продаются только за Robux (геймпасс)
	end
	if DataService.Get(player, "Coins") < item.Price then
		Remotes.Notify:FireClient(player, "NotEnoughCash", { Price = item.Price }, "error")
		return false, "NotEnoughCash"
	end
	DataService.Increment(player, "Coins", -item.Price)
	AnalyticsService.Economy(player, "Sink", item.Price, "Shop", id)
	DataService.GetTable(player, "Items")[id] = true
	syncItems(player)
	ItemService.GiveTools(player)
	Remotes.Notify:FireClient(player, "ItemBought", { Item = id }, "success")
	return true, "ItemBought"
end

function ItemService.OnLoaded(player: Player)
	syncItems(player)
end

function ItemService.OnCharacter(player: Player, character: Model)
	invisibleToken[player] = nil
	character:SetAttribute("Invisible", false)
	ItemService.GiveTools(player)
end

function ItemService.OnPlayerRemoving(player: Player)
	for _, banana in bananas[player] or {} do
		banana:Destroy()
	end
	bananas[player] = nil
	cooldowns[player] = nil
	invisibleToken[player] = nil
end

function ItemService.Start()
	bananaFolder = Instance.new("Folder")
	bananaFolder.Name = "Bananas"
	bananaFolder.Parent = workspace

	StealService.OnStealStarted = ItemService.BreakInvisibility
	Remotes.BuyItem.OnServerInvoke = ItemService.Buy
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Глобальные таблицы лидеров на карте: «Богачи» (всего заработано) и «Воры» (успешные кражи).
-- OrderedDataStore работает только в опубликованной игре (или в Studio с включёнными API Services).
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local UPDATE_INTERVAL = 120
local TOP = 10

local function getStore(name: string): OrderedDataStore?
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	return if ok then store else nil
end

local names: { [number]: string } = {}
local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	names[userId] = if ok then name else "?"
	return names[userId]
end

local function refresh(store: OrderedDataStore, key: string, board: BasePart, prefix: string)
	for _, player in Players:GetPlayers() do
		if DataService.IsLoaded(player) then
			local value = math.floor(DataService.Get(player, key))
			pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
		end
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, TOP)
	end)
	local list = board:FindFirstChild("Board") and (board:FindFirstChild("Board") :: SurfaceGui):FindFirstChild("List") :: TextLabel?
	if not list then
		return
	end
	if not ok then
		list.Text = "Publish the game to see the leaderboard\nОпубликуйте игру, чтобы увидеть рейтинг"
		return
	end
	local lines = {}
	for rank, item in pages:GetCurrentPage() do
		table.insert(lines, string.format("%d. %s — %s%s", rank, nameOf(tonumber(item.key) or 0), prefix, Format.Number(item.value)))
	end
	list.Text = if #lines > 0 then table.concat(lines, "\n") else "..."
end

function LeaderboardService.Start(boards: { Earned: BasePart, Stolen: BasePart })
	local earnedStore = getStore("TopEarned_v1")
	local stolenStore = getStore("TopStolen_v1")
	task.spawn(function()
		task.wait(15)
		while true do
			if earnedStore then
				refresh(earnedStore, "TotalEarned", boards.Earned, "$")
			end
			if stolenStore then
				refresh(stolenStore, "Stolen", boards.Stolen, "")
			end
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Строит карту кодом: земля, «красная дорожка» мемов, 8 баз игроков, сезонный декор,
-- точка появления и стены-границы. В режиме редактирования Studio мир пустой — он появляется по Play.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MapBuilder = {}

MapBuilder.CARPET_LENGTH = 360
MapBuilder.CARPET_WIDTH = 16
MapBuilder.CarpetStart = Vector3.new(-MapBuilder.CARPET_LENGTH / 2, 1, 0)
MapBuilder.CarpetEnd = Vector3.new(MapBuilder.CARPET_LENGTH / 2, 1, 0)
MapBuilder.PLOT_SIZE = Vector3.new(80, 1, 72)
MapBuilder.HALF_X = 230 -- граница карты по X
MapBuilder.HALF_Z = 130

local PLOT_X = { -135, -45, 45, 135 }
local PLOT_Z = 64
local SLOT_COLUMNS = 5
local SLOT_SPACING_X = 14
local SLOT_SPACING_Z = 10.5

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function setupLighting(winter: boolean)
	Lighting.ClockTime = if winter then 15.5 else 17.2
	Lighting.Brightness = 2.2
	Lighting.Ambient = if winter then Color3.fromRGB(90, 100, 130) else Color3.fromRGB(90, 70, 100)
	Lighting.OutdoorAmbient = if winter then Color3.fromRGB(150, 165, 200) else Color3.fromRGB(150, 120, 140)
	Lighting.GlobalShadows = true
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.3
		atmosphere.Color = if winter then Color3.fromRGB(200, 220, 255) else Color3.fromRGB(255, 190, 150)
		atmosphere.Decay = if winter then Color3.fromRGB(110, 130, 170) else Color3.fromRGB(120, 70, 110)
		atmosphere.Glare = 0.3
		atmosphere.Haze = 1.2
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 30
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
end

local function buildPumpkin(position: Vector3, size: number, parent: Instance)
	local pumpkin = part({
		Name = "Pumpkin",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size * 0.8, size),
		Color = Color3.fromRGB(255, 125, 20),
		CFrame = CFrame.new(position + Vector3.new(0, size * 0.4, 0)),
		CanCollide = false,
		Parent = parent,
	})
	part({
		Name = "Stem",
		Size = Vector3.new(size * 0.15, size * 0.3, size * 0.15),
		Color = Color3.fromRGB(70, 110, 40),
		CFrame = CFrame.new(position + Vector3.new(0, size * 0.85, 0)),
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 40)
	light.Range = size * 3
	light.Brightness = 1.2
	light.Parent = pumpkin
end

local function buildSnowman(position: Vector3, size: number, parent: Instance)
	local radii = { size, size * 0.75, size * 0.5 }
	local y = position.Y
	local head: Part? = nil
	for _, radius in radii do
		y += radius * 0.85
		head = part({
			Name = "Snowman",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * radius * 2,
			Color = Color3.fromRGB(245, 250, 255),
			Material = Enum.Material.Snow,
			CFrame = CFrame.new(position.X, y, position.Z),
			CanCollide = false,
			Parent = parent,
		})
		y += radius * 0.85
	end
	if head then
		part({
			Name = "Nose",
			Size = Vector3.new(size * 0.15, size * 0.15, size * 0.6),
			Color = Color3.fromRGB(255, 130, 30),
			CFrame = head.CFrame * CFrame.new(0, 0, -size * 0.6),
			CanCollide = false,
			Parent = parent,
		})
	end
end

local function buildTree(position: Vector3, height: number, random: Random, parent: Instance)
	part({
		Name = "TreeTrunk",
		Size = Vector3.new(1.5, height * 0.25, 1.5),
		Color = Color3.fromRGB(90, 60, 40),
		Material = Enum.Material.Wood,
		CFrame = CFrame.new(position + Vector3.new(0, height * 0.125, 0)),
		Parent = parent,
	})
	for layer = 0, 2 do
		local width = height * (0.7 - layer * 0.18)
		local cone = part({
			Name = "TreeLayer",
			Size = Vector3.new(width, height * 0.3, width),
			Color = Color3.fromRGB(30, 110, 60),
			Material = Enum.Material.Grass,
			CFrame = CFrame.new(position + Vector3.new(0, height * (0.35 + layer * 0.22), 0)) * CFrame.Angles(0, math.rad(layer * 30), 0),
			CanCollide = false,
			Parent = parent,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromHSV(random:NextNumber(), 0.6, 1)
		light.Range = 8
		light.Brightness = 0.8
		light.Parent = cone
	end
	part({
		Name = "TreeStar",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.4,
		Color = Color3.fromRGB(255, 220, 60),
		Material = Enum.Material.Neon,
		CFrame = CFrame.new(position + Vector3.new(0, height * 0.95, 0)),
		CanCollide = false,
		Parent = parent,
	})
end

-- Снегопад: большой невидимый «потолок» с частицами
local function buildSnowfall(parent: Instance)
	local sky = part({
		Name = "Snowfall",
		Size = Vector3.new(MapBuilder.HALF_X * 2, 1, MapBuilder.HALF_Z * 2),
		CFrame = CFrame.new(0, 70, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Parent = parent,
	})
	local snow = Instance.new("ParticleEmitter")
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.LightEmission = 0.3
	snow.Size = NumberSequence.new(0.35)
	snow.Rate = 90 -- частиц на всю карту; больше — тяжело для телефонов
	snow.Lifetime = NumberRange.new(9, 12)
	snow.Speed = NumberRange.new(6, 9)
	snow.SpreadAngle = Vector2.new(15, 15)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Parent = sky
end

local function buildLamp(position: Vector3, parent: Instance)
	part({
		Name = "LampPost",
		Size = Vector3.new(0.8, 12, 0.8),
		Color = Color3.fromRGB(40, 35, 50),
		Material = Enum.Material.Metal,
		CFrame = CFrame.new(position + Vector3.new(0, 6, 0)),
		Parent = parent,
	})
	local bulb = part({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2,
		Color = Color3.fromRGB(255, 190, 90),
		Material = Enum.Material.Neon,
		CFrame = CFrame.new(position + Vector3.new(0, 12.5, 0)),
		CanCollide = false,
		Parent = parent,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 180, 90)
	light.Range = 26
	light.Brightness = 1.6
	light.Parent = bulb
end

local function buildCarpet(map: Instance)
	local length = MapBuilder.CARPET_LENGTH
	part({
		Name = "Carpet",
		Size = Vector3.new(length, 0.4, MapBuilder.CARPET_WIDTH),
		CFrame = CFrame.new(0, 0.7, 0),
		Color = Color3.fromRGB(170, 25, 40),
		Material = Enum.Material.Fabric,
		Parent = map,
	})
	for _, side in { -1, 1 } do
		part({
			Name = "CarpetEdge",
			Size = Vector3.new(length, 0.6, 1),
			CFrame = CFrame.new(0, 0.8, side * (MapBuilder.CARPET_WIDTH / 2 + 0.5)),
			Color = Color3.fromRGB(255, 200, 60),
			Material = Enum.Material.Neon,
			Parent = map,
		})
	end

	-- Портал, из которого выходят мемы
	local portal = part({
		Name = "MemePortal",
		Size = Vector3.new(2, 20, 22),
		CFrame = CFrame.new(MapBuilder.CarpetStart + Vector3.new(-2, 10, 0)),
		Color = Color3.fromRGB(150, 60, 255),
		Material = Enum.Material.Neon,
		Transparency = 0.25,
		CanCollide = false,
		Parent = map,
	})
	local portalParticles = Instance.new("ParticleEmitter")
	portalParticles.Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 140, 40))
	portalParticles.LightEmission = 1
	portalParticles.Size = NumberSequence.new(1.2, 0)
	portalParticles.Rate = 30
	portalParticles.Lifetime = NumberRange.new(1, 2)
	portalParticles.Speed = NumberRange.new(4, 8)
	portalParticles.EmissionDirection = Enum.NormalId.Right
	portalParticles.Parent = portal
	for _, side in { -1, 1 } do
		part({
			Name = "PortalPillar",
			Size = Vector3.new(4, 24, 4),
			CFrame = CFrame.new(MapBuilder.CarpetStart + Vector3.new(-2, 12, side * 13)),
			Color = Color3.fromRGB(40, 30, 60),
			Material = Enum.Material.Slate,
			Parent = map,
		})
	end
	-- Ворота на выходе дорожки
	part({
		Name = "ExitGate",
		Size = Vector3.new(2, 20, 22),
		CFrame = CFrame.new(MapBuilder.CarpetEnd + Vector3.new(2, 10, 0)),
		Color = Color3.fromRGB(20, 20, 30),
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		CanCollide = false,
		Parent = map,
	})
end

-- Слоты одной базы: 5 колонок × 5 рядов, от задней стены к входу.
local function slotLocalPosition(index: number): Vector3
	local column = (index - 1) % SLOT_COLUMNS
	local row = (index - 1) // SLOT_COLUMNS
	return Vector3.new((column - (SLOT_COLUMNS - 1) / 2) * SLOT_SPACING_X, 0.6, 28 - row * SLOT_SPACING_Z)
end

local function buildPlot(index: number, center: Vector3, front: Vector3, parent: Instance): Model
	local plot = Instance.new("Model")
	plot.Name = "Plot" .. index
	plot.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	plot:SetAttribute("Index", index)
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("LockedUntil", 0)
	plot:SetAttribute("LockCooldownUntil", 0)

	-- lookAt: LookVector смотрит на дорожку, значит «вперёд» в локальных координатах — это -Z.
	local origin = CFrame.lookAt(center, center + front)
	local size = MapBuilder.PLOT_SIZE
	local hue = (index - 1) / 8

	local floor = part({
		Name = "Floor",
		Size = size,
		CFrame = origin,
		Color = Color3.fromHSV(hue, 0.35, 0.45),
		Material = Enum.Material.WoodPlanks,
		Parent = plot,
	})
	plot.PrimaryPart = floor

	local wallColor = Color3.fromHSV(hue, 0.5, 0.3)
	local wallHeight = 7
	-- Задняя и боковые стены (вход со стороны дорожки открыт)
	part({
		Name = "Wall",
		Size = Vector3.new(size.X, wallHeight, 1.5),
		CFrame = origin * CFrame.new(0, wallHeight / 2, size.Z / 2),
		Color = wallColor,
		Material = Enum.Material.Brick,
		Parent = plot,
	})
	for _, side in { -1, 1 } do
		part({
			Name = "Wall",
			Size = Vector3.new(1.5, wallHeight, size.Z),
			CFrame = origin * CFrame.new(side * size.X / 2, wallHeight / 2, 0),
			Color = wallColor,
			Material = Enum.Material.Brick,
			Parent = plot,
		})
		-- столбы ворот
		part({
			Name = "GatePillar",
			Size = Vector3.new(3, 18, 3),
			CFrame = origin * CFrame.new(side * 17, 9, -size.Z / 2),
			Color = wallColor,
			Material = Enum.Material.Brick,
			Parent = plot,
		})
	end

	-- Табличка над входом (SurfaceGui рисует клиент, Face = Front смотрит на дорожку)
	part({
		Name = "Sign",
		Size = Vector3.new(31, 6, 1),
		CFrame = origin * CFrame.new(0, 16, -size.Z / 2),
		Color = Color3.fromRGB(25, 20, 35),
		Parent = plot,
	})

	-- Силовой щит на входе: виден, когда база закрыта
	part({
		Name = "Shield",
		Size = Vector3.new(31, 14, 0.4),
		CFrame = origin * CFrame.new(0, 7, -size.Z / 2),
		Color = Color3.fromRGB(80, 200, 255),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = plot,
	})

	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = plot
	for slotIndex = 1, Config.AbsoluteMaxSlots do
		local slot = part({
			Name = "Slot" .. slotIndex,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 8, 8),
			CFrame = origin * CFrame.new(slotLocalPosition(slotIndex)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(60, 60, 70),
			Material = Enum.Material.Slate,
			Transparency = 0.6,
			CanCollide = false,
			Parent = slots,
		})
		slot:SetAttribute("Index", slotIndex)
		slot:SetAttribute("Unlocked", false)
	end

	local lockButton = part({
		Name = "LockButton",
		Size = Vector3.new(4, 3, 4),
		CFrame = origin * CFrame.new(size.X / 2 - 8, 1.5, -size.Z / 2 + 8),
		Color = Color3.fromRGB(80, 200, 255),
		Material = Enum.Material.Neon,
		Parent = plot,
	})
	local lockPrompt = Instance.new("ProximityPrompt")
	lockPrompt.Name = "LockPrompt"
	lockPrompt.ActionText = "Lock base"
	lockPrompt.ObjectText = "🔒"
	lockPrompt.RequiresLineOfSight = false
	lockPrompt.MaxActivationDistance = 10
	lockPrompt.Parent = lockButton

	local spawnPoint = part({
		Name = "Spawn",
		Size = Vector3.new(6, 0.2, 6),
		CFrame = origin * CFrame.new(0, 0.6, -size.Z / 2 + 8),
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.7,
		CanCollide = false,
		Parent = plot,
	})
	spawnPoint:SetAttribute("Spawn", true)

	local guardSpot = Instance.new("Attachment")
	guardSpot.Name = "GuardSpot"
	guardSpot.Position = Vector3.new(-(size.X / 2 - 8), size.Y / 2, -size.Z / 2 + 10)
	guardSpot.Parent = floor

	local memes = Instance.new("Folder")
	memes.Name = "Memes"
	memes.Parent = plot

	plot.Parent = parent
	return plot
end

local function buildLeaderboard(name: string, title: string, cframe: CFrame, parent: Instance): Part
	local board = part({
		Name = name,
		Size = Vector3.new(24, 30, 1),
		CFrame = cframe,
		Color = Color3.fromRGB(20, 18, 30),
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(480, 600)
	gui.LightInfluence = 0
	gui.Parent = board
	local header = Instance.new("TextLabel")
	header.Name = "Title"
	header.Size = UDim2.new(1, 0, 0, 70)
	header.BackgroundColor3 = Color3.fromRGB(150, 60, 255)
	header.TextColor3 = Color3.new(1, 1, 1)
	header.Font = Enum.Font.GothamBlack
	header.TextScaled = true
	header.Text = title
	header.Parent = gui
	local list = Instance.new("TextLabel")
	list.Name = "List"
	list.Position = UDim2.new(0, 16, 0, 80)
	list.Size = UDim2.new(1, -32, 1, -90)
	list.BackgroundTransparency = 1
	list.TextColor3 = Color3.fromRGB(240, 240, 255)
	list.Font = Enum.Font.GothamBold
	list.TextSize = 30
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.Text = "..."
	list.Parent = gui
	return board
end

-- Строит мир. Возвращает { Plots = { Model }, Leaderboards = { Earned = Part, Stolen = Part } }.
-- season: "Halloween" | "Winter" | "None" — от него зависит декор и освещение
function MapBuilder.Build(season: string)
	local winter = season == "Winter"
	setupLighting(winter)

	local map = Instance.new("Folder")
	map.Name = "Map"

	local random = Random.new(67)
	local halfX, halfZ = MapBuilder.HALF_X, MapBuilder.HALF_Z

	part({
		Name = "Ground",
		Size = Vector3.new(halfX * 2 + 40, 2, halfZ * 2 + 40),
		CFrame = CFrame.new(0, -0.5, 0),
		Color = if winter then Color3.fromRGB(235, 240, 250) else Color3.fromRGB(55, 70, 45),
		Material = if winter then Enum.Material.Snow else Enum.Material.Grass,
		Parent = map,
	})

	-- Невидимые стены по краю
	for _, data in {
		{ Vector3.new(0, 50, halfZ + 10), Vector3.new(halfX * 2 + 40, 100, 2) },
		{ Vector3.new(0, 50, -halfZ - 10), Vector3.new(halfX * 2 + 40, 100, 2) },
		{ Vector3.new(halfX + 10, 50, 0), Vector3.new(2, 100, halfZ * 2 + 40) },
		{ Vector3.new(-halfX - 10, 50, 0), Vector3.new(2, 100, halfZ * 2 + 40) },
	} do
		part({ Name = "Boundary", Position = data[1], Size = data[2], Transparency = 1, Parent = map })
	end

	buildCarpet(map)

	-- Центральная точка появления (игрока сразу переносит на его базу)
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "Spawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.new(MapBuilder.CarpetEnd.X + 30, 0.5, 0)
	spawnLocation.Duration = 0
	spawnLocation.Color = Color3.fromRGB(150, 60, 255)
	spawnLocation.Material = Enum.Material.Neon
	spawnLocation.Parent = map

	-- Декор по сезону: тыквы (Хэллоуин) или снеговики и ёлки (Зима), фонари вдоль дорожки всегда
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	local function seasonal(position: Vector3, size: number)
		if season == "Halloween" then
			buildPumpkin(position, size, decor)
		elseif winter then
			if random:NextNumber() < 0.5 then
				buildSnowman(position, size * 0.6, decor)
			else
				buildTree(position, size * 3, random, decor)
			end
		end
	end
	for x = -MapBuilder.CARPET_LENGTH / 2 + 10, MapBuilder.CARPET_LENGTH / 2, 30 do
		for _, side in { -1, 1 } do
			buildLamp(Vector3.new(x, 0.5, side * 14), decor)
			seasonal(Vector3.new(x + random:NextNumber(6, 14), 0.5, side * random:NextNumber(12, 18)), random:NextNumber(1.6, 3))
		end
	end
	for _ = 1, 30 do
		local x = random:NextNumber(-halfX, halfX)
		local z = random:NextNumber(halfZ - 25, halfZ) * (if random:NextNumber() < 0.5 then -1 else 1)
		seasonal(Vector3.new(x, 0.5, z), random:NextNumber(2, 5))
	end
	if winter then
		buildSnowfall(decor)
	end

	local leaderboards = Instance.new("Folder")
	leaderboards.Name = "Leaderboards"
	leaderboards.Parent = map
	local boardX = MapBuilder.CarpetEnd.X + 50
	local earned = buildLeaderboard("TopEarned", "💰 Richest / Богачи", CFrame.lookAt(Vector3.new(boardX, 15, -22), Vector3.new(0, 15, -22)), leaderboards)
	local stolen = buildLeaderboard("TopStolen", "🦹 Top Thieves / Воры", CFrame.lookAt(Vector3.new(boardX, 15, 22), Vector3.new(0, 15, 22)), leaderboards)

	map.Parent = workspace

	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	local plots = {}
	local index = 0
	for _, side in { 1, -1 } do
		for _, x in PLOT_X do
			index += 1
			-- y = 0.1: верх пола базы чуть выше верха земли (0.5), иначе грани совпадают и мерцают
			local center = Vector3.new(x, 0.1, side * PLOT_Z)
			table.insert(plots, buildPlot(index, center, Vector3.new(0, 0, -side), plotsFolder))
		end
	end
	plotsFolder.Parent = workspace

	return { Plots = plots, Leaderboards = { Earned = earned, Stolen = stolen } }
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MemeFactory</string>
          <string name="Source"><![CDATA[-- Собирает модель мема: из примитивов (тело + ножки + эмодзи-лицо) или из модели Creator Store
-- по Config.Creatures[*].ModelId. Подписи (имя, редкость, доход) рисует клиент.
local CollectionService = game:GetService("CollectionService")
local InsertService = game:GetService("InsertService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local MemeFactory = {}

local BASE_SIZE = 4 -- высота тела мема с Size = 1
local VIRAL_SCALE = 1.35

local loadedModels: { [number]: Model | false } = {}

-- Скрипты в бесплатных моделях часто оказываются «бэкдорами» — вырезаем всё исполняемое.
local function stripScripts(root: Instance)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		end
	end
end

local function loadTemplate(assetId: number): Model?
	local cached = loadedModels[assetId]
	if cached ~= nil then
		return if cached then cached else nil
	end
	local ok, container = pcall(function()
		return InsertService:LoadAsset(assetId)
	end)
	local model: Model? = nil
	if ok and container then
		stripScripts(container)
		local found = container:FindFirstChildWhichIsA("Model")
		if found then
			model = found
		elseif #container:GetChildren() > 0 then
			model = Instance.new("Model")
			for _, child in container:GetChildren() do
				child.Parent = model
			end
		end
	else
		warn("[MemeFactory] Не удалось загрузить модель", assetId, container)
	end
	loadedModels[assetId] = model or false
	return model
end

local function weld(part: BasePart, body: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.Massless = true
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = body
	constraint.Part1 = part
	constraint.Parent = part
end

local function applyMutation(part: BasePart, mutationId: string)
	if mutationId == "Gold" then
		part.Color = Color3.fromRGB(255, 205, 60)
		part.Material = Enum.Material.Foil
	elseif mutationId == "Diamond" then
		part.Color = Color3.fromRGB(130, 230, 255)
		part.Material = Enum.Material.Glass
		part.Transparency = math.max(part.Transparency, 0.15)
	elseif mutationId == "Pumpkin" then
		part.Color = Color3.fromRGB(255, 120, 20)
	elseif mutationId == "Ghost" then
		part.Material = Enum.Material.ForceField
		part.Color = Color3.fromRGB(190, 255, 240)
	end
end

local function buildPrimitive(model: Model, body: BasePart, creature: any, height: number): BasePart
	local shapeName = creature.Shape or "Ball"
	local visual = body
	if shapeName == "Ball" then
		body.Shape = Enum.PartType.Ball
		body.Size = Vector3.one * height
	elseif shapeName == "Cylinder" then
		-- Ось цилиндра у Part — X, поэтому видимую часть делаем отдельной деталью, повёрнутой
		-- вертикально, а Body оставляем невидимым блоком-«хитбоксом».
		body.Shape = Enum.PartType.Block
		body.Size = Vector3.new(height * 0.75, height, height * 0.75)
		body.Transparency = 1
		local shell = Instance.new("Part")
		shell.Name = "Shell"
		shell.Shape = Enum.PartType.Cylinder
		shell.Size = Vector3.new(height, height * 0.75, height * 0.75)
		shell.CFrame = body.CFrame * CFrame.Angles(0, 0, math.rad(90))
		shell.Color = creature.Color
		shell.Material = Enum.Material.SmoothPlastic
		weld(shell, body)
		shell.Parent = model
		visual = shell
	else
		body.Shape = Enum.PartType.Block
		body.Size = Vector3.new(height * 0.9, height, height * 0.9)
	end
	if visual == body then
		body.Color = creature.Color
		body.Material = Enum.Material.SmoothPlastic
		body.Transparency = 0
	end

	-- Ножки
	for _, side in { -1, 1 } do
		local foot = Instance.new("Part")
		foot.Name = "Foot"
		foot.Size = Vector3.new(height * 0.22, height * 0.18, height * 0.3)
		foot.Color = creature.Color:Lerp(Color3.new(0, 0, 0), 0.35)
		foot.Material = Enum.Material.SmoothPlastic
		foot.CFrame = body.CFrame * CFrame.new(side * height * 0.22, -height / 2 + foot.Size.Y / 2 - 0.05, -height * 0.05)
		weld(foot, body)
		foot.Parent = model
	end

	-- Эмодзи-лицо: всегда смотрит в камеру
	local face = Instance.new("BillboardGui")
	face.Name = "Face"
	face.Size = UDim2.fromScale(height * 1.1, height * 0.8)
	face.LightInfluence = 0
	face.MaxDistance = 120
	face.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = creature.Face
	label.Parent = face
	return visual
end

local function buildFromAsset(model: Model, body: BasePart, template: Model, height: number)
	local clone = template:Clone()
	local _, size = clone:GetBoundingBox()
	local scale = height / math.max(size.Y, 0.1)
	if scale > 0 and math.abs(scale - 1) > 0.01 then
		pcall(function()
			clone:ScaleTo(scale)
		end)
	end
	local cf, newSize = clone:GetBoundingBox()
	body.Size = newSize
	body.Transparency = 1
	body.CFrame = cf
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			weld(part, body)
		end
	end
	clone.Parent = model
end

-- Создаёт модель мема в точке cframe (низ модели на уровне cframe.Position).
-- Возвращает модель без Parent: вызывающий сам добавит промпты и поставит Parent.
function MemeFactory.Create(id: string, mutationId: string, viral: boolean, cframe: CFrame): Model
	local creature = Config.GetCreature(id)
	assert(creature, "Неизвестный мем: " .. tostring(id))

	local height = BASE_SIZE * (creature.Size or 1) * (if viral then VIRAL_SCALE else 1)

	local model = Instance.new("Model")
	model.Name = id

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.CanTouch = false
	body.CastShadow = true
	body.Size = Vector3.one * height
	body.CFrame = cframe * CFrame.new(0, height / 2 + height * 0.12, 0)
	body.Parent = model
	model.PrimaryPart = body

	local template = if creature.ModelId and creature.ModelId ~= 0 then loadTemplate(creature.ModelId) else nil
	if template then
		buildFromAsset(model, body, template, height)
	else
		local visual = buildPrimitive(model, body, creature, height)
		applyMutation(visual, mutationId)
	end

	if mutationId ~= "None" or viral then
		local mutation = Config.GetMutation(mutationId)
		local color = mutation.Color or Config.GetRarity(creature.Rarity).Color
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = height * 3
		light.Brightness = if viral then 3 else 1.5
		light.Parent = body
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Sparkles"
		sparkles.Color = ColorSequence.new(color)
		sparkles.LightEmission = 1
		sparkles.Size = NumberSequence.new(0.35, 0)
		sparkles.Lifetime = NumberRange.new(0.8, 1.4)
		sparkles.Rate = if viral then 14 else 6
		sparkles.Speed = NumberRange.new(1, 3)
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Parent = body
	end

	local rarityId = creature.Rarity
	if rarityId == "God" or rarityId == "Secret" or rarityId == "Mythic" then
		local aura = Instance.new("ParticleEmitter")
		aura.Name = "Aura"
		aura.Color = ColorSequence.new(Config.GetRarity(rarityId).Color)
		aura.LightEmission = 0.6
		aura.Size = NumberSequence.new(height * 0.25, 0)
		aura.Lifetime = NumberRange.new(1, 1.6)
		aura.Rate = 10
		aura.Speed = NumberRange.new(2, 4)
		aura.Parent = body
	end

	model:SetAttribute("CreatureId", id)
	model:SetAttribute("Mutation", mutationId)
	model:SetAttribute("Viral", viral)
	model:SetAttribute("Height", body.Size.Y)
	model:SetAttribute("State", "Carpet")
	model:SetAttribute("OwnerUserId", 0)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	CollectionService:AddTag(model, "Meme")
	return model
end

-- Высота от низа модели до центра Body (чтобы ставить мема на пол)
function MemeFactory.BodyOffset(model: Model): number
	local body = model.PrimaryPart :: BasePart
	return body.Size.Y / 2 + body.Size.Y * 0.12
end

function MemeFactory.AddPrompt(model: Model, name: string, actionText: string, holdDuration: number?): ProximityPrompt
	local body = model.PrimaryPart :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = Config.GetCreature(model:GetAttribute("CreatureId")).Name
	prompt.HoldDuration = holdDuration or 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = if name == "SellPrompt" then Enum.KeyCode.F elseif name == "MergePrompt" then Enum.KeyCode.R else Enum.KeyCode.E
	prompt.UIOffset = if name == "SellPrompt" then Vector2.new(0, 70) elseif name == "MergePrompt" then Vector2.new(0, 140) else Vector2.zero
	prompt.Parent = body
	return prompt
end

-- Сделать модель «переносимой»: привариваем Body к точке над головой персонажа.
function MemeFactory.AttachTo(model: Model, root: BasePart, offset: CFrame)
	local body = model.PrimaryPart :: BasePart
	body.Anchored = false
	body.Massless = true
	body.CFrame = root.CFrame * offset
	local constraint = Instance.new("WeldConstraint")
	constraint.Name = "CarryWeld"
	constraint.Part0 = root
	constraint.Part1 = body
	constraint.Parent = body
end

function MemeFactory.Detach(model: Model)
	local body = model.PrimaryPart :: BasePart
	local constraint = body:FindFirstChild("CarryWeld")
	if constraint then
		constraint:Destroy()
	end
	body.Anchored = true
end

return MemeFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Базы игроков: выдача базы, мемы в слотах, доход в секунду, замок, страж, Индекс, перерождения.
-- Мемы на базе хранятся в DataService (таблица Memes); модели в мире — их отображение.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local MemeFactory = require(script.Parent.MemeFactory)
local Remotes = require(script.Parent.Remotes)
local Hooks = require(script.Parent.Hooks)
local AnalyticsService = require(script.Parent.AnalyticsService)

local PlotService = {}

type Entry = { Id: string, Mut: string, Viral: boolean, Slot: number }

local plots: { Model } = {}
local plotOf: { [Player]: Model } = {}
local models: { [Player]: { [number]: Model } } = {} -- слот -> модель на базе
local away: { [Player]: { [number]: boolean } } = {} -- слоты, чьих мемов сейчас несут (вор или Смайлик)

-- Колбэки, которые выставляет init.server (чтобы не было циклических require)
PlotService.OnStealPrompt = nil :: ((thief: Player, owner: Player, slot: number, prompt: ProximityPrompt) -> ())?
-- Мем выставлен в обмен — его нельзя продать, слить, украсть (выставляет TradeService)
PlotService.IsTradeLocked = nil :: ((player: Player, slot: number) -> boolean)?

-- Мем сейчас недоступен для действий: его несут или он в обмене
function PlotService.IsBusy(player: Player, slot: number): boolean
	if PlotService.IsAway(player, slot) then
		return true
	end
	return PlotService.IsTradeLocked ~= nil and PlotService.IsTradeLocked(player, slot)
end

local function now(): number
	return workspace:GetServerTimeNow()
end

function PlotService.GetPlot(player: Player): Model?
	return plotOf[player]
end

function PlotService.GetOwner(plot: Model): Player?
	local userId = plot:GetAttribute("OwnerUserId")
	if not userId or userId == 0 then
		return nil
	end
	return Players:GetPlayerByUserId(userId)
end

function PlotService.AllPlots(): { Model }
	return plots
end

function PlotService.IsLocked(plot: Model): boolean
	return (plot:GetAttribute("LockedUntil") or 0) > now()
end

-- Находится ли точка внутри базы (по полу, с запасом по высоте)
function PlotService.InPlot(plot: Model, position: Vector3): boolean
	local floor = plot:FindFirstChild("Floor") :: BasePart
	local localPos = floor.CFrame:PointToObjectSpace(position)
	local size = floor.Size
	return math.abs(localPos.X) <= size.X / 2 and math.abs(localPos.Z) <= size.Z / 2 and localPos.Y > -5 and localPos.Y < 40
end

-- Точка перед входом в базу (сюда выталкивает с закрытой базы)
function PlotService.OutsidePoint(plot: Model): CFrame
	local floor = plot:FindFirstChild("Floor") :: BasePart
	return floor.CFrame * CFrame.new(0, 4, -floor.Size.Z / 2 - 8)
end

function PlotService.SpawnPoint(plot: Model): CFrame
	local spawnPart = plot:FindFirstChild("Spawn") :: BasePart
	local floor = plot:FindFirstChild("Floor") :: BasePart
	-- лицом к дорожке
	return CFrame.lookAt(spawnPart.Position + Vector3.new(0, 3, 0), spawnPart.Position + Vector3.new(0, 3, 0) + floor.CFrame.LookVector)
end

local function slotPart(plot: Model, slot: number): BasePart
	return (plot:FindFirstChild("Slots") :: Folder):FindFirstChild("Slot" .. slot) :: BasePart
end

-- Точка, где стоит мем в слоте (низ модели), лицом к дорожке
function PlotService.SlotCFrame(plot: Model, slot: number): CFrame
	local part = slotPart(plot, slot)
	local floor = plot:FindFirstChild("Floor") :: BasePart
	local position = part.Position + Vector3.new(0, part.Size.X / 2, 0)
	return CFrame.lookAt(position, position + floor.CFrame.LookVector)
end

function PlotService.MaxSlots(player: Player): number
	return Config.MaxSlots(DataService.Get(player, "Rebirths"), player:GetAttribute("Pass_ExtraSlots") == true)
end

function PlotService.GetEntries(player: Player): { Entry }
	return DataService.GetTable(player, "Memes")
end

function PlotService.GetEntry(player: Player, slot: number): Entry?
	for _, entry in PlotService.GetEntries(player) do
		if entry.Slot == slot then
			return entry
		end
	end
	return nil
end

function PlotService.FreeSlot(player: Player): number?
	if not plotOf[player] then
		return nil -- нет базы (сервер переполнен) — ставить некуда
	end
	local used = {}
	for _, entry in PlotService.GetEntries(player) do
		used[entry.Slot] = true
	end
	for slot = 1, PlotService.MaxSlots(player) do
		if not used[slot] then
			return slot
		end
	end
	return nil
end

function PlotService.IsAway(player: Player, slot: number): boolean
	return away[player] ~= nil and away[player][slot] == true
end

function PlotService.SetAway(player: Player, slot: number, value: boolean)
	if away[player] then
		away[player][slot] = if value then true else nil
	end
	PlotService.RefreshIncome(player)
end

function PlotService.GetModel(player: Player, slot: number): Model?
	return models[player] and models[player][slot]
end

-- Забрать модель со слота (для переноски). Модель больше не числится на базе.
function PlotService.DetachModel(player: Player, slot: number): Model?
	local model = PlotService.GetModel(player, slot)
	if model then
		models[player][slot] = nil
	end
	return model
end

-- ===== Доход =====

function PlotService.IncomeOf(player: Player): number
	if not DataService.IsLoaded(player) then
		return 0
	end
	local trending = ReplicatedStorage:GetAttribute("TrendingId")
	local total = 0
	for _, entry in PlotService.GetEntries(player) do
		if not PlotService.IsAway(player, entry.Slot) then
			local income = Config.BaseIncome(entry.Id, entry.Mut, entry.Viral)
			if entry.Id == trending then
				income *= Config.Trend.Mult
			end
			total += income
		end
	end
	total *= Config.IncomeMult(DataService.Get(player, "Rebirths"))
	if player:GetAttribute("Pass_VIP") then
		total *= Config.VipIncomeMult
	end
	total *= 1 + (player:GetAttribute("IndexCount") or 0) * Config.IndexBonusPerEntry
	total *= ReplicatedStorage:GetAttribute("EventIncomeMult") or 1 -- «Двойные деньги» админ-ивента
	total *= 1 + (player:GetAttribute("FriendBoost") or 0) + (if player:GetAttribute("InGroup") then Config.Social.GroupBoost else 0) -- друзья и группа (SocialService)
	return total
end

function PlotService.RefreshIncome(player: Player)
	if DataService.IsLoaded(player) then
		player:SetAttribute("Income", PlotService.IncomeOf(player))
	end
end

function PlotService.RefreshAllIncome()
	for player in plotOf do
		PlotService.RefreshIncome(player)
	end
end

function PlotService.AddCoins(player: Player, amount: number)
	DataService.Increment(player, "Coins", amount)
	if amount > 0 then
		DataService.Increment(player, "TotalEarned", amount)
	end
end

-- ===== Индекс =====

local function syncIndex(player: Player)
	local keys = {}
	for key in DataService.GetTable(player, "Index") do
		table.insert(keys, key)
	end
	player:SetAttribute("IndexJson", HttpService:JSONEncode(keys))
	player:SetAttribute("IndexCount", #keys)
end

local function discover(player: Player, id: string, mutationId: string)
	local index = DataService.GetTable(player, "Index")
	local key = Config.IndexKey(id, mutationId)
	if not index[key] then
		index[key] = true
		syncIndex(player)
		Remotes.Notify:FireClient(player, "NewIndex", { Meme = id }, "success")
	end
end

-- ===== Модели на базе =====

local function setupPlacedModel(player: Player, model: Model, slot: number)
	model:SetAttribute("State", "Placed")
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("Slot", slot)

	local steal = MemeFactory.AddPrompt(model, "StealPrompt", "Steal", Config.Steal.HoldDuration)
	steal.Triggered:Connect(function(thief)
		if PlotService.OnStealPrompt then
			PlotService.OnStealPrompt(thief, player, slot, steal)
		end
	end)

	local sell = MemeFactory.AddPrompt(model, "SellPrompt", "Sell", 0.6)
	sell.Triggered:Connect(function(who)
		if who == player then
			PlotService.Sell(player, slot)
		end
	end)

	local merge = MemeFactory.AddPrompt(model, "MergePrompt", "Make VIRAL", 0.8)
	merge.Triggered:Connect(function(who)
		if who == player then
			PlotService.Merge(player, slot)
		end
	end)
end

-- Поставить модель мема на слот (новую или вернувшуюся после кражи)
function PlotService.PlaceModel(player: Player, slot: number, model: Model)
	local plot = plotOf[player]
	if not plot then
		model:Destroy()
		return
	end
	MemeFactory.Detach(model)
	for _, prompt in (model.PrimaryPart :: BasePart):GetChildren() do
		if prompt:IsA("ProximityPrompt") then
			prompt:Destroy()
		end
	end
	model:PivotTo(PlotService.SlotCFrame(plot, slot) * CFrame.new(0, MemeFactory.BodyOffset(model), 0))
	setupPlacedModel(player, model, slot)
	model.Parent = plot:FindFirstChild("Memes")
	models[player][slot] = model
end

local function spawnModel(player: Player, entry: Entry): Model
	local plot = plotOf[player]
	local model = MemeFactory.Create(entry.Id, entry.Mut, entry.Viral, PlotService.SlotCFrame(plot, entry.Slot))
	PlotService.PlaceModel(player, entry.Slot, model)
	return model
end

-- Вернуть унесённого мема на его слот. Если модель успела уничтожиться
-- (например, упала за карту вместе с вором), собираем её заново по записи.
function PlotService.ReturnModel(player: Player, slot: number, model: Model)
	local entry = PlotService.GetEntry(player, slot)
	if not entry then
		model:Destroy()
		return
	end
	if model.PrimaryPart and model.PrimaryPart:IsDescendantOf(game) then
		PlotService.PlaceModel(player, slot, model)
	else
		model:Destroy()
		spawnModel(player, entry)
	end
end

local function updateSlotsInfo(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	local maxSlots = PlotService.MaxSlots(player)
	for slot = 1, Config.AbsoluteMaxSlots do
		local part = slotPart(plot, slot)
		local unlocked = slot <= maxSlots
		part:SetAttribute("Unlocked", unlocked)
		part.Transparency = if unlocked then 0 else 0.75
		part.Color = if unlocked then Color3.fromRGB(90, 90, 110) else Color3.fromRGB(40, 40, 45)
	end
	player:SetAttribute("SlotsUsed", #PlotService.GetEntries(player))
	player:SetAttribute("MaxSlots", maxSlots)
end
PlotService.UpdateSlotsInfo = updateSlotsInfo

-- Добавить мема игроку. walkFrom — откуда мем «идёт» на базу (покупка с дорожки).
-- Возвращает запись или nil, если нет места.
function PlotService.AddMeme(player: Player, id: string, mutationId: string, viral: boolean, walkFrom: CFrame?): Entry?
	if not plotOf[player] or not DataService.IsLoaded(player) then
		return nil
	end
	local slot = PlotService.FreeSlot(player)
	if not slot then
		return nil
	end
	local entry: Entry = { Id = id, Mut = mutationId, Viral = viral, Slot = slot }
	table.insert(PlotService.GetEntries(player), entry)
	discover(player, id, mutationId)

	local model = spawnModel(player, entry)
	if walkFrom then
		-- Короткая анимация: мем летит с дорожки на свой слот
		local target = model:GetPivot()
		local holder = Instance.new("CFrameValue")
		holder.Value = walkFrom
		model:PivotTo(walkFrom)
		holder.Changed:Connect(function(value)
			-- Мема могли украсть прямо в полёте: тогда двигать его нельзя (утащит вора вместе с ним)
			if model.Parent and PlotService.GetModel(player, entry.Slot) == model then
				model:PivotTo(value)
			end
		end)
		local tween = TweenService:Create(holder, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = target })
		tween.Completed:Connect(function()
			holder:Destroy()
		end)
		tween:Play()
	end

	updateSlotsInfo(player)
	PlotService.RefreshIncome(player)
	return entry
end

-- Убрать мема из данных (продажа, кража, слияние). Модель уничтожается, если она ещё на базе.
function PlotService.RemoveEntry(player: Player, slot: number): Entry?
	local entries = PlotService.GetEntries(player)
	for i, entry in entries do
		if entry.Slot == slot then
			table.remove(entries, i)
			local model = PlotService.DetachModel(player, slot)
			if model then
				model:Destroy()
			end
			if away[player] then
				away[player][slot] = nil
			end
			updateSlotsInfo(player)
			PlotService.RefreshIncome(player)
			return entry
		end
	end
	return nil
end

function PlotService.Sell(player: Player, slot: number)
	if PlotService.IsBusy(player, slot) then
		return
	end
	local entry = PlotService.GetEntry(player, slot)
	if not entry then
		return
	end
	local refund = math.floor(Config.PriceOf(entry.Id, entry.Mut) * (if entry.Viral then Config.Viral.Count else 1) * Config.Steal.SellRefund)
	PlotService.RemoveEntry(player, slot)
	PlotService.AddCoins(player, refund)
	Remotes.Notify:FireClient(player, "Sold", { Meme = entry.Id, Coins = refund }, "success")
end

function PlotService.Merge(player: Player, slot: number)
	local entry = PlotService.GetEntry(player, slot)
	if not entry or entry.Viral or PlotService.IsBusy(player, slot) then
		return
	end
	local same = {}
	for _, other in PlotService.GetEntries(player) do
		if other.Id == entry.Id and other.Mut == entry.Mut and not other.Viral and not PlotService.IsBusy(player, other.Slot) then
			table.insert(same, other.Slot)
		end
	end
	if #same < Config.Viral.Count then
		Remotes.Notify:FireClient(player, "NeedMoreToMerge", { Count = Config.Viral.Count }, "error")
		return
	end
	-- Оставляем выбранный слот, остальные сливаются в него
	local removed = 0
	for _, otherSlot in same do
		if otherSlot ~= slot and removed < Config.Viral.Count - 1 then
			PlotService.RemoveEntry(player, otherSlot)
			removed += 1
		end
	end
	local position = (PlotService.GetModel(player, slot) :: Model):GetPivot().Position
	PlotService.RemoveEntry(player, slot)
	-- Возвращаем в тот же слот: он освободился и он минимальный не обязательно, поэтому ставим напрямую
	local viralEntry: Entry = { Id = entry.Id, Mut = entry.Mut, Viral = true, Slot = slot }
	table.insert(PlotService.GetEntries(player), viralEntry)
	spawnModel(player, viralEntry)
	updateSlotsInfo(player)
	PlotService.RefreshIncome(player)
	Remotes.Fx:FireAllClients("Merged", { Position = position })
	Remotes.Notify:FireClient(player, "Merged", { Meme = entry.Id, Mult = Config.Viral.Mult }, "success")
	Hooks.Fire(player, "Merge", 1)
end

-- ===== Замок =====

function PlotService.Lock(player: Player, duration: number?, ignoreCooldown: boolean?): boolean
	local plot = plotOf[player]
	if not plot then
		return false
	end
	local t = now()
	if PlotService.IsLocked(plot) then
		if ignoreCooldown then
			plot:SetAttribute("LockedUntil", plot:GetAttribute("LockedUntil") + (duration or Config.Plot.LockDuration))
			plot:SetAttribute("LockCooldownUntil", plot:GetAttribute("LockedUntil") + Config.Plot.LockCooldown)
			return true
		end
		return false
	end
	local cooldownUntil = plot:GetAttribute("LockCooldownUntil") or 0
	if not ignoreCooldown and cooldownUntil > t then
		Remotes.Notify:FireClient(player, "LockCooldown", { Seconds = math.ceil(cooldownUntil - t) }, "error")
		return false
	end
	local lockedUntil = t + (duration or Config.Plot.LockDuration)
	plot:SetAttribute("LockedUntil", lockedUntil)
	plot:SetAttribute("LockCooldownUntil", lockedUntil + Config.Plot.LockCooldown)
	Remotes.Notify:FireClient(player, "Locked", { Seconds = math.floor(lockedUntil - t) }, "success")
	Hooks.Fire(player, "Lock", 1)
	return true
end

-- ===== Страж =====

function PlotService.RefreshGuard(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	local existing = plot:FindFirstChild("Guard")
	if existing then
		existing:Destroy()
	end
	local level = DataService.Get(player, "GuardLevel")
	if level <= 0 then
		return
	end
	local floor = plot:FindFirstChild("Floor") :: BasePart
	local spot = floor:FindFirstChild("GuardSpot") :: Attachment
	local base = CFrame.lookAt(spot.WorldPosition, spot.WorldPosition + floor.CFrame.LookVector)
	local guard = MemeFactory.Create("SwordKitten", "None", false, base)
	guard.Name = "Guard"
	-- Страж — не мем на продажу: снимаем тег, чтобы клиент не рисовал ему ценник
	game:GetService("CollectionService"):RemoveTag(guard, "Meme")
	guard:SetAttribute("GuardLevel", level)
	local sword = Instance.new("Part")
	sword.Name = "Sword"
	sword.Size = Vector3.new(0.4, 5, 0.9)
	sword.Color = Color3.fromRGB(220, 230, 255)
	sword.Material = Enum.Material.Metal
	local body = guard.PrimaryPart :: BasePart
	sword.CFrame = body.CFrame * CFrame.new(body.Size.X / 2 + 0.6, 0.5, 0) * CFrame.Angles(math.rad(-20), 0, 0)
	sword.Anchored = false
	sword.CanCollide = false
	sword.Massless = true
	local weldConstraint = Instance.new("WeldConstraint")
	weldConstraint.Part0 = body
	weldConstraint.Part1 = sword
	weldConstraint.Parent = sword
	sword.Parent = guard
	guard.Parent = plot
end

function PlotService.UpgradeGuard(player: Player): (boolean, string)
	local level = DataService.Get(player, "GuardLevel")
	local nextLevel = Config.Guard[level + 1]
	if not nextLevel then
		return false, "GuardMax"
	end
	if DataService.Get(player, "Coins") < nextLevel.Price then
		Remotes.Notify:FireClient(player, "NotEnoughCash", { Price = nextLevel.Price }, "error")
		return false, "NotEnoughCash"
	end
	DataService.Increment(player, "Coins", -nextLevel.Price)
	AnalyticsService.Economy(player, "Sink", nextLevel.Price, "Gameplay", "Guard" .. (level + 1))
	DataService.Set(player, "GuardLevel", level + 1)
	PlotService.RefreshGuard(player)
	Remotes.Notify:FireClient(player, "GuardUpgraded", { Level = level + 1 }, "success")
	return true, "GuardUpgraded"
end

-- ===== Перерождение =====

function PlotService.Rebirth(player: Player): (boolean, string)
	local rebirths = DataService.Get(player, "Rebirths")
	local cost = Config.RebirthCost(rebirths)
	if DataService.Get(player, "Coins") < cost then
		Remotes.Notify:FireClient(player, "RebirthNeed", { Price = cost }, "error")
		return false, "RebirthNeed"
	end
	DataService.Set(player, "Coins", 0)
	AnalyticsService.Economy(player, "Sink", cost, "Gameplay", "Rebirth")
	DataService.Set(player, "Rebirths", rebirths + 1)
	updateSlotsInfo(player)
	PlotService.RefreshIncome(player)
	Remotes.Fx:FireAllClients("Rebirth", { UserId = player.UserId })
	Remotes.Notify:FireClient(player, "Rebirthed", { Count = rebirths + 1 }, "success")
	return true, "Rebirthed"
end

-- ===== Игроки =====

function PlotService.Assign(player: Player): Model?
	for _, plot in plots do
		if plot:GetAttribute("OwnerUserId") == 0 then
			plot:SetAttribute("OwnerUserId", player.UserId)
			plot:SetAttribute("OwnerName", player.DisplayName)
			plot:SetAttribute("LockedUntil", 0)
			plot:SetAttribute("LockCooldownUntil", 0)
			plotOf[player] = plot
			models[player] = {}
			away[player] = {}
			player:SetAttribute("Plot", plot:GetAttribute("Index"))
			return plot
		end
	end
	warn("[PlotService] Нет свободной базы для", player.Name, "— выставьте Max Players = 8")
	return nil
end

-- Вызывается после загрузки данных: расставить мемов, Индекс, стража
function PlotService.LoadPlayer(player: Player)
	if not plotOf[player] then
		return
	end
	local entries = PlotService.GetEntries(player)
	local maxSlots = PlotService.MaxSlots(player)
	-- Если геймпасс слотов пропал (возврат), лишние мемы переезжают на свободные места или остаются вне слотов
	for _, entry in entries do
		if entry.Slot > maxSlots then
			warn("[PlotService] Мем за пределами слотов", player.Name, entry.Id)
		end
	end
	if #entries == 0 and DataService.IsNew(player) then
		table.insert(entries, { Id = Config.StarterMeme, Mut = "None", Viral = false, Slot = 1 })
	end
	for _, entry in entries do
		spawnModel(player, entry)
		discover(player, entry.Id, entry.Mut)
	end
	syncIndex(player)
	updateSlotsInfo(player)
	PlotService.RefreshGuard(player)
	PlotService.RefreshIncome(player)
end

function PlotService.Release(player: Player)
	local plot = plotOf[player]
	if not plot then
		return
	end
	for _, model in models[player] or {} do
		model:Destroy()
	end
	local guard = plot:FindFirstChild("Guard")
	if guard then
		guard:Destroy()
	end
	for _, child in (plot:FindFirstChild("Memes") :: Folder):GetChildren() do
		child:Destroy()
	end
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("LockedUntil", 0)
	plot:SetAttribute("LockCooldownUntil", 0)
	for slot = 1, Config.AbsoluteMaxSlots do
		local part = slotPart(plot, slot)
		part:SetAttribute("Unlocked", false)
		part.Transparency = 0.6
	end
	plotOf[player] = nil
	models[player] = nil
	away[player] = nil
end

function PlotService.Start(builtPlots: { Model })
	plots = builtPlots

	for _, plot in plots do
		local prompt = plot:FindFirstChild("LockButton"):FindFirstChild("LockPrompt") :: ProximityPrompt
		prompt.Triggered:Connect(function(player)
			if plotOf[player] == plot then
				PlotService.Lock(player)
			end
		end)
	end

	Remotes.LockBase.OnServerEvent:Connect(function(player)
		if DataService.IsLoaded(player) then
			PlotService.Lock(player)
		end
	end)
	Remotes.Rebirth.OnServerInvoke = function(player)
		if not DataService.IsLoaded(player) then
			return false, "NotLoaded"
		end
		return PlotService.Rebirth(player)
	end
	Remotes.UpgradeGuard.OnServerInvoke = function(player)
		if not DataService.IsLoaded(player) then
			return false, "NotLoaded"
		end
		return PlotService.UpgradeGuard(player)
	end

	-- Доход раз в секунду
	task.spawn(function()
		while true do
			task.wait(1)
			for player in plotOf do
				if DataService.IsLoaded(player) then
					local income = PlotService.IncomeOf(player)
					player:SetAttribute("Income", income)
					if income > 0 then
						PlotService.AddCoins(player, income)
						Hooks.Fire(player, "Earn", income)
					end
				end
			end
		end
	end)

	-- Щиты закрытых баз и выталкивание чужих игроков
	task.spawn(function()
		while true do
			task.wait(0.2)
			for _, plot in plots do
				local locked = PlotService.IsLocked(plot)
				local shield = plot:FindFirstChild("Shield") :: BasePart
				shield.Transparency = if locked then 0.2 else 1
				if not locked then
					continue
				end
				local ownerId = plot:GetAttribute("OwnerUserId")
				for _, other in Players:GetPlayers() do
					if other.UserId == ownerId then
						continue
					end
					local character = other.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root and PlotService.InPlot(plot, root.Position) then
						(character :: Model):PivotTo(PlotService.OutsidePoint(plot))
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- Ежедневные квесты: Config.Quests.PerDay случайных заданий из пула, сброс в полночь UTC.
-- Прогресс двигают Hooks (другие сервисы сообщают «что произошло»), время в игре считаем здесь же.
-- Данные: DataService.GetTable(player, "Quests") = { Day, List = { { Id, Goal, Progress, Claimed } }, AllClaimed }.
-- Клиент читает атрибут QuestsJson и просит награду через Remotes.ClaimQuest(index | "All").
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Hooks = require(script.Parent.Hooks)
local Remotes = require(script.Parent.Remotes)

local QuestService = {}

local SECONDS_PER_DAY = 86400
local DAY_CHECK = 30
local PLAY_TICK = 5

local function currentDay(): number
	return os.time() // SECONDS_PER_DAY
end

local function isReady(player: Player): boolean
	return player.Parent ~= nil and player:GetAttribute("DataLoaded") == true and DataService.IsLoaded(player)
end

-- Сохранённые квесты могли испортиться или устареть после правки конфига — проверяем всё
local function isValid(data: any): boolean
	if type(data) ~= "table" or type(data.Day) ~= "number" or type(data.List) ~= "table" then
		return false
	end
	for _, quest in data.List do
		if type(quest) ~= "table" or type(quest.Id) ~= "string" or not Config.GetQuest(quest.Id)
			or type(quest.Goal) ~= "number" or quest.Goal < 1
			or type(quest.Progress) ~= "number" or type(quest.Claimed) ~= "boolean" then
			return false
		end
	end
	return #data.List > 0
end

-- Новый набор квестов на день
local function roll(player: Player, data: { [string]: any })
	local pool = table.clone(Config.Quests.Pool)
	local list = {}
	for _ = 1, math.min(Config.Quests.PerDay, #pool) do
		local quest = table.remove(pool, math.random(1, #pool))
		local goal = quest.Goal
		if quest.Stat == "Earn" then
			goal = math.max(1000, math.floor(PlotService.IncomeOf(player) * (quest.GoalIncomeSeconds or 0)))
		end
		table.insert(list, { Id = quest.Id, Goal = goal, Progress = 0, Claimed = false })
	end
	table.clear(data)
	data.Day = currentDay()
	data.List = list
	data.AllClaimed = false
end

local function sync(player: Player)
	local data = DataService.GetTable(player, "Quests")
	local secondsLeft = SECONDS_PER_DAY - os.time() % SECONDS_PER_DAY
	player:SetAttribute("QuestsJson", HttpService:JSONEncode({
		List = data.List,
		AllClaimed = data.AllClaimed == true,
		ResetAt = workspace:GetServerTimeNow() + secondsLeft,
	}))
end

-- Квесты актуальны на сегодня; иначе перевыбираем. Возвращает таблицу квестов или nil, если данных нет.
local function ensure(player: Player): { [string]: any }?
	if not DataService.IsLoaded(player) then
		return nil
	end
	local data = DataService.GetTable(player, "Quests")
	if not isValid(data) or data.Day ~= currentDay() then
		roll(player, data)
		sync(player)
	end
	return data
end

local function onStat(player: Player, stat: string, amount: number)
	if not isReady(player) or type(amount) ~= "number" or amount <= 0 then
		return
	end
	local data = ensure(player)
	if not data then
		return
	end
	local changed = false
	for _, quest in data.List do
		local config = Config.GetQuest(quest.Id)
		if config and config.Stat == stat and not quest.Claimed and quest.Progress < quest.Goal then
			quest.Progress = math.min(quest.Goal, quest.Progress + amount)
			changed = true
			if quest.Progress >= quest.Goal then
				Remotes.Notify:FireClient(player, "QuestDone", nil, "success")
			end
		end
	end
	if changed then
		sync(player)
	end
end

local function claim(player: Player, index: any): (boolean, string)
	if not isReady(player) then
		return false, "QuestNotReady"
	end
	local data = ensure(player)
	if not data then
		return false, "QuestNotReady"
	end

	if index == "All" then
		if data.AllClaimed then
			return false, "QuestAlreadyClaimed"
		end
		for _, quest in data.List do
			if not quest.Claimed then
				return false, "QuestAllNotReady"
			end
		end
		data.AllClaimed = true
		local coins = math.max(Config.Quests.AllDoneMinCoins,
			math.floor(PlotService.IncomeOf(player) * Config.Quests.AllDoneIncomeSeconds))
		PlotService.AddCoins(player, coins)
		sync(player)
		Remotes.Notify:FireClient(player, "QuestAllReward", { Coins = coins }, "success")
		return true, "QuestAllClaimed"
	end

	-- Номер квеста: только целое число в пределах списка
	if type(index) ~= "number" or index ~= index or index % 1 ~= 0 then
		return false, "QuestNotReady"
	end
	local quest = data.List[index]
	if not quest then
		return false, "QuestNotReady"
	end
	if quest.Claimed then
		return false, "QuestAlreadyClaimed"
	end
	if quest.Progress < quest.Goal then
		return false, "QuestNotReady"
	end
	local config = Config.GetQuest(quest.Id)
	if not config then
		return false, "QuestNotReady"
	end
	quest.Claimed = true
	local coins = math.max(config.MinCoins, math.floor(PlotService.IncomeOf(player) * config.IncomeSeconds))
	PlotService.AddCoins(player, coins)
	sync(player)
	Remotes.Notify:FireClient(player, "QuestReward", { Coins = coins }, "success")
	Hooks.Fire(player, "Quest", 1) -- XP Мем-пропуска за квест
	return true, "QuestClaimed"
end

-- Вызывается из init.server после загрузки базы (доход уже известен — нужен для цели Earn)
function QuestService.OnLoaded(player: Player)
	if ensure(player) then
		sync(player)
	end
end

function QuestService.Start()
	Hooks.Connect(onStat)

	Remotes.ClaimQuest.OnServerInvoke = function(player: Player, index: any)
		local ok, result, key = pcall(claim, player, index)
		if not ok then
			warn("[QuestService] Ошибка выдачи награды квеста:", result)
			return false, "QuestNotReady"
		end
		return result, key
	end

	-- Время в игре (квесты Play) — через Hooks, чтобы его видели и другие подписчики
	task.spawn(function()
		while true do
			task.wait(PLAY_TICK)
			for _, player in Players:GetPlayers() do
				if isReady(player) then
					Hooks.Fire(player, "Play", PLAY_TICK)
				end
			end
		end
	end)

	-- Полночь UTC: новые квесты тем, кто в игре
	task.spawn(function()
		while true do
			task.wait(DAY_CHECK)
			for _, player in Players:GetPlayers() do
				if isReady(player) then
					ensure(player)
				end
			end
		end
	end)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Создаёт ReplicatedStorage.Remotes. Клиент получает их через
-- ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name).
-- Покупка, кража, продажа и слияние мемов идут через ProximityPrompt на сервере, remotes для них не нужны.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function make(className: string, name: string)
	local remote = Instance.new(className)
	remote.Name = name
	remote.Parent = folder
	return remote
end

local Remotes = {
	-- сервер -> клиент: (key: string, args: { [string]: any }?, kind: "success" | "error" | "info"?)
	-- key — ключ из Shared.Locale, клиент сам переводит текст на язык игрока.
	Notify = make("RemoteEvent", "Notify") :: RemoteEvent,
	-- сервер -> клиент: (velocity: Vector3, stun: number?) — отбросить своего персонажа и уронить на stun секунд
	Knockback = make("RemoteEvent", "Knockback") :: RemoteEvent,
	-- сервер -> все: (kind: string, data: { [string]: any }) — разовые эффекты, см. README
	Fx = make("RemoteEvent", "Fx") :: RemoteEvent,
	-- сервер -> клиент: (kind: "Offline" | "Daily", data: { Coins: number, Seconds: number?, Day: number? })
	Popup = make("RemoteEvent", "Popup") :: RemoteEvent,
	-- клиент -> сервер: () — закрыть свою базу
	LockBase = make("RemoteEvent", "LockBase") :: RemoteEvent,
	-- клиент -> сервер: () -> (ok: boolean, key: string)
	Rebirth = make("RemoteFunction", "Rebirth") :: RemoteFunction,
	-- клиент -> сервер: () -> (ok: boolean, key: string)
	UpgradeGuard = make("RemoteFunction", "UpgradeGuard") :: RemoteFunction,
	-- клиент -> сервер: (itemId: string) -> (ok: boolean, key: string) — купить предмет за монеты
	BuyItem = make("RemoteFunction", "BuyItem") :: RemoteFunction,
	-- клиент -> сервер: () — туториал пройден или пропущен
	TutorialDone = make("RemoteEvent", "TutorialDone") :: RemoteEvent,
	-- клиент -> сервер: () -> (ok, key) — забрать ежедневную награду
	ClaimDaily = make("RemoteFunction", "ClaimDaily") :: RemoteFunction,
	-- клиент -> сервер: (index: number | "All") -> (ok, key) — забрать награду квеста / бонус за все
	ClaimQuest = make("RemoteFunction", "ClaimQuest") :: RemoteFunction,
	-- клиент -> сервер: (kind: "Turret" | "LaserGate") -> (ok, key) — купить/улучшить защиту базы
	UpgradeDefense = make("RemoteFunction", "UpgradeDefense") :: RemoteFunction,
	-- клиент -> сервер: (emoteId: string) — сыграть эмоцию (все увидят через Fx "Emote")
	Emote = make("RemoteEvent", "Emote") :: RemoteEvent,
	-- Обмен (см. CONTRACT.md):
	TradeRequest = make("RemoteEvent", "TradeRequest") :: RemoteEvent, -- C→S (targetUserId)
	TradeIncoming = make("RemoteEvent", "TradeIncoming") :: RemoteEvent, -- S→C (fromUserId, fromName)
	TradeRespond = make("RemoteEvent", "TradeRespond") :: RemoteEvent, -- C→S (fromUserId, accept: boolean)
	TradeSetOffer = make("RemoteEvent", "TradeSetOffer") :: RemoteEvent, -- C→S (slots: { number })
	TradeReady = make("RemoteEvent", "TradeReady") :: RemoteEvent, -- C→S (ready: boolean)
	TradeCancel = make("RemoteEvent", "TradeCancel") :: RemoteEvent, -- C→S ()
	TradeState = make("RemoteEvent", "TradeState") :: RemoteEvent, -- S→C (state | nil)
	-- v4: коды, колесо, пропуск, скины, группа
	RedeemCode = make("RemoteFunction", "RedeemCode") :: RemoteFunction, -- C→S (code: string) -> (ok, key)
	Spin = make("RemoteFunction", "Spin") :: RemoteFunction, -- C→S () -> (ok, key, segmentIndex?)
	ClaimPass = make("RemoteFunction", "ClaimPass") :: RemoteFunction, -- C→S (level: number, track: "Free" | "Premium") -> (ok, key)
	BuySkin = make("RemoteFunction", "BuySkin") :: RemoteFunction, -- C→S (skinId) -> (ok, key)
	EquipSkin = make("RemoteFunction", "EquipSkin") :: RemoteFunction, -- C→S (skinId) -> (ok, key)
	CheckGroup = make("RemoteEvent", "CheckGroup") :: RemoteEvent, -- C→S () — перепроверить членство в группе
}

folder.Parent = ReplicatedStorage

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[-- Награды за возвращение: оффлайн-доход, календарь ежедневных наград (игрок забирает сам), подарки за время в игре.
-- Время для подарков копится за день и сохраняется, поэтому перезаход не даёт получить их заново.
-- Календарь: DailyStreak — последний забранный день (1..#Config.DailyCalendar), LastDailyDay — UTC-день забора.
-- Пропустил день — календарь начинается заново с первого дня.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)

local RewardService = {}

-- Выдан предмет из календаря (init.server связывает с ItemService, чтобы обновить инструменты и ItemsJson)
RewardService.OnItemGranted = nil :: ((Player) -> ())?

local SECONDS_PER_DAY = 86400
local GIFT_TICK = 5
local DAILY_TICK = 60

local function currentDay(): number
	return os.time() // SECONDS_PER_DAY
end

-- Какой день календаря выдадим следующим (стрик продолжается, только если забирал вчера)
local function nextDailyDay(player: Player): number
	if DataService.Get(player, "LastDailyDay") == currentDay() - 1 then
		return DataService.Get(player, "DailyStreak") % #Config.DailyCalendar + 1
	end
	return 1
end

-- Атрибуты DailyReady / DailyDay для кнопки календаря на клиенте
local function syncDaily(player: Player)
	if not DataService.IsLoaded(player) then
		return
	end
	local ready = DataService.Get(player, "LastDailyDay") ~= currentDay()
	player:SetAttribute("DailyReady", ready)
	player:SetAttribute("DailyDay", if ready then nextDailyDay(player) else DataService.Get(player, "DailyStreak"))
end

local function incomeCoins(player: Player, incomeSeconds: number, minCoins: number): number
	return math.max(minCoins, math.floor(PlotService.IncomeOf(player) * incomeSeconds))
end

-- Случайный обычный (не сезонный) мем нужной редкости
local function randomMemeOf(rarity: string): string?
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarity and not creature.Event then
			table.insert(pool, creature.Id)
		end
	end
	if #pool == 0 then
		return nil
	end
	return pool[math.random(1, #pool)]
end

local function claimDaily(player: Player): (boolean, string)
	if not player:GetAttribute("DataLoaded") or not DataService.IsLoaded(player) then
		return false, "DailyNotReady"
	end
	if DataService.Get(player, "LastDailyDay") == currentDay() then
		return false, "DailyNotReady"
	end
	local day = nextDailyDay(player)
	local reward = Config.DailyCalendar[day]
	-- Сначала отмечаем забор (до любых выдач), чтобы повторный вызов не выдал награду дважды
	DataService.Set(player, "DailyStreak", day)
	DataService.Set(player, "LastDailyDay", currentDay())
	syncDaily(player)

	local popup: { [string]: any } = { Day = day }
	if reward.Kind == "Meme" then
		local id = randomMemeOf(reward.Rarity)
		if id and PlotService.AddMeme(player, id, "None", false) then
			popup.Meme = id
		elseif id then
			-- База заполнена — половина цены мема деньгами
			local coins = math.max(1, math.floor(Config.PriceOf(id, "None") * 0.5))
			PlotService.AddCoins(player, coins)
			popup.Coins = coins
			Remotes.Notify:FireClient(player, "DailyMemeToCoins", { Meme = id, Coins = coins }, "info")
		else
			warn("[RewardService] Нет мемов редкости", reward.Rarity)
			popup.Coins = incomeCoins(player, 300, 1000)
			PlotService.AddCoins(player, popup.Coins)
		end
	elseif reward.Kind == "Item" then
		local items = DataService.GetTable(player, "Items")
		if Config.GetItem(reward.ItemId) and not items[reward.ItemId] then
			items[reward.ItemId] = true
			popup.Item = reward.ItemId
			if RewardService.OnItemGranted then
				task.spawn(RewardService.OnItemGranted, player)
			end
		else
			local fallback = reward.Fallback
			popup.Coins = incomeCoins(player, fallback.IncomeSeconds, fallback.MinCoins)
			PlotService.AddCoins(player, popup.Coins)
		end
	else
		popup.Coins = incomeCoins(player, reward.IncomeSeconds, reward.MinCoins)
		PlotService.AddCoins(player, popup.Coins)
	end

	Remotes.Popup:FireClient(player, "Daily", popup)
	return true, "DailyClaimed"
end

-- Новый день — обнуляем время и подарки. SessionStart для клиента = «сейчас минус сыграно сегодня».
local function syncPlaytime(player: Player)
	local today = os.time() // SECONDS_PER_DAY
	if DataService.Get(player, "GiftDay") ~= today then
		DataService.Set(player, "GiftDay", today)
		DataService.Set(player, "PlayedToday", 0)
		DataService.Set(player, "GiftsClaimed", 0)
	end
	player:SetAttribute("SessionStart", workspace:GetServerTimeNow() - DataService.Get(player, "PlayedToday"))
end

-- Вызывается после PlotService.LoadPlayer, когда доход игрока уже известен
function RewardService.OnLoaded(player: Player)
	syncPlaytime(player)

	-- Оффлайн-доход считаем без множителя админ-ивента: «Двойные деньги» не должны удваивать
	-- до 12 часов отсутствия только потому, что игрок зашёл во время ивента
	local income = PlotService.IncomeOf(player) / math.max(ReplicatedStorage:GetAttribute("EventIncomeMult") or 1, 1)

	-- Оффлайн-доход
	local lastSeen = DataService.Get(player, "LastSeen")
	if lastSeen > 0 then
		local plus = player:GetAttribute("Pass_OfflinePlus") == true
		local maxSeconds = if plus then Config.Offline.PassMaxSeconds else Config.Offline.MaxSeconds
		local rate = if plus then Config.Offline.PassRate else Config.Offline.Rate
		local seconds = math.clamp(os.time() - lastSeen, 0, maxSeconds)
		local coins = math.floor(income * rate * seconds)
		if seconds >= 60 and coins > 0 then
			PlotService.AddCoins(player, coins)
			Remotes.Popup:FireClient(player, "Offline", { Coins = coins, Seconds = seconds })
		end
	end

	syncDaily(player)
end

function RewardService.Start()
	Remotes.ClaimDaily.OnServerInvoke = function(player: Player)
		local ok, result, key = pcall(claimDaily, player)
		if not ok then
			warn("[RewardService] Ошибка выдачи ежедневной награды:", result)
			return false, "DailyNotReady"
		end
		return result, key
	end

	-- Смена UTC-дня у тех, кто в игре: календарь снова доступен
	task.spawn(function()
		while true do
			task.wait(DAILY_TICK)
			for _, player in Players:GetPlayers() do
				syncDaily(player)
			end
		end
	end)

	-- Подарки за время в игре
	task.spawn(function()
		while true do
			task.wait(GIFT_TICK)
			for _, player in Players:GetPlayers() do
				if not player:GetAttribute("DataLoaded") or not DataService.IsLoaded(player) then
					continue
				end
				DataService.Increment(player, "PlayedToday", GIFT_TICK)
				syncPlaytime(player)
				local played = DataService.Get(player, "PlayedToday")
				local claimed = DataService.Get(player, "GiftsClaimed")
				local gift = Config.PlaytimeGifts[claimed + 1]
				if gift and played >= gift.Minutes * 60 then
					local coins = math.max(gift.MinCoins, math.floor(PlotService.IncomeOf(player) * gift.IncomeSeconds))
					DataService.Set(player, "GiftsClaimed", claimed + 1)
					PlotService.AddCoins(player, coins)
					Remotes.Notify:FireClient(player, "Gift", { Coins = coins }, "success")
				end
			end
		end
	end)
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Покупки за Robux: геймпассы (проверка при входе и после покупки) и продукты (ProcessReceipt).
-- ID берутся из Config.GamePasses / Config.Products; с Id = 0 товар просто не работает.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)
local AnalyticsService = require(script.Parent.AnalyticsService)

local ShopService = {}

-- Колбэки из init.server
ShopService.OnSummonGod = nil :: (() -> ())?
-- Изменились геймпассы, от которых зависят предметы (золотой тапок, конфетти-пушка)
ShopService.OnToolsChanged = nil :: ((player: Player) -> ())?
-- Запустить Мем-дождь на сервере (продукт MemeRain): (player) -> boolean
ShopService.OnMemeRain = nil :: ((player: Player) -> boolean)?
-- Вращения колеса и уровни Мем-пропуска за Robux: (player, n) -> boolean (false — данные не загружены)
ShopService.OnSpins = nil :: ((player: Player, n: number) -> boolean)?
ShopService.OnPassLevels = nil :: ((player: Player, n: number) -> boolean)?
-- Куплен премиум Мем-пропуск
ShopService.OnBattlePass = nil :: ((player: Player) -> ())?

local function passKeyById(id: number): string?
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 and pass.Id == id then
			return key
		end
	end
	return nil
end

local function applyPass(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	if not DataService.IsLoaded(player) then
		return
	end
	if key == "ExtraSlots" then
		PlotService.UpdateSlotsInfo(player)
	elseif key == "VIP" then
		PlotService.RefreshIncome(player)
	elseif (key == "GoldSlipper" or key == "ConfettiCannon") and ShopService.OnToolsChanged then
		ShopService.OnToolsChanged(player)
	elseif key == "BattlePass" and ShopService.OnBattlePass then
		ShopService.OnBattlePass(player)
	end
end

-- Проверить все геймпассы игрока (при входе, до загрузки базы)
function ShopService.CheckPasses(player: Player)
	for key, pass in Config.GamePasses do
		player:SetAttribute("Pass_" .. key, false)
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns then
				player:SetAttribute("Pass_" .. key, true)
			end
		end
	end
end

local function incomeCoins(player: Player, product: any): number
	return math.max(product.MinCoins or 0, math.floor(PlotService.IncomeOf(player) * (product.IncomeSeconds or 0)))
end

-- Мистери-бокс: случайный мем редкости из Config.MysteryBox. Нет места — монеты за полцены мема.
local function openMysteryBox(player: Player): boolean
	local box = Config.MysteryBox
	local total = 0
	for _, weight in box.Weights do
		total += weight
	end
	local roll = math.random() * total
	local rarity = box.Rarities[#box.Rarities]
	for i, weight in box.Weights do
		roll -= weight
		if roll <= 0 then
			rarity = box.Rarities[i]
			break
		end
	end
	local pool = {}
	for _, creature in Config.Creatures do
		if creature.Rarity == rarity and not creature.Event then
			table.insert(pool, creature.Id)
		end
	end
	if #pool == 0 then
		return false
	end
	local id = pool[math.random(1, #pool)]
	if not PlotService.AddMeme(player, id, "None", false) then
		local coins = math.floor(Config.PriceOf(id, "None") * 0.5)
		PlotService.AddCoins(player, coins)
		Remotes.Notify:FireClient(player, "CashBought", { Coins = coins }, "success")
	end
	Remotes.Fx:FireAllClients("MysteryBox", { UserId = player.UserId, Meme = id })
	return true
end

-- Выдача продукта. Возвращает true, если выдано.
local function grantProduct(player: Player, key: string): boolean
	local product = Config.Products[key]
	if key == "ServerLuck" then
		local current = ReplicatedStorage:GetAttribute("LuckEndsAt") or 0
		local base = math.max(current, workspace:GetServerTimeNow())
		ReplicatedStorage:SetAttribute("LuckEndsAt", base + Config.ServerLuckDuration)
		Remotes.Notify:FireAllClients("ServerLuck", { Player = player.DisplayName }, "success")
		return true
	elseif key == "SummonGod" then
		if ShopService.OnSummonGod then
			ShopService.OnSummonGod()
		end
		Remotes.Notify:FireAllClients("GodSummoned", { Player = player.DisplayName }, "success")
		return true
	elseif key == "CashSmall" or key == "CashMedium" or key == "CashLarge" then
		local coins = incomeCoins(player, product)
		PlotService.AddCoins(player, coins)
		AnalyticsService.Economy(player, "Source", coins, "IAP", key)
		Remotes.Notify:FireClient(player, "CashBought", { Coins = coins }, "success")
		return true
	elseif key == "LockExtend" then
		if PlotService.Lock(player, Config.Plot.LockDuration, true) then
			Remotes.Notify:FireClient(player, "LockExtended", nil, "success")
			return true
		end
		return false
	elseif key == "MysteryBox" then
		return openMysteryBox(player)
	elseif key == "Spins3" or key == "Spins10" then
		return ShopService.OnSpins ~= nil and ShopService.OnSpins(player, product.Spins)
	elseif key == "PassLevels" then
		return ShopService.OnPassLevels ~= nil and ShopService.OnPassLevels(player, product.Levels)
	elseif key == "MemeRain" then
		return ShopService.OnMemeRain ~= nil and ShopService.OnMemeRain(player)
	end
	return false
end

-- Чеки, которые выдаются прямо сейчас: выдача может ждать (загрузка модели Мем-Бога),
-- а повторный вызов ProcessReceipt с тем же PurchaseId не должен выдать товар второй раз
local inFlight: { [string]: boolean } = {}

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if DataService.HasReceipt(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if inFlight[purchaseId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key: string? = nil
	for productKey, product in Config.Products do
		if product.Id ~= 0 and product.Id == receipt.ProductId then
			key = productKey
		end
	end
	if not key then
		warn("[ShopService] Неизвестный продукт", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	inFlight[purchaseId] = true
	local ok, granted = pcall(grantProduct, player, key)
	inFlight[purchaseId] = nil
	if not ok or not granted then
		warn("[ShopService] Не удалось выдать", key, granted)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not DataService.IsLoaded(player) then
		-- Игрок вышел, пока шла выдача (ждёт только призыв Мем-Бога — он уже на дорожке):
		-- чек записать некуда, но повторять покупку нельзя
		warn("[ShopService] Выдано, игрок уже вышел", purchaseId)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	DataService.AddReceipt(player, purchaseId)
	AnalyticsService.Custom(player, "RobuxPurchase", 1, key)
	-- Сохраняем сразу, чтобы чек не потерялся при падении сервера
	if not DataService.Save(player) then
		warn("[ShopService] Покупка выдана, но не сохранена", player.Name, purchaseId)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = passKeyById(passId)
		if key then
			applyPass(player, key)
			Remotes.Notify:FireClient(player, "PassBought", nil, "success")
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">SkinService</string>
          <string name="Source"><![CDATA[-- Скины базы и тапка (Config.Skins). Покупка за монеты — только скины с Price > 0 и без Source
-- (скины с Source = "Pass"/"Spin" приходят через Grant.Give из пропуска/колеса).
-- Данные: DataService.GetTable(player, "Skins") = { Owned = { [id] = true }, Base = id, Slipper = id }.
-- Скин базы: сервер перекрашивает Floor, Wall и GatePillar своей базы; исходный вид хранится в атрибутах
-- деталей (OrigColor/OrigMaterial), чтобы вернуть его при смене скина и уходе игрока.
-- Скин тапка: атрибут игрока SlipperSkin, сам тапок перекрашивает ItemService (через OnSlipperChanged).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)

local SkinService = {}

-- Колбэк из init.server: скин тапка сменился (перевыдать/перекрасить тапок)
SkinService.OnSlipperChanged = nil :: ((Player) -> ())?

local DEFAULTS = { Base = "BaseDefault", Slipper = "SlipperDefault" }
local WALL_PARTS = { Wall = true, GatePillar = true }
local EQUIP_COOLDOWN = 0.5

local lastEquip: { [Player]: number } = {}

local function isReady(player: Player): boolean
	return player.Parent ~= nil and player:GetAttribute("DataLoaded") == true and DataService.IsLoaded(player)
end

local function materialOf(name: any): Enum.Material?
	if type(name) ~= "string" then
		return nil
	end
	local ok, material = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	return if ok then material else nil
end

-- Проверенные данные скинов: неизвестные id выкидываем, стандартные скины есть всегда
local function ensure(player: Player): { [string]: any }
	local data = DataService.GetTable(player, "Skins")
	local owned = {}
	if type(data.Owned) == "table" then
		for id, value in data.Owned do
			if type(id) == "string" and value == true and Config.GetSkin(id) then
				owned[id] = true
			end
		end
	end
	for _, id in DEFAULTS do
		owned[id] = true
	end
	data.Owned = owned
	for kind, default in DEFAULTS do
		local skin = type(data[kind]) == "string" and Config.GetSkin(data[kind])
		if not skin or skin.Kind ~= kind or not owned[skin.Id] then
			data[kind] = default
		end
	end
	return data
end

local function sync(player: Player, data: { [string]: any })
	local owned = {}
	for id in data.Owned do
		table.insert(owned, id)
	end
	table.sort(owned)
	player:SetAttribute("SkinsJson", HttpService:JSONEncode({
		Owned = owned,
		Base = data.Base,
		Slipper = data.Slipper,
	}))
end

-- Запомнить исходный вид детали перед первой перекраской
local function remember(part: BasePart)
	if part:GetAttribute("OrigColor") == nil then
		part:SetAttribute("OrigColor", part.Color)
		part:SetAttribute("OrigMaterial", part.Material.Name)
	end
end

local function restore(part: BasePart)
	local color = part:GetAttribute("OrigColor")
	if typeof(color) == "Color3" then
		part.Color = color
	end
	local material = materialOf(part:GetAttribute("OrigMaterial"))
	if material then
		part.Material = material
	end
end

-- Перекрасить базу; skin = nil или скин без цветов — вернуть исходный вид
local function paintPlot(plot: Model, skin: any)
	local custom = skin ~= nil and typeof(skin.Floor) == "Color3"
	for _, part in plot:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		if part.Name == "Floor" and part.Parent == plot then
			if custom then
				remember(part)
				part.Color = skin.Floor
				part.Material = materialOf(skin.Material) or part.Material
			else
				restore(part)
			end
		elseif WALL_PARTS[part.Name] then
			if custom and typeof(skin.Wall) == "Color3" then
				remember(part)
				part.Color = skin.Wall
			else
				restore(part)
			end
		end
	end
end

local function applyBase(player: Player, data: { [string]: any })
	local plot = PlotService.GetPlot(player)
	if plot then
		paintPlot(plot, Config.GetSkin(data.Base))
	end
end

local function applySlipper(player: Player, data: { [string]: any }, notify: boolean)
	player:SetAttribute("SlipperSkin", data.Slipper)
	if notify and SkinService.OnSlipperChanged then
		task.spawn(SkinService.OnSlipperChanged, player)
	end
end

local function equip(player: Player, data: { [string]: any }, skin: any)
	data[skin.Kind] = skin.Id
	if skin.Kind == "Base" then
		applyBase(player, data)
	else
		applySlipper(player, data, true)
	end
	sync(player, data)
end

local function buy(player: Player, id: any): (boolean, string)
	if not isReady(player) then
		return false, "SkinNotReady"
	end
	local skin = type(id) == "string" and Config.GetSkin(id)
	if not skin then
		return false, "SkinInvalid"
	end
	local data = ensure(player)
	if data.Owned[skin.Id] then
		return false, "SkinOwned"
	end
	if skin.Source or type(skin.Price) ~= "number" or skin.Price <= 0 then
		return false, "SkinNotForSale"
	end
	if DataService.Get(player, "Coins") < skin.Price then
		Remotes.Notify:FireClient(player, "NotEnoughCash", { Price = skin.Price }, "error")
		return false, "NotEnoughCash"
	end
	DataService.Increment(player, "Coins", -skin.Price)
	data.Owned[skin.Id] = true
	-- Купленный скин сразу надеваем
	equip(player, data, skin)
	Remotes.Notify:FireClient(player, "SkinBought", nil, "success")
	return true, "SkinBought"
end

local function equipRequest(player: Player, id: any): (boolean, string)
	if not isReady(player) then
		return false, "SkinNotReady"
	end
	local skin = type(id) == "string" and Config.GetSkin(id)
	if not skin then
		return false, "SkinInvalid"
	end
	local now = os.clock()
	if lastEquip[player] and now - lastEquip[player] < EQUIP_COOLDOWN then
		return false, "SkinTooFast"
	end
	local data = ensure(player)
	if not data.Owned[skin.Id] then
		return false, "SkinNotOwned"
	end
	lastEquip[player] = now
	if data[skin.Kind] ~= skin.Id then
		equip(player, data, skin)
	end
	return true, "SkinEquipped"
end

-- Пересчитать SkinsJson (например, скин выдан через Grant.Give)
function SkinService.Refresh(player: Player)
	if DataService.IsLoaded(player) then
		sync(player, ensure(player))
	end
end

-- Вызывается из init.server после загрузки базы и ДО выдачи тапка (DataLoaded),
-- чтобы ItemService уже видел атрибут SlipperSkin
function SkinService.OnLoaded(player: Player)
	if not DataService.IsLoaded(player) then
		return
	end
	local data = ensure(player)
	sync(player, data)
	applyBase(player, data)
	applySlipper(player, data, false)
end

-- Вызывается из init.server ДО PlotService.Release: база возвращается к исходному виду
function SkinService.OnPlayerRemoving(player: Player)
	lastEquip[player] = nil
	local plot = PlotService.GetPlot(player)
	if plot then
		paintPlot(plot, nil)
	end
end

local function guarded(callback: (Player, any) -> (boolean, string), name: string)
	return function(player: Player, id: any)
		local ok, result, key = pcall(callback, player, id)
		if not ok then
			warn("[SkinService] Ошибка " .. name .. ":", result)
			return false, "SkinNotReady"
		end
		return result, key
	end
end

function SkinService.Start()
	Remotes.BuySkin.OnServerInvoke = guarded(buy, "покупки скина")
	Remotes.EquipSkin.OnServerInvoke = guarded(equipRequest, "смены скина")

	Players.PlayerRemoving:Connect(function(player)
		lastEquip[player] = nil
	end)
end

return SkinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">SocialService</string>
          <string name="Source"><![CDATA[-- Коды, бонус за друзей на сервере и бонус участникам группы.
-- Коды: Remotes.RedeemCode(code) -> (ok, key); введённые коды — DataService.GetTable(player, "Codes") = { [CODE] = true }.
-- Друзья: атрибут FriendBoost (доля, 0..Config.Social.FriendBoostMax) пересчитывается при входе/выходе игроков.
-- Группа: атрибут InGroup; Remotes.CheckGroup перепроверяет после вступления.
-- Оба бонуса учитывает PlotService.IncomeOf.
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Grant = require(script.Parent.Grant)
local AnalyticsService = require(script.Parent.AnalyticsService)
local Remotes = require(script.Parent.Remotes)

local SocialService = {}

local CODE_MAX_LENGTH = 30
local CODE_COOLDOWN = 1
local GROUP_COOLDOWN = 5

local active: { [Player]: boolean } = {} -- игроки с загруженными данными
local lastCode: { [Player]: number } = {}
local lastGroupCheck: { [Player]: number } = {}
-- Кеш дружбы по паре "меньшийId:большийId" (IsFriendsWith — запрос к сети)
local friendCache: { [string]: boolean } = {}

local function now(): number
	return os.clock()
end

-- ===== Коды =====

local function normalize(code: string): string
	return (string.upper(code):match("^%s*(.-)%s*$")) or ""
end

local function redeem(player: Player, code: unknown): (boolean, string)
	if not active[player] or not DataService.IsLoaded(player) then
		return false, "CodeInvalid"
	end
	local t = now()
	if t - (lastCode[player] or -math.huge) < CODE_COOLDOWN then
		return false, "CodeWait"
	end
	lastCode[player] = t
	if type(code) ~= "string" or #code > CODE_MAX_LENGTH then
		return false, "CodeInvalid"
	end
	local key = normalize(code)
	local entry = Config.Codes[key]
	if key == "" or type(entry) ~= "table" then
		return false, "CodeInvalid"
	end
	if entry.Expires and os.time() > entry.Expires then
		return false, "CodeExpired"
	end
	local used = DataService.GetTable(player, "Codes")
	if used[key] then
		return false, "CodeUsed"
	end
	-- Сначала помечаем код, потом выдаём: повторный запрос не получит награду дважды
	used[key] = true
	local result = Grant.Give(player, entry.Reward)
	if result.Coins then
		AnalyticsService.Economy(player, "Source", result.Coins, "Gameplay", "Code_" .. key)
	end
	result.Code = key
	Remotes.Popup:FireClient(player, "Code", result)
	return true, "CodeRedeemed"
end

-- ===== Друзья =====

local function pairKey(a: number, b: number): string
	if a > b then
		a, b = b, a
	end
	return a .. ":" .. b
end

local function areFriends(player: Player, other: Player): boolean
	local key = pairKey(player.UserId, other.UserId)
	local cached = friendCache[key]
	if cached ~= nil then
		return cached
	end
	local ok, result = pcall(function()
		return player:IsFriendsWith(other.UserId)
	end)
	if not ok then
		return false -- не кешируем ошибку: попробуем при следующем пересчёте
	end
	friendCache[key] = result == true
	return result == true
end

local function applyFriendBoost(player: Player, count: number)
	local social = Config.Social
	local boost = math.min(count * social.FriendBoostPer, social.FriendBoostMax)
	local old = player:GetAttribute("FriendBoost") or 0
	if math.abs(boost - old) < 1e-6 then
		return
	end
	player:SetAttribute("FriendBoost", boost)
	PlotService.RefreshIncome(player)
	if boost > old then
		Remotes.Notify:FireClient(player, "FriendBoost", { Percent = math.floor(boost * 100 + 0.5) }, "success")
	end
end

-- Пересчёт идёт в одном потоке: если состав сервера меняется во время пересчёта, просто повторяем
local recomputing = false
local dirty = false

local function recomputeAll()
	dirty = true
	if recomputing then
		return
	end
	recomputing = true
	while dirty do
		dirty = false
		local list = {}
		for player in active do
			table.insert(list, player)
		end
		for _, player in list do
			if active[player] then
				local count = 0
				for _, other in list do
					if other ~= player and active[other] and areFriends(player, other) then
						count += 1
					end
				end
				if active[player] then
					applyFriendBoost(player, count)
				end
			end
		end
	end
	recomputing = false
end

-- ===== Группа =====

local function setInGroup(player: Player, inGroup: boolean)
	local old = player:GetAttribute("InGroup") == true
	player:SetAttribute("InGroup", inGroup)
	if old ~= inGroup then
		PlotService.RefreshIncome(player)
		if inGroup then
			Remotes.Notify:FireClient(player, "GroupBoostOn", { Percent = math.floor(Config.Social.GroupBoost * 100 + 0.5) }, "success")
		end
	end
end

-- Свежая проверка: IsInGroup кеширует ответ на всю сессию, GetGroupsAsync — нет
local function checkGroupFresh(player: Player)
	local groupId = Config.Social.GroupId
	if groupId == 0 or not active[player] then
		return
	end
	local ok, groups = pcall(function()
		return GroupService:GetGroupsAsync(player.UserId)
	end)
	if not ok or type(groups) ~= "table" or not active[player] then
		return
	end
	local found = false
	for _, group in groups do
		if type(group) == "table" and group.Id == groupId then
			found = true
			break
		end
	end
	setInGroup(player, found)
end

-- ===== Жизненный цикл =====

function SocialService.OnLoaded(player: Player)
	if not DataService.IsLoaded(player) then
		return
	end
	active[player] = true
	player:SetAttribute("FriendBoost", 0)
	player:SetAttribute("InGroup", false)
	task.spawn(recomputeAll)

	local groupId = Config.Social.GroupId
	if groupId ~= 0 then
		task.spawn(function()
			local ok, inGroup = pcall(function()
				return player:IsInGroup(groupId)
			end)
			if ok and active[player] then
				setInGroup(player, inGroup == true)
			end
		end)
	end
end

function SocialService.OnPlayerRemoving(player: Player)
	local wasActive = active[player]
	active[player] = nil
	lastCode[player] = nil
	lastGroupCheck[player] = nil
	local prefix = player.UserId .. ":"
	local suffix = ":" .. player.UserId
	for key in friendCache do
		if string.sub(key, 1, #prefix) == prefix or string.sub(key, -#suffix) == suffix then
			friendCache[key] = nil
		end
	end
	if wasActive then
		task.spawn(recomputeAll)
	end
end

function SocialService.Start()
	Remotes.RedeemCode.OnServerInvoke = function(player, code)
		return redeem(player, code)
	end
	Remotes.CheckGroup.OnServerEvent:Connect(function(player)
		if Config.Social.GroupId == 0 or not active[player] then
			return
		end
		local t = now()
		if t - (lastGroupCheck[player] or -math.huge) < GROUP_COOLDOWN then
			return
		end
		lastGroupCheck[player] = t
		checkGroupFresh(player)
	end)
end

return SocialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">SpinService</string>
          <string name="Source"><![CDATA[-- Колесо удачи: одно бесплатное вращение в UTC-день, остальные — из запаса Spins (Robux, пропуск, коды).
-- Клиент зовёт Remotes.Spin() -> (ok, key, segmentIndex), крутит колесо до сегмента,
-- а награду показывает Popup "Spin", который приходит после анимации.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local Grant = require(script.Parent.Grant)
local Remotes = require(script.Parent.Remotes)

local SpinService = {}

local SECONDS_PER_DAY = 86400
local SPIN_COOLDOWN = 2 -- сек между вращениями (защита от спама)
local POPUP_DELAY = 4 -- сек: столько клиент крутит колесо
local REFRESH_INTERVAL = 60

local lastSpin: { [Player]: number } = {}

local function today(): number
	return os.time() // SECONDS_PER_DAY
end

local function isReady(player: Player): boolean
	return player.Parent ~= nil and player:GetAttribute("DataLoaded") == true and DataService.IsLoaded(player)
end

local function freeReady(player: Player): boolean
	return DataService.Get(player, "LastFreeSpinDay") ~= today()
end

local function refresh(player: Player)
	if DataService.IsLoaded(player) then
		player:SetAttribute("FreeSpinReady", freeReady(player))
	end
end

-- Случайный сегмент с учётом весов
local function pickSegment(): number
	local segments = Config.Spin.Segments
	local total = 0
	for _, segment in segments do
		total += segment.Weight
	end
	local roll = math.random() * total
	for index, segment in segments do
		roll -= segment.Weight
		if roll <= 0 then
			return index
		end
	end
	return #segments
end

local function spin(player: Player): (boolean, string, number?)
	if not isReady(player) then
		return false, "SpinNotReady"
	end
	local now = os.clock()
	if lastSpin[player] and now - lastSpin[player] < SPIN_COOLDOWN then
		return false, "SpinTooFast"
	end

	if freeReady(player) then
		DataService.Set(player, "LastFreeSpinDay", today())
		refresh(player)
	elseif DataService.Get(player, "Spins") >= 1 then
		DataService.Increment(player, "Spins", -1)
	else
		return false, "NoSpins"
	end
	lastSpin[player] = now

	local index = pickSegment()
	local result = Grant.Give(player, Config.Spin.Segments[index].Reward)
	-- Награда уже выдана; показываем её, когда колесо на клиенте остановится
	task.delay(POPUP_DELAY, function()
		if player.Parent then
			Remotes.Popup:FireClient(player, "Spin", result)
		end
	end)
	return true, "SpinDone", index
end

-- Добавить вращения (покупка Spins3/Spins10). false — данные не загружены, покупку повторить позже.
function SpinService.AddSpins(player: Player, n: number): boolean
	if not DataService.IsLoaded(player) then
		return false
	end
	if type(n) == "number" and n == n and n >= 1 then
		DataService.Increment(player, "Spins", math.floor(n))
	end
	return true
end

-- Вызывается из init.server после загрузки данных
function SpinService.OnLoaded(player: Player)
	refresh(player)
end

function SpinService.Start()
	Remotes.Spin.OnServerInvoke = function(player: Player)
		local ok, result, key, index = pcall(spin, player)
		if not ok then
			warn("[SpinService] Ошибка вращения колеса:", result)
			return false, "SpinNotReady"
		end
		return result, key, index
	end

	Players.PlayerRemoving:Connect(function(player)
		lastSpin[player] = nil
	end)

	-- Полночь UTC: бесплатное вращение снова доступно
	task.spawn(function()
		while true do
			task.wait(REFRESH_INTERVAL)
			for _, player in Players:GetPlayers() do
				refresh(player)
			end
		end
	end)
end

return SpinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[-- Кражи: удержание «Украсть», переноска мема над головой, доставка на свою базу,
-- возврат хозяину (удар оружием, смерть, таймер, выход), отброс и скорость персонажа, страж-котёнок.
-- Само оружие и гаджеты — в ItemService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local MemeFactory = require(script.Parent.MemeFactory)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)
local Hooks = require(script.Parent.Hooks)

local StealService = {}

type Carry = {
	Owner: Player,
	Slot: number,
	Model: Model,
	Id: string,
	EndsAt: number,
	-- Анти-чит: последняя проверенная позиция вора и число нарушений скорости
	LastPos: Vector3?,
	LastTime: number?,
	Strikes: number?,
}

local carries: { [Player]: Carry } = {} -- вор -> что несёт
local holdStart: { [Player]: number } = {}
local guardLastHit: { [Model]: number } = {}

local BASE_WALK_SPEED = 16

local checkMovement: (thief: Player, carry: Carry, root: BasePart, t: number) -> boolean

-- Колбэк начала кражи (выставляет init.server): снять шапку-невидимку и т.п.
StealService.OnStealStarted = nil :: ((thief: Player) -> ())?

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setCarryAttributes(player: Player, id: string, endsAt: number)
	player:SetAttribute("Carrying", id)
	player:SetAttribute("CarryEndsAt", endsAt)
end

-- Все текущие переноски: вор -> { Owner, Slot, Model, Id, EndsAt } (только для чтения)
function StealService.GetCarries(): { [Player]: Carry }
	return carries
end

function StealService.IsCarrying(player: Player): boolean
	return carries[player] ~= nil
end

-- Скорость персонажа: с мемом медленнее, энергетик (атрибут BoostUntil на персонаже) быстрее
function StealService.UpdateSpeed(player: Player)
	local humanoid = humanoidOf(player)
	if not humanoid then
		return
	end
	local speed = if carries[player] then Config.Steal.CarryWalkSpeed else BASE_WALK_SPEED
	local character = player.Character :: Model
	if (character:GetAttribute("BoostUntil") or 0) > now() then
		speed += character:GetAttribute("BoostSpeed") or 0
	end
	humanoid.WalkSpeed = speed
end

-- Перенос закончился неудачей: мем возвращается хозяину
function StealService.Fail(thief: Player)
	local carry = carries[thief]
	if not carry then
		return
	end
	carries[thief] = nil
	setCarryAttributes(thief, "", 0)
	StealService.UpdateSpeed(thief)

	local owner = carry.Owner
	if owner.Parent and PlotService.GetPlot(owner) and DataService.IsLoaded(owner) and PlotService.GetEntry(owner, carry.Slot) then
		PlotService.ReturnModel(owner, carry.Slot, carry.Model)
		PlotService.SetAway(owner, carry.Slot, false)
		Remotes.Notify:FireClient(owner, "MemeReturned", { Meme = carry.Id }, "success")
	else
		carry.Model:Destroy()
	end
	if thief.Parent then
		Remotes.Notify:FireClient(thief, "StealFailed", { Meme = carry.Id }, "error")
	end
end

local function deliver(thief: Player)
	local carry = carries[thief]
	if not carry then
		return
	end
	local owner = carry.Owner
	-- Хозяин уже вышел (база освобождена) — мем остаётся в его сохранении, вору не достаётся
	if not PlotService.GetPlot(owner) or not DataService.IsLoaded(owner) then
		StealService.Fail(thief)
		return
	end
	local entry = PlotService.GetEntry(owner, carry.Slot)
	if not entry or not PlotService.FreeSlot(thief) then
		StealService.Fail(thief)
		return
	end
	carries[thief] = nil
	setCarryAttributes(thief, "", 0)
	StealService.UpdateSpeed(thief)

	local position = carry.Model:GetPivot().Position
	carry.Model:Destroy()
	PlotService.RemoveEntry(owner, carry.Slot)
	PlotService.AddMeme(thief, entry.Id, entry.Mut, entry.Viral)
	DataService.Increment(thief, "Stolen", 1)
	Hooks.Fire(thief, "Steal", 1)
	-- Дублей не бывает: при выходе хозяина все кражи его мемов отменяются до сохранения.
	Remotes.Fx:FireAllClients("Delivered", { Position = position, UserId = thief.UserId })
	Remotes.Notify:FireClient(thief, "Delivered", { Meme = entry.Id }, "success")
	Remotes.Notify:FireClient(owner, "MemeLost", { Meme = entry.Id, Player = thief.DisplayName }, "error")
end

local function requiredHold(player: Player): number
	return if player:GetAttribute("Pass_FastSteal") then Config.Steal.FastHoldDuration else Config.Steal.HoldDuration
end

-- Вызывается PlotService, когда кто-то дозажал «Украсть» на чужом меме
function StealService.TryStart(thief: Player, owner: Player, slot: number, prompt: ProximityPrompt)
	if thief == owner or not DataService.IsLoaded(thief) or not PlotService.GetPlot(thief) or not DataService.IsLoaded(owner) then
		return
	end
	-- Удержание проверяем сами: клиент может «нажать» промпт мгновенно
	local began = holdStart[thief]
	holdStart[thief] = nil
	local held = if began then os.clock() - began else 0
	if not began or held < requiredHold(thief) - 0.25 or held > requiredHold(thief) + 3 then
		return
	end
	if carries[thief] then
		Remotes.Notify:FireClient(thief, "AlreadyCarrying", nil, "error")
		return
	end
	local plot = PlotService.GetPlot(owner)
	if not plot then
		return
	end
	if PlotService.IsLocked(plot) then
		Remotes.Notify:FireClient(thief, "BaseLocked", nil, "error")
		return
	end
	if PlotService.IsBusy(owner, slot) or not PlotService.GetEntry(owner, slot) then
		return
	end
	if not PlotService.FreeSlot(thief) then
		Remotes.Notify:FireClient(thief, "BaseFull", nil, "error")
		return
	end
	local root = rootOf(thief)
	local humanoid = humanoidOf(thief)
	local model = PlotService.GetModel(owner, slot)
	if not root or not humanoid or humanoid.Health <= 0 or not model then
		return
	end
	if (root.Position - model:GetPivot().Position).Magnitude > 18 then
		return
	end

	PlotService.DetachModel(owner, slot)
	PlotService.SetAway(owner, slot, true)
	prompt:Destroy()
	for _, child in (model.PrimaryPart :: BasePart):GetChildren() do
		if child:IsA("ProximityPrompt") then
			child:Destroy()
		end
	end
	model:SetAttribute("State", "Carried")
	local height = (model.PrimaryPart :: BasePart).Size.Y
	MemeFactory.AttachTo(model, root, CFrame.new(0, 3 + height / 2, 0))
	model.Parent = workspace

	local id = model:GetAttribute("CreatureId")
	local endsAt = now() + Config.Steal.CarryTimeout
	carries[thief] = { Owner = owner, Slot = slot, Model = model, Id = id, EndsAt = endsAt }
	setCarryAttributes(thief, id, endsAt)
	StealService.UpdateSpeed(thief)
	if StealService.OnStealStarted then
		StealService.OnStealStarted(thief)
	end

	Remotes.Fx:FireAllClients("Stolen", { Position = root.Position })
	Remotes.Notify:FireClient(thief, "StealStarted", { Meme = id }, "success")
	Remotes.Notify:FireClient(owner, "BeingStolen", { Meme = id, Player = thief.DisplayName }, "error")
end

-- Анти-чит переноски: вор не может двигаться быстрее своей скорости (телепорт домой с мемом).
-- Возвращает false, если перенос сорван. Отброс и ракетные ботинки ставят персонажу
-- атрибут MoveGraceUntil — в это время скорость не проверяем.
function checkMovement(thief: Player, carry: Carry, root: BasePart, t: number): boolean
	local position = root.Position
	local lastPos, lastTime = carry.LastPos, carry.LastTime
	carry.LastPos, carry.LastTime = position, t
	if not lastPos or not lastTime then
		return true
	end
	local character = thief.Character
	if character and (character:GetAttribute("MoveGraceUntil") or 0) > t then
		return true
	end
	local humanoid = humanoidOf(thief)
	local speed = math.max(if humanoid then humanoid.WalkSpeed else BASE_WALK_SPEED, BASE_WALK_SPEED)
	local flat = Vector3.new(position.X - lastPos.X, 0, position.Z - lastPos.Z).Magnitude
	local allowed = speed * (t - lastTime) * Config.AntiCheat.CarrySpeedSlack + Config.AntiCheat.CarryExtraStuds
	if flat <= allowed then
		return true
	end
	carry.Strikes = (carry.Strikes or 0) + 1
	warn(string.format("[AntiCheat] %s двигается слишком быстро с мемом: %.1f studs (можно %.1f)", thief.Name, flat, allowed))
	if carry.Strikes >= Config.AntiCheat.MaxStrikes then
		StealService.Fail(thief)
		return false
	end
	return true
end

-- Отменить все кражи мемов этого хозяина (хозяин выходит из игры)
function StealService.CancelFromOwner(owner: Player)
	for thief, carry in carries do
		if carry.Owner == owner then
			StealService.Fail(thief)
		end
	end
end

-- Отбросить игрока (stun — сколько секунд он лежит) и выбить у него мема
function StealService.Knock(target: Player, from: Vector3, power: number, stun: number?)
	local root = rootOf(target)
	if not root then
		return
	end
	local direction = root.Position - from
	direction = Vector3.new(direction.X, 0, direction.Z)
	direction = if direction.Magnitude > 0.01 then direction.Unit else Vector3.new(1, 0, 0)
	local character = target.Character
	if character then
		character:SetAttribute("MoveGraceUntil", now() + 1.5 + (stun or 0.6))
	end
	Remotes.Knockback:FireClient(target, direction * power + Vector3.new(0, power * 0.45, 0), stun or 0.6)
	local carry = carries[target]
	if carry then
		StealService.Fail(target)
		-- Хозяин отбил своего мема (сам, стражем, турелью или ловушкой) — засчитываем защиту
		if carry.Owner.Parent then
			Hooks.Fire(carry.Owner, "Defend", 1)
		end
	end
end

-- ===== Персонажи =====

function StealService.OnCharacter(player: Player, character: Model)
	StealService.Fail(player)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.Died:Connect(function()
			StealService.Fail(player)
		end)
	end
end

function StealService.OnPlayerRemoving(player: Player)
	StealService.Fail(player)
	StealService.CancelFromOwner(player)
	holdStart[player] = nil
end

-- ===== Цикл: доставка, таймеры, страж =====

local function guardStep()
	local t = os.clock()
	for _, plot in PlotService.AllPlots() do
		local guard = plot:FindFirstChild("Guard") :: Model?
		local owner = PlotService.GetOwner(plot)
		if not guard or not owner then
			continue
		end
		local level = Config.Guard[guard:GetAttribute("GuardLevel") or 1]
		if not level or t - (guardLastHit[guard] or 0) < level.Cooldown then
			continue
		end
		local guardPosition = guard:GetPivot().Position
		for thief, carry in carries do
			if carry.Owner ~= owner then
				continue
			end
			local root = rootOf(thief)
			if root and (root.Position - guardPosition).Magnitude <= level.Range then
				guardLastHit[guard] = t
				StealService.Knock(thief, guardPosition, Config.Slap.Knockback)
				Remotes.Fx:FireAllClients("Slap", { Position = root.Position })
				Remotes.Notify:FireClient(thief, "GuardHit", nil, "error")
				-- Страж разворачивается к вору
				local base = guard:GetPivot()
				guard:PivotTo(CFrame.lookAt(base.Position, Vector3.new(root.Position.X, base.Position.Y, root.Position.Z)))
				break
			end
		end
	end
	for guard in guardLastHit do
		if not guard.Parent then
			guardLastHit[guard] = nil
		end
	end
end

function StealService.Start()
	PlotService.OnStealPrompt = StealService.TryStart

	-- Удержание промпта «Украсть» начинается — запоминаем время (проверка в TryStart)
	game:GetService("ProximityPromptService").PromptButtonHoldBegan:Connect(function(prompt, player)
		if prompt.Name == "StealPrompt" then
			holdStart[player] = os.clock()
		end
	end)
	local function step()
		local t = now()
		for thief, carry in carries do
			if not thief.Parent then
				continue
			end
			if t >= carry.EndsAt then
				StealService.Fail(thief)
				continue
			end
			local plot = PlotService.GetPlot(thief)
			local root = rootOf(thief)
			if root and not checkMovement(thief, carry, root, t) then
				continue
			end
			if plot and root and PlotService.InPlot(plot, root.Position) then
				deliver(thief)
			end
		end
		guardStep()
	end
	task.spawn(function()
		while true do
			task.wait(0.2)
			-- Ошибка в одном тике не должна навсегда остановить доставку, таймеры и стражей
			local ok, err = pcall(step)
			if not ok then
				warn("[StealService]", err)
			end
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[-- Обмен мемами между игроками (только мемы, без монет).
-- Запрос -> ответ -> окно обмена: каждый выбирает свои слоты, оба жмут «Готово»,
-- идёт отсчёт Config.Trade.ConfirmDelay, затем сервер заново всё проверяет и меняет мемов разом.
-- Мемы в предложении заблокированы (PlotService.IsTradeLocked): их нельзя продать, слить, украсть.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local Remotes = require(script.Parent.Remotes)

local TradeService = {}

type Shown = { Slot: number, Id: string, Mut: string, Viral: boolean }
type Session = {
	Players: { Player }, -- два участника
	Offers: { [Player]: { Shown } }, -- что выставлено (копия записей на момент выбора)
	Ready: { [Player]: boolean },
	CountdownEndsAt: number,
	Token: number, -- меняется при любом изменении: отложенный обмен проверяет, что ничего не поменялось
	Closed: boolean,
}
type Request = { From: Player, Target: Player, ExpiresAt: number }

local sessionOf: { [Player]: Session } = {}
local outgoing: { [Player]: Request } = {} -- от кого -> его запрос (один на игрока)
local lastRequestAt: { [Player]: number } = {}
local lastOfferAt: { [Player]: number } = {}

local OFFER_MIN_INTERVAL = 0.1 -- защита от спама TradeSetOffer

local function now(): number
	return workspace:GetServerTimeNow()
end

local function notify(player: Player, key: string, args: { [string]: any }?, kind: string?)
	if player.Parent then
		Remotes.Notify:FireClient(player, key, args, kind)
	end
end

-- Игрок в игре, данные загружены, есть база
local function isReady(player: Player): boolean
	return player.Parent ~= nil and DataService.IsLoaded(player) and PlotService.GetPlot(player) ~= nil
end

local function partnerOf(session: Session, player: Player): Player
	return if session.Players[1] == player then session.Players[2] else session.Players[1]
end

-- ===== Состояние для клиента =====

local function stateFor(session: Session, player: Player)
	local partner = partnerOf(session, player)
	local myOffer = {}
	for _, item in session.Offers[player] do
		table.insert(myOffer, { Slot = item.Slot, Id = item.Id, Mut = item.Mut, Viral = item.Viral })
	end
	local theirOffer = {}
	for _, item in session.Offers[partner] do
		-- номера чужих слотов клиенту не нужны
		table.insert(theirOffer, { Id = item.Id, Mut = item.Mut, Viral = item.Viral })
	end
	return {
		PartnerUserId = partner.UserId,
		PartnerName = partner.DisplayName,
		MyOffer = myOffer,
		TheirOffer = theirOffer,
		MyReady = session.Ready[player] == true,
		TheirReady = session.Ready[partner] == true,
		CountdownEndsAt = session.CountdownEndsAt,
	}
end

local function push(session: Session)
	for _, player in session.Players do
		if player.Parent then
			Remotes.TradeState:FireClient(player, stateFor(session, player))
		end
	end
end

local function close(session: Session, key: string?, kind: string?)
	if session.Closed then
		return
	end
	session.Closed = true
	session.Token += 1
	for _, player in session.Players do
		if sessionOf[player] == session then
			sessionOf[player] = nil
		end
		if player.Parent then
			Remotes.TradeState:FireClient(player, nil)
			if key then
				notify(player, key, nil, kind)
			end
		end
	end
end

-- Любое изменение предложения или «Готово: нет» снимает обе галочки и отсчёт
local function resetReady(session: Session)
	session.Ready = {}
	session.CountdownEndsAt = 0
	session.Token += 1
end

-- ===== Проверки и сам обмен =====

-- Сколько свободных слотов у игрока (в пределах его лимита)
local function freeSlotCount(player: Player): number
	local maxSlots = PlotService.MaxSlots(player)
	local used = {}
	for _, entry in PlotService.GetEntries(player) do
		used[entry.Slot] = true
	end
	local free = 0
	for slot = 1, maxSlots do
		if not used[slot] then
			free += 1
		end
	end
	return free
end

-- Выставленные мемы на месте и не изменились с момента показа
local function offerStillValid(player: Player, offer: { Shown }): boolean
	for _, item in offer do
		local entry = PlotService.GetEntry(player, item.Slot)
		if not entry or entry.Id ~= item.Id or entry.Mut ~= item.Mut or entry.Viral ~= item.Viral then
			return false
		end
		if PlotService.IsAway(player, item.Slot) then
			return false
		end
	end
	return true
end

-- Хватит ли места: свободные + освободившиеся (свои отданные в пределах лимита) >= входящие
local function hasRoom(player: Player, ownOffer: { Shown }, incoming: number): boolean
	local maxSlots = PlotService.MaxSlots(player)
	local freed = 0
	for _, item in ownOffer do
		if item.Slot <= maxSlots then
			freed += 1
		end
	end
	return freeSlotCount(player) + freed >= incoming
end

local function execute(session: Session)
	local a, b = session.Players[1], session.Players[2]
	if not isReady(a) or not isReady(b) then
		close(session, "TradeCancelled", "error")
		return
	end
	local offerA, offerB = session.Offers[a], session.Offers[b]
	if not offerStillValid(a, offerA) or not offerStillValid(b, offerB) then
		close(session, "TradeFailed", "error")
		return
	end
	if not hasRoom(a, offerA, #offerB) or not hasRoom(b, offerB, #offerA) then
		close(session, "TradeNoSpace", "error")
		return
	end

	-- Без yield между проверкой и обменом: сначала убираем всё, потом раздаём
	local removedA, removedB = {}, {}
	for _, item in offerA do
		local entry = PlotService.RemoveEntry(a, item.Slot)
		if entry then
			table.insert(removedA, entry)
		end
	end
	for _, item in offerB do
		local entry = PlotService.RemoveEntry(b, item.Slot)
		if entry then
			table.insert(removedB, entry)
		end
	end
	local function give(to: Player, back: Player, entries: { any })
		for _, entry in entries do
			if not PlotService.AddMeme(to, entry.Id, entry.Mut, entry.Viral) then
				-- Не должно случаться (место проверено), но мем не теряем
				if not PlotService.AddMeme(back, entry.Id, entry.Mut, entry.Viral) then
					warn("[TradeService] Мем потерян при обмене", entry.Id, to.Name, back.Name)
				end
			end
		end
	end
	give(b, a, removedA)
	give(a, b, removedB)

	close(session, "TradeDone", "success")
	-- Сохраняем обоих сразу, чтобы сбой сервера не разделил обмен на «до» и «после»
	task.spawn(DataService.Save, a)
	task.spawn(DataService.Save, b)
end

local function checkBothReady(session: Session)
	if session.Closed then
		return
	end
	local a, b = session.Players[1], session.Players[2]
	if not (session.Ready[a] and session.Ready[b]) then
		return
	end
	session.Token += 1
	local token = session.Token
	session.CountdownEndsAt = now() + Config.Trade.ConfirmDelay
	task.delay(Config.Trade.ConfirmDelay, function()
		if not session.Closed and session.Token == token then
			execute(session)
		end
	end)
end

-- ===== Обработчики remotes =====

local function onRequest(player: Player, targetUserId: unknown)
	if typeof(targetUserId) ~= "number" or targetUserId ~= targetUserId or targetUserId % 1 ~= 0 then
		return
	end
	if not isReady(player) then
		return
	end
	local t = now()
	if t - (lastRequestAt[player] or -math.huge) < Config.Trade.RequestCooldown then
		notify(player, "TradeCooldown", { Seconds = math.ceil(Config.Trade.RequestCooldown - (t - lastRequestAt[player])) }, "error")
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player or not isReady(target) then
		notify(player, "TradeNotAvailable", nil, "error")
		return
	end
	if sessionOf[player] or sessionOf[target] then
		notify(player, "TradeBusy", nil, "error")
		return
	end
	lastRequestAt[player] = t
	local request: Request = { From = player, Target = target, ExpiresAt = t + Config.Trade.RequestTimeout }
	outgoing[player] = request
	Remotes.TradeIncoming:FireClient(target, player.UserId, player.DisplayName)
	notify(player, "TradeRequestSent", { Player = target.DisplayName }, "info")

	task.delay(Config.Trade.RequestTimeout, function()
		if outgoing[player] == request then
			outgoing[player] = nil
			notify(player, "TradeExpired", { Player = target.DisplayName }, "info")
		end
	end)
end

local function onRespond(player: Player, fromUserId: unknown, accept: unknown)
	if typeof(fromUserId) ~= "number" or typeof(accept) ~= "boolean" then
		return
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	if not from then
		return
	end
	local request = outgoing[from]
	if not request or request.Target ~= player or request.ExpiresAt < now() then
		return
	end
	outgoing[from] = nil
	if not accept then
		notify(from, "TradeDeclined", { Player = player.DisplayName }, "error")
		return
	end
	if not isReady(player) or not isReady(from) then
		notify(player, "TradeNotAvailable", nil, "error")
		return
	end
	if sessionOf[player] or sessionOf[from] then
		notify(player, "TradeBusy", nil, "error")
		return
	end
	-- Входящие запросы, отправленные самим участникам, больше не актуальны
	outgoing[player] = nil
	local session: Session = {
		Players = { from, player },
		Offers = { [from] = {}, [player] = {} },
		Ready = {},
		CountdownEndsAt = 0,
		Token = 0,
		Closed = false,
	}
	sessionOf[from] = session
	sessionOf[player] = session
	push(session)
end

-- Проверка формы: массив уникальных целых слотов, не больше MaxMemes
local function parseSlots(slots: unknown): { number }?
	if typeof(slots) ~= "table" then
		return nil
	end
	local list = slots :: { [any]: any }
	local count = 0
	for _ in list do
		count += 1
		if count > Config.Trade.MaxMemes then
			return nil
		end
	end
	local result = {}
	local seen = {}
	for i = 1, count do
		local slot = list[i]
		if typeof(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > Config.AbsoluteMaxSlots or seen[slot] then
			return nil
		end
		seen[slot] = true
		table.insert(result, slot)
	end
	return result
end

local function onSetOffer(player: Player, slots: unknown)
	local session = sessionOf[player]
	if not session or session.Closed or not isReady(player) then
		return
	end
	local t = os.clock()
	if t - (lastOfferAt[player] or 0) < OFFER_MIN_INTERVAL then
		push(session) -- отбросили запрос — пусть клиент вернётся к правде
		return
	end
	lastOfferAt[player] = t

	local parsed = parseSlots(slots)
	if not parsed then
		notify(player, "TradeOfferInvalid", nil, "error")
		push(session)
		return
	end
	local offer: { Shown } = {}
	for _, slot in parsed do
		local entry = PlotService.GetEntry(player, slot)
		if not entry or PlotService.IsAway(player, slot) then
			notify(player, "TradeOfferInvalid", nil, "error")
			push(session)
			return
		end
		table.insert(offer, { Slot = slot, Id = entry.Id, Mut = entry.Mut, Viral = entry.Viral })
	end
	session.Offers[player] = offer
	resetReady(session)
	push(session)
end

local function onReady(player: Player, ready: unknown)
	if typeof(ready) ~= "boolean" then
		return
	end
	local session = sessionOf[player]
	if not session or session.Closed then
		return
	end
	if ready then
		local partner = partnerOf(session, player)
		if #session.Offers[player] == 0 and #session.Offers[partner] == 0 then
			notify(player, "TradeEmpty", nil, "error")
			return
		end
		if session.Ready[player] then
			return
		end
		session.Ready[player] = true
		checkBothReady(session)
	else
		if not session.Ready[player] and session.CountdownEndsAt == 0 then
			return
		end
		resetReady(session)
	end
	push(session)
end

local function onCancel(player: Player)
	local session = sessionOf[player]
	if session then
		close(session, "TradeCancelled", "info")
	end
end

-- ===== Публичное API =====

-- Слот выставлен в текущем обмене игрока
function TradeService.IsOffered(player: Player, slot: number): boolean
	local session = sessionOf[player]
	if not session or session.Closed then
		return false
	end
	for _, item in session.Offers[player] do
		if item.Slot == slot then
			return true
		end
	end
	return false
end

-- Отменить обмен игрока (например, он начал кражу) — без ошибки, если обмена нет
function TradeService.Cancel(player: Player)
	onCancel(player)
end

function TradeService.OnPlayerRemoving(player: Player)
	local session = sessionOf[player]
	if session then
		close(session, "TradeCancelled", "info")
	end
	outgoing[player] = nil
	for from, request in outgoing do
		if request.Target == player then
			outgoing[from] = nil
		end
	end
	lastRequestAt[player] = nil
	lastOfferAt[player] = nil
end

function TradeService.Start()
	PlotService.IsTradeLocked = TradeService.IsOffered

	Remotes.TradeRequest.OnServerEvent:Connect(onRequest)
	Remotes.TradeRespond.OnServerEvent:Connect(onRespond)
	Remotes.TradeSetOffer.OnServerEvent:Connect(onSetOffer)
	Remotes.TradeReady.OnServerEvent:Connect(onReady)
	Remotes.TradeCancel.OnServerEvent:Connect(onCancel)
end

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">WeeklyService</string>
          <string name="Source"><![CDATA[-- Лимитированный мем недели (Config.Weekly): публикует ReplicatedStorage.WeeklyMeme / WeeklyEndsAt
-- и сообщает всем, когда неделя сменилась. Появление мема на дорожке — в ConveyorService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local WeeklyService = {}

local CHECK_INTERVAL = 60

local function update(announce: boolean)
	local meme, endsAt = Config.WeeklyMeme(os.time())
	local changed = ReplicatedStorage:GetAttribute("WeeklyMeme") ~= meme
	ReplicatedStorage:SetAttribute("WeeklyMeme", meme)
	ReplicatedStorage:SetAttribute("WeeklyEndsAt", endsAt)
	if changed and announce then
		for _, player in Players:GetPlayers() do
			Remotes.Notify:FireClient(player, "WeeklyNew", { Meme = meme }, "info")
		end
	end
end

function WeeklyService.Start()
	update(false)
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			update(true)
		end
	end)
end

return WeeklyService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="43">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="45">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Точка входа клиента «Укради Мем»: создаёт экран, общий контекст UI и запускает модули.
-- Клиент только рисует состояние (атрибуты, теги) и просит действия через Remotes;
-- все решения (цены, кражи, награды) принимает сервер.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Строки UI добавляются в Locale до того, как кто-то их попросит
local Locale = require(script:WaitForChild("Strings"))
local UiKit = require(script:WaitForChild("UiKit"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local gui = UiKit.screen("GameUi")
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets -- кнопки не под чёлкой и не под кнопками Roblox

-- Уведомления — чуть ниже баннеров события сверху
local toastHolder = UiKit.create("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 112),
	Size = UDim2.new(1, 0, 0, 220),
	BackgroundTransparency = 1,
	ZIndex = 20,
	Parent = gui,
})
local rawToast = UiKit.toaster(toastHolder)

-- Один и тот же текст дважды подряд не показываем: сервер шлёт Notify, а окна ещё
-- показывают ключ, который вернула RemoteFunction (Rebirth/UpgradeGuard/ClaimDaily/...)
local recentToasts: { [string]: number } = {}
local function toast(message: string, kind: string?)
	local now = os.clock()
	if recentToasts[message] and now - recentToasts[message] < 2 then
		return
	end
	recentToasts[message] = now
	for text, at in recentToasts do
		if now - at >= 2 then
			recentToasts[text] = nil
		end
	end
	rawToast(message, kind)
end

-- Масштаб интерфейса по высоте экрана: телефон в альбомной ориентации ~ 0.6, ПК — 1
local scales: { UIScale } = {}
local function currentScale(): number
	local camera = workspace.CurrentCamera
	local height = if camera then camera.ViewportSize.Y else 720
	return math.clamp(height / 720, 0.6, 1)
end
local function rescale()
	local value = currentScale()
	for _, scale in scales do
		scale.Scale = value
	end
end
local function watchCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	rescale()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

local windows: { [string]: GuiObject } = {}

-- Общий контекст, который получают все модули интерфейса
local ctx = {
	Gui = gui,
	Toast = toast,
	Windows = windows,
}

-- Добавить UIScale к кластеру интерфейса (панель, кнопки, окно)
function ctx.Scale(frame: GuiObject)
	local scale = Instance.new("UIScale")
	scale.Scale = currentScale()
	scale.Parent = frame
	table.insert(scales, scale)
end

-- Одно окно за раз: открыть/закрыть по имени
function ctx.Open(name: string, forceOpen: boolean?)
	local target = windows[name]
	if not target then
		return
	end
	local show = forceOpen or not target.Visible
	for _, window in windows do
		window.Visible = false
	end
	target.Visible = show
end

-- Окна не масштабируются: UiKit.window уже подгоняет размер под экран
function ctx.Register(name: string, window: GuiObject)
	windows[name] = window
end

Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(key, args, kind)
	if type(key) ~= "string" then
		return
	end
	toast(Locale.T(key, if type(args) == "table" then args else nil), if type(kind) == "string" then kind else nil)
end)

-- Модули: окна регистрируются раньше HUD, который их открывает
local modules = {
	"Shop",
	"IndexWindow",
	"RebirthWindow",
	"DefenseWindow",
	"Items",
	"DailyWindow",
	"QuestsWindow",
	"Emotes",
	"TradeWindow",
	"CodesWindow",
	"PassWindow",
	"SpinWindow",
	"SkinsWindow",
	"Popups",
	"Hud",
	"Social",
	"Banners",
	"Carry",
	"PlotSigns",
	"Prompts",
	"MemeBillboards",
	"Effects",
	"FxExtra",
	"Status",
	"Tutorial",
}
for _, name in modules do
	local ok, err = pcall(function()
		require(script:WaitForChild(name)).Start(ctx)
	end)
	if not ok then
		warn("[Client] " .. name .. " failed: " .. tostring(err))
	end
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Banners</string>
            <string name="Source"><![CDATA[-- Баннеры сверху по центру: админ-ивент (идёт / до следующего), «В ТРЕНДЕ», Ночь Смайлика
-- (идёт / до следующей, с эмодзи сезона), Удача сервера и маленький чип «мем недели» (лимитный).
-- Источник — атрибуты ReplicatedStorage (AdminEvent, AdminEventEndsAt, NextAdminEventAt, TrendingId,
-- TrendEndsAt, NightActive, NightEndsAt, NextNightAt, LuckEndsAt, Season, WeeklyMeme, WeeklyEndsAt).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create

local NIGHT_COLOR = Color3.fromRGB(255, 220, 40)
local LUCK_COLOR = Color3.fromRGB(80, 230, 120)
local ADMIN_COLOR = Color3.fromRGB(255, 120, 230)
local ADMIN_SOON = 24 * 3600 -- «следующий админ-ивент через …» показываем только в пределах суток
local SEASON_EMOJI = { Halloween = "🎃", Winter = "❄️" } -- по атрибуту Season в ReplicatedStorage

local Banners = {}

local function banner(parent: Instance, order: number, textSize: number, stroke: Color3): TextLabel
	local label = UiKit.text({
		Text = "",
		TextSize = textSize,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, textSize + 12),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.15,
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	})
	UiKit.corner(10).Parent = label
	create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = label })
	create("UIStroke", { Color = stroke, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = label })
	return label
end

function Banners.Start(ctx)
	local stack = create("Frame", {
		Name = "Banners",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	}, {
		create("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 4),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	ctx.Scale(stack)

	local admin = banner(stack, -2, 24, ADMIN_COLOR)
	admin.TextColor3 = ADMIN_COLOR
	admin.BackgroundColor3 = Color3.fromRGB(45, 20, 60)
	local adminDesc = banner(stack, -1, 14, ADMIN_COLOR)
	local adminNext = banner(stack, -1, 14, COLORS.PanelLight)
	adminNext.TextColor3 = COLORS.Muted

	local trend = banner(stack, 1, 20, COLORS.Gold)
	trend.TextColor3 = COLORS.Gold
	local night = banner(stack, 2, 22, NIGHT_COLOR)
	local luck = banner(stack, 3, 16, LUCK_COLOR)
	luck.TextColor3 = LUCK_COLOR
	local limitedColor = Config.GetRarity("Limited").Color
	local weekly = banner(stack, 4, 13, limitedColor)
	weekly.TextColor3 = limitedColor

	-- Мем недели: из атрибутов сервера, запасной вариант — та же формула из Config (время — unix)
	local function renderWeekly(now: number)
		local id = Util.str(ReplicatedStorage, "WeeklyMeme")
		local endsAt = Util.num(ReplicatedStorage, "WeeklyEndsAt")
		if id == "" and Config.WeeklyMeme then
			id, endsAt = Config.WeeklyMeme(now)
		end
		local creature = Config.GetCreature(id)
		weekly.Visible = creature ~= nil and endsAt > now
		if creature then
			weekly.Text = Locale.T("BannerWeekly", {
				Face = creature.Face,
				Name = creature.Name,
				Time = Rewards.timeLeft(endsAt - now),
			})
		end
	end

	local function renderAdmin(now: number)
		local event = Config.GetAdminEvent(Util.str(ReplicatedStorage, "AdminEvent"))
		local endsAt = Util.num(ReplicatedStorage, "AdminEventEndsAt")
		admin.Visible = event ~= nil
		adminDesc.Visible = event ~= nil
		if event then
			admin.Text = Locale.T("BannerAdminEvent", {
				Face = event.Face,
				Name = Locale.Name(event),
				Time = Util.clock(endsAt - now),
			})
			adminDesc.Text = if Locale.IsRussian and event.DescRu then event.DescRu else event.Desc
			adminNext.Visible = false
			return
		end
		local nextAt = Util.num(ReplicatedStorage, "NextAdminEventAt")
		adminNext.Visible = nextAt > now and nextAt - now <= ADMIN_SOON
		if adminNext.Visible then
			adminNext.Text = Locale.T("BannerNextAdminEvent", { Time = Util.clock(nextAt - now) })
		end
	end

	local function render()
		local now = Util.now()
		renderAdmin(now)

		local trendId = Util.str(ReplicatedStorage, "TrendingId")
		trend.Visible = trendId ~= "" and Config.GetCreature(trendId) ~= nil
		if trend.Visible then
			trend.Text = Locale.T("BannerTrend", {
				Meme = trendId,
				Mult = Config.Trend.Mult,
				Time = Util.clock(Util.num(ReplicatedStorage, "TrendEndsAt") - now),
			})
		end

		local seasonEmoji = SEASON_EMOJI[Util.str(ReplicatedStorage, "Season")]
		local prefix = if seasonEmoji then seasonEmoji .. " " else ""

		if Util.bool(ReplicatedStorage, "NightActive") then
			night.Visible = true
			night.TextSize = 22
			night.Size = UDim2.fromOffset(0, 34)
			night.TextColor3 = NIGHT_COLOR
			night.BackgroundColor3 = Color3.fromRGB(40, 10, 30)
			night.Text = prefix .. Locale.T("BannerNight", { Time = Util.clock(Util.num(ReplicatedStorage, "NightEndsAt") - now) })
		else
			local nextAt = Util.num(ReplicatedStorage, "NextNightAt")
			night.Visible = nextAt > now
			night.TextSize = 14
			night.Size = UDim2.fromOffset(0, 24)
			night.TextColor3 = COLORS.Muted
			night.BackgroundColor3 = COLORS.Panel
			night.Text = prefix .. Locale.T("BannerNextNight", { Time = Util.clock(nextAt - now) })
		end

		renderWeekly(now)

		local luckLeft = Util.num(ReplicatedStorage, "LuckEndsAt") - now
		luck.Visible = luckLeft > 0
		if luck.Visible then
			luck.Text = Locale.T("BannerLuck", { Time = Util.clock(luckLeft) })
		end
	end

	task.spawn(function()
		while true do
			render()
			task.wait(0.25)
		end
	end)
end

return Banners
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Carry</string>
            <string name="Source"><![CDATA[-- Кража: пока игрок несёт мема (атрибут Carrying), показываем баннер с таймером
-- и луч от персонажа к своей базе. Плюс метка «ТВОЯ БАЗА ⬇» над своей базой в начале игры.
-- Всё создаётся локально и видно только этому игроку.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local INTRO_SECONDS = 90 -- сколько показывать метку над своей базой после входа
local BEAM_COLOR = Color3.fromRGB(80, 255, 140)

local Carry = {}

function Carry.Start(ctx)
	-- Баннер по центру (ниже середины, чтобы не закрывать персонажа и уведомления)
	local bannerLabel = UiKit.text({
		Name = "CarryBanner",
		Text = "",
		TextSize = 24,
		TextColor3 = COLORS.Gold,
		TextStrokeTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.7),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = ctx.Gui,
	})
	UiKit.corner(12).Parent = bannerLabel
	create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = bannerLabel })
	local bannerStroke = create("UIStroke", {
		Color = COLORS.Green,
		Thickness = 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = bannerLabel,
	})
	ctx.Scale(bannerLabel)

	-- Луч к базе: вложения создаём локально, сам Beam живёт в персонаже
	local beam: Beam? = nil
	local fromAttachment: Attachment? = nil
	local toAttachment: Attachment? = nil

	local function clearBeam()
		if beam then
			beam:Destroy()
		end
		if fromAttachment then
			fromAttachment:Destroy()
		end
		if toAttachment then
			toAttachment:Destroy()
		end
		beam, fromAttachment, toAttachment = nil, nil, nil
	end

	local function ensureBeam()
		local _, root = Util.character()
		local plot = Util.myPlot()
		local floor = plot and plot:FindFirstChild("Floor")
		if not root or not floor or not floor:IsA("BasePart") then
			clearBeam()
			return
		end
		if beam and fromAttachment and toAttachment and fromAttachment.Parent == root and toAttachment.Parent == floor then
			return
		end
		clearBeam()
		local a0 = create("Attachment", { Name = "CarryBeamFrom", Parent = root })
		local a1 = create("Attachment", {
			Name = "CarryBeamTo",
			Position = Vector3.new(0, floor.Size.Y / 2 + 3, 0),
			Parent = floor,
		})
		beam = create("Beam", {
			Name = "CarryBeam",
			Attachment0 = a0,
			Attachment1 = a1,
			Color = ColorSequence.new(BEAM_COLOR),
			Transparency = NumberSequence.new(0.2, 0.5),
			Width0 = 0.8,
			Width1 = 0.8,
			CurveSize0 = 6,
			CurveSize1 = -6,
			Segments = 20,
			FaceCamera = true,
			LightEmission = 1,
			Parent = root,
		})
		fromAttachment, toAttachment = a0, a1
	end

	-- «ТВОЯ БАЗА ⬇» над полом своей базы
	local folder = create("Folder", { Name = "LocalMarkers", Parent = player:WaitForChild("PlayerGui") })
	local marker = create("BillboardGui", {
		Name = "YourBase",
		Size = UDim2.fromOffset(220, 56),
		StudsOffsetWorldSpace = Vector3.new(0, 14, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		Enabled = false,
		Parent = folder,
	})
	local markerText = UiKit.text({
		Text = Locale.T("YourBaseArrow"),
		TextScaled = true,
		TextColor3 = COLORS.Green,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = marker,
	})
	-- Мягкое покачивание метки, чтобы её было заметно
	TweenService:Create(
		markerText,
		TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = UDim2.fromOffset(0, 8) }
	):Play()

	local introStart: number? = nil -- отсчёт с момента, когда своя база впервые найдена

	local function render()
		local carrying = Util.str(player, "Carrying")
		local isCarrying = carrying ~= ""

		bannerLabel.Visible = isCarrying
		if isCarrying then
			local left = Util.num(player, "CarryEndsAt") - Util.now()
			bannerLabel.Text = Locale.T("BannerCarry", { Meme = carrying, Time = Util.clock(left) })
			bannerStroke.Color = if left < 10 then COLORS.Red else COLORS.Green
			ensureBeam()
		elseif beam then
			clearBeam()
		end

		local plot = Util.myPlot()
		local floor = plot and plot:FindFirstChild("Floor")
		marker.Adornee = if floor and floor:IsA("BasePart") then floor else nil
		if marker.Adornee and not introStart then
			introStart = os.clock()
		end
		local intro = introStart ~= nil and os.clock() - introStart < INTRO_SECONDS
		marker.Enabled = marker.Adornee ~= nil and (isCarrying or intro)
	end

	player.CharacterRemoving:Connect(clearBeam)
	task.spawn(function()
		while true do
			render()
			task.wait(0.2)
		end
	end)
end

return Carry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CodesWindow</string>
            <string name="Source"><![CDATA[-- Окно кодов: поле ввода + «Активировать» -> Remotes.RedeemCode(text).
-- Проверяет код и выдаёт награду сервер (Config.Codes); награда приходит Popup "Code".
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local COLORS = UiKit.Colors
local create = UiKit.create

local MAX_LENGTH = 32

local CodesWindow = {}

function CodesWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("CodesTitle"), Vector2.new(420, 230))
	window.Name = "CodesWindow"
	ctx.Register("Codes", window)

	UiKit.text({
		Text = Locale.T("CodesHint"),
		TextScaled = true,
		TextWrapped = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		Size = UDim2.new(1, 0, 0, 36),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15 }) })

	local box = create("TextBox", {
		Text = "",
		PlaceholderText = Locale.T("CodesPlaceholder"),
		PlaceholderColor3 = COLORS.Muted,
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		TextColor3 = COLORS.Text,
		BackgroundColor3 = COLORS.PanelLight,
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 0, 50),
		Parent = body,
	}, { UiKit.corner(10), create("UIStroke", { Color = COLORS.Purple, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) })

	local redeem = UiKit.button({
		Text = Locale.T("CodesRedeem"),
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		Size = UDim2.new(0.7, 0, 0, 50),
		BackgroundColor3 = COLORS.Green,
		Parent = body,
	})

	-- Ограничиваем длину прямо в поле (сервер всё равно проверит)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > MAX_LENGTH then
			box.Text = string.sub(box.Text, 1, MAX_LENGTH)
		end
	end)

	local busy = false
	local function submit()
		if busy then
			return
		end
		local code = string.gsub(box.Text, "^%s+", "")
		code = string.gsub(code, "%s+$", "")
		if code == "" then
			ctx.Toast(Locale.T("CodesEmpty"), "error")
			return
		end
		busy = true
		redeem.AutoButtonColor = false
		redeem.BackgroundColor3 = COLORS.PanelLight
		local success, key = Rewards.invoke("RedeemCode", code)
		busy = false
		redeem.AutoButtonColor = true
		redeem.BackgroundColor3 = COLORS.Green
		if type(key) == "string" then
			ctx.Toast(Locale.T(key), if success then "success" else "error")
		end
		if success then
			box.Text = ""
		end
	end

	redeem.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
end

return CodesWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DailyWindow</string>
            <string name="Source"><![CDATA[-- Календарь ежедневных наград: 7 клеток из Config.DailyCalendar, забранные дни с галочкой,
-- текущий день подсвечен. Забрать — Remotes.ClaimDaily (награду выбирает и выдаёт сервер).
-- Атрибуты игрока: DailyReady (можно забрать), DailyDay (какой день выдадут; если не готово —
-- последний забранный), DailyStreak. Окно само открывается один раз за сессию, если награда
-- готова (но не во время туториала).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local AUTO_OPEN_DELAY = 2.5 -- после загрузки данных, чтобы не перекрыть оффлайн-доход сразу

local DailyWindow = {}

-- Иконка, подпись и цвет награды дня
local function describe(reward): (string, string, Color3)
	if reward.Kind == "Meme" then
		local rarity = Config.GetRarity(reward.Rarity)
		return "🎲", Locale.T("DailyMeme", { Rarity = Locale.Name(rarity) }), rarity.Color
	elseif reward.Kind == "Item" then
		local item = Config.GetItem(reward.ItemId)
		-- Предмет уже куплен — сервер выдаст монеты Fallback, их и показываем
		local owned = Util.json(player, "ItemsJson")
		local hasItem = type(owned) == "table" and table.find(owned, reward.ItemId) ~= nil
		if item and not hasItem then
			return item.Face, Locale.Name(item), COLORS.Purple
		end
		local fallback = reward.Fallback or {}
		return "💰", Locale.T("DailyCoins", { Coins = Util.coinsFor(fallback.IncomeSeconds, fallback.MinCoins) }), COLORS.Gold
	end
	return "💰", Locale.T("DailyCoins", { Coins = Util.coinsFor(reward.IncomeSeconds, reward.MinCoins) }), COLORS.Gold
end

-- Сколько дней текущего круга уже забрано и какой день подсветить
local function progress(): (number, number, boolean)
	local ready = Util.bool(player, "DailyReady")
	local day = math.clamp(Util.num(player, "DailyDay"), 0, #Config.DailyCalendar)
	if ready then
		local current = math.max(day, 1)
		return current - 1, current, true
	end
	-- Уже забрано сегодня: DailyDay = последний забранный день (DailyStreak — запасной вариант)
	local claimed = if day > 0 then day else math.clamp(Util.num(player, "DailyStreak"), 0, #Config.DailyCalendar)
	local nextDay = if claimed >= #Config.DailyCalendar then 1 else claimed + 1
	return claimed, nextDay, false
end

function DailyWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("DailyTitle"), Vector2.new(640, 380))
	window.Name = "DailyWindow"
	ctx.Register("Daily", window)

	UiKit.text({
		Text = Locale.T("DailyHint"),
		TextScaled = true,
		TextWrapped = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		Size = UDim2.new(1, 0, 0, 22),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15 }) })

	local grid = create("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 1, -94),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / 7, -6, 1, 0),
			CellPadding = UDim2.fromOffset(6, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	local cells = {}
	for day, reward in Config.DailyCalendar do
		local cell = create("Frame", {
			Name = "Day" .. day,
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = day,
			Parent = grid,
		}, { UiKit.corner(10) })
		local stroke = create("UIStroke", { Color = COLORS.Gold, Thickness = 3, Enabled = false, Parent = cell })
		local dayLabel = UiKit.text({
			Text = Locale.T("DailyDayN", { Day = day }),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 2, 0, 4),
			Size = UDim2.new(1, -4, 0.16, 0),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 16 }) })
		local icon = UiKit.text({
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromScale(0.15, 0.2),
			Size = UDim2.fromScale(0.7, 0.4),
			Parent = cell,
		})
		create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = icon })
		local caption = UiKit.text({
			TextScaled = true,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 3, 0.62, 0),
			Size = UDim2.new(1, -6, 0.24, 0),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 7 }) })
		local tag = UiKit.text({
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = COLORS.Gold,
			Position = UDim2.new(0, 2, 0.86, 0),
			Size = UDim2.new(1, -4, 0.12, 0),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 12 }) })
		local check = UiKit.text({
			Text = "✅",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.42),
			Size = UDim2.fromScale(0.6, 0.35),
			ZIndex = 3,
			Visible = false,
			Parent = cell,
		})
		create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = check })
		cells[day] = { Reward = reward, Frame = cell, Stroke = stroke, Day = dayLabel, Icon = icon, Caption = caption, Tag = tag, Check = check }
	end

	local claim = UiKit.button({
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(0.6, 0, 0, 54),
		BackgroundColor3 = COLORS.Green,
		Parent = body,
	})

	local function render()
		local claimed, highlight, ready = progress()
		for day, cell in cells do
			local icon, caption, color = describe(cell.Reward)
			local done = day <= claimed
			local current = day == highlight
			cell.Icon.Text = icon
			cell.Icon.TextTransparency = if done then 0.6 else 0
			cell.Caption.Text = caption
			cell.Caption.TextColor3 = color
			cell.Check.Visible = done
			cell.Stroke.Enabled = current
			cell.Stroke.Color = if ready then COLORS.Green else COLORS.Gold
			cell.Frame.BackgroundColor3 = if current and ready then Color3.fromRGB(40, 80, 55) else COLORS.PanelLight
			cell.Tag.Text = if current then Locale.T(if ready then "DailyToday" else "DailyNext") else ""
			cell.Tag.TextColor3 = if ready then COLORS.Green else COLORS.Gold
		end
		claim.Text = Locale.T(if ready then "DailyClaim" else "DailyTomorrow")
		claim.BackgroundColor3 = if ready then COLORS.Green else COLORS.PanelLight
		claim.TextColor3 = if ready then COLORS.Text else COLORS.Muted
		claim.AutoButtonColor = ready
	end

	for _, name in { "DailyReady", "DailyDay", "DailyStreak" } do
		player:GetAttributeChangedSignal(name):Connect(render)
	end
	player:GetAttributeChangedSignal("ItemsJson"):Connect(render)
	player:GetAttributeChangedSignal("Income"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()

	local busy = false
	claim.Activated:Connect(function()
		if busy or not Util.bool(player, "DailyReady") then
			return
		end
		busy = true
		local ok, success, key = pcall(function()
			return Remotes:WaitForChild("ClaimDaily"):InvokeServer()
		end)
		busy = false
		if ok and type(key) == "string" then
			ctx.Toast(Locale.T(key), if success then "success" else "error")
		end
		if ok and success then
			-- Награду показывает Popup «Daily» от сервера
			window.Visible = false
		end
		render()
	end)

	-- Автооткрытие: один раз за сессию, после загрузки данных и вне туториала
	task.spawn(function()
		while not Util.bool(player, "DataLoaded") do
			player:GetAttributeChangedSignal("DataLoaded"):Wait()
		end
		task.wait(AUTO_OPEN_DELAY)
		while player:GetAttribute("TutorialDone") == 0 do
			player:GetAttributeChangedSignal("TutorialDone"):Wait()
		end
		if not Util.bool(player, "DailyReady") then
			return
		end
		-- Не перебиваем окно, которое игрок уже открыл сам
		for _, other in ctx.Windows do
			if other.Visible then
				return
			end
		end
		ctx.Open("Daily", true)
	end)
end

return DailyWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">DefenseWindow</string>
            <string name="Source"><![CDATA[-- Окно защиты базы: три карточки — страж (Kitten with a Sword), турель и лазерные ворота.
-- Уровни — атрибуты игрока GuardLevel / TurretLevel / LaserLevel, цены и параметры — Config.Guard и
-- Config.Defense. Покупку проверяет сервер: Remotes.UpgradeGuard() и Remotes.UpgradeDefense(kind).
-- (Раньше страж жил в отдельном GuardWindow; теперь это одна вкладка-карточка здесь.)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local CARD_HEIGHT = 132

-- Карточки: атрибут уровня, таблица уровней, как просить сервер и как описать следующий уровень
local KINDS = {
	{
		Id = "Guard",
		Title = "DefenseGuardName",
		Info = "GuardInfo",
		Attribute = "GuardLevel",
		Levels = Config.Guard,
		Invoke = function()
			return Remotes:WaitForChild("UpgradeGuard"):InvokeServer()
		end,
		Next = function(level)
			return Locale.T("GuardNext", { Range = level.Range, Cooldown = level.Cooldown })
		end,
	},
	{
		Id = "Turret",
		Title = "DefenseTurretName",
		Info = "DefenseTurretInfo",
		Attribute = "TurretLevel",
		Levels = Config.Defense.Turret,
		Invoke = function()
			return Remotes:WaitForChild("UpgradeDefense"):InvokeServer("Turret")
		end,
		Next = function(level)
			return Locale.T("DefenseTurretNext", { Range = level.Range, Cooldown = level.Cooldown, Stun = level.Stun })
		end,
	},
	{
		Id = "LaserGate",
		Title = "DefenseLaserName",
		Info = "DefenseLaserInfo",
		Attribute = "LaserLevel",
		Levels = Config.Defense.LaserGate,
		Invoke = function()
			return Remotes:WaitForChild("UpgradeDefense"):InvokeServer("LaserGate")
		end,
		Next = function(level)
			return Locale.T("DefenseLaserNext", { Cooldown = level.Cooldown, Stun = level.Stun })
		end,
	},
}

local DefenseWindow = {}

-- Самая дешёвая доступная прокачка (для подписи кнопки в HUD); nil — всё на максимуме
function DefenseWindow.CheapestPrice(): number?
	local best: number? = nil
	for _, kind in KINDS do
		local nextLevel = kind.Levels[Util.num(player, kind.Attribute) + 1]
		if nextLevel and (best == nil or nextLevel.Price < best) then
			best = nextLevel.Price
		end
	end
	return best
end

DefenseWindow.Attributes = { "GuardLevel", "TurretLevel", "LaserLevel" }

function DefenseWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("DefenseTitle"), Vector2.new(560, 480))
	window.Name = "DefenseWindow"
	ctx.Register("Defense", window)

	local list = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})

	local cards = {}
	local busy = false

	for order, kind in KINDS do
		local frame = create("Frame", {
			Name = kind.Id,
			Size = UDim2.new(1, 0, 0, CARD_HEIGHT),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
			Parent = list,
		}, { UiKit.corner(10), UiKit.padding(10) })
		UiKit.text({
			Text = Locale.T(kind.Title),
			TextScaled = true,
			Size = UDim2.new(1, -140, 0, 26),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 20, MinTextSize = 12 }) })
		local level = UiKit.text({
			TextScaled = true,
			TextColor3 = COLORS.Gold,
			TextXAlignment = Enum.TextXAlignment.Right,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(130, 26),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 18 }) })
		UiKit.text({
			Text = Locale.T(kind.Info),
			TextScaled = true,
			TextWrapped = true,
			Font = Enum.Font.Gotham,
			TextColor3 = COLORS.Muted,
			Position = UDim2.fromOffset(0, 28),
			Size = UDim2.new(1, -140, 0, 34),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }) })
		local nextInfo = UiKit.text({
			TextScaled = true,
			TextWrapped = true,
			Position = UDim2.fromOffset(0, 66),
			Size = UDim2.new(1, -140, 0, 40),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 8 }) })
		local buy = UiKit.button({
			TextScaled = true,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(1, 1),
			Size = UDim2.fromOffset(130, 52),
			BackgroundColor3 = COLORS.Green,
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 17, Parent = buy })
		create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = buy })

		buy.Activated:Connect(function()
			local current = Util.num(player, kind.Attribute)
			local nextLevel = kind.Levels[current + 1]
			if busy or not nextLevel then
				return
			end
			busy = true
			local ok, success, key = pcall(kind.Invoke)
			busy = false
			if ok and type(key) == "string" then
				ctx.Toast(Locale.T(key, { Level = current + 1, Price = nextLevel.Price }), if success then "success" else "error")
			end
		end)

		cards[kind.Id] = { Kind = kind, Level = level, Next = nextInfo, Buy = buy }
	end

	local function render()
		local coins = Util.num(player, "Coins")
		for _, card in cards do
			local kind = card.Kind
			local current = Util.num(player, kind.Attribute)
			local nextLevel = kind.Levels[current + 1]
			card.Level.Text = Locale.T("GuardLevelNow", { Level = current, Max = #kind.Levels })
			if nextLevel then
				card.Next.Text = kind.Next(nextLevel)
				card.Buy.Text = Locale.T(if current == 0 then "GuardBuy" else "GuardUpgrade", { Price = nextLevel.Price })
				local affordable = coins >= nextLevel.Price
				card.Buy.BackgroundColor3 = if affordable then COLORS.Green else COLORS.Panel
				card.Buy.TextColor3 = if affordable then COLORS.Text else COLORS.Red
				card.Buy.AutoButtonColor = true
			else
				card.Next.Text = ""
				card.Buy.Text = Locale.T("GuardMaxed")
				card.Buy.BackgroundColor3 = COLORS.Panel
				card.Buy.TextColor3 = COLORS.Muted
				card.Buy.AutoButtonColor = false
			end
		end
	end

	for _, name in DefenseWindow.Attributes do
		player:GetAttributeChangedSignal(name):Connect(render)
	end
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()
end

return DefenseWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Клиентские эффекты: отбрасывание с оглушением (Remotes.Knockback), разовые вспышки/конфетти
-- (Remotes.Fx), оттенок Ночью Смайлика по сезону (Хэллоуин — красноватый, Зима — холодный синий)
-- и табличка со здоровьем монстра.
-- Всё создаётся локально, без звуков и текстур по ID.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local KNOCKBACK_TIME = 0.6 -- оглушение по умолчанию (старый вызов без второго аргумента)
local MAX_STUN = 4
local DIZZY_STUN = 1.5 -- с такого оглушения над головой крутятся звёздочки
local MAX_KNOCKBACK = 300 -- защита от странных значений: клиент не улетит за карту
local MAX_PIECES = 250 -- не больше стольких частиц конфетти одновременно
local VIRAL_COLOR = Color3.fromRGB(255, 80, 220)
local MONSTER_COLOR = Color3.fromRGB(255, 220, 40)
local BANANA_COLOR = Color3.fromRGB(255, 225, 50)
local ENERGY_COLOR = Color3.fromRGB(80, 255, 120)

-- Оттенок ночи по сезону (Season в ReplicatedStorage); без сезона — как на Хэллоуин
local NIGHT_TINTS = {
	Halloween = { TintColor = Color3.fromRGB(255, 222, 215), Saturation = -0.15, Contrast = 0.12, Brightness = -0.03 },
	Winter = { TintColor = Color3.fromRGB(205, 225, 255), Saturation = -0.1, Contrast = 0.1, Brightness = -0.02 },
}
local NO_TINT = { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0, Brightness = 0 }

local Effects = {}

-- ===== Отбрасывание =====
local function shakeCamera(humanoid: Humanoid, duration: number, strength: number)
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < duration and humanoid.Parent do
			local fade = 1 - (os.clock() - started) / duration
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * strength * fade,
				(math.random() - 0.5) * strength * fade,
				0
			)
			task.wait()
		end
		humanoid.CameraOffset = Vector3.zero
	end)
end

-- «💫» над своей головой на время оглушения (только у себя)
local dizzyGui: BillboardGui? = nil
local function showDizzy(character: Model, duration: number)
	if dizzyGui then
		dizzyGui:Destroy()
	end
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local gui = create("BillboardGui", {
		Name = "Dizzy",
		Adornee = head,
		Size = UDim2.fromOffset(60, 60),
		StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local label = UiKit.text({
		Text = "💫",
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	TweenService:Create(label, TweenInfo.new(0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), { Rotation = 360 }):Play()
	dizzyGui = gui
	task.delay(duration, function()
		if dizzyGui == gui then
			dizzyGui = nil
		end
		gui:Destroy()
	end)
end

local knockToken = 0
local function onKnockback(velocity: any, stun: any)
	if typeof(velocity) ~= "Vector3" or velocity ~= velocity then
		return
	end
	local duration = if type(stun) == "number" and stun == stun then math.clamp(stun, 0, MAX_STUN) else KNOCKBACK_TIME
	if velocity.Magnitude > MAX_KNOCKBACK then
		velocity = velocity.Unit * MAX_KNOCKBACK
	end
	local character, root, humanoid = Util.character()
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if duration <= 0 then
		-- stun = 0 (ракетные ботинки): просто толчок без падения и тряски камеры.
		-- В Physics + сразу GettingUp персонаж «вставал» и терял скорость; прыжок сохраняет полёт.
		-- Если игрок сейчас оглушён — не прерываем оглушение, только добавляем скорость.
		if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
		root.AssemblyLinearVelocity = velocity
		return
	end
	knockToken += 1
	local token = knockToken
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	root.AssemblyLinearVelocity = velocity
	shakeCamera(humanoid, 0.35, 0.6)
	if duration >= DIZZY_STUN then
		showDizzy(character, duration)
	end
	task.delay(duration, function()
		-- Новый удар за это время продлевает полёт
		if token == knockToken and humanoid.Parent and humanoid.Health > 0 then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

-- ===== Вспышки и конфетти =====
local livePieces = 0

local function fxParent(): Instance
	return workspace.CurrentCamera or workspace
end

local function piece(position: Vector3, size: Vector3, color: Color3, shape: Enum.PartType?): Part
	return create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.Neon,
		Shape = shape or Enum.PartType.Block,
		Size = size,
		Color = color,
		CFrame = CFrame.new(position),
		Parent = fxParent(),
	})
end

-- Разлетающиеся кусочки цветов colors
local function confetti(position: Vector3, colors: { Color3 }, count: number, spread: number)
	count = math.min(count, MAX_PIECES - livePieces)
	for _ = 1, count do
		livePieces += 1
		local size = 0.25 + math.random() * 0.35
		local part = piece(position, Vector3.new(size, size, size * 0.4), colors[math.random(#colors)])
		local direction = Vector3.new(math.random() - 0.5, 0.6 + math.random(), math.random() - 0.5).Unit
		local target = position + direction * (spread * (0.5 + math.random() * 0.5))
		local spin = CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		local fly = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(part, fly, { CFrame = CFrame.new(target) * spin }):Play()
		TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.5), {
			Transparency = 1,
		}):Play()
		Debris:AddItem(part, 1.1)
		task.delay(1.1, function()
			livePieces -= 1
		end)
	end
end

-- Расширяющийся светящийся шар
local function flash(position: Vector3, color: Color3, size: number, duration: number)
	local ball = piece(position, Vector3.one, color, Enum.PartType.Ball)
	ball.Transparency = 0.2
	TweenService:Create(ball, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * size,
		Transparency = 1,
	}):Play()
	Debris:AddItem(ball, duration + 0.1)
end

-- Всплывающая надпись в мире (поднимается и тает)
local function floatText(position: Vector3, text: string, color: Color3)
	local anchor = piece(position, Vector3.one * 0.2, color)
	anchor.Transparency = 1
	local gui = create("BillboardGui", {
		Size = UDim2.fromOffset(160, 50),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 120,
		Parent = anchor,
	})
	local label = UiKit.text({
		Text = text,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local rise = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(anchor, rise, { CFrame = CFrame.new(position + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.6), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(anchor, 1.1)
end

-- Белая вспышка экрана и крупный текст при своём перерождении
local function rebirthScreen()
	local overlay = create("ScreenGui", {
		Name = "RebirthFlash",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 50,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local white = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Parent = overlay,
	})
	local label = UiKit.text({
		Text = "♻️ " .. Locale.T("FxRebirth"),
		TextScaled = true,
		TextColor3 = COLORS.Purple,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.8, 0.18),
		Parent = overlay,
	})
	local pop = create("UIScale", { Scale = 0.3, Parent = label })
	TweenService:Create(white, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(pop, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.6, function()
		TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	Debris:AddItem(overlay, 2.3)
end

local function onFx(kind: any, data: any)
	if type(kind) ~= "string" or type(data) ~= "table" then
		return
	end
	local position = data.Position
	local hasPosition = typeof(position) == "Vector3"

	-- Эффекты далеко от игрока не рисуем — экономим телефоны
	if hasPosition then
		local _, root = Util.character()
		if root and (root.Position - position).Magnitude > 250 then
			return
		end
	end

	if kind == "Slap" and hasPosition then
		flash(position, Color3.new(1, 1, 1), 6, 0.25)
		confetti(position, { Color3.new(1, 1, 1), Color3.fromRGB(255, 240, 200) }, 10, 4)
	elseif kind == "Bought" and hasPosition then
		local rarityId = if type(data.Rarity) == "string" then data.Rarity else "Common"
		local color = Config.GetRarity(rarityId).Color
		local colors = if rarityId == "Secret"
			then { Color3.new(1, 1, 1), COLORS.Gold, Color3.fromRGB(40, 40, 40) }
			else { color, color, Color3.new(1, 1, 1), COLORS.Gold }
		confetti(position, colors, 24, 7)
	elseif kind == "Stolen" and hasPosition then
		flash(position, COLORS.Red, 5, 0.3)
		confetti(position, { COLORS.Red, Color3.fromRGB(255, 160, 160) }, 12, 5)
	elseif kind == "Delivered" and hasPosition then
		local mine = data.UserId == player.UserId
		confetti(position, { COLORS.Green, COLORS.Gold, Color3.new(1, 1, 1) }, if mine then 36 else 16, 8)
	elseif kind == "Merged" and hasPosition then
		flash(position, VIRAL_COLOR, 9, 0.45)
		confetti(position, { VIRAL_COLOR, COLORS.Purple, COLORS.Gold, Color3.new(1, 1, 1) }, 40, 9)
	elseif kind == "MonsterHit" and hasPosition then
		flash(position, MONSTER_COLOR, 4, 0.2)
		confetti(position, { MONSTER_COLOR, Color3.new(1, 1, 1) }, 8, 4)
	elseif kind == "Invisible" and hasPosition then
		flash(position, Color3.fromRGB(170, 170, 180), 8, 0.5)
		confetti(position, { Color3.fromRGB(150, 150, 160), Color3.fromRGB(210, 210, 220), Color3.new(1, 1, 1) }, 18, 5)
	elseif kind == "Banana" and hasPosition then
		flash(position, BANANA_COLOR, 6, 0.3)
		confetti(position, { BANANA_COLOR, Color3.fromRGB(255, 240, 150), Color3.fromRGB(120, 90, 30) }, 16, 6)
		floatText(position + Vector3.new(0, 3, 0), Locale.T("FxSlip"), BANANA_COLOR)
	elseif kind == "Energy" and hasPosition then
		flash(position, ENERGY_COLOR, 5, 0.25)
		confetti(position, { ENERGY_COLOR, Color3.fromRGB(200, 255, 120), Color3.new(1, 1, 1) }, 20, 9)
	elseif kind == "Rebirth" then
		if data.UserId == player.UserId then
			rebirthScreen()
		end
		-- Конфетти над перерождённым игроком (если он рядом)
		local who = if type(data.UserId) == "number" then Players:GetPlayerByUserId(data.UserId) else nil
		local character = who and who.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			confetti(root.Position + Vector3.new(0, 3, 0), { COLORS.Purple, COLORS.Gold, Color3.new(1, 1, 1) }, 40, 10)
		end
	end
end

-- ===== Ночь Смайлика: лёгкий оттенок по сезону поверх освещения сервера =====
local function startNightTint()
	local tint = create("ColorCorrectionEffect", {
		Name = "SmileyNightLocal",
		TintColor = Color3.new(1, 1, 1),
		Parent = Lighting,
	})
	local fade = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	local function render()
		local active = Util.bool(ReplicatedStorage, "NightActive")
		local goal = if active then NIGHT_TINTS[Util.str(ReplicatedStorage, "Season")] or NIGHT_TINTS.Halloween else NO_TINT
		TweenService:Create(tint, fade, goal):Play()
	end
	ReplicatedStorage:GetAttributeChangedSignal("NightActive"):Connect(render)
	ReplicatedStorage:GetAttributeChangedSignal("Season"):Connect(render)
	render()
end

-- ===== Монстр: табличка с полосой здоровья =====
local function trackMonster(model: Instance): () -> ()
	local gui = create("BillboardGui", {
		Name = "Monster",
		Size = UDim2.fromOffset(220, 74),
		SizeOffset = Vector2.new(0, 0.5),
		AlwaysOnTop = true,
		MaxDistance = 300,
		LightInfluence = 0,
		ResetOnSpawn = false,
	})
	local name = UiKit.text({
		Text = Locale.T("MonsterName"),
		TextSize = 20,
		TextColor3 = MONSTER_COLOR,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = gui,
	})
	local bar = create("Frame", {
		Position = UDim2.fromOffset(10, 26),
		Size = UDim2.new(1, -20, 0, 18),
		BackgroundColor3 = Color3.fromRGB(30, 20, 20),
		Parent = gui,
	}, { UiKit.corner(6), create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLORS.Red,
		Parent = bar,
	}, { UiKit.corner(6) })
	local hpText = UiKit.text({
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bar,
	})
	local carrying = UiKit.text({
		TextSize = 16,
		TextColor3 = COLORS.Red,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = gui,
	})

	local function render()
		local hp, maxHp = Util.num(model, "Hp"), Util.num(model, "MaxHp")
		local ratio = if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0
		TweenService:Create(fill, TweenInfo.new(0.15), { Size = UDim2.fromScale(ratio, 1) }):Play()
		hpText.Text = math.max(0, math.ceil(hp)) .. " / " .. math.ceil(maxHp)
		local memeId = Util.str(model, "Carrying")
		carrying.Text = if memeId ~= "" then "😈 " .. Locale.MemeName(memeId) else ""
		name.Text = (if memeId ~= "" then "😈 " else "") .. Locale.T("MonsterName")
	end

	local function adorn()
		local part = Util.mainPart(model)
		gui.Adornee = part
		local height = if part then part.Size.Y else 6
		if model:IsA("Model") then
			local ok, size = pcall(model.GetExtentsSize, model)
			if ok and size.Y > 0 then
				height = size.Y
			end
		end
		gui.StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 1, 0)
	end

	adorn()
	render()
	gui.Parent = player:WaitForChild("PlayerGui"):FindFirstChild("MemeBillboards") or player.PlayerGui

	local connections = {
		model.AttributeChanged:Connect(render),
		model.ChildAdded:Connect(function(child)
			if child:IsA("BasePart") then
				adorn()
			end
		end),
	}
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
		gui:Destroy()
	end
end

-- Помощники для других модулей эффектов (FxExtra): те же детали, вспышки и конфетти
Effects.Piece = piece
Effects.Confetti = confetti
Effects.Flash = flash
Effects.FloatText = floatText
Effects.FxParent = fxParent

function Effects.Start()
	Remotes:WaitForChild("Knockback").OnClientEvent:Connect(onKnockback)
	Remotes:WaitForChild("Fx").OnClientEvent:Connect(onFx)
	startNightTint()
	Util.watchTagged("Monster", trackMonster)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Emotes</string>
            <string name="Source"><![CDATA[-- Эмоции: окно-сетка из Config.Emotes (закрытые геймпассом — с замком и покупкой) и процедурная
-- анимация персонажа по Fx "Emote" { UserId, Emote } — у любого игрока, включая себя.
--
-- Анимация двигает суставы (Motor6D.Transform): R15 — RightShoulder/LeftShoulder (+ локти),
-- Waist, Root, Neck; R6 — "Right Shoulder"/"Left Shoulder", RootJoint, Neck в Torso/HumanoidRootPart.
-- Почему RunService.PreSimulation: Animator записывает Transform из играющих треков (бег, idle)
-- до PreSimulation, а рендер идёт после — значение, поставленное здесь, перекрывает анимацию на
-- этот кадр и не «дерётся» с ней (в RenderStepped Animator затёр бы его на следующем шаге,
-- а в Heartbeat кадр уже отрисован с позой Animator). Мы полностью заменяем Transform своих
-- суставов, а не умножаем: так значение не копится на суставах, которые Animator не трогает.
-- В конце Transform сбрасывается в identity (Animator перезапишет своё со следующего кадра).
--
-- Поза задаётся поворотом D в пространстве Part0 (торса): ось X — вправо, Y — вверх, -Z — вперёд.
-- Для любого рига T = rot(C0)⁻¹ · D · rot(C0), поэтому одни и те же позы работают на R6 и R15.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MAX_DISTANCE = 200 -- дальше эмоции не анимируем
local FADE_IN = 0.2
local FADE_OUT = 0.3
local TEAR_COLOR = Color3.fromRGB(90, 180, 255)

local Emotes = {}

local function rx(deg: number): CFrame
	return CFrame.Angles(math.rad(deg), 0, 0)
end
local function ry(deg: number): CFrame
	return CFrame.Angles(0, math.rad(deg), 0)
end
local function rz(deg: number): CFrame
	return CFrame.Angles(0, 0, math.rad(deg))
end

-- Позы: (t — секунды с начала, w — 0..1 плавный вход/выход, duration) -> { сустав = D }.
-- Суставы: R, L (плечи), RE, LE (локти, только R15), Waist (только R15), Root, Neck.
type Pose = { [string]: CFrame }
local PROCS: { [string]: (number, number, number) -> Pose } = {
	Wave = function(t, w)
		local s = math.sin(t * 12)
		return { R = rz(w * (155 + 18 * s)), RE = rz(w * (20 * s)) }
	end,
	Clap = function(t, w)
		local s = math.abs(math.sin(t * 9))
		local inward = 12 + 26 * s
		return {
			R = ry(w * inward) * rx(w * 85),
			L = ry(-w * inward) * rx(w * 85),
		}
	end,
	SixSeven = function(t, w)
		local s = math.sin(t * 7)
		return {
			R = rx(w * (55 + 22 * s)),
			L = rx(w * (55 - 22 * s)),
			RE = rx(w * 45),
			LE = rx(w * 45),
			Neck = rz(w * 6 * s),
		}
	end,
	Spin = function(t, w, duration)
		-- Целое число оборотов за эмоцию, чтобы в конце не было рывка
		local turns = math.max(1, math.floor(duration * 1.5 + 0.5))
		local angle = 360 * turns * math.clamp(t / duration, 0, 1)
		return { Root = ry(angle), R = rz(w * 60), L = rz(-w * 60) }
	end,
	Flex = function(t, w)
		local pump = 8 * math.sin(t * 6)
		return {
			R = rz(w * (95 + pump)),
			L = rz(-w * (95 + pump)),
			RE = rz(w * 100),
			LE = rz(-w * 100),
			Neck = rx(w * 12),
		}
	end,
	Floss = function(t, w)
		local s = math.sin(t * 8)
		local c = math.cos(t * 8)
		return {
			R = rz(w * 35 * s) * rx(w * 25 * c),
			L = rz(w * 35 * s) * rx(-w * 25 * c),
			Root = CFrame.new(-0.35 * s * w, 0, 0) * rz(-w * 6 * s),
		}
	end,
	Dab = function(_, w)
		return {
			R = rz(w * 130) * rx(w * 20),
			L = ry(-w * 55) * rx(w * 105),
			LE = rx(w * 70),
			Neck = rz(-w * 15) * rx(-w * 30),
		}
	end,
	Cry = function(t, w)
		local shake = 4 * math.sin(t * 25)
		return {
			R = rz(w * shake) * ry(w * 30) * rx(w * 125),
			L = rz(w * shake) * ry(-w * 30) * rx(w * 125),
			RE = rx(w * 80),
			LE = rx(w * 80),
			Neck = rx(w * (-20 + 5 * math.sin(t * 25))),
		}
	end,
}

-- Суставы персонажа по ключам поз (R15 или R6)
local function findJoints(character: Model): { [string]: Motor6D }
	local found: { [string]: Motor6D } = {}
	local function take(key: string, partName: string, jointName: string)
		local part = character:FindFirstChild(partName)
		local joint = part and part:FindFirstChild(jointName)
		if joint and joint:IsA("Motor6D") then
			found[key] = joint
		end
	end
	if character:FindFirstChild("UpperTorso") then
		take("R", "RightUpperArm", "RightShoulder")
		take("L", "LeftUpperArm", "LeftShoulder")
		take("RE", "RightLowerArm", "RightElbow")
		take("LE", "LeftLowerArm", "LeftElbow")
		take("Waist", "UpperTorso", "Waist")
		take("Root", "LowerTorso", "Root")
		take("Neck", "Head", "Neck")
	else
		take("R", "Torso", "Right Shoulder")
		take("L", "Torso", "Left Shoulder")
		take("Root", "HumanoidRootPart", "RootJoint")
		take("Neck", "Torso", "Neck")
	end
	return found
end

-- Поворот в пространстве Part0 -> Transform в системе сустава (C0)
local function toTransform(joint: Motor6D, pose: CFrame): CFrame
	local basis = joint.C0.Rotation
	return basis:Inverse() * pose * basis
end

type Active = {
	Character: Model,
	Humanoid: Humanoid,
	Joints: { [string]: Motor6D },
	Touched: { [Motor6D]: boolean },
	Proc: (number, number, number) -> Pose,
	Started: number,
	Duration: number,
	Gui: BillboardGui?,
	Tears: boolean,
	NextTear: number,
}

local active: { [Model]: Active } = {}
local stepConnection: RBXScriptConnection? = nil

local function stop(character: Model)
	local entry = active[character]
	if not entry then
		return
	end
	active[character] = nil
	for joint in entry.Touched do
		if joint.Parent then
			joint.Transform = CFrame.identity
		end
	end
	if entry.Gui then
		entry.Gui:Destroy()
	end
	if next(active) == nil and stepConnection then
		stepConnection:Disconnect()
		stepConnection = nil
	end
end

local function tear(head: BasePart)
	local side = if math.random() < 0.5 then -0.35 else 0.35
	local start = (head.CFrame * CFrame.new(side, 0.1, -0.55)).Position
	local drop = create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.25,
		Color = TEAR_COLOR,
		CFrame = CFrame.new(start),
		Parent = workspace.CurrentCamera or workspace,
	})
	TweenService:Create(drop, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = CFrame.new(start + Vector3.new(side * 0.8, -2.5, 0)),
		Transparency = 1,
	}):Play()
	Debris:AddItem(drop, 0.7)
end

local function step()
	local now = os.clock()
	for character, entry in active do
		local t = now - entry.Started
		if t >= entry.Duration or entry.Humanoid.Health <= 0 or not character.Parent then
			stop(character)
			continue
		end
		local fade = math.min(t / FADE_IN, (entry.Duration - t) / FADE_OUT, 1)
		local w = fade * fade * (3 - 2 * fade) -- smoothstep
		local ok, pose = pcall(entry.Proc, t, w, entry.Duration)
		if not ok then
			stop(character)
			continue
		end
		for key, cframe in pose do
			local joint = entry.Joints[key]
			if joint and joint.Parent then
				joint.Transform = toTransform(joint, cframe)
				entry.Touched[joint] = true
			end
		end
		if entry.Tears and now >= entry.NextTear then
			entry.NextTear = now + 0.12
			local head = character:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				tear(head)
			end
		end
	end
end

-- Крупный эмодзи над головой на время эмоции
local function headEmoji(character: Model, face: string, duration: number): BillboardGui?
	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return nil
	end
	local gui = create("BillboardGui", {
		Name = "Emote",
		Adornee = head,
		Size = UDim2.fromOffset(80, 80),
		StudsOffsetWorldSpace = Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 120,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local label = UiKit.text({
		Text = face,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local pop = create("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(math.max(0, duration - 0.3), function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		end
	end)
	return gui
end

local function play(userId: number, emoteId: string)
	local emote = Config.GetEmote(emoteId)
	local who = Players:GetPlayerByUserId(userId)
	local character = who and who.Character
	if not emote or not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - root.Position).Magnitude > MAX_DISTANCE then
		return
	end

	stop(character)
	local duration = Config.EmoteDuration
	local proc = PROCS[emote.Proc]
	active[character] = {
		Character = character,
		Humanoid = humanoid,
		Joints = findJoints(character),
		Touched = {},
		Proc = proc or function()
			return {}
		end,
		Started = os.clock(),
		Duration = duration,
		Gui = headEmoji(character, emote.Face, duration),
		Tears = emote.Proc == "Cry",
		NextTear = 0,
	}
	if not stepConnection then
		stepConnection = RunService.PreSimulation:Connect(step)
	end
end

-- ===== Окно эмоций =====
local function isLocked(emote): boolean
	return emote.Pass ~= nil and not Util.bool(player, "Pass_" .. emote.Pass)
end

local function buildWindow(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("EmotesTitle"), Vector2.new(480, 340))
	window.Name = "EmotesWindow"
	ctx.Register("Emotes", window)

	local grid = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.new(0.25, -8, 0, 104),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2) }),
	})

	local cells = {}
	local lastEmoteAt = -math.huge
	for order, emote in Config.Emotes do
		local cell = UiKit.button({
			Text = "",
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
			Parent = grid,
		})
		UiKit.text({
			Text = emote.Face,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 8, 0, 6),
			Size = UDim2.new(1, -16, 0, 52),
			Parent = cell,
		})
		UiKit.text({
			Text = Locale.Name(emote),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 60),
			Size = UDim2.new(1, -8, 0, 20),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 8 }) })
		local lock = UiKit.text({
			Text = Locale.T("EmotePackLocked"),
			TextScaled = true,
			TextColor3 = COLORS.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 82),
			Size = UDim2.new(1, -8, 0, 16),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 7 }) })
		cells[emote.Id] = { Emote = emote, Cell = cell, Lock = lock }

		cell.Activated:Connect(function()
			if isLocked(emote) then
				Util.promptPass(emote.Pass, ctx.Toast)
				return
			end
			-- Перезарядку проверяет сервер; здесь только не спамим запросами
			local left = Config.EmoteCooldown - (os.clock() - lastEmoteAt)
			if left > 0 then
				ctx.Toast(Locale.T("EmoteWait", { Seconds = math.ceil(left) }), "error")
				return
			end
			lastEmoteAt = os.clock()
			Remotes:WaitForChild("Emote"):FireServer(emote.Id)
			window.Visible = false
		end)
	end

	local function render()
		for _, entry in cells do
			local locked = isLocked(entry.Emote)
			entry.Lock.Visible = locked
			entry.Cell.BackgroundColor3 = if locked then COLORS.Panel else COLORS.PanelLight
		end
	end
	local passes = {}
	for _, emote in Config.Emotes do
		if emote.Pass and not passes[emote.Pass] then
			passes[emote.Pass] = true
			player:GetAttributeChangedSignal("Pass_" .. emote.Pass):Connect(render)
		end
	end
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()
end

function Emotes.Start(ctx)
	buildWindow(ctx)
	task.spawn(function()
		Remotes:WaitForChild("Fx").OnClientEvent:Connect(function(kind, data)
			if kind ~= "Emote" or type(data) ~= "table" then
				return
			end
			if type(data.UserId) == "number" and type(data.Emote) == "string" then
				play(data.UserId, data.Emote)
			end
		end)
	end)
	-- Персонаж удалён (респаун/выход) — сразу чистим запись
	Players.PlayerRemoving:Connect(function(who)
		if who.Character then
			stop(who.Character)
		end
	end)
end

return Emotes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">FxExtra</string>
            <string name="Source"><![CDATA[-- Эффекты v3 по Remotes.Fx: выстрел турели ("Turret" {From, To}), вспышка лазерных ворот ("Laser"
-- {Position}), ледяная бомба ("Freeze" {Position, Radius}), ракетные ботинки ("Rocket" {Position}),
-- дальнее оружие ("Shot" {From, To, Item?}), старт админ-ивента ("AdminEvent" {Id} — большая заставка
-- по центру на 3 с) и мистери-бокс ("MysteryBox" {UserId, Meme}: себе — анимация открытия, другим — тост).
-- Всё локально, без звуков и текстур по ID; детали/конфетти — помощники из Effects.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local MAX_DISTANCE = 250
local MAX_TRACER = 120 -- длиннее не рисуем (защита от странных координат)
local TURRET_COLOR = Color3.fromRGB(255, 170, 40)
local LASER_COLOR = Color3.fromRGB(255, 40, 40)
local ICE_COLOR = Color3.fromRGB(150, 225, 255)
local FLAME_COLORS = { Color3.fromRGB(255, 200, 40), Color3.fromRGB(255, 120, 20), Color3.fromRGB(255, 60, 30) }
local CONFETTI_COLORS = {
	Color3.fromRGB(255, 80, 120),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(120, 255, 120),
	Color3.fromRGB(190, 110, 255),
}
-- Цвет трассера дальнего оружия по Id предмета (нет / неизвестно — белый)
local SHOT_COLORS: { [string]: { Color3 } } = {
	Snowball = { Color3.new(1, 1, 1), ICE_COLOR },
	ConfettiCannon = CONFETTI_COLORS,
}

local FxExtra = {}

local function near(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera == nil or (camera.CFrame.Position - position).Magnitude <= MAX_DISTANCE
end

local function isVector(value: any): boolean
	return typeof(value) == "Vector3" and value == value
end

-- Светящийся луч from -> to, который быстро тает
local function tracer(from: Vector3, to: Vector3, color: Color3, width: number, duration: number)
	local distance = (to - from).Magnitude
	if distance < 0.1 or distance > MAX_TRACER then
		return
	end
	local beam = Effects.Piece(from, Vector3.new(width, width, distance), color)
	beam.CFrame = CFrame.lookAt((from + to) / 2, to)
	beam.Transparency = 0.1
	TweenService:Create(beam, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Transparency = 1,
		Size = Vector3.new(width * 0.2, width * 0.2, distance),
	}):Play()
	Debris:AddItem(beam, duration + 0.1)
end

-- Снаряд-шарик летит from -> to и по прилёту вызывает onHit
local function projectile(from: Vector3, to: Vector3, color: Color3, size: number, speed: number, onHit: (() -> ())?)
	local distance = (to - from).Magnitude
	if distance > MAX_TRACER then
		return
	end
	local time = math.clamp(distance / speed, 0.05, 0.6)
	local ball = Effects.Piece(from, Vector3.one * size, color, Enum.PartType.Ball)
	TweenService:Create(ball, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.new(to) }):Play()
	task.delay(time, function()
		ball:Destroy()
		if onHit then
			onHit()
		end
	end)
end

local function onTurret(data)
	local from, to = data.From, data.To
	if not isVector(from) or not isVector(to) or not (near(from) or near(to)) then
		return
	end
	Effects.Flash(from, TURRET_COLOR, 3, 0.15)
	tracer(from, to, TURRET_COLOR, 0.25, 0.25)
	projectile(from, to, Color3.fromRGB(255, 240, 150), 0.7, 160, function()
		Effects.Flash(to, TURRET_COLOR, 5, 0.25)
		Effects.Confetti(to, { TURRET_COLOR, Color3.new(1, 1, 1) }, 10, 4)
	end)
end

local function onLaser(data)
	local position = data.Position
	if not isVector(position) or not near(position) then
		return
	end
	Effects.Flash(position, LASER_COLOR, 8, 0.35)
	-- Вертикальная красная полоса «сработал лазер»
	local pillar = Effects.Piece(position, Vector3.new(0.4, 10, 0.4), LASER_COLOR)
	pillar.Transparency = 0.1
	TweenService:Create(pillar, TweenInfo.new(0.4), { Transparency = 1, Size = Vector3.new(2.5, 10, 2.5) }):Play()
	Debris:AddItem(pillar, 0.5)
	Effects.Confetti(position, { LASER_COLOR, Color3.fromRGB(255, 150, 150) }, 12, 5)
end

local function onFreeze(data)
	local position = data.Position
	if not isVector(position) or not near(position) then
		return
	end
	local radius = if type(data.Radius) == "number" and data.Radius == data.Radius then math.clamp(data.Radius, 2, 40) else 14
	local sphere = Effects.Piece(position, Vector3.one * 2, ICE_COLOR, Enum.PartType.Ball)
	sphere.Material = Enum.Material.Glass
	sphere.Transparency = 0.35
	TweenService:Create(sphere, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * radius * 2,
	}):Play()
	TweenService:Create(sphere, TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 0.35), {
		Transparency = 1,
	}):Play()
	Debris:AddItem(sphere, 0.9)
	Effects.Flash(position, Color3.new(1, 1, 1), 6, 0.3)
	Effects.Confetti(position, { ICE_COLOR, Color3.new(1, 1, 1), Color3.fromRGB(200, 240, 255) }, 30, radius * 0.8)
end

local function onRocket(data)
	local position = data.Position
	if not isVector(position) or not near(position) then
		return
	end
	Effects.Flash(position, FLAME_COLORS[2], 6, 0.3)
	Effects.Confetti(position - Vector3.new(0, 1.5, 0), FLAME_COLORS, 22, 5)
	Effects.Confetti(position - Vector3.new(0, 2, 0), { Color3.fromRGB(90, 90, 90), Color3.fromRGB(150, 150, 150) }, 8, 3)
end

local function onShot(data)
	local from, to = data.From, data.To
	if not isVector(from) or not isVector(to) or not (near(from) or near(to)) then
		return
	end
	local colors = SHOT_COLORS[if type(data.Item) == "string" then data.Item else ""] or { Color3.new(1, 1, 1) }
	tracer(from, to, colors[1], 0.3, 0.3)
	projectile(from, to, colors[#colors], 0.8, 140, function()
		Effects.Flash(to, colors[1], 5, 0.25)
		Effects.Confetti(to, if #colors > 1 then colors else { colors[1], Color3.fromRGB(230, 230, 230) }, 18, 6)
	end)
end

-- ===== Экранные заставки =====
local function overlay(name: string): ScreenGui
	return create("ScreenGui", {
		Name = name,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 40,
		Parent = player:WaitForChild("PlayerGui"),
	})
end

local function bigLabel(parent: Instance, text: string, color: Color3, y: number, height: number): TextLabel
	return UiKit.text({
		Text = text,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, y),
		Size = UDim2.fromScale(0.85, height),
		Parent = parent,
	})
end

local function fadeOut(labels: { TextLabel }, after: number, duration: number)
	task.delay(after, function()
		for _, label in labels do
			if label.Parent then
				TweenService:Create(label, TweenInfo.new(duration), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end
	end)
end

local function popIn(label: GuiObject, delay: number)
	local scale = create("UIScale", { Scale = 0, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delay), { Scale = 1 }):Play()
end

-- Старт админ-ивента: эмодзи, «АДМИН-ИВЕНТ!», название и описание на 3 секунды
local function adminSplash(id: string)
	local event = Config.GetAdminEvent(id)
	if not event then
		return
	end
	local gui = overlay("AdminEventSplash")
	local band = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(1, 0.46),
		BackgroundColor3 = Color3.fromRGB(30, 10, 45),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	TweenService:Create(band, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local face = bigLabel(gui, event.Face, Color3.new(1, 1, 1), 0.27, 0.14)
	local header = bigLabel(gui, "⭐ " .. Locale.T("SplashAdminEvent") .. " ⭐", COLORS.Gold, 0.37, 0.06)
	local name = bigLabel(gui, Locale.Name(event), Color3.fromRGB(255, 120, 230), 0.46, 0.11)
	local desc = bigLabel(gui, if Locale.IsRussian and event.DescRu then event.DescRu else event.Desc, Color3.new(1, 1, 1), 0.57, 0.05)
	popIn(face, 0)
	popIn(header, 0.1)
	popIn(name, 0.2)
	popIn(desc, 0.35)
	local spin = TweenService:Create(face, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 12 })
	face.Rotation = -12
	spin:Play()
	fadeOut({ face, header, name, desc }, 2.6, 0.4)
	task.delay(2.6, function()
		TweenService:Create(band, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	end)
	Debris:AddItem(gui, 3.1)
end

-- Своё открытие мистери-бокса: коробка трясётся, вспышка, затем мем с редкостью
local function mysteryReveal(memeId: string)
	local creature = Config.GetCreature(memeId)
	if not creature then
		return
	end
	local rarity = Config.GetRarity(creature.Rarity)
	local gui = overlay("MysteryBoxReveal")
	local box = bigLabel(gui, "📦", Color3.new(1, 1, 1), 0.42, 0.22)
	popIn(box, 0)
	local shake = TweenService:Create(box, TweenInfo.new(0.07, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), { Rotation = 14 })
	box.Rotation = -14
	shake:Play()

	task.delay(1, function()
		shake:Cancel()
		box:Destroy()
		local flashFrame = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = rarity.Color,
			BackgroundTransparency = 0.2,
			BorderSizePixel = 0,
			Parent = gui,
		})
		TweenService:Create(flashFrame, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
		local you = bigLabel(gui, Locale.T("MysteryBoxYou"), Color3.new(1, 1, 1), 0.22, 0.05)
		local face = bigLabel(gui, creature.Face, Color3.new(1, 1, 1), 0.36, 0.2)
		local name = bigLabel(gui, creature.Name .. "!", COLORS.Gold, 0.52, 0.08)
		local rarityLabel = bigLabel(gui, Locale.Name(rarity), rarity.Color, 0.61, 0.06)
		rarityLabel.TextStrokeColor3 = Color3.new(1, 1, 1)
		popIn(you, 0)
		popIn(face, 0)
		popIn(name, 0.15)
		popIn(rarityLabel, 0.3)
		fadeOut({ you, face, name, rarityLabel }, 2.3, 0.5)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			Effects.Confetti(root.Position + Vector3.new(0, 3, 0), { rarity.Color, COLORS.Gold, Color3.new(1, 1, 1) }, 40, 10)
		end
	end)
	Debris:AddItem(gui, 4)
end

function FxExtra.Start(ctx)
	local handlers = {
		Turret = onTurret,
		Laser = onLaser,
		Freeze = onFreeze,
		Rocket = onRocket,
		Shot = onShot,
	}
	task.spawn(function()
		Remotes:WaitForChild("Fx").OnClientEvent:Connect(function(kind, data)
			if type(kind) ~= "string" or type(data) ~= "table" then
				return
			end
			local handler = handlers[kind]
			if handler then
				handler(data)
			elseif kind == "AdminEvent" and type(data.Id) == "string" then
				adminSplash(data.Id)
			elseif kind == "MysteryBox" and type(data.Meme) == "string" and Config.GetCreature(data.Meme) then
				if data.UserId == player.UserId then
					mysteryReveal(data.Meme)
				else
					local who = if type(data.UserId) == "number" then Players:GetPlayerByUserId(data.UserId) else nil
					ctx.Toast(Locale.T("MysteryBoxOther", { Player = if who then who.DisplayName else "?", Meme = data.Meme }), "info")
				end
			end
		end)
	end)
end

return FxExtra
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- HUD: деньги/доход/слоты/бонус друзей слева сверху, таймер подарка за игру и боковые кнопки в две
-- колонки: главная (Магазин, Мем-пропуск, Колесо, Награды дня, Квесты, Меню — со значками) и база
-- (Замок, Перерождение, Защита). Остальные окна (Предметы, Индекс, Скины, Эмоции, Обмен, Коды) и
-- приглашение друзей / группа — в меню «☰»: на телефоне кнопки не закрывают экран.
-- Всё рисуется из атрибутов игрока.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local DefenseWindow = require(script.Parent:WaitForChild("DefenseWindow"))
local PassWindow = require(script.Parent:WaitForChild("PassWindow"))
local QuestsWindow = require(script.Parent:WaitForChild("QuestsWindow"))
local Social = require(script.Parent:WaitForChild("Social"))
local SpinWindow = require(script.Parent:WaitForChild("SpinWindow"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local BUTTON = 56 -- размер боковой кнопки при масштабе 1 (на телефоне UIScale ~0.6)

local Hud = {}

-- Панель статистики слева сверху
local function buildStats(ctx)
	-- ScreenGui не игнорирует GuiInset, поэтому y = 8 — это уже под кнопками Roblox (~60 px от края)
	-- root без раскладки: в нём панель и всплывающие «+$X» рядом с ней
	local root = create("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(240, 120),
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	})
	ctx.Scale(root)
	local panel = create("Frame", {
		Name = "Panel",
		Size = UDim2.fromOffset(240, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.2,
		Parent = root,
	}, {
		UiKit.corner(12),
		UiKit.padding(8),
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local coins = UiKit.text({
		Name = "Coins",
		TextSize = 30,
		TextColor3 = COLORS.Gold,
		TextStrokeTransparency = 0.5,
		Size = UDim2.new(1, 0, 0, 36),
		LayoutOrder = 1,
		Parent = panel,
	})
	local coinsPop = create("UIScale", { Parent = coins })
	local income = UiKit.text({ TextSize = 20, TextColor3 = COLORS.Green, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 2, Parent = panel })
	local info = UiKit.text({ TextScaled = true, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 3, Parent = panel })
	create("UITextSizeConstraint", { MaxTextSize = 16, Parent = info })
	local gift = UiKit.text({ TextSize = 14, TextColor3 = COLORS.Muted, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 4, Parent = panel })

	-- Плавный счётчик денег
	local shown = create("NumberValue", { Value = Util.num(player, "Coins") })
	shown.Changed:Connect(function(value)
		coins.Text = "💰 $" .. Format.Number(value)
	end)
	coins.Text = "💰 $" .. Format.Number(shown.Value)

	-- Всплывающее «+$X» справа от панели (в root, вне UIListLayout)
	local function floatGain(amount: number)
		local start = UDim2.new(1, 6, 0, 12)
		local label = UiKit.text({
			Text = "+$" .. Format.Number(amount),
			TextSize = 22,
			TextColor3 = COLORS.Green,
			TextStrokeTransparency = 0.3,
			Position = start,
			Size = UDim2.fromOffset(120, 26),
			Parent = root,
		})
		local fade = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(label, fade, {
			Position = start - UDim2.fromOffset(0, 26),
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()
		task.delay(0.9, label.Destroy, label)
	end

	local lastCoins = Util.num(player, "Coins")
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		local value = Util.num(player, "Coins")
		local delta = value - lastCoins
		lastCoins = value
		TweenService:Create(shown, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Value = value }):Play()
		-- Первая загрузка данных — не «доход», без всплывающей цифры
		if delta > 0 and Util.bool(player, "DataLoaded") then
			coinsPop.Scale = 1.1
			TweenService:Create(coinsPop, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			floatGain(delta)
		end
	end)

	local function renderInfo()
		income.Text = Locale.T("UiIncome", { Coins = Util.num(player, "Income") })
		local count = Util.num(player, "IndexCount")
		info.Text = Locale.T("UiSlots", { Used = Util.num(player, "SlotsUsed"), Max = Util.num(player, "MaxSlots") })
			.. "   "
			.. Locale.T("UiRebirths", { Count = Util.num(player, "Rebirths") })
			.. "   "
			.. Locale.T("UiIndexBonus", { Percent = math.floor(count * Config.IndexBonusPerEntry * 100 + 0.5) })
		-- Бонус за друзей на сервере и группу
		local social = Social.BoostPercent()
		if social > 0 then
			info.Text ..= "   " .. Locale.T("UiSocialBoost", { Percent = social })
		end
	end
	for _, name in { "Income", "SlotsUsed", "MaxSlots", "Rebirths", "IndexCount", "FriendBoost", "InGroup" } do
		player:GetAttributeChangedSignal(name):Connect(renderInfo)
	end
	renderInfo()

	-- Подарок за время в игре: выдаёт сервер, клиент только считает время до следующего
	local function renderGift()
		local claimed = Util.num(player, "GiftsClaimed")
		local nextGift = Config.PlaytimeGifts[claimed + 1]
		local start = Util.num(player, "SessionStart")
		if not nextGift then
			gift.Text = Locale.T("UiGiftsDone")
		elseif start <= 0 then
			gift.Text = ""
		else
			local left = start + nextGift.Minutes * 60 - Util.now()
			gift.Text = Locale.T("UiGiftIn", { Time = Util.clock(left) })
		end
	end
	return renderGift
end

-- Боковая кнопка: эмодзи крупно + подпись. Возвращает (кнопка, подпись).
local function sideButton(parent: Instance, order: number, icon: string, caption: string): (TextButton, TextLabel)
	local button = UiKit.button({
		Text = "",
		Size = UDim2.fromOffset(BUTTON, BUTTON),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = parent,
	})
	create("UIStroke", { Color = COLORS.PanelLight, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = button })
	UiKit.text({
		Name = "Icon",
		Text = icon,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 3),
		Size = UDim2.new(1, -12, 0, 32),
		Parent = button,
	})
	local label = UiKit.text({
		Name = "Caption",
		Text = caption,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Position = UDim2.new(0, 2, 1, -19),
		Size = UDim2.new(1, -4, 0, 16),
		Parent = button,
	})
	create("UITextSizeConstraint", { MaxTextSize = 14, Parent = label })
	return button, label
end

-- Красный значок в правом верхнем углу кнопки: число или просто точка (text = "")
local function badge(button: GuiObject): TextLabel
	local label = UiKit.text({
		Name = "Badge",
		Text = "",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 0,
		BackgroundColor3 = COLORS.Red,
		ZIndex = 3,
		Visible = false,
		Parent = button,
	}, { UiKit.corner(10), create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 1.5 }) })
	return label
end

local function column(parent: Instance, order: number): Frame
	return create("Frame", {
		Size = UDim2.fromOffset(BUTTON, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

-- Меню «☰»: второстепенные окна плиткой + друзья и группа. Регистрируется как окно,
-- поэтому закрывается, когда открывается любое другое.
local function buildMenu(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("MenuTitle"), Vector2.new(400, 380))
	window.Name = "MenuWindow"
	ctx.Register("Menu", window)

	local scroll = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})

	local grid = create("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = scroll,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.new(1 / 3, -6, 0, 64),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local tiles = {
		{ Icon = "🗡️", Caption = "BtnItems", Window = "Items" },
		{ Icon = "📖", Caption = "BtnIndex", Window = "Index" },
		{ Icon = "🎨", Caption = "BtnSkins", Window = "Skins" },
		{ Icon = "😀", Caption = "BtnEmotes", Window = "Emotes" },
		{ Icon = "🤝", Caption = "BtnTrade", Window = "TradePick" },
		{ Icon = "🎟️", Caption = "BtnCodes", Window = "Codes" },
	}
	for order, tile in tiles do
		local button = sideButton(grid, order, tile.Icon, Locale.T(tile.Caption))
		button.Activated:Connect(function()
			ctx.Open(tile.Window, true)
		end)
	end

	-- Друзья: приглашение + подсказка про бонус
	local invite = UiKit.button({
		Text = Locale.T("SocialInvite"),
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = COLORS.Green,
		LayoutOrder = 2,
		Parent = scroll,
	})
	create("UITextSizeConstraint", { MaxTextSize = 20, Parent = invite })
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = invite })
	UiKit.text({
		Text = Locale.T("SocialInviteHint", {
			Per = math.floor(Config.Social.FriendBoostPer * 100 + 0.5),
			Max = math.floor(Config.Social.FriendBoostMax * 100 + 0.5),
		}),
		TextScaled = true,
		TextWrapped = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 3,
		Parent = scroll,
	}, { create("UITextSizeConstraint", { MaxTextSize = 14 }) })
	invite.Activated:Connect(function()
		Social.Invite(ctx.Toast)
	end)

	-- Группа: кнопка только если GroupId задан и игрок ещё не в группе
	local group = UiKit.button({
		Text = Locale.T("SocialJoinGroup", { Percent = math.floor(Config.Social.GroupBoost * 100 + 0.5) }),
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = COLORS.Purple,
		LayoutOrder = 4,
		Parent = scroll,
	})
	create("UITextSizeConstraint", { MaxTextSize = 20, Parent = group })
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = group })
	group.Activated:Connect(Social.JoinGroup)
	local function renderGroup()
		group.Visible = Social.CanJoinGroup()
	end
	player:GetAttributeChangedSignal("InGroup"):Connect(renderGroup)
	renderGroup()
end

function Hud.Start(ctx)
	local renderGift = buildStats(ctx)
	buildMenu(ctx)

	-- Кнопки слева по центру, две колонки: главное (с значками) и база (замок, перерождение, защита).
	-- Остальное — в меню «☰», чтобы на телефоне кнопки не закрывали экран.
	local side = create("Frame", {
		Name = "SideButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.55, 0),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	ctx.Scale(side)
	local main = column(side, 1)
	local extra = column(side, 2)

	local shop = sideButton(main, 1, "🛒", Locale.T("BtnShop"))
	local pass = sideButton(main, 2, "🎫", Locale.T("BtnPass"))
	local spin = sideButton(main, 3, "🎡", Locale.T("BtnSpin"))
	local daily = sideButton(main, 4, "📅", Locale.T("BtnDaily"))
	local quests = sideButton(main, 5, "📜", Locale.T("BtnQuests"))
	local menu = sideButton(main, 6, "☰", Locale.T("BtnMenu"))

	local lock, lockCaption = sideButton(extra, 1, "🔒", Locale.T("BtnLock"))
	local rebirth, rebirthCaption = sideButton(extra, 2, "♻️", Locale.T("BtnRebirth"))
	local guard, guardCaption = sideButton(extra, 3, "🛡️", Locale.T("BtnDefense"))
	local lockIcon = lock:FindFirstChild("Icon") :: TextLabel

	local passBadge = badge(pass)
	local spinBadge = badge(spin)
	local dailyBadge = badge(daily)
	local questsBadge = badge(quests)

	local opens = { [shop] = "Shop", [pass] = "Pass", [spin] = "Spin", [daily] = "Daily", [quests] = "Quests", [menu] = "Menu" }
	for button, name in opens do
		button.Activated:Connect(function()
			ctx.Open(name)
		end)
	end

	local function setBadge(label: TextLabel, button: TextButton, count: number)
		label.Visible = count > 0
		label.Text = if count > 0 then tostring(count) else ""
		button.BackgroundColor3 = if count > 0 then COLORS.Purple else COLORS.Panel
	end

	local function renderBadges()
		setBadge(dailyBadge, daily, if Util.bool(player, "DailyReady") then 1 else 0)
		dailyBadge.Text = ""
		setBadge(questsBadge, quests, QuestsWindow.ClaimableCount())
		setBadge(passBadge, pass, PassWindow.ClaimableCount())
		setBadge(spinBadge, spin, SpinWindow.Available())
	end
	local badgeAttributes = { "DailyReady", "QuestsJson" }
	for _, list in { PassWindow.Attributes, SpinWindow.Attributes } do
		for _, name in list do
			table.insert(badgeAttributes, name)
		end
	end
	for _, name in badgeAttributes do
		player:GetAttributeChangedSignal(name):Connect(renderBadges)
	end
	renderBadges()

	shop.BackgroundColor3 = COLORS.Green
	rebirth.Activated:Connect(function()
		ctx.Open("Rebirth")
	end)
	guard.Activated:Connect(function()
		ctx.Open("Defense")
	end)
	lock.Activated:Connect(function()
		-- Можно ли закрыть — решает сервер (он же пришлёт Notify с причиной)
		Remotes:WaitForChild("LockBase"):FireServer()
	end)

	-- Подпись «Перерождения» — прогресс в процентах (короткая цель всегда на экране)
	local function renderRebirth()
		local progress = Util.num(player, "Coins") / Config.RebirthCost(Util.num(player, "Rebirths"))
		rebirthCaption.Text = math.floor(math.clamp(progress, 0, 1) * 100) .. "%"
		rebirth.BackgroundColor3 = if progress >= 1 then COLORS.Purple else COLORS.Panel
	end

	-- Подпись «Защиты» — цена самой дешёвой следующей прокачки (страж, турель, лазер)
	local function renderGuard()
		local price = DefenseWindow.CheapestPrice()
		guardCaption.Text = if price then "$" .. Format.Number(price) else Locale.T("BtnMax")
	end

	player:GetAttributeChangedSignal("Coins"):Connect(renderRebirth)
	player:GetAttributeChangedSignal("Rebirths"):Connect(renderRebirth)
	for _, name in DefenseWindow.Attributes do
		player:GetAttributeChangedSignal(name):Connect(renderGuard)
	end
	renderRebirth()
	renderGuard()

	-- Замок базы: таймер из атрибутов своей базы
	local function renderLock()
		local plot = Util.myPlot()
		local now = Util.now()
		local lockedLeft = Util.num(plot, "LockedUntil") - now
		local cooldownLeft = Util.num(plot, "LockCooldownUntil") - now
		if lockedLeft > 0 then
			lockIcon.Text = "🔒"
			lockCaption.Text = Util.clock(lockedLeft)
			lock.BackgroundColor3 = COLORS.Green
		elseif cooldownLeft > 0 then
			lockIcon.Text = "⏳"
			lockCaption.Text = Util.clock(cooldownLeft)
			lock.BackgroundColor3 = COLORS.PanelLight
		else
			lockIcon.Text = "🔓"
			lockCaption.Text = Locale.T("BtnLock")
			lock.BackgroundColor3 = COLORS.Panel
		end
	end

	task.spawn(function()
		while true do
			renderLock()
			renderGift()
			task.wait(0.25)
		end
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">IndexWindow</string>
            <string name="Source"><![CDATA[-- Окно Индекса: сетка всех мемов из Config.Creatures. Открытые — цветные, закрытые — «???».
-- Источник — атрибут игрока IndexJson (JSON-массив ключей "Id|Mutation", см. Config.IndexKey).
-- Лимитные мемы помечены «Лимитный» («На этой неделе!» — мем недели WeeklyMeme), эксклюзивы —
-- «Только пропуск / колесо».
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local UNKNOWN_BG = Color3.fromRGB(14, 15, 22)
local CELL_HEIGHT = 132
local GAP = 8
local SEASON_TAGS = { Halloween = "IndexSeasonHalloween", Winter = "IndexSeasonWinter" }

local IndexWindow = {}

-- Множество открытых ключей; битый или пустой JSON -> пустое множество
local function discoveredSet(): { [string]: boolean }
	local set = {}
	local raw = Util.str(player, "IndexJson")
	if raw == "" then
		return set
	end
	local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(list) == "table" then
		for _, key in list do
			if type(key) == "string" then
				set[key] = true
			end
		end
	end
	return set
end

-- Текст цвета редкости; у «Секретного» цвет почти чёрный — рисуем белым с тёмной обводкой
local function paintRarity(label: TextLabel, rarityId: string)
	local rarity = Config.GetRarity(rarityId)
	if rarityId == "Secret" then
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = 0
	else
		label.TextColor3 = rarity.Color
		label.TextStrokeTransparency = 0.6
	end
	label.Text = Locale.Name(rarity)
end

function IndexWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("IndexTitle"), Vector2.new(720, 480))
	window.Name = "IndexWindow"
	ctx.Register("Index", window)

	local header = UiKit.text({
		Text = "",
		TextSize = 18,
		TextColor3 = COLORS.Gold,
		Size = UDim2.new(1, 0, 0, 24),
		Parent = body,
	})
	local sub = UiKit.text({
		Text = "",
		TextSize = 14,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = body,
	})

	local grid = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 6) }),
	})
	local layout = create("UIGridLayout", {
		CellPadding = UDim2.fromOffset(GAP, GAP),
		CellSize = UDim2.fromOffset(110, CELL_HEIGHT),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	-- Число колонок по ширине: 2 на узком телефоне, до 6 на ПК
	local function relayout()
		local width = grid.AbsoluteSize.X - 10
		if width <= 0 then
			return
		end
		local columns = math.clamp(math.floor((width + GAP) / (110 + GAP)), 2, 6)
		layout.CellSize = UDim2.fromOffset(math.floor((width - GAP * (columns - 1)) / columns), CELL_HEIGHT)
	end
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
	relayout()

	-- Ячейки создаются один раз, render() только перекрашивает
	local cells = {}
	for order, creature in Config.Creatures do
		local cell = create("Frame", {
			BackgroundColor3 = UNKNOWN_BG,
			LayoutOrder = order,
			Parent = grid,
		}, { UiKit.corner(10) })
		local stroke = create("UIStroke", { Thickness = 2, Color = COLORS.PanelLight, Parent = cell })
		local face = UiKit.text({
			Text = "❓",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 6, 0, 6),
			Size = UDim2.new(1, -12, 0, 46),
			Parent = cell,
		})
		local name = UiKit.text({
			Text = "",
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 56),
			Size = UDim2.new(1, -8, 0, 32),
			Parent = cell,
		})
		create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 9, Parent = name })
		local rarity = UiKit.text({
			Text = "",
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 88),
			Size = UDim2.new(1, -8, 0, 16),
			Parent = cell,
		})
		-- Точки открытых мутаций (цвет мутации) + пометка «только ночью» для сезонных
		local extra = UiKit.text({
			Text = "",
			RichText = true,
			TextSize = 13,
			TextColor3 = COLORS.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 106),
			Size = UDim2.new(1, -8, 0, 18),
			Parent = cell,
		})
		cells[creature.Id] = {
			Creature = creature,
			Frame = cell,
			Stroke = stroke,
			Face = face,
			Name = name,
			Rarity = rarity,
			Extra = extra,
		}
	end

	local function render()
		local set = discoveredSet()
		local weeklyId = Util.str(ReplicatedStorage, "WeeklyMeme")
		local found, mutated = 0, 0
		for _, cell in cells do
			local creature = cell.Creature
			local known = set[Config.IndexKey(creature.Id, "None")] == true

			-- Открытые мутации этого вида
			local dots = {}
			for _, mutation in Config.Mutations do
				if mutation.Id ~= "None" and set[Config.IndexKey(creature.Id, mutation.Id)] then
					mutated += 1
					known = true -- вид встречен хотя бы в мутации — тоже считаем открытым
					local c = mutation.Color or COLORS.Text
					table.insert(dots, '<font color="#' .. c:ToHex() .. '">●</font>')
				end
			end
			if known then
				found += 1
			end

			local rarityColor = Config.GetRarity(creature.Rarity).Color
			cell.Frame.BackgroundColor3 = if known then COLORS.PanelLight else UNKNOWN_BG
			cell.Stroke.Color = if known then rarityColor else COLORS.PanelLight
			cell.Face.Text = if known then creature.Face else "❓"
			cell.Face.TextTransparency = if known then 0 else 0.5
			cell.Name.Text = if known then Locale.Name(creature) else Locale.T("IndexUnknown")
			cell.Name.TextColor3 = if known then COLORS.Text else COLORS.Muted
			paintRarity(cell.Rarity, creature.Rarity)
			if creature.Limited or creature.Rarity == "Limited" then
				cell.Extra.Text = Locale.T(if creature.Id == weeklyId then "IndexLimitedNow" else "IndexLimited")
				cell.Extra.TextColor3 = Config.GetRarity("Limited").Color
			elseif creature.Exclusive or creature.Rarity == "Exclusive" then
				cell.Extra.Text = Locale.T("IndexExclusive")
				cell.Extra.TextColor3 = Config.GetRarity("Exclusive").Color
			elseif #dots > 0 then
				cell.Extra.Text = table.concat(dots, " ")
			elseif creature.Event then
				-- Сезонные: «Ночь Хэллоуина» / «Зимняя ночь», без сезона — просто «Только ночью»
				cell.Extra.Text = Locale.T(SEASON_TAGS[creature.Season or ""] or "IndexEvent")
			else
				cell.Extra.Text = ""
			end
		end

		local count = Util.num(player, "IndexCount")
		header.Text = Locale.T("IndexHeader", {
			Count = count,
			Percent = math.floor(count * Config.IndexBonusPerEntry * 100 + 0.5),
		})
		sub.Text = Locale.T("IndexSub", { Found = found, Total = #Config.Creatures, Mutated = mutated })
	end

	player:GetAttributeChangedSignal("IndexJson"):Connect(render)
	player:GetAttributeChangedSignal("IndexCount"):Connect(render)
	ReplicatedStorage:GetAttributeChangedSignal("WeeklyMeme"):Connect(render)
	render()
end

return IndexWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Items</string>
            <string name="Source"><![CDATA[-- Окно предметов: оружие и гаджеты из Config.Items, покупка за монеты навсегда.
-- Купленные — атрибут игрока ItemsJson (JSON-массив Id). Покупку проверяет и выдаёт сервер
-- (Remotes.BuyItem), клиент только просит и показывает ответ.
-- Предметы с Pass (Confetti Cannon) за монеты не продаются: кнопка показывает цену геймпасса
-- Config.GamePasses[item.Pass] и открывает его покупку; куплено — атрибут "Pass_" .. item.Pass.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ROW_HEIGHT = 86

local Items = {}

-- Множество купленных Id; нет атрибута или битый JSON -> только Тапок (он есть всегда)
local function ownedSet(): { [string]: boolean }
	local set = { Slipper = true }
	local raw = Util.str(player, "ItemsJson")
	if raw == "" then
		return set
	end
	local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(list) == "table" then
		for _, id in list do
			if type(id) == "string" then
				set[id] = true
			end
		end
	end
	return set
end

local function isOwned(item, owned: { [string]: boolean }): boolean
	return owned[item.Id] == true or (item.Pass ~= nil and Util.bool(player, "Pass_" .. item.Pass))
end

local function statsText(item): string
	if item.Kind == "Weapon" then
		local text = Locale.T("ItemStatsWeapon", { Range = item.Range, Cooldown = item.Cooldown, Stun = item.Stun or 0 })
		if item.Area then
			text ..= " · " .. Locale.T("ItemArea")
		end
		return text
	end
	return Locale.T("ItemStatsGadget", { Duration = item.Duration or 0, Cooldown = item.Cooldown or 0 })
end

function Items.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("ItemsTitle"), Vector2.new(580, 480))
	window.Name = "ItemsWindow"
	ctx.Register("Items", window)

	local list = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function section(key: string)
		UiKit.text({
			Text = Locale.T(key),
			TextSize = 18,
			TextColor3 = COLORS.Gold,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = nextOrder(),
			Parent = list,
		})
	end

	-- Строки создаются один раз, render() только перекрашивает кнопки
	local rows = {}
	local busy = false

	local function row(item)
		local frame = create("Frame", {
			Name = item.Id,
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = nextOrder(),
			Parent = list,
		}, { UiKit.corner(10) })
		UiKit.text({
			Text = item.Face,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(6, 13),
			Size = UDim2.fromOffset(60, 60),
			Parent = frame,
		})
		local name = UiKit.text({
			Text = Locale.Name(item),
			TextScaled = true,
			Position = UDim2.fromOffset(72, 4),
			Size = UDim2.new(1, -200, 0, 26),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10, Parent = name })
		local desc = UiKit.text({
			Text = if Locale.IsRussian and item.DescRu then item.DescRu else item.Desc or "",
			TextScaled = true,
			TextWrapped = true,
			Font = Enum.Font.Gotham,
			TextColor3 = COLORS.Text,
			Position = UDim2.fromOffset(72, 30),
			Size = UDim2.new(1, -200, 0, 32),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 9, Parent = desc })
		local stats = UiKit.text({
			Text = statsText(item),
			TextScaled = true,
			TextColor3 = COLORS.Muted,
			Position = UDim2.fromOffset(72, 62),
			Size = UDim2.new(1, -200, 0, 18),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8, Parent = stats })
		local buy = UiKit.button({
			Text = "",
			TextSize = 18,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(116, 46),
			BackgroundColor3 = COLORS.Green,
			Parent = frame,
		})

		-- Пометка «геймпасс за Robux» над кнопкой
		if item.Pass then
			UiKit.text({
				Text = "🎟️ " .. Locale.T("ItemRobuxPass"),
				TextScaled = true,
				TextColor3 = COLORS.Gold,
				TextXAlignment = Enum.TextXAlignment.Center,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 3),
				Size = UDim2.fromOffset(116, 14),
				Parent = frame,
			}, { create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 7 }) })
			buy.Position = UDim2.new(1, -8, 0.5, 6)
		end

		buy.Activated:Connect(function()
			if busy or isOwned(item, ownedSet()) then
				return
			end
			if item.Pass then
				Util.promptPass(item.Pass, ctx.Toast)
				return
			end
			busy = true
			local ok, success, key = pcall(function()
				return Remotes:WaitForChild("BuyItem"):InvokeServer(item.Id)
			end)
			busy = false
			if ok and type(key) == "string" then
				ctx.Toast(Locale.T(key, { Price = item.Price }), if success then "success" else "error")
			end
		end)

		rows[item.Id] = { Item = item, Button = buy }
	end

	local function render()
		local owned = ownedSet()
		local coins = Util.num(player, "Coins")
		for _, entry in rows do
			local item, buy = entry.Item, entry.Button
			local pass = item.Pass and Config.GamePasses[item.Pass]
			if isOwned(item, owned) then
				buy.Text = Locale.T("ShopOwned")
				buy.TextColor3 = COLORS.Muted
				buy.BackgroundColor3 = COLORS.Panel
				buy.AutoButtonColor = false
			elseif item.Pass then
				buy.Text = if pass then "R$ " .. pass.Robux else "R$"
				buy.TextColor3 = COLORS.Text
				buy.BackgroundColor3 = COLORS.Purple
				buy.AutoButtonColor = true
			else
				local affordable = coins >= item.Price
				buy.Text = if item.Price > 0 then "$" .. Format.Number(item.Price) else Locale.T("ItemFree")
				-- Не хватает денег — цена красным, кнопка тусклая (решает всё равно сервер)
				buy.TextColor3 = if affordable then COLORS.Text else COLORS.Red
				buy.BackgroundColor3 = if affordable then COLORS.Green else COLORS.Panel
				buy.AutoButtonColor = true
			end
		end
	end

	local groups = {
		{ Kind = "Weapon", Title = "ItemsWeapons" },
		{ Kind = "Gadget", Title = "ItemsGadgets" },
	}
	for _, group in groups do
		section(group.Title)
		for _, item in Config.Items do
			if item.Kind == group.Kind then
				row(item)
			end
		end
	end

	player:GetAttributeChangedSignal("ItemsJson"):Connect(render)
	for _, item in Config.Items do
		if item.Pass then
			player:GetAttributeChangedSignal("Pass_" .. item.Pass):Connect(render)
		end
	end
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()
end

return Items
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">MemeBillboards</string>
            <string name="Source"><![CDATA[-- Таблички над мемами (тег "Meme"): мутация, ВИРУСНЫЙ, имя, редкость, доход/сек, цена на дорожке.
-- BillboardGui создаются локально в PlayerGui и привязываются к Body (Adornee), поэтому
-- переживают стриминг: Body ушёл — табличка пустая, вернулся — снова привязываем.
-- Редкость «Лимит» пульсирует (мем недели), цвета Limited/Exclusive — из Config.Rarities.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local VIRAL_COLOR = Color3.fromRGB(255, 80, 220)
local MAX_DISTANCE = 60
local PULSE = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local PULSE_RARITIES = { Limited = true }

local MemeBillboards = {}

type Entry = {
	Model: Instance,
	Gui: BillboardGui,
	Tags: TextLabel,
	Name: TextLabel,
	Rarity: TextLabel,
	Income: TextLabel,
	Price: TextLabel,
	Pulse: Tween?,
}
local entries: { [Instance]: Entry } = {}

local function row(parent: Instance, order: number, height: number, textSize: number): TextLabel
	return UiKit.text({
		Text = "",
		RichText = true,
		TextSize = textSize,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.2,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = order,
		Parent = parent,
	})
end

local function render(entry: Entry)
	local model = entry.Model
	local id = Util.str(model, "CreatureId")
	local creature = Config.GetCreature(id)
	local mutation = Config.GetMutation(Util.str(model, "Mutation"))
	local viral = Util.bool(model, "Viral")
	local state = Util.str(model, "State")

	-- Мутация (цветом) и значок ВИРУСНЫЙ
	local tags = {}
	if mutation.Id ~= "None" then
		local color = mutation.Color or COLORS.Text
		table.insert(tags, '<font color="#' .. color:ToHex() .. '">' .. Locale.Name(mutation) .. "</font>")
	end
	if viral then
		table.insert(tags, '<font color="#' .. VIRAL_COLOR:ToHex() .. '">🔥 ' .. Locale.T("BbViral") .. "</font>")
	end
	entry.Tags.Text = table.concat(tags, "  ")
	entry.Tags.Visible = #tags > 0

	entry.Name.Text = if creature then Locale.Name(creature) else id

	-- Редкость; «Секретный» почти чёрный — белый текст с тёмной обводкой
	local rarityId = if creature then creature.Rarity else "Common"
	local rarity = Config.GetRarity(rarityId)
	entry.Rarity.Text = Locale.Name(rarity)
	if rarityId == "Secret" then
		entry.Rarity.TextColor3 = Color3.new(1, 1, 1)
		entry.Rarity.TextStrokeColor3 = Color3.new(0, 0, 0)
		entry.Rarity.TextStrokeTransparency = 0
	else
		entry.Rarity.TextColor3 = rarity.Color
		entry.Rarity.TextStrokeColor3 = Color3.new(0, 0, 0)
		entry.Rarity.TextStrokeTransparency = 0.2
	end
	-- Пульсация подписи редкости (один бесконечный твин на табличку)
	if PULSE_RARITIES[rarityId] and not entry.Pulse then
		local scale = create("UIScale", { Parent = entry.Rarity })
		entry.Pulse = TweenService:Create(scale, PULSE, { Scale = 1.25 })
		entry.Pulse:Play()
	end

	-- Доход/сек: базовый × тренд (без личных множителей игрока)
	local income = Config.BaseIncome(id, mutation.Id, viral)
	local trending = id ~= "" and Util.str(ReplicatedStorage, "TrendingId") == id
	if trending then
		income *= Config.Trend.Mult
	end
	local incomeText = Locale.T("BbIncome", { Coins = income })
	entry.Income.Text = if trending then "📈 " .. incomeText else incomeText
	entry.Income.TextColor3 = if trending then COLORS.Gold else COLORS.Green

	-- Цена — только на дорожке: зелёная, если хватает денег, иначе красная
	local price = Util.num(model, "Price")
	local onCarpet = state == "Carpet" and Util.num(model, "OwnerUserId") == 0 and price > 0
	entry.Price.Visible = onCarpet
	if onCarpet then
		entry.Price.Text = "$" .. Format.Number(price)
		entry.Price.TextColor3 = if Util.num(player, "Coins") >= price then COLORS.Green else COLORS.Red
	end

	-- Высота таблички — над макушкой модели
	local body = entry.Gui.Adornee
	local height = Util.num(model, "Height")
	if height <= 0 and body and body:IsA("BasePart") then
		height = body.Size.Y
	end
	entry.Gui.StudsOffsetWorldSpace = Vector3.new(0, height / 2 + 0.8, 0)
end

local function track(model: Instance): () -> ()
	local folder = player:WaitForChild("PlayerGui"):FindFirstChild("MemeBillboards")
	local gui = create("BillboardGui", {
		Name = "Meme",
		Size = UDim2.fromOffset(200, 112),
		SizeOffset = Vector2.new(0, 0.5), -- нижний край таблички на точке привязки
		MaxDistance = MAX_DISTANCE,
		LightInfluence = 0,
		ResetOnSpawn = false,
		ClipsDescendants = false,
	})
	local list = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		create("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local entry: Entry = {
		Model = model,
		Gui = gui,
		Tags = row(list, 1, 18, 15),
		Name = row(list, 2, 24, 20),
		Rarity = row(list, 3, 18, 15),
		Income = row(list, 4, 20, 17),
		Price = row(list, 5, 24, 21),
	}
	entry.Name.TextColor3 = COLORS.Text
	entry.Name.TextStrokeTransparency = 0
	entry.Price.TextStrokeTransparency = 0
	entries[model] = entry

	local connections: { RBXScriptConnection } = {}
	local function adorn()
		gui.Adornee = Util.mainPart(model)
		render(entry)
	end
	adorn()
	gui.Parent = folder

	-- StreamingEnabled: Body может прийти позже (или заново после выгрузки)
	table.insert(connections, model.ChildAdded:Connect(function(child)
		if child.Name == "Body" or (not gui.Adornee and child:IsA("BasePart")) then
			adorn()
		end
	end))
	table.insert(connections, model.AttributeChanged:Connect(function()
		render(entry)
	end))

	return function()
		entries[model] = nil
		if entry.Pulse then
			entry.Pulse:Cancel()
		end
		for _, connection in connections do
			connection:Disconnect()
		end
		gui:Destroy()
	end
end

local function renderAll()
	for _, entry in entries do
		render(entry)
	end
end

function MemeBillboards.Start()
	create("Folder", { Name = "MemeBillboards", Parent = player:WaitForChild("PlayerGui") })

	ReplicatedStorage:GetAttributeChangedSignal("TrendingId"):Connect(renderAll)
	-- Цвет цены зависит от денег игрока
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		for _, entry in entries do
			if entry.Price.Visible then
				local price = Util.num(entry.Model, "Price")
				entry.Price.TextColor3 = if Util.num(player, "Coins") >= price then COLORS.Green else COLORS.Red
			end
		end
	end)

	Util.watchTagged("Meme", track)
end

return MemeBillboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">PassWindow</string>
            <string name="Source"><![CDATA[-- Окно Мем-пропуска (боевой пропуск сезона). Источник — атрибут игрока BPJson:
-- { Season, Xp, Level, XpInLevel, Free = { забранные уровни }, Premium = { ... }, EndsAt }.
-- Уровни и награды — Config.BattlePass.Levels; премиум-ряд — с геймпассом BattlePass (Pass_BattlePass).
-- Забрать — Remotes.ClaimPass(level, "Free" | "Premium"); награду выдаёт сервер (Popup "Pass").
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local BP = Config.BattlePass
local COLUMN_WIDTH = 112
local GAP = 8
local PREMIUM_COLOR = Color3.fromRGB(255, 200, 50)
local PREMIUM_BG = Color3.fromRGB(60, 48, 24)
local TRACKS = { "Free", "Premium" }

local PassWindow = {}

type Data = { Level: number, XpInLevel: number, EndsAt: number, Free: { [number]: boolean }, Premium: { [number]: boolean } }

local function levelSet(list: any): { [number]: boolean }
	local set = {}
	if type(list) == "table" then
		for _, level in list do
			if type(level) == "number" then
				set[level] = true
			end
		end
	end
	return set
end

-- Разобрать BPJson; нет данных — уровень 0
function PassWindow.Read(): Data
	local raw = Util.json(player, "BPJson")
	if type(raw) ~= "table" then
		raw = {}
	end
	return {
		Level = math.clamp(if type(raw.Level) == "number" then raw.Level else 0, 0, #BP.Levels),
		XpInLevel = if type(raw.XpInLevel) == "number" then raw.XpInLevel else 0,
		EndsAt = if type(raw.EndsAt) == "number" and raw.EndsAt > 0 then raw.EndsAt else BP.EndsAt,
		Free = levelSet(raw.Free),
		Premium = levelSet(raw.Premium),
	}
end

local function claimable(data: Data, level: number, track: string): boolean
	if level > data.Level then
		return false
	end
	if track == "Premium" then
		return Util.bool(player, "Pass_BattlePass") and not data.Premium[level]
	end
	return not data.Free[level]
end

-- Сколько наград можно забрать прямо сейчас (значок на кнопке HUD)
function PassWindow.ClaimableCount(): number
	local data = PassWindow.Read()
	local count = 0
	for level = 1, data.Level do
		for _, track in TRACKS do
			if claimable(data, level, track) then
				count += 1
			end
		end
	end
	return count
end

PassWindow.Attributes = { "BPJson", "Pass_BattlePass" }

function PassWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("PassTitle"), Vector2.new(780, 470))
	window.Name = "PassWindow"
	ctx.Register("Pass", window)

	-- Шапка: сезон и сколько осталось
	local season = UiKit.text({
		Text = Locale.Name(BP),
		TextScaled = true,
		TextColor3 = COLORS.Gold,
		Size = UDim2.new(0.6, 0, 0, 22),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 18 }) })
	season.Name = "Season"
	local endsIn = UiKit.text({
		TextScaled = true,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, 0, 0, 22),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15 }) })

	-- Уровень и полоса XP текущего уровня
	local levelLabel = UiKit.text({
		TextScaled = true,
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(0, 130, 0, 22),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 18 }) })
	local bar = create("Frame", {
		Position = UDim2.fromOffset(136, 29),
		Size = UDim2.new(1, -136, 0, 18),
		BackgroundColor3 = COLORS.PanelLight,
		Parent = body,
	}, { UiKit.corner(8) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = COLORS.Purple,
		Parent = bar,
	}, { UiKit.corner(8) })
	local barText = UiKit.text({
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bar,
	})
	UiKit.text({
		Text = Locale.T("PassXpHint"),
		TextScaled = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 13 }) })

	-- Кнопки покупки снизу: премиум (геймпасс) и +5 уровней (продукт)
	local footer = create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local premiumButton = UiKit.button({
		Text = Locale.T("PassUnlockPremium", { Robux = Config.GamePasses.BattlePass.Robux }),
		TextScaled = true,
		Size = UDim2.new(0.55, -4, 1, 0),
		BackgroundColor3 = Color3.fromRGB(200, 140, 20),
		LayoutOrder = 1,
		Parent = footer,
	})
	create("UITextSizeConstraint", { MaxTextSize = 18, Parent = premiumButton })
	create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = premiumButton })
	local levelsProduct = Config.Products.PassLevels
	local levelsButton = UiKit.button({
		Text = Locale.T("PassBuyLevels", { Count = levelsProduct.Levels or 5, Robux = levelsProduct.Robux }),
		TextScaled = true,
		Size = UDim2.new(0.45, -4, 1, 0),
		BackgroundColor3 = COLORS.Purple,
		LayoutOrder = 2,
		Parent = footer,
	})
	create("UITextSizeConstraint", { MaxTextSize = 18, Parent = levelsButton })
	create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = levelsButton })

	premiumButton.Activated:Connect(function()
		if not Util.bool(player, "Pass_BattlePass") then
			Util.promptPass("BattlePass", ctx.Toast)
		end
	end)
	levelsButton.Activated:Connect(function()
		Rewards.promptProduct("PassLevels", ctx.Toast)
	end)

	-- Лента уровней: колонка на уровень (номер, бесплатная клетка, премиум-клетка), прокрутка по X
	local strip = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -72 - 52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.fromScale(0, 1), -- высота холста = высота ленты, колонки тянутся по ней
		ScrollingDirection = Enum.ScrollingDirection.X,
		Parent = body,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, GAP),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		create("UIPadding", { PaddingBottom = UDim.new(0, 10) }),
	})

	local current: Data = PassWindow.Read()
	local busy = false
	local function claim(level: number, track: string)
		if busy then
			return
		end
		if track == "Premium" and not Util.bool(player, "Pass_BattlePass") then
			Util.promptPass("BattlePass", ctx.Toast)
			return
		end
		if not claimable(current, level, track) then
			return
		end
		busy = true
		local success, key = Rewards.invoke("ClaimPass", level, track)
		busy = false
		-- Успех показывает всплывающее окно с наградой; ошибку — тостом
		if not success and type(key) == "string" then
			ctx.Toast(Locale.T(key), "error")
		end
	end

	-- Клетка награды: иконка, подпись, кнопка состояния
	local function cell(parent: Instance, order: number, reward: any, premium: boolean)
		local frame = create("Frame", {
			Size = UDim2.new(1, 0, 0.5, -16),
			BackgroundColor3 = if premium then PREMIUM_BG else COLORS.PanelLight,
			LayoutOrder = order,
			Parent = parent,
		}, { UiKit.corner(10) })
		local stroke = create("UIStroke", {
			Color = if premium then PREMIUM_COLOR else COLORS.PanelLight,
			Thickness = 2,
			Parent = frame,
		})
		local icon, text, color = Rewards.describe(reward)
		UiKit.text({
			Text = icon,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 6, 0, 4),
			Size = UDim2.new(1, -12, 0.38, 0),
			Parent = frame,
		})
		local label = UiKit.text({
			Text = text,
			TextScaled = true,
			TextWrapped = true,
			TextColor3 = color,
			TextStrokeTransparency = 0.5,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0.38, 4),
			Size = UDim2.new(1, -8, 0.3, -4),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8, Parent = label })
		local button = UiKit.button({
			Text = "",
			TextScaled = true,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -4),
			Size = UDim2.new(1, -10, 0.3, -4),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 15, Parent = button })
		return { Frame = frame, Stroke = stroke, Label = label, Button = button }
	end

	local columns = {}
	for level, entry in BP.Levels do
		local column = create("Frame", {
			Size = UDim2.new(0, COLUMN_WIDTH, 1, 0),
			BackgroundTransparency = 1,
			LayoutOrder = level,
			Parent = strip,
		}, {
			create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local title = UiKit.text({
			Text = Locale.T("PassLv", { Level = level }),
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 0,
			BackgroundColor3 = COLORS.Panel,
			LayoutOrder = 0,
			Parent = column,
		}, { UiKit.corner(8) })
		local free = cell(column, 1, entry.Free, false)
		local premium = cell(column, 2, entry.Premium, true)
		free.Button.Activated:Connect(function()
			claim(level, "Free")
		end)
		premium.Button.Activated:Connect(function()
			claim(level, "Premium")
		end)
		columns[level] = { Title = title, Free = free, Premium = premium }
	end

	local function paint(c, data: Data, level: number, track: string)
		local hasPass = Util.bool(player, "Pass_BattlePass")
		local claimed = if track == "Premium" then data.Premium[level] else data.Free[level]
		local reached = level <= data.Level
		local button: TextButton = c.Button
		if claimed then
			button.Text = "✅"
			button.BackgroundColor3 = COLORS.Panel
			button.AutoButtonColor = false
			c.Frame.BackgroundTransparency = 0.4
		elseif track == "Premium" and not hasPass then
			button.Text = "🔒 " .. Locale.T("PassPremium")
			button.BackgroundColor3 = Color3.fromRGB(120, 90, 20)
			button.AutoButtonColor = true
			c.Frame.BackgroundTransparency = 0
		elseif reached then
			button.Text = Locale.T("PassClaim")
			button.BackgroundColor3 = COLORS.Green
			button.AutoButtonColor = true
			c.Frame.BackgroundTransparency = 0
		else
			button.Text = "🔒"
			button.BackgroundColor3 = COLORS.Panel
			button.AutoButtonColor = false
			c.Frame.BackgroundTransparency = 0.4
		end
		c.Stroke.Color = if not claimed and reached and (track == "Free" or hasPass)
			then COLORS.Green
			elseif track == "Premium" then PREMIUM_COLOR
			else COLORS.PanelLight
	end

	local function render()
		current = PassWindow.Read()
		local hasPass = Util.bool(player, "Pass_BattlePass")
		local max = #BP.Levels
		levelLabel.Text = Locale.T("PassLevel", { Level = current.Level, Max = max })
		if current.Level >= max then
			fill.Size = UDim2.fromScale(1, 1)
			barText.Text = Locale.T("PassMaxLevel")
		else
			local ratio = math.clamp(current.XpInLevel / math.max(BP.XpPerLevel, 1), 0, 1)
			TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(ratio, 1) }):Play()
			barText.Text = Locale.T("PassXp", { Xp = math.floor(current.XpInLevel), Need = BP.XpPerLevel })
		end
		for level, c in columns do
			c.Title.TextColor3 = if level <= current.Level then COLORS.Gold else COLORS.Muted
			paint(c.Free, current, level, "Free")
			paint(c.Premium, current, level, "Premium")
		end
		premiumButton.Text = if hasPass
			then Locale.T("PassPremiumOwned")
			else Locale.T("PassUnlockPremium", { Robux = Config.GamePasses.BattlePass.Robux })
		premiumButton.AutoButtonColor = not hasPass
		premiumButton.BackgroundColor3 = if hasPass then COLORS.PanelLight else Color3.fromRGB(200, 140, 20)
		levelsButton.Visible = current.Level < max
	end

	for _, name in PassWindow.Attributes do
		player:GetAttributeChangedSignal(name):Connect(render)
	end
	player:GetAttributeChangedSignal("Income"):Connect(function()
		if window.Visible then
			-- Подписи «~$X» зависят от дохода: перерисовываем текст клеток с монетами
			for level, c in columns do
				local entry = BP.Levels[level]
				c.Free.Label.Text = select(2, Rewards.describe(entry.Free))
				c.Premium.Label.Text = select(2, Rewards.describe(entry.Premium))
			end
		end
	end)

	-- При открытии — прокрутить к первой незабранной награде (или к текущему уровню)
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if not window.Visible then
			return
		end
		render()
		local target = math.max(current.Level, 1)
		for level = 1, current.Level do
			if claimable(current, level, "Free") or claimable(current, level, "Premium") then
				target = level
				break
			end
		end
		task.defer(function()
			strip.CanvasPosition = Vector2.new(math.max(0, (target - 1) * (COLUMN_WIDTH + GAP) - COLUMN_WIDTH), 0)
		end)
	end)
	render()

	task.spawn(function()
		while true do
			if window.Visible then
				local left = current.EndsAt - Util.now()
				endsIn.Text = if left > 0 then Locale.T("PassEndsIn", { Time = Rewards.timeLeft(left) }) else Locale.T("PassEnded")
			end
			task.wait(1)
		end
	end)
end

return PassWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">PlotSigns</string>
            <string name="Source"><![CDATA[-- Таблички баз: SurfaceGui на Sign каждой базы (Face = Front) — имя хозяина или «Свободно»,
-- замок с таймером, своя база подсвечена зелёным. SurfaceGui живут в PlayerGui с Adornee = Sign,
-- поэтому не пропадают при стриминге: Sign вернулся — снова привязываем.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local OWN_COLOR = Color3.fromRGB(40, 150, 70)
local LOCK_COLOR = Color3.fromRGB(255, 120, 100)

local PlotSigns = {}

type Sign = {
	Plot: Instance,
	Gui: SurfaceGui,
	Background: Frame,
	Owner: TextLabel,
	Status: TextLabel,
}

function PlotSigns.Start()
	local folder = create("Folder", { Name = "PlotSigns", Parent = player:WaitForChild("PlayerGui") })
	local signs: { Sign } = {}

	Util.forEachPlot(function(plot: Instance)
		local gui = create("SurfaceGui", {
			Name = plot.Name,
			Face = Enum.NormalId.Front,
			SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
			PixelsPerStud = 40,
			LightInfluence = 0,
			ResetOnSpawn = false,
			Parent = folder,
		})
		local background = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = COLORS.Panel,
			Parent = gui,
		}, { UiKit.padding(6) })
		local owner = UiKit.text({
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 0.4,
			Size = UDim2.fromScale(1, 0.6),
			Parent = background,
		})
		local status = UiKit.text({
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromScale(0, 0.62),
			Size = UDim2.fromScale(1, 0.38),
			Parent = background,
		})
		table.insert(signs, { Plot = plot, Gui = gui, Background = background, Owner = owner, Status = status })
	end)

	local function render(sign: Sign)
		local plot = sign.Plot
		if not plot.Parent then
			return
		end
		local signPart = plot:FindFirstChild("Sign")
		sign.Gui.Adornee = if signPart and signPart:IsA("BasePart") then signPart else nil
		if not sign.Gui.Adornee then
			return
		end

		local ownerId = Util.num(plot, "OwnerUserId")
		local mine = ownerId == player.UserId
		if ownerId == 0 then
			sign.Owner.Text = Locale.T("SignFree")
			sign.Owner.TextColor3 = COLORS.Muted
		else
			local name = Util.str(plot, "OwnerName")
			sign.Owner.Text = if mine then Locale.T("SignYours") else name
			sign.Owner.TextColor3 = if mine then Color3.new(1, 1, 1) else COLORS.Gold
		end
		sign.Background.BackgroundColor3 = if mine then OWN_COLOR else COLORS.Panel

		local lockedLeft = Util.num(plot, "LockedUntil") - Util.now()
		if ownerId ~= 0 and lockedLeft > 0 then
			sign.Status.Text = "🔒 " .. Util.clock(lockedLeft)
			sign.Status.TextColor3 = LOCK_COLOR
		else
			sign.Status.Text = if mine then Util.str(plot, "OwnerName") else ""
			sign.Status.TextColor3 = Color3.new(1, 1, 1)
		end
	end

	task.spawn(function()
		while true do
			for _, sign in signs do
				render(sign)
			end
			task.wait(0.25)
		end
	end)
end

return PlotSigns
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Popups</string>
            <string name="Source"><![CDATA[-- Всплывающие окна от сервера (Remotes.Popup): оффлайн-доход и ежедневная награда
-- (Daily: Day + одно или несколько из Coins / Meme (Id) / Item (Id)), а также v4:
-- "Code" { Code, Coins?, Meme?, Spins?, Item? }, "Spin" { ... } (после анимации колеса),
-- "Pass" { Level, Track, Coins?, Meme?, Spins?, Skin?, Item? }.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Popups = {}

-- Текст ежедневной награды: заголовок дня и строка на каждую часть награды
local function dailyText(data): string
	local day = if type(data.Day) == "number" then data.Day else 1
	local lines = {}
	local creature = if type(data.Meme) == "string" then Config.GetCreature(data.Meme) else nil
	if creature then
		table.insert(lines, Locale.T("PopupDailyMeme", { Face = creature.Face, Name = creature.Name }))
	end
	local item = if type(data.Item) == "string" then Config.GetItem(data.Item) else nil
	if item then
		table.insert(lines, Locale.T("PopupDailyItem", { Face = item.Face, Name = Locale.Name(item) }))
	end
	if type(data.Coins) == "number" and data.Coins > 0 then
		table.insert(lines, "💰 " .. Locale.T("CashBought", { Coins = data.Coins }))
	end
	if #lines == 0 then
		return Locale.T("PopupDaily", { Coins = 0, Day = day })
	end
	return Locale.T("PopupDailyHead", { Day = day }) .. "\n" .. table.concat(lines, "\n")
end

-- Текст награды кода / колеса / пропуска: строка на каждую часть (RichText, мем — цветом редкости)
local function rewardText(data, header: string?): string
	local lines = Rewards.lines(data)
	if #lines == 0 then
		table.insert(lines, Locale.T("PopupRewardEmpty"))
	end
	if header then
		table.insert(lines, 1, header)
	end
	return table.concat(lines, "\n")
end

function Popups.Start(ctx)
	-- Очередь: если пришли и «Оффлайн», и «Ежедневная», показываем по одному
	local queue: { { Title: string, Text: string } } = {}
	local showing = false

	local window, body = UiKit.window(ctx.Gui, "", Vector2.new(420, 260))
	window.Name = "PopupWindow"
	window.ZIndex = 10
	local title = window:FindFirstChildWhichIsA("TextLabel")
	if title then
		-- Заголовки наград бывают длинными («Мем-пропуск — уровень 20»): ужимаем, а не обрезаем
		title.TextScaled = true
		create("UITextSizeConstraint", { MaxTextSize = 26, Parent = title })
	end

	local message = UiKit.text({
		TextSize = 22,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = COLORS.Gold,
		Size = UDim2.new(1, 0, 1, -64),
		Parent = body,
	})
	create("UITextSizeConstraint", { MaxTextSize = 24, Parent = message })
	message.TextScaled = true
	message.RichText = true
	local pop = create("UIScale", { Parent = window })
	local ok = UiKit.button({
		Text = Locale.T("PopupOk"),
		TextSize = 22,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(0.6, 0, 0, 52),
		BackgroundColor3 = COLORS.Green,
		Parent = body,
	})

	local function showNext()
		local item = table.remove(queue, 1)
		if not item then
			showing = false
			window.Visible = false
			return
		end
		showing = true
		if title then
			title.Text = item.Title
		end
		message.Text = item.Text
		window.Visible = true
		-- Награда «выскакивает»
		pop.Scale = 0.7
		TweenService:Create(pop, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end

	ok.Activated:Connect(showNext)
	-- Крестик в заголовке тоже переходит к следующему
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if not window.Visible and showing then
			task.defer(showNext)
		end
	end)

	local function enqueue(item: { Title: string, Text: string })
		table.insert(queue, item)
		if not showing then
			showNext()
		end
	end

	Remotes:WaitForChild("Popup").OnClientEvent:Connect(function(kind, data)
		if type(data) ~= "table" then
			return
		end
		local coins = if type(data.Coins) == "number" then data.Coins else 0
		if kind == "Spin" then
			-- Ждём, пока колесо докрутится (SpinWindow держит Rewards.SpinHoldUntil)
			task.spawn(function()
				while os.clock() < Rewards.SpinHoldUntil do
					task.wait(0.1)
				end
				enqueue({ Title = Locale.T("PopupSpinTitle"), Text = rewardText(data) })
			end)
			return
		elseif kind == "Code" then
			local code = if type(data.Code) == "string" then string.upper(string.sub(data.Code, 1, 32)) else ""
			table.insert(queue, { Title = Locale.T("PopupCodeTitle", { Code = code }), Text = rewardText(data) })
		elseif kind == "Pass" then
			local level = if type(data.Level) == "number" then data.Level else 0
			local header = if data.Track == "Premium" then Locale.T("PopupPassPremium") else nil
			table.insert(queue, { Title = Locale.T("PopupPassTitle", { Level = level }), Text = rewardText(data, header) })
		elseif kind == "Offline" then
			local seconds = if type(data.Seconds) == "number" then data.Seconds else 0
			table.insert(queue, {
				Title = Locale.T("PopupOfflineTitle"),
				Text = Locale.T("PopupOffline", { Coins = coins, Time = Util.clock(seconds) }),
			})
		elseif kind == "Daily" then
			table.insert(queue, {
				Title = Locale.T("PopupDailyTitle"),
				Text = dailyText(data),
			})
		else
			return
		end
		if not showing then
			showNext()
		end
	end)
end

return Popups
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[-- ProximityPrompt мемов и замков баз: перевод ActionText/ObjectText и локальное выключение лишних
-- (Украсть — на своих, Продать/Слить — на чужих, Слить — только если есть Config.Viral.Count одинаковых,
-- Замок — только на своей базе). Сервер всё равно проверяет каждое действие сам.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local Util = require(script.Parent:WaitForChild("Util"))

local player = Players.LocalPlayer

local Prompts = {}

-- ===== Управляемые подсказки =====
-- Enabled = (значение сервера) and (локальное правило). Значение сервера запоминаем,
-- чтобы при снятии локального запрета вернуть именно его, а не включить то, что сервер выключил.
type Managed = {
	Server: boolean,
	Expected: boolean?,
	Rule: () -> (boolean, string?, string?), -- (можно ли, ActionText, ObjectText)
	Connections: { RBXScriptConnection },
}
local managed: { [ProximityPrompt]: Managed } = {}

local function setIfDiff(prompt: ProximityPrompt, property: string, value: any)
	if (prompt :: any)[property] ~= value then
		(prompt :: any)[property] = value
	end
end

local function apply(prompt: ProximityPrompt)
	local entry = managed[prompt]
	if not entry then
		return
	end
	local ok, allowed, action, object = pcall(entry.Rule)
	if not ok then
		return
	end
	if action then
		setIfDiff(prompt, "ActionText", action)
	end
	if object then
		setIfDiff(prompt, "ObjectText", object)
	end
	local want = entry.Server and allowed
	entry.Expected = want
	setIfDiff(prompt, "Enabled", want)
end

local function manage(prompt: ProximityPrompt, rule: () -> (boolean, string?, string?))
	local existing = managed[prompt]
	if existing then
		existing.Rule = rule
		apply(prompt)
		return
	end
	local entry: Managed = { Server = prompt.Enabled, Expected = nil, Rule = rule, Connections = {} }
	managed[prompt] = entry
	table.insert(
		entry.Connections,
		prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
			-- Сигналы отложенные: своё же изменение узнаём по Expected
			if prompt.Enabled ~= entry.Expected then
				entry.Server = prompt.Enabled
				apply(prompt)
			end
		end)
	)
	-- Сервер мог переписать текст — переводим заново
	for _, property in { "ActionText", "ObjectText" } do
		table.insert(entry.Connections, prompt:GetPropertyChangedSignal(property):Connect(function()
			task.defer(apply, prompt)
		end))
	end
	table.insert(entry.Connections, prompt.Destroying:Connect(function()
		for _, connection in entry.Connections do
			connection:Disconnect()
		end
		managed[prompt] = nil
	end))
	apply(prompt)
end

-- ===== Мемы =====
local memes: { [Instance]: boolean } = {}

-- Имя мема с мутацией и пометкой вирусности: «Gold Kolobok», «VIRAL Kolobok»
local function memeTitle(model: Instance): string
	local name = Locale.MemeName(Util.str(model, "CreatureId"))
	local mutation = Config.GetMutation(Util.str(model, "Mutation"))
	if mutation.Id ~= "None" then
		name = Locale.Name(mutation) .. " " .. name
	end
	if Util.bool(model, "Viral") then
		name = Locale.T("BbViral") .. " " .. name
	end
	return name
end

local function myMemesFolder(): Instance?
	local plot = Util.myPlot()
	return plot and plot:FindFirstChild("Memes")
end

local function isMine(model: Instance): boolean
	return Util.num(model, "OwnerUserId") == player.UserId
end

-- Сколько у игрока на базе таких же невирусных мемов (тот же вид и мутация), включая этот
local function sameCount(model: Instance): number
	local folder = myMemesFolder()
	local id, mutation = Util.str(model, "CreatureId"), Util.str(model, "Mutation")
	local count = 0
	for other in memes do
		local onBase = if folder then other.Parent == folder else isMine(other)
		if
			onBase
			and isMine(other)
			and not Util.bool(other, "Viral")
			and Util.str(other, "State") ~= "Carried"
			and Util.str(other, "CreatureId") == id
			and Util.str(other, "Mutation") == mutation
		then
			count += 1
		end
	end
	return count
end

local function ruleFor(model: Instance, prompt: ProximityPrompt): (() -> (boolean, string?, string?))?
	if prompt.Name == "BuyPrompt" then
		return function()
			local price = Util.num(model, "Price")
			return true, Locale.T("PromptBuy"), memeTitle(model) .. " — $" .. Format.Number(price)
		end
	elseif prompt.Name == "StealPrompt" then
		return function()
			-- Быстрая кража: только время удержания на клиенте, сервер проверяет сам
			prompt.HoldDuration = if Util.bool(player, "Pass_FastSteal")
				then Config.Steal.FastHoldDuration
				else Config.Steal.HoldDuration
			local allowed = not isMine(model)
				and Util.str(player, "Carrying") == ""
				and Util.str(model, "State") ~= "Carried"
			return allowed, Locale.T("PromptSteal"), memeTitle(model)
		end
	elseif prompt.Name == "SellPrompt" then
		return function()
			return isMine(model), Locale.T("PromptSell"), memeTitle(model)
		end
	elseif prompt.Name == "MergePrompt" then
		return function()
			local allowed = isMine(model) and not Util.bool(model, "Viral") and sameCount(model) >= Config.Viral.Count
			return allowed, Locale.T("PromptMerge", { Count = Config.Viral.Count }), memeTitle(model)
		end
	end
	return nil
end

-- Перепроверить все подсказки мемов (одним пакетом за кадр)
local refreshQueued = false
local function refreshAll()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		for prompt in managed do
			apply(prompt)
		end
	end)
end

local function trackMeme(model: Instance): () -> ()
	memes[model] = true
	local connections: { RBXScriptConnection } = {}

	local function hookPrompt(child: Instance)
		if child:IsA("ProximityPrompt") then
			local rule = ruleFor(model, child)
			if rule then
				manage(child, rule)
			end
		end
	end

	local function hookBody(body: Instance)
		for _, child in body:GetChildren() do
			hookPrompt(child)
		end
		table.insert(connections, body.ChildAdded:Connect(hookPrompt))
	end

	local body = model:FindFirstChild("Body")
	if body then
		hookBody(body)
	end
	-- StreamingEnabled: Body может прийти позже или подгрузиться заново
	table.insert(connections, model.ChildAdded:Connect(function(child)
		if child.Name == "Body" then
			hookBody(child)
		end
	end))
	table.insert(connections, model.AttributeChanged:Connect(refreshAll))
	table.insert(connections, model.AncestryChanged:Connect(refreshAll))
	refreshAll()

	return function()
		memes[model] = nil
		for _, connection in connections do
			connection:Disconnect()
		end
		refreshAll()
	end
end

-- ===== Замки баз =====
local function trackPlot(plot: Instance)
	local function hookButton(button: Instance)
		local function hookPrompt(prompt: Instance)
			if not prompt:IsA("ProximityPrompt") then
				return
			end
			manage(prompt, function()
				local mine = Util.num(plot, "OwnerUserId") == player.UserId
				return mine, Locale.T("PromptLock"), Locale.T("PromptLockObject", { Seconds = Config.Plot.LockDuration })
			end)
		end
		local prompt = button:FindFirstChild("LockPrompt")
		if prompt then
			hookPrompt(prompt)
		end
		button.ChildAdded:Connect(function(child)
			if child.Name == "LockPrompt" then
				hookPrompt(child)
			end
		end)
	end

	local button = plot:FindFirstChild("LockButton")
	if button then
		hookButton(button)
	end
	plot.ChildAdded:Connect(function(child)
		if child.Name == "LockButton" then
			hookButton(child)
		end
	end)
	plot:GetAttributeChangedSignal("OwnerUserId"):Connect(refreshAll)
end

function Prompts.Start()
	for _, name in { "Carrying", "Pass_FastSteal", "Plot" } do
		player:GetAttributeChangedSignal(name):Connect(refreshAll)
	end
	Util.watchTagged("Meme", trackMeme)
	Util.forEachPlot(trackPlot)
end

return Prompts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">QuestsWindow</string>
            <string name="Source"><![CDATA[-- Окно ежедневных квестов. Источник — атрибут игрока QuestsJson:
-- { List = { { Id, Goal, Progress, Claimed } }, AllClaimed = bool, ResetAt = serverTime }.
-- Описание и награда — из Config.GetQuest(Id); прогресс и цель (Goal) считает сервер.
-- Забрать — Remotes.ClaimQuest(index) / ClaimQuest("All") за бонус «все квесты».
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ROW_HEIGHT = 78

local QuestsWindow = {}

type Entry = { Id: string, Goal: number, Progress: number, Claimed: boolean }
type Data = { List: { Entry }, AllClaimed: boolean, ResetAt: number }

-- Разобрать QuestsJson; битые записи пропускаются
function QuestsWindow.Read(): Data
	local raw = Util.json(player, "QuestsJson")
	local data: Data = { List = {}, AllClaimed = false, ResetAt = 0 }
	if type(raw) ~= "table" then
		return data
	end
	data.AllClaimed = raw.AllClaimed == true
	data.ResetAt = if type(raw.ResetAt) == "number" then raw.ResetAt else 0
	if type(raw.List) == "table" then
		for _, entry in raw.List do
			if type(entry) == "table" and type(entry.Id) == "string" then
				table.insert(data.List, {
					Id = entry.Id,
					Goal = if type(entry.Goal) == "number" then entry.Goal else 1,
					Progress = if type(entry.Progress) == "number" then entry.Progress else 0,
					Claimed = entry.Claimed == true,
				})
			end
		end
	end
	return data
end

local function isDone(entry: Entry): boolean
	return entry.Progress >= entry.Goal
end

local function allClaimed(data: Data): boolean
	if #data.List == 0 then
		return false
	end
	for _, entry in data.List do
		if not entry.Claimed then
			return false
		end
	end
	return true
end

-- Сколько наград можно забрать прямо сейчас (для значка на кнопке HUD)
function QuestsWindow.ClaimableCount(): number
	local data = QuestsWindow.Read()
	local count = 0
	for _, entry in data.List do
		if isDone(entry) and not entry.Claimed then
			count += 1
		end
	end
	if allClaimed(data) and not data.AllClaimed then
		count += 1
	end
	return count
end

-- Число в описании и прогрессе: деньги — "$1.2K", время — "5:00", остальное — "12"
local function amount(quest, value: number): string
	if quest and quest.Stat == "Earn" then
		return "$" .. Format.Number(value)
	elseif quest and quest.Stat == "Play" then
		return Util.clock(value)
	end
	return Format.Number(value)
end

local function describe(quest, goal: number): string
	if not quest then
		return "?"
	end
	local text = if Locale.IsRussian and quest.DescRu then quest.DescRu else quest.Desc
	local goalText = if quest.Stat == "Earn" then "$" .. Format.Number(goal) else Format.Number(goal)
	return (string.gsub(text, "{Goal}", function()
		return goalText
	end))
end

function QuestsWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("QuestsTitle"), Vector2.new(560, 440))
	window.Name = "QuestsWindow"
	ctx.Register("Quests", window)

	local resetLabel = UiKit.text({
		TextScaled = true,
		TextColor3 = COLORS.Muted,
		Font = Enum.Font.Gotham,
		Size = UDim2.new(1, 0, 0, 20),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15 }) })

	local list = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 1, -26),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})

	local busy = false
	local function claim(index: number | string)
		if busy then
			return
		end
		busy = true
		local ok, success, key = pcall(function()
			return Remotes:WaitForChild("ClaimQuest"):InvokeServer(index)
		end)
		busy = false
		if ok and type(key) == "string" then
			ctx.Toast(Locale.T(key), if success then "success" else "error")
		end
	end

	-- Строка: описание, полоса прогресса, награда и кнопка справа. Возвращает (кнопка, полоса, подписи)
	local function row(order: number)
		local frame = create("Frame", {
			Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
			Parent = list,
		}, { UiKit.corner(10) })
		local title = UiKit.text({
			TextScaled = true,
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -150, 0, 24),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10 }) })
		local bar = create("Frame", {
			Position = UDim2.fromOffset(12, 34),
			Size = UDim2.new(1, -150, 0, 16),
			BackgroundColor3 = COLORS.Panel,
			Parent = frame,
		}, { UiKit.corner(6) })
		local fill = create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = COLORS.Green,
			Parent = bar,
		}, { UiKit.corner(6) })
		local barText = UiKit.text({
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextStrokeTransparency = 0.4,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			Parent = bar,
		})
		local reward = UiKit.text({
			TextScaled = true,
			TextColor3 = COLORS.Gold,
			Position = UDim2.fromOffset(12, 54),
			Size = UDim2.new(1, -150, 0, 18),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 14 }) })
		local button = UiKit.button({
			TextSize = 18,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(122, 46),
			Parent = frame,
		})
		return { Frame = frame, Title = title, Bar = bar, Fill = fill, BarText = barText, Reward = reward, Button = button }
	end

	local function setButton(button: TextButton, state: "Claim" | "Done" | "Locked", text: string?)
		button.Text = text or ""
		if state == "Claim" then
			button.Text = Locale.T("QuestClaim")
			button.BackgroundColor3 = COLORS.Green
			button.TextColor3 = COLORS.Text
			button.AutoButtonColor = true
		elseif state == "Done" then
			button.Text = Locale.T("QuestDoneMark")
			button.BackgroundColor3 = COLORS.Panel
			button.TextColor3 = COLORS.Muted
			button.AutoButtonColor = false
		else
			button.BackgroundColor3 = COLORS.Panel
			button.TextColor3 = COLORS.Muted
			button.AutoButtonColor = false
		end
	end

	-- Строки квестов создаются по мере надобности и переиспользуются
	local rows = {}
	local current: Data = QuestsWindow.Read()

	local emptyLabel = UiKit.text({
		Text = Locale.T("QuestsEmpty"),
		TextSize = 16,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 0,
		Parent = list,
	})

	local bonus = row(1000)
	bonus.Title.Text = Locale.T("QuestAllBonus")
	bonus.Frame.BackgroundColor3 = Color3.fromRGB(55, 45, 80)
	bonus.Button.Activated:Connect(function()
		if allClaimed(current) and not current.AllClaimed then
			claim("All")
		end
	end)

	local function render()
		current = QuestsWindow.Read()
		emptyLabel.Visible = #current.List == 0
		for index, entry in current.List do
			local r = rows[index]
			if not r then
				r = row(index)
				rows[index] = r
				local myIndex = index
				r.Button.Activated:Connect(function()
					local e = current.List[myIndex]
					if e and isDone(e) and not e.Claimed then
						claim(myIndex)
					end
				end)
			end
			r.Frame.Visible = true
			local quest = Config.GetQuest(entry.Id)
			local ratio = if entry.Goal > 0 then math.clamp(entry.Progress / entry.Goal, 0, 1) else 1
			r.Title.Text = describe(quest, entry.Goal)
			TweenService:Create(r.Fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(ratio, 1) }):Play()
			r.BarText.Text = amount(quest, math.min(entry.Progress, entry.Goal)) .. " / " .. amount(quest, entry.Goal)
			r.Reward.Text = if quest then Locale.T("QuestRewardHint", { Coins = Util.coinsFor(quest.IncomeSeconds, quest.MinCoins) }) else ""
			if entry.Claimed then
				setButton(r.Button, "Done")
			elseif isDone(entry) then
				setButton(r.Button, "Claim")
			else
				setButton(r.Button, "Locked", math.floor(ratio * 100) .. "%")
			end
		end
		for index = #current.List + 1, #rows do
			rows[index].Frame.Visible = false
		end

		-- Бонус за все квесты
		local claimedCount = 0
		for _, entry in current.List do
			if entry.Claimed then
				claimedCount += 1
			end
		end
		local total = math.max(#current.List, 1)
		bonus.Frame.Visible = #current.List > 0
		bonus.Fill.Size = UDim2.fromScale(claimedCount / total, 1)
		bonus.Fill.BackgroundColor3 = COLORS.Gold
		bonus.BarText.Text = claimedCount .. " / " .. #current.List
		bonus.Reward.Text = Locale.T("QuestRewardHint", {
			Coins = Util.coinsFor(Config.Quests.AllDoneIncomeSeconds, Config.Quests.AllDoneMinCoins),
		})
		if current.AllClaimed then
			setButton(bonus.Button, "Done")
		elseif allClaimed(current) then
			setButton(bonus.Button, "Claim")
		else
			setButton(bonus.Button, "Locked", "🔒")
			bonus.Reward.Text ..= "  ·  " .. Locale.T("QuestAllHint")
		end
	end

	player:GetAttributeChangedSignal("QuestsJson"):Connect(render)
	player:GetAttributeChangedSignal("Income"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()

	-- Таймер до сброса квестов
	task.spawn(function()
		while true do
			if window.Visible then
				local left = current.ResetAt - Util.now()
				resetLabel.Text = if current.ResetAt > 0 then Locale.T("QuestsResetIn", { Time = Util.clock(left) }) else ""
			end
			task.wait(0.5)
		end
	end)
end

return QuestsWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">RebirthWindow</string>
            <string name="Source"><![CDATA[-- Окно перерождения: цена, прогресс денег до цены, что даёт, кнопка.
-- Цену и условия проверяет сервер (Remotes.Rebirth), клиент только показывает и просит.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local RebirthWindow = {}

function RebirthWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("RebirthTitle"), Vector2.new(460, 360))
	window.Name = "RebirthWindow"
	ctx.Register("Rebirth", window)

	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = body,
	})

	local cost = UiKit.text({ TextSize = 22, TextColor3 = COLORS.Gold, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = body })

	local bar = create("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = COLORS.PanelLight,
		LayoutOrder = 2,
		Parent = body,
	}, { UiKit.corner(8) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = COLORS.Green,
		Parent = bar,
	}, { UiKit.corner(8) })
	local barText = UiKit.text({
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bar,
	})

	local function perk(order: number): TextLabel
		return UiKit.text({
			TextSize = 16,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 22),
			LayoutOrder = order,
			Parent = body,
		})
	end
	local perkIncome = perk(3)
	local perkSlots = perk(4)
	local cashReset = perk(5)
	cashReset.TextColor3 = COLORS.Muted
	cashReset.TextSize = 14
	cashReset.Text = Locale.T("RebirthCashReset")

	local go = UiKit.button({
		Text = Locale.T("RebirthButton"),
		TextSize = 22,
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = COLORS.Purple,
		LayoutOrder = 6,
		Parent = body,
	})

	local function render()
		local rebirths = Util.num(player, "Rebirths")
		local coins = Util.num(player, "Coins")
		local price = Config.RebirthCost(rebirths)
		local progress = math.clamp(coins / price, 0, 1)

		cost.Text = Locale.T("RebirthCost", { Price = price })
		TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.fromScale(progress, 1) }):Play()
		barText.Text = "$" .. Format.Number(coins) .. " / $" .. Format.Number(price) .. "  (" .. math.floor(progress * 100) .. "%)"
		go.BackgroundColor3 = if progress >= 1 then COLORS.Green else COLORS.PanelLight

		perkIncome.Text = Locale.T("RebirthPerkIncome", {
			Percent = math.floor(Config.Rebirth.IncomeBonus * 100 + 0.5),
			Mult = Config.IncomeMult(rebirths + 1),
		})
		local now = Config.MaxSlots(rebirths)
		local after = Config.MaxSlots(rebirths + 1)
		perkSlots.Text = if after > now
			then Locale.T("RebirthPerkSlots", { Count = after - now })
			else Locale.T("RebirthPerkSlotsMax")
	end

	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	player:GetAttributeChangedSignal("Rebirths"):Connect(render)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()

	local busy = false
	go.Activated:Connect(function()
		if busy then
			return
		end
		busy = true
		local rebirths = Util.num(player, "Rebirths")
		local ok, success, key = pcall(function()
			return Remotes:WaitForChild("Rebirth"):InvokeServer()
		end)
		busy = false
		if not ok then
			return
		end
		if type(key) == "string" then
			ctx.Toast(
				Locale.T(key, { Count = rebirths + 1, Price = Config.RebirthCost(rebirths) }),
				if success then "success" else "error"
			)
		end
		if success then
			window.Visible = false
		end
	end)
end

return RebirthWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Rewards</string>
            <string name="Source"><![CDATA[-- Общие помощники для наград v4 (коды, Мем-пропуск, колесо): описание награды из Config
-- (Kind = Coins / Meme / Spins / Item / Skin), строки всплывающего окна по данным от сервера,
-- цвет редкости и «осталось N д M ч». Сумму награды всегда считает сервер, клиент пишет «~».
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local player = Players.LocalPlayer

local Rewards = {}

-- Пока колесо крутится, всплывашка «Spin» ждёт (os.clock(), см. SpinWindow и Popups)
Rewards.SpinHoldUntil = 0

-- Цвет редкости для текста: «Секретный» почти чёрный — рисуем белым
function Rewards.rarityColor(rarityId: string): Color3
	if rarityId == "Secret" then
		return Color3.new(1, 1, 1)
	end
	return Config.GetRarity(rarityId).Color
end

local function colored(text: string, color: Color3): string
	return '<font color="#' .. color:ToHex() .. '">' .. text .. "</font>"
end

-- 200000 -> "2д 7ч", 5000 -> "1ч 23м", 300 -> "5:00"
function Rewards.timeLeft(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	if total >= 86400 then
		return Locale.T("TimeDH", { D = total // 86400, H = (total % 86400) // 3600 })
	elseif total >= 3600 then
		return Locale.T("TimeHM", { H = total // 3600, M = (total % 3600) // 60 })
	end
	return Util.clock(total)
end

-- Награда из Config (уровень пропуска, сегмент колеса): иконка, короткая подпись, цвет
function Rewards.describe(reward: any): (string, string, Color3)
	if type(reward) ~= "table" then
		return "❔", "?", COLORS.Muted
	end
	local kind = reward.Kind
	if kind == "Meme" then
		local creature = if type(reward.Id) == "string" then Config.GetCreature(reward.Id) else nil
		if creature then
			return creature.Face, creature.Name, Rewards.rarityColor(creature.Rarity)
		end
		local rarity = Config.GetRarity(reward.Rarity)
		return "🎲", Locale.T("DailyMeme", { Rarity = Locale.Name(rarity) }), Rewards.rarityColor(rarity.Id)
	elseif kind == "Spins" then
		return "🎡", Locale.T("RewardSpins", { Count = reward.Amount or 1 }), COLORS.Purple
	elseif kind == "Item" then
		local item = Config.GetItem(reward.ItemId)
		if item then
			return item.Face, Locale.Name(item), COLORS.Purple
		end
		return "🎁", "?", COLORS.Purple
	elseif kind == "Skin" then
		local skin = Config.GetSkin(reward.SkinId)
		local icon = if skin and skin.Kind == "Base" then "🏠" else "🩴"
		return icon, Locale.T("RewardSkin", { Name = Locale.Name(skin) }), Color3.fromRGB(0, 230, 200)
	end
	return "💰", Locale.T("RewardCoinsApprox", { Coins = Util.coinsFor(reward.IncomeSeconds, reward.MinCoins) }), COLORS.Gold
end

-- Строки RichText для всплывающего окна по данным Popup { Coins?, Meme?, Spins?, Item?, Skin? }
function Rewards.lines(data: { [string]: any }): { string }
	local lines = {}
	local creature = if type(data.Meme) == "string" then Config.GetCreature(data.Meme) else nil
	if creature then
		local color = Rewards.rarityColor(creature.Rarity)
		table.insert(lines, colored(Locale.T("PopupDailyMeme", { Face = creature.Face, Name = creature.Name }), color))
		table.insert(lines, colored(Locale.Name(Config.GetRarity(creature.Rarity)), color))
	end
	if type(data.Coins) == "number" and data.Coins > 0 then
		table.insert(lines, "💰 " .. Locale.T("RewardCoins", { Coins = data.Coins }))
	end
	if type(data.Spins) == "number" and data.Spins > 0 then
		table.insert(lines, "🎡 " .. Locale.T("RewardSpins", { Count = data.Spins }))
	end
	local item = if type(data.Item) == "string" then Config.GetItem(data.Item) else nil
	if item then
		table.insert(lines, Locale.T("PopupDailyItem", { Face = item.Face, Name = Locale.Name(item) }))
	end
	local skin = if type(data.Skin) == "string" then Config.GetSkin(data.Skin) else nil
	if skin then
		table.insert(lines, "🎨 " .. Locale.T("RewardSkin", { Name = Locale.Name(skin) }))
	end
	return lines
end

-- Вызов RemoteFunction -> (success, key, extra). Нет ремоута или ошибка сети -> (false, "NotLoaded")
function Rewards.invoke(name: string, ...: any): (boolean, any, any)
	local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name, 5)
	if not remote or not remote:IsA("RemoteFunction") then
		return false, "NotLoaded", nil
	end
	local args = table.pack(...)
	local ok, success, key, extra = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, "NotLoaded", nil
	end
	return success == true, key, extra
end

-- Купить продукт по ключу Config.Products; Id = 0 -> «не настроено»
function Rewards.promptProduct(key: string, toast: (string, string?) -> ())
	local product = Config.Products[key]
	if not product or product.Id == 0 then
		toast(Locale.T("NotConfigured"), "error")
		return
	end
	game:GetService("MarketplaceService"):PromptProductPurchase(player, product.Id)
end

return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- Окно магазина: геймпассы (навсегда) и продукты за Robux (бусты, деньги).
-- Клиент только открывает окно покупки Roblox; выдачу делает сервер (ProcessReceipt / проверка пасса).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local Shop = {}

-- Подсказка под названием для товаров без пачки денег (из Config, чтобы цифры не расходились)
local function staticHint(key: string): string
	if key == "MysteryBox" and Config.MysteryBox then
		local total = 0
		for _, weight in Config.MysteryBox.Weights do
			total += weight
		end
		local percents = {}
		for i, weight in Config.MysteryBox.Weights do
			percents[i] = math.floor(weight / math.max(total, 1) * 100 + 0.5)
		end
		return Locale.T("ShopHintMysteryBox", { A = percents[1] or 0, B = percents[2] or 0, C = percents[3] or 0 })
	elseif key == "MemeRain" and Config.AdminEvents then
		return Locale.T("ShopHintMemeRain", { Time = Util.clock(Config.AdminEvents.MemeRainDuration or 0) })
	elseif key == "EmotePack" then
		local count = 0
		for _, emote in Config.Emotes or {} do
			if emote.Pass == key then
				count += 1
			end
		end
		return Locale.T("ShopHintEmotePack", { Count = count })
	end
	-- Геймпасс, который даёт предмет (Confetti Cannon) — описание предмета
	for _, item in Config.Items do
		if item.Pass == key then
			return item.Face .. " " .. (if Locale.IsRussian and item.DescRu then item.DescRu else item.Desc or "")
		end
	end
	return ""
end

-- Ключи словаря по возрастанию цены (порядок обхода словаря в Luau не гарантирован)
local function sortedKeys(items: { [string]: any }): { string }
	local keys = {}
	for key in items do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		if items[a].Robux == items[b].Robux then
			return a < b
		end
		return items[a].Robux < items[b].Robux
	end)
	return keys
end

function Shop.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("ShopTitle"), Vector2.new(560, 460))
	window.Name = "ShopWindow"
	ctx.Register("Shop", window)

	local list = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function section(key: string)
		UiKit.text({
			Text = Locale.T(key),
			TextSize = 18,
			TextColor3 = COLORS.Gold,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = nextOrder(),
			Parent = list,
		})
	end

	-- Строка товара: название слева, кнопка с ценой справа. Возвращает (кнопка, подпись-подсказка).
	local function row(item): (TextButton, TextLabel)
		local frame = create("Frame", {
			Size = UDim2.new(1, 0, 0, 56),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = nextOrder(),
			Parent = list,
		}, { UiKit.corner(10) })
		local name = UiKit.text({
			Text = Locale.Name(item),
			TextScaled = true,
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -140, 0, 28),
			Parent = frame,
		})
		create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10, Parent = name })
		local hint = UiKit.text({
			Text = "",
			TextScaled = true,
			TextColor3 = COLORS.Muted,
			Position = UDim2.fromOffset(12, 32),
			Size = UDim2.new(1, -140, 0, 18),
			Parent = frame,
		}, { create("UITextSizeConstraint", { MaxTextSize = 14, MinTextSize = 8 }) })
		local buy = UiKit.button({
			Text = "R$ " .. item.Robux,
			TextSize = 18,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(116, 42),
			BackgroundColor3 = COLORS.Green,
			Parent = frame,
		})
		return buy, hint
	end

	-- Геймпассы
	section("ShopPasses")
	for _, key in sortedKeys(Config.GamePasses) do
		local item = Config.GamePasses[key]
		local buy, hint = row(item)
		hint.Text = staticHint(key)
		local attribute = "Pass_" .. key

		local function render()
			local owned = Util.bool(player, attribute)
			buy.Text = if owned then Locale.T("ShopOwned") else "R$ " .. item.Robux
			buy.BackgroundColor3 = if owned then COLORS.Panel else COLORS.Green
			buy.AutoButtonColor = not owned
		end
		player:GetAttributeChangedSignal(attribute):Connect(render)
		render()

		buy.Activated:Connect(function()
			if Util.bool(player, attribute) then
				return
			end
			if item.Id == 0 then
				ctx.Toast(Locale.T("NotConfigured"), "error")
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, item.Id)
		end)
	end

	-- Продукты (многоразовые)
	section("ShopProducts")
	for _, key in sortedKeys(Config.Products) do
		local item = Config.Products[key]
		local buy, hint = row(item)
		hint.Text = staticHint(key)

		-- Для пачек денег показываем примерную сумму (точную считает сервер)
		if item.IncomeSeconds then
			local function render()
				local estimate = math.max(Util.num(player, "Income") * item.IncomeSeconds, item.MinCoins or 0)
				hint.Text = Locale.T("ShopCashHint", { Coins = estimate })
			end
			player:GetAttributeChangedSignal("Income"):Connect(render)
			render()
		end

		buy.Activated:Connect(function()
			if item.Id == 0 then
				ctx.Toast(Locale.T("NotConfigured"), "error")
				return
			end
			MarketplaceService:PromptProductPurchase(player, item.Id)
		end)
	end
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">SkinsWindow</string>
            <string name="Source"><![CDATA[-- Окно скинов: две вкладки (база / тапок) из Config.Skins. Источник — атрибут игрока SkinsJson:
-- { Owned = { id… }, Base = id, Slipper = id }. Купить за монеты — Remotes.BuySkin(id)
-- (только Price > 0 без Source), надеть — Remotes.EquipSkin(id). Скины с Source = "Pass" / "Spin"
-- не продаются: их выдаёт Мем-пропуск или колесо. Цену и владение проверяет сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local CELL_HEIGHT = 150
local GAP = 8
local DEFAULT_SWATCH = Color3.fromRGB(150, 150, 160)
local TABS = { { Kind = "Base", Key = "SkinsBase" }, { Kind = "Slipper", Key = "SkinsSlipper" } }

local SkinsWindow = {}

type State = { Owned: { [string]: boolean }, Base: string, Slipper: string }

local function readState(): State
	local raw = Util.json(player, "SkinsJson")
	local state: State = { Owned = {}, Base = "BaseDefault", Slipper = "SlipperDefault" }
	if type(raw) ~= "table" then
		return state
	end
	if type(raw.Owned) == "table" then
		for _, id in raw.Owned do
			if type(id) == "string" then
				state.Owned[id] = true
			end
		end
	end
	if type(raw.Base) == "string" then
		state.Base = raw.Base
	end
	if type(raw.Slipper) == "string" then
		state.Slipper = raw.Slipper
	end
	return state
end

-- Бесплатные скины без Source (классика) есть у всех
local function owns(state: State, skin): boolean
	return state.Owned[skin.Id] == true or (skin.Price == 0 and skin.Source == nil)
end

-- Образец цвета: пол базы (обводка — стены) или цвет тапка; радужный — градиент
local function swatch(parent: Instance, skin)
	local main = skin.Floor or skin.Color or DEFAULT_SWATCH
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = main,
		Parent = parent,
	}, {
		UiKit.corner(if skin.Kind == "Slipper" then 28 else 10),
		create("UIStroke", { Color = skin.Wall or Color3.new(1, 1, 1), Thickness = 3 }),
	})
	if skin.Rainbow then
		frame.BackgroundColor3 = Color3.new(1, 1, 1)
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
				ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 40)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 230, 90)),
				ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 140, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 70, 255)),
			}),
			Rotation = 45,
			Parent = frame,
		})
	end
	return frame
end

function SkinsWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("SkinsTitle"), Vector2.new(620, 440))
	window.Name = "SkinsWindow"
	ctx.Register("Skins", window)

	local tabRow = create("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Parent = body,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local grid = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 6) }),
	})
	local layout = create("UIGridLayout", {
		CellPadding = UDim2.fromOffset(GAP, GAP),
		CellSize = UDim2.fromOffset(130, CELL_HEIGHT),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	-- Колонки по ширине: 2 на узком телефоне, до 4 на ПК
	local function relayout()
		local width = grid.AbsoluteSize.X - 10
		if width <= 0 then
			return
		end
		local columns = math.clamp(math.floor((width + GAP) / (130 + GAP)), 2, 4)
		layout.CellSize = UDim2.fromOffset(math.floor((width - GAP * (columns - 1)) / columns), CELL_HEIGHT)
	end
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout)
	relayout()

	local busy = false
	local function call(remote: string, id: string)
		if busy then
			return
		end
		busy = true
		local success, key = Rewards.invoke(remote, id)
		busy = false
		if type(key) == "string" then
			ctx.Toast(Locale.T(key), if success then "success" else "error")
		end
	end

	-- Клетки создаются один раз; вкладка только скрывает чужой вид
	local cells = {}
	for order, skin in Config.Skins do
		local cell = create("Frame", {
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
			Visible = false,
			Parent = grid,
		}, { UiKit.corner(10) })
		local stroke = create("UIStroke", { Color = COLORS.PanelLight, Thickness = 2, Parent = cell })
		swatch(cell, skin)
		local name = UiKit.text({
			Text = Locale.Name(skin),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 4, 0, 70),
			Size = UDim2.new(1, -8, 0, 22),
			Parent = cell,
		}, { create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 9 }) })
		name.Name = "SkinName"
		local button = UiKit.button({
			Text = "",
			TextScaled = true,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -16, 0, 40),
			Parent = cell,
		})
		create("UITextSizeConstraint", { MaxTextSize = 16, Parent = button })
		create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = button })
		cells[skin.Id] = { Skin = skin, Frame = cell, Stroke = stroke, Button = button }
	end

	local currentKind = "Base"
	local tabButtons = {}

	local function render()
		local state = readState()
		local coins = Util.num(player, "Coins")
		for _, c in cells do
			local skin = c.Skin
			c.Frame.Visible = skin.Kind == currentKind
			local equipped = (if skin.Kind == "Base" then state.Base else state.Slipper) == skin.Id
			local button: TextButton = c.Button
			if equipped then
				button.Text = "✅ " .. Locale.T("SkinEquipped")
				button.BackgroundColor3 = COLORS.Panel
				button.AutoButtonColor = false
				c.Stroke.Color = COLORS.Green
			elseif owns(state, skin) then
				button.Text = Locale.T("SkinEquip")
				button.BackgroundColor3 = COLORS.Purple
				button.AutoButtonColor = true
				c.Stroke.Color = COLORS.PanelLight
			elseif skin.Source then
				button.Text = if skin.Source == "Spin" then Locale.T("SkinFromSpin") else Locale.T("SkinFromPass")
				button.BackgroundColor3 = Color3.fromRGB(90, 70, 20)
				button.AutoButtonColor = skin.Source == "Pass"
				c.Stroke.Color = COLORS.Gold
			else
				button.Text = "$" .. Format.Number(skin.Price)
				button.BackgroundColor3 = if coins >= skin.Price then COLORS.Green else COLORS.Panel
				button.AutoButtonColor = true
				c.Stroke.Color = COLORS.PanelLight
			end
		end
		for kind, tab in tabButtons do
			tab.BackgroundColor3 = if kind == currentKind then COLORS.Purple else COLORS.PanelLight
		end
	end

	for order, tab in TABS do
		local button = UiKit.button({
			Text = Locale.T(tab.Key),
			TextScaled = true,
			Size = UDim2.new(0.5, -4, 1, 0),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
			Parent = tabRow,
		})
		create("UITextSizeConstraint", { MaxTextSize = 18, Parent = button })
		tabButtons[tab.Kind] = button
		button.Activated:Connect(function()
			currentKind = tab.Kind
			grid.CanvasPosition = Vector2.zero
			render()
		end)
	end

	for id, c in cells do
		c.Button.Activated:Connect(function()
			local state = readState()
			local skin = c.Skin
			local equipped = (if skin.Kind == "Base" then state.Base else state.Slipper) == id
			if equipped then
				return
			elseif owns(state, skin) then
				call("EquipSkin", id)
			elseif skin.Source == "Pass" then
				ctx.Open("Pass", true) -- где взять — в Мем-пропуске
			elseif not skin.Source and skin.Price > 0 then
				call("BuySkin", id)
			end
		end)
	end

	player:GetAttributeChangedSignal("SkinsJson"):Connect(render)
	player:GetAttributeChangedSignal("Coins"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	window:GetPropertyChangedSignal("Visible"):Connect(render)
	render()
end

return SkinsWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">Social</string>
            <string name="Source"><![CDATA[-- Друзья, группа и избранное — только клиентские окна Roblox (бонусы считает сервер):
--  * Invite — SocialService:PromptGameInvite (друзья на сервере дают FriendBoost);
--  * JoinGroup — GroupService:PromptJoinAsync(Config.Social.GroupId), затем Remotes.CheckGroup;
--  * через Config.Social.FavoritePromptAfter секунд игры (раз за сессию) — «Добавить в избранное».
-- Все вызовы в pcall: в Studio и на части устройств эти окна недоступны.
local AvatarEditorService = game:GetService("AvatarEditorService")
local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Util = require(script.Parent:WaitForChild("Util"))

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Social = {}

-- Суммарный бонус дохода от друзей и группы, в процентах (для строки HUD)
function Social.BoostPercent(): number
	local boost = Util.num(player, "FriendBoost")
	if Util.bool(player, "InGroup") and Config.Social.GroupId ~= 0 then
		boost += Config.Social.GroupBoost
	end
	return math.floor(boost * 100 + 0.5)
end

-- Показывать ли кнопку «Вступить в группу»
function Social.CanJoinGroup(): boolean
	return Config.Social.GroupId ~= 0 and not Util.bool(player, "InGroup")
end

function Social.Invite(toast: (string, string?) -> ())
	task.spawn(function()
		local okCheck, canSend = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
		if not okCheck or not canSend then
			toast(Locale.T("SocialInviteUnavailable"), "error")
			return
		end
		local ok = pcall(SocialService.PromptGameInvite, SocialService, player)
		if not ok then
			toast(Locale.T("SocialInviteUnavailable"), "error")
		end
	end)
end

function Social.JoinGroup()
	if not Social.CanJoinGroup() then
		return
	end
	task.spawn(function()
		pcall(GroupService.PromptJoinAsync, GroupService, Config.Social.GroupId)
		-- Вступил или нет — проверяет сервер (IsInGroup), клиент только просит перепроверить
		local remote = Remotes:FindFirstChild("CheckGroup")
		if remote and remote:IsA("RemoteEvent") then
			remote:FireServer()
		end
	end)
end

function Social.Start()
	-- Раз за сессию, после N секунд игры: окно «Добавить игру в избранное»
	task.delay(Config.Social.FavoritePromptAfter, function()
		pcall(function()
			AvatarEditorService:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
		end)
	end)
end

return Social
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">SpinWindow</string>
            <string name="Source"><![CDATA[-- Колесо удачи: сегменты из Config.Spin.Segments по кругу, указатель сверху.
-- «Крутить» -> Remotes.Spin() -> (ok, key, segmentIndex): награду выбирает сервер, клиент только
-- докручивает колесо до выпавшего сегмента (~3.5 с). Награда приходит Popup "Spin" — Popups
-- показывает её после анимации (Rewards.SpinHoldUntil). Атрибуты игрока: Spins, FreeSpinReady.
-- Шансы сегментов показаны в окне: вращения продаются за Robux (правила Roblox о случайных наградах).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local Rewards = require(script.Parent:WaitForChild("Rewards"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local SEGMENTS = Config.Spin.Segments
local SPIN_TIME = 3.5
local TURNS = 5 -- полных оборотов до остановки
local WHEEL_BG = Color3.fromRGB(32, 30, 52)

local SpinWindow = {}

-- Сколько вращений доступно сейчас (бесплатное + купленные)
function SpinWindow.Available(): number
	return Util.num(player, "Spins") + (if Util.bool(player, "FreeSpinReady") then 1 else 0)
end

SpinWindow.Attributes = { "Spins", "FreeSpinReady" }

local function totalWeight(): number
	local total = 0
	for _, segment in SEGMENTS do
		total += segment.Weight
	end
	return math.max(total, 0.0001)
end

-- Колесо: круг, разделители и подписи сегментов. Всё внутри wheel, который вращается целиком.
local function buildWheel(holder: Frame): Frame
	local wheel = create("Frame", {
		Name = "Wheel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.94),
		BackgroundColor3 = WHEEL_BG,
		Parent = holder,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		create("UIStroke", { Color = COLORS.Gold, Thickness = 4 }),
	})
	local step = 360 / #SEGMENTS
	for index, segment in SEGMENTS do
		-- Подпись: «контейнер на весь круг» повёрнут к центру сегмента, сама подпись — у обода.
		-- Rotation поворачивает вокруг центра объекта, поэтому контейнер размером с колесо.
		local arm = create("Frame", {
			Name = "Segment" .. index,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = (index - 0.5) * step,
			Parent = wheel,
		})
		local icon, text, color = Rewards.describe(segment.Reward)
		-- Цветная точка у обода (цвет награды) и подпись без фона — соседние подписи не наезжают
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.025),
			Size = UDim2.fromScale(0.05, 0.05),
			BackgroundColor3 = color,
			Parent = arm,
		}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
		local chip = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.085),
			Size = UDim2.fromScale(0.21, 0.28),
			BackgroundTransparency = 1,
			Parent = arm,
		})
		UiKit.text({
			Text = icon,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 0.5),
			Parent = chip,
		})
		local label = UiKit.text({
			Name = "Label",
			Text = text,
			TextScaled = true,
			TextWrapped = true,
			TextColor3 = color,
			TextStrokeTransparency = 0.2,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromScale(0.04, 0.5),
			Size = UDim2.fromScale(0.92, 0.48),
			Parent = chip,
		})
		create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 6, Parent = label })

		-- Разделитель на границе сегмента
		local divider = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Rotation = index * step,
			Parent = wheel,
		})
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.new(0, 2, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Parent = divider,
		})
	end
	-- Ступица по центру
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.16, 0.16),
		BackgroundColor3 = COLORS.Gold,
		ZIndex = 2,
		Parent = wheel,
	}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	return wheel
end

function SpinWindow.Start(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("SpinTitle"), Vector2.new(660, 430))
	window.Name = "SpinWindow"
	ctx.Register("Spin", window)

	-- Слева колесо (квадрат по высоте), справа кнопки и шансы
	local holder = create("Frame", {
		Size = UDim2.fromScale(0.5, 1),
		BackgroundTransparency = 1,
		Parent = body,
	}, { create("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	local wheel = buildWheel(holder)
	UiKit.text({
		Text = "▼",
		TextScaled = true,
		TextColor3 = COLORS.Red,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.35),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.14, 0.14),
		ZIndex = 5,
		Parent = holder,
	})

	local side = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, -10, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	local spinButton = UiKit.button({
		Text = "",
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = COLORS.Green,
		Parent = side,
	})
	create("UITextSizeConstraint", { MaxTextSize = 22, Parent = spinButton })
	create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = spinButton })
	UiKit.text({
		Text = Locale.T("SpinHint"),
		TextScaled = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = side,
	}, { create("UITextSizeConstraint", { MaxTextSize = 14 }) })

	-- Покупка вращений
	local buyRow = create("Frame", {
		Position = UDim2.fromOffset(0, 78),
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = side,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for order, key in { "Spins3", "Spins10" } do
		local product = Config.Products[key]
		local buy = UiKit.button({
			Text = "🎡 +" .. tostring(product.Spins or 0) .. " · R$ " .. product.Robux,
			TextScaled = true,
			Size = UDim2.new(0.5, -3, 1, 0),
			BackgroundColor3 = COLORS.Purple,
			LayoutOrder = order,
			Parent = buyRow,
		})
		create("UITextSizeConstraint", { MaxTextSize = 16, Parent = buy })
		create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = buy })
		buy.Activated:Connect(function()
			Rewards.promptProduct(key, ctx.Toast)
		end)
	end

	-- Шансы
	UiKit.text({
		Text = Locale.T("SpinOdds"),
		TextSize = 16,
		TextColor3 = COLORS.Gold,
		Position = UDim2.fromOffset(0, 124),
		Size = UDim2.new(1, 0, 0, 20),
		Parent = side,
	})
	local odds = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 146),
		Size = UDim2.new(1, 0, 1, -146),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = side,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		create("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})
	local oddsLabels = {}
	local total = totalWeight()
	for index, segment in SEGMENTS do
		local label = UiKit.text({
			Text = "",
			RichText = true,
			TextScaled = true,
			Font = Enum.Font.Gotham,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = index,
			Parent = odds,
		}, { create("UITextSizeConstraint", { MaxTextSize = 14 }) })
		oddsLabels[index] = { Label = label, Percent = segment.Weight / total * 100 }
	end

	local function renderOdds()
		for index, segment in SEGMENTS do
			local entry = oddsLabels[index]
			local icon, text, color = Rewards.describe(segment.Reward)
			local percent = entry.Percent
			local percentText = if percent >= 1 then string.format("%.0f%%", percent) else string.format("%.1f%%", percent)
			entry.Label.Text = icon .. ' <font color="#' .. color:ToHex() .. '">' .. text .. "</font> — " .. percentText
		end
	end

	local spinning = false
	local function renderButton()
		if spinning then
			spinButton.Text = Locale.T("SpinSpinning")
			spinButton.BackgroundColor3 = COLORS.PanelLight
			spinButton.AutoButtonColor = false
			return
		end
		local spins = Util.num(player, "Spins")
		if Util.bool(player, "FreeSpinReady") then
			spinButton.Text = Locale.T("SpinFree")
		elseif spins > 0 then
			spinButton.Text = Locale.T("SpinLeft", { Count = spins })
		else
			spinButton.Text = Locale.T("SpinNone")
		end
		local can = SpinWindow.Available() > 0
		spinButton.BackgroundColor3 = if can then COLORS.Green else COLORS.Panel
		spinButton.AutoButtonColor = can
	end

	-- Докрутить колесо так, чтобы сегмент index оказался под указателем сверху
	local function spinTo(index: number)
		local step = 360 / #SEGMENTS
		local center = (index - 0.5) * step
		local jitter = (math.random() - 0.5) * step * 0.6
		local current = wheel.Rotation % 360
		wheel.Rotation = current
		local base = current + 360 * TURNS
		local desired = (-center + jitter) % 360
		local target = base + (desired - base) % 360
		local tween = TweenService:Create(wheel, TweenInfo.new(SPIN_TIME, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			Rotation = target,
		})
		tween:Play()
		tween.Completed:Wait()
	end

	spinButton.Activated:Connect(function()
		if spinning or SpinWindow.Available() <= 0 then
			return
		end
		spinning = true
		renderButton()
		-- Пока ждём ответа и крутим, всплывашку с наградой придерживаем
		Rewards.SpinHoldUntil = os.clock() + 15
		local success, key, segmentIndex = Rewards.invoke("Spin")
		if success and type(segmentIndex) == "number" and SEGMENTS[segmentIndex] then
			Rewards.SpinHoldUntil = os.clock() + SPIN_TIME + 0.3
			spinTo(segmentIndex)
		else
			Rewards.SpinHoldUntil = 0
			if not success and type(key) == "string" then
				ctx.Toast(Locale.T(key), "error")
			end
		end
		Rewards.SpinHoldUntil = 0
		spinning = false
		renderButton()
	end)

	for _, name in SpinWindow.Attributes do
		player:GetAttributeChangedSignal(name):Connect(renderButton)
	end
	-- Подписи «~$X» зависят от дохода — обновляем при открытии окна
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if window.Visible then
			renderOdds()
			for index, segment in SEGMENTS do
				local label = wheel:FindFirstChild("Segment" .. index, true)
				local text = label and label:FindFirstChild("Label", true)
				if text and text:IsA("TextLabel") then
					text.Text = select(2, Rewards.describe(segment.Reward))
				end
			end
		end
	end)
	renderOdds()
	renderButton()
end

return SpinWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Status</string>
            <string name="Source"><![CDATA[-- Состояние своего персонажа над панелью предметов (снизу по центру):
-- перезарядка экипированного предмета (Tool.CooldownEndsAt), невидимость (Invisible) и энергетик (BoostUntil).
-- Пока своя невидимость включена, игрок видит себя полупрозрачным (LocalTransparencyModifier) —
-- остальные не видят его вовсе (это делает сервер).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer

local SELF_GHOST = 0.6 -- насколько прозрачным игрок видит себя в невидимости
local HIDDEN = 0.99 -- деталь считается спрятанной сервером, если прозрачнее этого
local HOTBAR_GAP = 78 -- отступ от низа экрана: над стандартной панелью предметов Roblox
local INVIS_COLOR = Color3.fromRGB(190, 200, 230)
local BOOST_COLOR = Color3.fromRGB(110, 255, 140)

local Status = {}

-- Небольшая плашка с текстом и обводкой
local function chip(parent: Instance, order: number, stroke: Color3): TextLabel
	local label = UiKit.text({
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 28),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.15,
		LayoutOrder = order,
		Visible = false,
		Parent = parent,
	})
	UiKit.corner(8).Parent = label
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = label })
	create("UIStroke", { Color = stroke, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = label })
	return label
end

-- ===== Своя полупрозрачность в невидимости =====
-- Сервер прячет детали (Transparency = 1) для всех. Чтобы игрок видел себя, локально
-- возвращаем исходную прозрачность и добавляем LocalTransparencyModifier.
-- Исходную прозрачность запоминаем, пока невидимость выключена.
local original: { [Instance]: number } = {}
local touched: { [Instance]: boolean } = {}

local function isVisual(inst: Instance): boolean
	if inst:IsA("BasePart") then
		return inst.Name ~= "HumanoidRootPart"
	end
	return inst:IsA("Decal")
end

local function remember(inst: Instance)
	if isVisual(inst) and original[inst] == nil then
		original[inst] = (inst :: any).Transparency
	end
end

local function applyGhost(character: Model)
	for _, inst in character:GetDescendants() do
		if isVisual(inst) then
			local target = inst :: any
			local base = original[inst]
			if base and base < HIDDEN and target.Transparency >= HIDDEN then
				target.Transparency = base
			end
			target.LocalTransparencyModifier = math.max(target.LocalTransparencyModifier, SELF_GHOST)
			touched[inst] = true
		end
	end
end

local function clearGhost()
	-- Transparency не трогаем: сервер сам вернёт исходную (ту же, что мы поставили локально)
	for inst in touched do
		if inst.Parent then
			(inst :: any).LocalTransparencyModifier = 0
		end
	end
	table.clear(touched)
end

local function trackCharacter(character: Model)
	table.clear(original)
	table.clear(touched)
	for _, inst in character:GetDescendants() do
		remember(inst)
	end
	character.DescendantAdded:Connect(function(inst)
		if not Util.bool(character, "Invisible") then
			remember(inst)
		end
	end)
end

function Status.Start(ctx)
	local holder = create("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -HOTBAR_GAP),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = ctx.Gui,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	ctx.Scale(holder)

	-- Перезарядка: имя предмета + полоса + секунды
	local cooldown = create("Frame", {
		Name = "Cooldown",
		Size = UDim2.fromOffset(170, 44),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.15,
		LayoutOrder = 1,
		Visible = false,
		Parent = holder,
	}, {
		UiKit.corner(8),
		create("UIStroke", { Color = COLORS.Gold, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	local itemName = UiKit.text({
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 2),
		Size = UDim2.new(1, -12, 0, 18),
		Parent = cooldown,
	})
	create("UITextSizeConstraint", { MaxTextSize = 14, Parent = itemName })
	local bar = create("Frame", {
		Position = UDim2.fromOffset(8, 22),
		Size = UDim2.new(1, -16, 0, 16),
		BackgroundColor3 = COLORS.PanelLight,
		Parent = cooldown,
	}, { UiKit.corner(5) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLORS.Gold,
		Parent = bar,
	}, { UiKit.corner(5) })
	local seconds = UiKit.text({
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bar,
	})

	local invisible = chip(holder, 2, INVIS_COLOR)
	invisible.TextColor3 = INVIS_COLOR
	local boost = chip(holder, 3, BOOST_COLOR)
	boost.TextColor3 = BOOST_COLOR

	if player.Character then
		trackCharacter(player.Character)
	end
	player.CharacterAdded:Connect(trackCharacter)

	local wasInvisible = false
	local invisibleSince = 0

	local function render()
		local now = Util.now()
		local character = player.Character

		-- Экипированный предмет на перезарядке
		local tool = character and character:FindFirstChildOfClass("Tool")
		local left = if tool then Util.num(tool, "CooldownEndsAt") - now else 0
		cooldown.Visible = left > 0
		if tool and left > 0 then
			local itemId = Util.str(tool, "ItemId")
			local item = Config.GetItem(if itemId ~= "" then itemId else tool.Name)
			local total = if item and item.Cooldown and item.Cooldown > 0 then item.Cooldown else left
			itemName.Text = if item then item.Face .. " " .. Locale.Name(item) else tool.Name
			fill.Size = UDim2.fromScale(math.clamp(left / total, 0, 1), 1)
			seconds.Text = Locale.T("StatusCooldown", { Seconds = string.format("%.1f", left) })
		end

		-- Невидимость: длительность — из Config.Items (сервер даёт только флаг)
		local isInvisible = character ~= nil and Util.bool(character, "Invisible")
		if isInvisible and not wasInvisible then
			invisibleSince = now
		end
		if isInvisible and character then
			applyGhost(character)
			local hat = Config.GetItem("InvisHat")
			local duration = if hat and hat.Duration then hat.Duration else 0
			invisible.Text = Locale.T("StatusInvisible", { Time = Util.clock(math.ceil(duration - (now - invisibleSince))) })
		elseif wasInvisible then
			clearGhost()
		end
		invisible.Visible = isInvisible
		wasInvisible = isInvisible

		local boostLeft = if character then Util.num(character, "BoostUntil") - now else 0
		boost.Visible = boostLeft > 0
		if boostLeft > 0 then
			boost.Text = Locale.T("StatusBoost", { Time = Util.clock(math.ceil(boostLeft)) })
		end
	end

	task.spawn(function()
		while true do
			render()
			task.wait(0.1)
		end
	end)
end

return Status
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Strings</string>
            <string name="Source"><![CDATA[--!strict
-- Строки клиентского интерфейса (англ. + рус.). Добавляются в общий Locale через Locale.Add,
-- чтобы не трогать Shared/Locale.luau. Подключается первым в init.client.luau.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Locale = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Locale"))

Locale.Add({
	-- HUD
	UiIncome = { "+{Coins}/s", "+{Coins}/сек" },
	UiSlots = { "📦 {Used}/{Max}", "📦 {Used}/{Max}" },
	UiRebirths = { "♻️ {Count}", "♻️ {Count}" },
	UiIndexBonus = { "📖 +{Percent}%", "📖 +{Percent}%" },
	UiGiftIn = { "🎁 Gift in {Time}", "🎁 Подарок через {Time}" },
	UiGiftsDone = { "🎁 All gifts claimed!", "🎁 Все подарки получены!" },

	-- боковые кнопки
	BtnShop = { "Shop", "Магазин" },
	BtnIndex = { "Index", "Индекс" },
	BtnRebirth = { "Rebirth", "Рестарт" },
	BtnLock = { "Lock", "Замок" },
	BtnGuard = { "Guard", "Страж" },
	BtnMax = { "MAX", "МАКС" },

	-- баннеры
	BannerTrend = { "📈 TRENDING: {Meme} x{Mult} — {Time}", "📈 В ТРЕНДЕ: {Meme} ×{Mult} — {Time}" },
	BannerNight = { "🌙 SMILEY NIGHT {Time}", "🌙 НОЧЬ СМАЙЛИКА {Time}" },
	BannerNextNight = { "🌙 Next night in {Time}", "🌙 Ночь через {Time}" },
	BannerLuck = { "🍀 SERVER LUCK x2 — {Time}", "🍀 УДАЧА СЕРВЕРА ×2 — {Time}" },
	BannerCarry = { "Carrying {Meme}! Run to your base! {Time}", "Несёшь: {Meme}! Беги на свою базу! {Time}" },

	-- табличка мема
	BbViral = { "VIRAL", "ВИРУСНЫЙ" },
	BbIncome = { "{Coins}/s", "{Coins}/сек" },

	-- подсказки (ProximityPrompt)
	PromptBuy = { "Buy", "Купить" },
	PromptSteal = { "Steal", "Украсть" },
	PromptSell = { "Sell", "Продать" },
	PromptMerge = { "Make VIRAL ({Count} → 1)", "Сделать ВИРУСНЫМ ({Count} → 1)" },
	PromptLock = { "Lock base", "Закрыть базу" },
	PromptLockObject = { "{Seconds}s", "{Seconds} сек" },

	-- таблички баз
	SignFree = { "Free", "Свободно" },
	SignYours = { "YOUR BASE", "ТВОЯ БАЗА" },
	YourBaseArrow = { "YOUR BASE ⬇", "ТВОЯ БАЗА ⬇" },

	-- магазин
	ShopTitle = { "🛒 Shop", "🛒 Магазин" },
	ShopPasses = { "Game Passes (forever)", "Геймпассы (навсегда)" },
	ShopProducts = { "Boosts and Cash", "Бусты и деньги" },
	ShopOwned = { "Owned", "Куплено" },
	ShopCashHint = { "~{Coins}", "~{Coins}" },

	-- индекс
	IndexTitle = { "📖 Index", "📖 Индекс" },
	IndexHeader = { "Discovered {Count} — +{Percent}% income", "Открыто {Count} — +{Percent}% дохода" },
	IndexSub = { "Memes: {Found}/{Total} · Mutated: {Mutated}", "Мемы: {Found}/{Total} · С мутацией: {Mutated}" },
	IndexUnknown = { "???", "???" },
	IndexEvent = { "Night only", "Только ночью" },

	-- перерождение
	RebirthTitle = { "♻️ Rebirth", "♻️ Перерождение" },
	RebirthCost = { "Cost: {Price}", "Цена: {Price}" },
	RebirthPerkIncome = { "✅ +{Percent}% income forever (now x{Mult})", "✅ +{Percent}% дохода навсегда (сейчас ×{Mult})" },
	RebirthPerkSlots = { "✅ +{Count} base slots", "✅ +{Count} слота на базе" },
	RebirthPerkSlotsMax = { "Slots are already at max", "Слотов уже максимум" },
	RebirthCashReset = { "Your cash resets to $0, memes stay", "Деньги обнулятся, мемы останутся" },
	RebirthButton = { "REBIRTH", "ПЕРЕРОДИТЬСЯ" },

	-- страж
	GuardTitle = { "🐱⚔️ Sword Kitten Guard", "🐱⚔️ Страж: Kitten with a Sword" },
	GuardInfo = { "Slaps thieves who carry memes away from your base.", "Бьёт воров, которые уносят мемов с твоей базы." },
	GuardLevelNow = { "Level {Level}/{Max}", "Уровень {Level}/{Max}" },
	GuardNext = { "Next: range {Range} · hit every {Cooldown}s", "Дальше: радиус {Range} · удар раз в {Cooldown} сек" },
	GuardBuy = { "Hire for {Price}", "Нанять за {Price}" },
	GuardUpgrade = { "Upgrade for {Price}", "Улучшить за {Price}" },
	GuardMaxed = { "MAX LEVEL", "МАКС. УРОВЕНЬ" },

	-- всплывающие окна
	PopupOfflineTitle = { "Welcome back!", "С возвращением!" },
	PopupOffline = { "While you were away ({Time}) you earned {Coins}", "Пока тебя не было ({Time}), ты заработал {Coins}" },
	PopupDailyTitle = { "Daily reward", "Ежедневная награда" },
	PopupDaily = { "Day {Day} reward: {Coins}", "Награда за день {Day}: {Coins}" },
	PopupOk = { "OK", "OK" },

	-- ответы сервера без своей строки в Locale
	NotLoaded = { "Loading your data, try again in a moment", "Загружаем твои данные, попробуй через секунду" },

	-- эффекты
	FxRebirth = { "REBIRTH!", "ПЕРЕРОЖДЕНИЕ!" },
	FxSlip = { "SLIP!", "БАЦ!" },
