-- Ответы сервера v4: добавляем, только если сервер не положил свои строки в Shared/Strings
do
	local fallback: { [string]: { string } } = {
		CodeRedeemed = { "Code redeemed!", "Код активирован!" },
		CodeInvalid = { "This code doesn't exist", "Такого кода нет" },
		CodeUsed = { "You already used this code", "Ты уже активировал этот код" },
		CodeExpired = { "This code has expired", "Срок действия кода истёк" },
	}
	local missing = {}
	for key, value in fallback do
		if Locale.T(key) == key then
			missing[key] = value
		end
	end
	Locale.Add(missing)
end

return Locale
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">TradeWindow</string>
            <string name="Source"><![CDATA[-- Обмен мемами между игроками. Клиент только показывает состояние и шлёт намерения; что можно
-- отдать, кто готов и сам обмен решает сервер (TradeService).
--  * Окно выбора игрока ("TradePick") -> Remotes.TradeRequest(userId).
--  * Входящий запрос (Remotes.TradeIncoming(fromUserId, fromName)) — карточка справа
--    «Принять / Отказать» -> Remotes.TradeRespond(fromUserId, accept); пропадает через Config.Trade.RequestTimeout.
--  * Окно обмена — пока Remotes.TradeState присылает state (nil — обмен закрыт). Слева свои мемы
--    (модели в Memes своей базы: CreatureId, Mutation, Viral, Slot; несомых State == "Carried" пропускаем),
--    нажатие добавляет/убирает слот -> Remotes.TradeSetOffer(slots); справа state.TheirOffer.
--    «Готов» -> Remotes.TradeReady(bool), «Отмена» / крестик -> Remotes.TradeCancel().
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local SELECTED_COLOR = Color3.fromRGB(40, 95, 60)
local VIRAL_COLOR = Color3.fromRGB(255, 80, 220)

local TradeWindow = {}

local function remote(name: string): RemoteEvent
	return Remotes:WaitForChild(name) :: RemoteEvent
end

-- Список с прокруткой; grid = true — две колонки карточек мемов
local function scroller(parent: Instance, position: UDim2, size: UDim2, grid: boolean): ScrollingFrame
	local layout = if grid
		then create("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 62),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		else create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	return create("ScrollingFrame", {
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	}, { layout, create("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2) }) })
end

-- Карточка мема: эмодзи, имя (всегда по-английски), мутация/вирусный, доход в секунду
local function memeCard(parent: Instance, order: number, id: string, mutation: string, viral: boolean): TextButton
	local creature = Config.GetCreature(id)
	local card = UiKit.button({
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = COLORS.PanelLight,
		LayoutOrder = order,
		Parent = parent,
	})
	create("UIStroke", {
		Name = "Selected",
		Color = COLORS.Green,
		Thickness = 3,
		Enabled = false,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = card,
	})
	UiKit.text({
		Text = if creature then creature.Face else "❓",
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(4, 7),
		Size = UDim2.fromOffset(46, 46),
		Parent = card,
	})
	UiKit.text({
		Text = if creature then creature.Name else id,
		TextScaled = true,
		Position = UDim2.fromOffset(54, 4),
		Size = UDim2.new(1, -58, 0, 20),
		Parent = card,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 7 }) })
	local mut = Config.GetMutation(mutation)
	local tags = {}
	if mut.Id ~= "None" then
		table.insert(tags, Locale.Name(mut))
	end
	if viral then
		table.insert(tags, Locale.T("BbViral"))
	end
	UiKit.text({
		Text = table.concat(tags, " · "),
		TextScaled = true,
		TextColor3 = if viral then VIRAL_COLOR else (mut.Color or COLORS.Muted),
		Position = UDim2.fromOffset(54, 24),
		Size = UDim2.new(1, -58, 0, 16),
		Parent = card,
	}, { create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 7 }) })
	UiKit.text({
		Text = Locale.T("BbIncome", { Coins = Config.BaseIncome(id, mutation, viral) }),
		TextScaled = true,
		TextColor3 = COLORS.Green,
		Position = UDim2.fromOffset(54, 41),
		Size = UDim2.new(1, -58, 0, 16),
		Parent = card,
	}, { create("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 7 }) })
	return card
end

-- ===== Выбор игрока =====
local function buildPicker(ctx)
	local window, body = UiKit.window(ctx.Gui, Locale.T("TradePickTitle"), Vector2.new(420, 420))
	window.Name = "TradePickWindow"
	ctx.Register("TradePick", window)
	local list = scroller(body, UDim2.new(), UDim2.fromScale(1, 1), false)

	local function render()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local others = {}
		for _, other in Players:GetPlayers() do
			if other ~= player then
				table.insert(others, other)
			end
		end
		table.sort(others, function(a, b)
			return a.DisplayName:lower() < b.DisplayName:lower()
		end)
		if #others == 0 then
			UiKit.text({
				Text = Locale.T("TradePickEmpty"),
				TextSize = 16,
				TextColor3 = COLORS.Muted,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 40),
				Parent = list,
			})
			return
		end
		for order, other in others do
			local button = UiKit.button({
				Text = "",
				BackgroundColor3 = COLORS.PanelLight,
				Size = UDim2.new(1, 0, 0, 52),
				LayoutOrder = order,
				Parent = list,
			})
			UiKit.text({
				Text = other.DisplayName,
				TextScaled = true,
				Position = UDim2.fromOffset(12, 4),
				Size = UDim2.new(1, -70, 0, 26),
				Parent = button,
			}, { create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10 }) })
			UiKit.text({
				Text = "@" .. other.Name,
				TextSize = 13,
				Font = Enum.Font.Gotham,
				TextColor3 = COLORS.Muted,
				Position = UDim2.fromOffset(12, 30),
				Size = UDim2.new(1, -70, 0, 16),
				Parent = button,
			})
			UiKit.text({
				Text = "🤝",
				TextScaled = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(40, 40),
				Parent = button,
			})
			local userId = other.UserId
			button.Activated:Connect(function()
				-- Ответ (отправлено / занят / перезарядка) пришлёт сервер через Notify
				remote("TradeRequest"):FireServer(userId)
				window.Visible = false
			end)
		end
	end

	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if window.Visible then
			render()
		end
	end)
	Players.PlayerAdded:Connect(function()
		if window.Visible then
			render()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if window.Visible then
			task.defer(render)
		end
	end)
end

-- ===== Входящие запросы =====
local function buildIncoming(ctx)
	local holder = create("Frame", {
		Name = "TradeRequests",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.42, 0),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = 15,
		Parent = ctx.Gui,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	ctx.Scale(holder)

	local cards: { [number]: Frame } = {}
	local count = 0

	local function dismiss(userId: number)
		local card = cards[userId]
		if card then
			cards[userId] = nil
			card:Destroy()
		end
	end

	local function show(fromUserId: number, fromName: string)
		dismiss(fromUserId)
		count += 1
		local card = create("Frame", {
			Size = UDim2.fromOffset(300, 112),
			BackgroundColor3 = COLORS.Panel,
			BackgroundTransparency = 0.05,
			LayoutOrder = count,
			Parent = holder,
		}, {
			UiKit.corner(12),
			UiKit.padding(10),
			create("UIStroke", { Color = COLORS.Purple, Thickness = 2 }),
		})
		UiKit.text({
			Text = Locale.T("TradeIncomingText", { Player = fromName }),
			TextScaled = true,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 36),
			Parent = card,
		}, { create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 10 }) })
		local timer = create("Frame", {
			Position = UDim2.fromOffset(0, 40),
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = COLORS.Purple,
			BorderSizePixel = 0,
			Parent = card,
		})
		local accept = UiKit.button({
			Text = Locale.T("TradeAccept"),
			TextSize = 18,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(0.5, -4, 0, 44),
			BackgroundColor3 = COLORS.Green,
			Parent = card,
		})
		local decline = UiKit.button({
			Text = Locale.T("TradeDecline"),
			TextSize = 18,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(1, 1),
			Size = UDim2.new(0.5, -4, 0, 44),
			BackgroundColor3 = COLORS.Red,
			Parent = card,
		})
		cards[fromUserId] = card

		local timeout = Config.Trade.RequestTimeout
		TweenService:Create(timer, TweenInfo.new(timeout, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 4) }):Play()
		accept.Activated:Connect(function()
			dismiss(fromUserId)
			remote("TradeRespond"):FireServer(fromUserId, true)
		end)
		decline.Activated:Connect(function()
			dismiss(fromUserId)
			remote("TradeRespond"):FireServer(fromUserId, false)
		end)
		task.delay(timeout, function()
			if cards[fromUserId] == card then
				dismiss(fromUserId)
			end
		end)
	end

	task.spawn(function()
		remote("TradeIncoming").OnClientEvent:Connect(function(fromUserId, fromName)
			if type(fromUserId) ~= "number" then
				return
			end
			show(fromUserId, if type(fromName) == "string" then fromName else "?")
		end)
	end)

	-- Начался обмен — старые запросы больше не нужны
	return function()
		for userId in cards do
			dismiss(userId)
		end
	end
end

-- ===== Окно обмена =====
local function buildTrade(ctx, clearRequests: () -> ())
	-- Окно не регистрируется в ctx: другие окна не должны закрывать идущий обмен
	local window, body = UiKit.window(ctx.Gui, "", Vector2.new(760, 460))
	window.Name = "TradeWindow"
	window.ZIndex = 8
	local title = window:FindFirstChildWhichIsA("TextLabel") :: TextLabel

	local left = create("Frame", {
		Size = UDim2.new(0.5, -4, 1, -60),
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 1,
		Parent = body,
	})
	local right = create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.5, -4, 1, -60),
		BackgroundTransparency = 1,
		Parent = body,
	})
	local myHeader = UiKit.text({ TextScaled = true, TextColor3 = COLORS.Gold, Size = UDim2.new(1, 0, 0, 22), Parent = left }, {
		create("UITextSizeConstraint", { MaxTextSize = 18 }),
	})
	local tip = UiKit.text({
		Text = Locale.T("TradeTip"),
		TextScaled = true,
		Font = Enum.Font.Gotham,
		TextColor3 = COLORS.Muted,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = left,
	}, { create("UITextSizeConstraint", { MaxTextSize = 13 }) })
	local myList = scroller(left, UDim2.fromOffset(0, 40), UDim2.new(1, 0, 1, -40), true)
	local theirHeader = UiKit.text({ TextScaled = true, TextColor3 = COLORS.Gold, Size = UDim2.new(1, 0, 0, 22), Parent = right }, {
		create("UITextSizeConstraint", { MaxTextSize = 18 }),
	})
	local theirList = scroller(right, UDim2.fromOffset(0, 40), UDim2.new(1, 0, 1, -40), true)

	local status = UiKit.text({
		TextScaled = true,
		TextWrapped = true,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, -280, 0, 50),
		Parent = body,
	}, { create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 9 }) })
	local ready = UiKit.button({
		TextSize = 20,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -132, 1, 0),
		Size = UDim2.fromOffset(140, 50),
		BackgroundColor3 = COLORS.Green,
		Parent = body,
	})
	local cancel = UiKit.button({
		Text = Locale.T("TradeBtnCancel"),
		TextSize = 18,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(124, 50),
		BackgroundColor3 = COLORS.Red,
		Parent = body,
	})

	local state: any = nil
	local pending: { number } = {} -- свои выбранные слоты (сразу после нажатия, до ответа сервера)

	local function isPending(slot: number): boolean
		return table.find(pending, slot) ~= nil
	end

	-- Свои мемы на базе: { Slot, Id, Mut, Viral }, сначала самые доходные
	local function myMemes()
		local result = {}
		local plot = Util.myPlot()
		local folder = plot and plot:FindFirstChild("Memes")
		if not folder then
			return result
		end
		for _, model in folder:GetChildren() do
			local id = Util.str(model, "CreatureId")
			local slot = Util.num(model, "Slot")
			if id ~= "" and slot > 0 and Util.str(model, "State") ~= "Carried" and Config.GetCreature(id) then
				table.insert(result, { Slot = slot, Id = id, Mut = Util.str(model, "Mutation"), Viral = Util.bool(model, "Viral") })
			end
		end
		table.sort(result, function(a, b)
			local ia, ib = Config.BaseIncome(a.Id, a.Mut, a.Viral), Config.BaseIncome(b.Id, b.Mut, b.Viral)
			if ia == ib then
				return a.Slot < b.Slot
			end
			return ia > ib
		end)
		return result
	end

	local function clear(frame: Instance)
		for _, child in frame:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
	end

	local function emptyNote(parent: Instance, key: string)
		UiKit.text({
			Text = Locale.T(key),
			TextSize = 14,
			TextWrapped = true,
			TextColor3 = COLORS.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = parent,
		})
	end

	local render: () -> ()

	local function toggle(slot: number)
		if not state then
			return
		end
		local slots = table.clone(pending)
		local index = table.find(slots, slot)
		if index then
			table.remove(slots, index)
		elseif #slots >= Config.Trade.MaxMemes then
			ctx.Toast(Locale.T("TradeMaxMemes", { Count = Config.Trade.MaxMemes }), "error")
			return
		else
			table.insert(slots, slot)
		end
		pending = slots
		remote("TradeSetOffer"):FireServer(slots)
		render()
	end

	local function renderMine()
		clear(myList)
		local memes = myMemes()
		if #memes == 0 then
			emptyNote(myList, "TradeNoMemes")
		end
		for order, meme in memes do
			local card = memeCard(myList, order, meme.Id, meme.Mut, meme.Viral)
			local selected = isPending(meme.Slot)
			card.BackgroundColor3 = if selected then SELECTED_COLOR else COLORS.PanelLight
			local stroke = card:FindFirstChild("Selected") :: UIStroke
			stroke.Enabled = selected
			card.Activated:Connect(function()
				toggle(meme.Slot)
			end)
		end
	end

	local function renderTheirs()
		clear(theirList)
		local offer = if state and type(state.TheirOffer) == "table" then state.TheirOffer else {}
		if #offer == 0 then
			emptyNote(theirList, "TradeNothing")
		end
		for order, meme in offer do
			if type(meme) == "table" and type(meme.Id) == "string" then
				memeCard(theirList, order, meme.Id, if type(meme.Mut) == "string" then meme.Mut else "None", meme.Viral == true)
			end
		end
	end

	local function renderStatus()
		if not state then
			return
		end
		local endsAt = if type(state.CountdownEndsAt) == "number" then state.CountdownEndsAt else 0
		if endsAt > 0 then
			status.Text = "⏳ " .. Locale.T("TradeCountdown", { Seconds = math.max(0, math.ceil(endsAt - Util.now())) })
			status.TextColor3 = COLORS.Green
		else
			status.Text = Locale.T("TradeWaiting")
			status.TextColor3 = COLORS.Muted
		end
	end

	render = function()
		if not state then
			return
		end
		local partner = if type(state.PartnerName) == "string" then state.PartnerName else "?"
		title.Text = Locale.T("TradeTitle", { Player = partner })
		myHeader.Text = Locale.T("TradeYourOffer", { Count = #pending, Max = Config.Trade.MaxMemes })
			.. (if state.MyReady then "  ✅" else "")
		theirHeader.Text = Locale.T("TradeTheirOffer", { Player = partner }) .. (if state.TheirReady then "  ✅" else "")
		ready.Text = if state.MyReady then "✅ " .. Locale.T("TradeBtnReady") else Locale.T("TradeBtnReady")
		ready.BackgroundColor3 = if state.MyReady then COLORS.Purple else COLORS.Green
		tip.Visible = not state.MyReady
		renderMine()
		renderTheirs()
		renderStatus()
	end

	-- Следим за папкой мемов своей базы, пока открыт обмен
	local memesConnections: { RBXScriptConnection } = {}
	local function watchMemes()
		for _, connection in memesConnections do
			connection:Disconnect()
		end
		table.clear(memesConnections)
		local plot = Util.myPlot()
		local folder = plot and plot:FindFirstChild("Memes")
		if not folder then
			return
		end
		local function changed()
			if state then
				task.defer(render)
			end
		end
		table.insert(memesConnections, folder.ChildAdded:Connect(changed))
		table.insert(memesConnections, folder.ChildRemoved:Connect(changed))
	end

	local closingByServer = false
	local function onState(newState: any)
		if type(newState) ~= "table" then
			state = nil
			pending = {}
			closingByServer = true
			window.Visible = false
			closingByServer = false
			for _, connection in memesConnections do
				connection:Disconnect()
			end
			table.clear(memesConnections)
			return
		end
		local opening = state == nil
		state = newState
		pending = {}
		if type(newState.MyOffer) == "table" then
			for _, item in newState.MyOffer do
				if type(item) == "table" and type(item.Slot) == "number" then
					table.insert(pending, item.Slot)
				end
			end
		end
		if opening then
			clearRequests()
			-- Прячем остальные окна, чтобы обмен был на виду
			for _, other in ctx.Windows do
				other.Visible = false
			end
			watchMemes()
		end
		window.Visible = true
		render()
	end

	ready.Activated:Connect(function()
		if state then
			remote("TradeReady"):FireServer(not state.MyReady)
		end
	end)
	cancel.Activated:Connect(function()
		if state then
			remote("TradeCancel"):FireServer()
		end
	end)
	-- Крестик окна = отмена обмена
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if not window.Visible and state and not closingByServer then
			remote("TradeCancel"):FireServer()
			window.Visible = true -- окно закроет ответ сервера (TradeState nil)
		end
	end)

	task.spawn(function()
		remote("TradeState").OnClientEvent:Connect(onState)
	end)
	task.spawn(function()
		while true do
			if state and window.Visible then
				renderStatus()
			end
			task.wait(0.2)
		end
	end)
end

function TradeWindow.Start(ctx)
	buildPicker(ctx)
	local clearRequests = buildIncoming(ctx)
	buildTrade(ctx, clearRequests)
end

return TradeWindow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[-- Обучение новичка (атрибут игрока TutorialDone == 0): карточка с шагом внизу по центру и
-- локальный луч от персонажа к цели. Шаги: купить мема -> доход -> украсть -> защитить базу.
-- Прогресс читается из атрибутов (SlotsUsed, Stolen, LockedUntil базы). В конце или по «Пропустить»
-- клиент сообщает серверу Remotes.TutorialDone — награды/сохранение решает сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Locale = require(Shared:WaitForChild("Locale"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Util = require(script.Parent:WaitForChild("Util"))

local COLORS = UiKit.Colors
local create = UiKit.create
local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local TOTAL_STEPS = 4
local INCOME_STEP_TIME = 7
local STEAL_SKIP_HINT = 90 -- через столько секунд кнопка «Пропустить» на шаге кражи становится заметной
local PROTECT_STEP_TIME = 15
local CARD_BOTTOM = 128 -- над панелью состояния и стандартной панелью предметов
local BEAM_COLOR = Color3.fromRGB(255, 220, 60)
local POLL = 0.2

local Tutorial = {}

-- Ближайший пол чужой занятой базы (или nil)
local function nearestOtherFloor(from: Vector3): BasePart?
	local folder = workspace:FindFirstChild("Plots")
	if not folder then
		return nil
	end
	local best: BasePart? = nil
	local bestDistance = math.huge
	for _, plot in folder:GetChildren() do
		local owner = Util.num(plot, "OwnerUserId")
		local floor = plot:FindFirstChild("Floor")
		if owner ~= 0 and owner ~= player.UserId and floor and floor:IsA("BasePart") then
			local distance = (floor.Position - from).Magnitude
			if distance < bestDistance then
				best, bestDistance = floor, distance
			end
		end
	end
	return best
end

local function run(ctx)
	-- Ждём загрузки данных: до неё TutorialDone ещё не известен
	while not Util.bool(player, "DataLoaded") do
		player:GetAttributeChangedSignal("DataLoaded"):Wait()
	end
	if player:GetAttribute("TutorialDone") == nil then
		task.wait(3) -- атрибут мог прийти чуть позже DataLoaded
	end
	if player:GetAttribute("TutorialDone") ~= 0 then
		return
	end

	-- ===== Карточка шага =====
	local card = create("Frame", {
		Name = "Tutorial",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -CARD_BOTTOM),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = COLORS.Panel,
		BackgroundTransparency = 0.1,
		Parent = ctx.Gui,
	}, {
		UiKit.corner(12),
		UiKit.padding(10),
		create("UIStroke", { Color = COLORS.Gold, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	})
	ctx.Scale(card)

	local header = UiKit.text({
		Text = "",
		TextSize = 14,
		TextColor3 = COLORS.Gold,
		Size = UDim2.new(1, -110, 0, 18),
		Parent = card,
	})
	local message = UiKit.text({
		Text = "",
		TextSize = 18,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -110, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	})
	local pop = create("UIScale", { Parent = message })
	local skip = UiKit.button({
		Text = Locale.T("TutorialSkip"),
		TextSize = 15,
		TextColor3 = COLORS.Muted,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(100, 34),
		BackgroundColor3 = COLORS.PanelLight,
		Parent = card,
	})
	local skipStroke = create("UIStroke", {
		Color = COLORS.Gold,
		Thickness = 2,
		Enabled = false,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = skip,
	})

	-- ===== Луч к цели (виден только этому игроку) =====
	local beam: Beam? = nil
	local fromAttachment: Attachment? = nil
	local toAttachment = create("Attachment", { Name = "TutorialTarget", Parent = workspace.Terrain })

	local function clearBeam()
		if beam then
			beam:Destroy()
		end
		if fromAttachment then
			fromAttachment:Destroy()
		end
		beam, fromAttachment = nil, nil
	end

	local function pointBeam(target: Vector3?)
		local _, root = Util.character()
		if not target or not root then
			clearBeam()
			return
		end
		toAttachment.WorldPosition = target
		if beam and fromAttachment and fromAttachment.Parent == root then
			return
		end
		clearBeam()
		local a0 = create("Attachment", { Name = "TutorialFrom", Parent = root })
		beam = create("Beam", {
			Name = "TutorialBeam",
			Attachment0 = a0,
			Attachment1 = toAttachment,
			Color = ColorSequence.new(BEAM_COLOR),
			Transparency = NumberSequence.new(0.2, 0.5),
			Width0 = 0.8,
			Width1 = 0.8,
			CurveSize0 = 6,
			CurveSize1 = -6,
			Segments = 20,
			FaceCamera = true,
			LightEmission = 1,
			Parent = root,
		})
		fromAttachment = a0
	end

	-- ===== Завершение =====
	local finished = false
	local function finish(completed: boolean)
		if finished then
			return
		end
		finished = true
		clearBeam()
		toAttachment:Destroy()
		card:Destroy()
		Remotes:WaitForChild("TutorialDone"):FireServer()
		if completed then
			ctx.Toast(Locale.T("TutorialFinished"), "success")
		end
	end
	skip.Activated:Connect(function()
		finish(false)
	end)
	player.CharacterRemoving:Connect(clearBeam)

	local function emphasizeSkip(on: boolean)
		skip.BackgroundColor3 = if on then COLORS.Gold else COLORS.PanelLight
		skip.TextColor3 = if on then COLORS.Panel else COLORS.Muted
		skipStroke.Enabled = on
	end

	local function setStep(step: number, key: string)
		header.Text = Locale.T("TutorialStep", { Step = step, Total = TOTAL_STEPS })
		message.Text = Locale.T(key)
		emphasizeSkip(false)
		pop.Scale = 1.15
		TweenService:Create(pop, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end

	-- Опрос условия шага; target() — куда вести луч (nil — без луча). Пока игрок несёт мема,
	-- карточку прячем: по центру уже баннер кражи.
	local function waitStep(done: () -> boolean, target: (() -> Vector3?)?, timeout: number?)
		local started = os.clock()
		while not finished do
			if done() or (timeout and os.clock() - started >= timeout) then
				return
			end
			card.Visible = Util.str(player, "Carrying") == ""
			pointBeam(if target then target() else nil)
			task.wait(POLL)
		end
	end

	-- Ковёр ищем в фоне (при StreamingEnabled может подгрузиться позже)
	local carpet: BasePart? = nil
	task.spawn(function()
		local map = workspace:WaitForChild("Map", 60)
		local found = map and map:WaitForChild("Carpet", 60)
		if found and found:IsA("BasePart") then
			carpet = found
		end
	end)

	-- Шаг 1: купить мема на дорожке
	setStep(1, "TutorialBuy")
	local slots = Util.num(player, "SlotsUsed")
	waitStep(function()
		local now = Util.num(player, "SlotsUsed")
		if now < slots then
			slots = now -- продал мема — считаем от нового значения
		end
		return now > slots
	end, function()
		return if carpet then carpet.Position + Vector3.new(0, carpet.Size.Y / 2 + 2, 0) else nil
	end)

	-- Шаг 2: доход
	if not finished then
		setStep(2, "TutorialIncome")
		waitStep(function()
			return false
		end, nil, INCOME_STEP_TIME)
	end

	-- Шаг 3: украсть и донести домой
	if not finished then
		setStep(3, "TutorialSteal")
		local stolen = Util.num(player, "Stolen")
		local started = os.clock()
		waitStep(function()
			return Util.num(player, "Stolen") > stolen
		end, function()
			local _, root = Util.character()
			local floor = if root then nearestOtherFloor(root.Position) else nil
			emphasizeSkip(floor == nil or os.clock() - started >= STEAL_SKIP_HINT)
			return if floor then floor.Position + Vector3.new(0, floor.Size.Y / 2 + 3, 0) else nil
		end)
	end

	-- Шаг 4: защита базы
	if not finished then
		setStep(4, "TutorialProtect")
		waitStep(function()
			return Util.num(Util.myPlot(), "LockedUntil") > Util.now()
		end, nil, PROTECT_STEP_TIME)
	end

	finish(true)
end

function Tutorial.Start(ctx)
	task.spawn(run, ctx)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">UiKit</string>
            <string name="Source"><![CDATA[-- Небольшой набор для построения UI кодом (Studio под рукой нет, поэтому весь интерфейс — в скриптах).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UiKit = {}

UiKit.Colors = {
	Panel = Color3.fromRGB(24, 26, 38),
	PanelLight = Color3.fromRGB(40, 43, 60),
	Text = Color3.fromRGB(245, 245, 255),
	Muted = Color3.fromRGB(160, 165, 190),
	Gold = Color3.fromRGB(255, 200, 50),
	Green = Color3.fromRGB(70, 210, 110),
	Red = Color3.fromRGB(235, 80, 80),
	Purple = Color3.fromRGB(160, 100, 255),
}
local COLORS = UiKit.Colors

-- create("Frame", { Size = ..., Parent = gui }, { UiKit.corner() })
-- Parent ставится последним, чтобы объект не реплицировался/рендерился наполовину настроенным.
function UiKit.create(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local create = UiKit.create

function UiKit.corner(radius: number?)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UiKit.padding(px: number)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

-- children (необязательно) — как у create: констрейнты, обводки и т.п.
function UiKit.text(props: { [string]: any }, children: { Instance }?): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or COLORS.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props, children)
end

-- Используйте .Activated, а не .MouseButton1Click: Activated работает и на телефоне, и на геймпаде.
function UiKit.button(props: { [string]: any }): TextButton
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or COLORS.Text
	props.AutoButtonColor = if props.AutoButtonColor == nil then true else props.AutoButtonColor
	return create("TextButton", props, { UiKit.corner(8) })
end

function UiKit.screen(name: string): ScreenGui
	return create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
end

-- Окно по центру с заголовком и кнопкой закрытия. Возвращает (window, body).
function UiKit.window(parent: Instance, title: string, maxSize: Vector2?): (Frame, Frame)
	local window = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.75),
		BackgroundColor3 = COLORS.Panel,
		Visible = false,
		Parent = parent,
	}, {
		UiKit.corner(14),
		UiKit.padding(14),
		create("UISizeConstraint", { MaxSize = maxSize or Vector2.new(500, 430) }),
		create("UIStroke", { Color = COLORS.PanelLight, Thickness = 2 }),
	})
	UiKit.text({ Text = title, TextSize = 26, Size = UDim2.new(1, -50, 0, 34), Parent = window })
	local close = UiKit.button({
		Text = "✕",
		TextSize = 20,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(36, 36),
		BackgroundColor3 = COLORS.Red,
		Parent = window,
	})
	close.Activated:Connect(function()
		window.Visible = false
	end)
	local body = create("Frame", {
		Position = UDim2.new(0, 0, 0, 46),
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		Parent = window,
	})
	return window, body
end

-- Всплывающие уведомления сверху по центру. Возвращает функцию toast(text, kind).
function UiKit.toaster(parent: Instance): (string, string?) -> ()
	local container = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(0.9, 0, 0, 200),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		create("UIListLayout", {
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local count = 0
	return function(message: string, kind: string?)
		count += 1
		local color = if kind == "error" then COLORS.Red elseif kind == "success" then COLORS.Green else COLORS.Purple
		local label = UiKit.text({
			Text = message,
			TextWrapped = true,
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Center,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(0, 420, 0, 0),
			BackgroundTransparency = 0.1,
			BackgroundColor3 = COLORS.Panel,
			LayoutOrder = count,
			Parent = container,
		})
		local stroke = create("UIStroke", {
			Color = color,
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = label,
		})
		UiKit.corner(10).Parent = label
		UiKit.padding(8).Parent = label
		create("UISizeConstraint", { MaxSize = Vector2.new(420, math.huge), Parent = label })

		task.delay(2.5, function()
			local fade = TweenInfo.new(0.4)
			TweenService:Create(label, fade, { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
			TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
			task.wait(0.4)
			label:Destroy()
		end)
	end
end

return UiKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Util</string>
            <string name="Source"><![CDATA[--!strict
-- Общие помощники клиента: серверное время, атрибуты с значениями по умолчанию,
-- слежение за объектами с тегом (с учётом StreamingEnabled) и поиск своей базы.
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Util = {}

local player = Players.LocalPlayer

-- Время сервера: все отметки в атрибутах (TrendEndsAt, LockedUntil, ...) в этой шкале
function Util.now(): number
	return workspace:GetServerTimeNow()
end

-- 75 -> "1:15", 3725 -> "1:02:05"
function Util.clock(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local hours = total // 3600
	local minutes = (total % 3600) // 60
	local secs = total % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

-- Атрибуты могут ещё не прийти от сервера — подставляем значение по умолчанию нужного типа
function Util.num(inst: Instance?, name: string): number
	local value = if inst then inst:GetAttribute(name) else nil
	return if type(value) == "number" then value else 0
end

function Util.str(inst: Instance?, name: string): string
	local value = if inst then inst:GetAttribute(name) else nil
	return if type(value) == "string" then value else ""
end

function Util.bool(inst: Instance?, name: string): boolean
	return (if inst then inst:GetAttribute(name) else nil) == true
end

-- Вызывает callback(child), когда у parent появится ребёнок name (сразу, если уже есть).
-- Нужно при StreamingEnabled: части моделей подгружаются позже. Возвращает соединение (или nil).
function Util.onChild(parent: Instance, name: string, callback: (Instance) -> ()): RBXScriptConnection?
	local existing = parent:FindFirstChild(name)
	if existing then
		task.spawn(callback, existing)
		return nil
	end
	local connection: RBXScriptConnection
	connection = parent.ChildAdded:Connect(function(child)
		if child.Name == name then
			connection:Disconnect()
			callback(child)
		end
	end)
	return connection
end

-- Следит за всеми объектами с тегом. onAdded(inst) может вернуть функцию очистки,
-- она вызывается, когда объект теряет тег или уходит из стриминга.
function Util.watchTagged(tag: string, onAdded: (Instance) -> (() -> ())?)
	local cleanups: { [Instance]: () -> () } = {}

	local function added(inst: Instance)
		if cleanups[inst] then
			return
		end
		local ok, cleanup = pcall(onAdded, inst)
		if not ok then
			warn("[" .. tag .. "]", cleanup)
			return
		end
		cleanups[inst] = cleanup or function() end
	end

	local function removed(inst: Instance)
		local cleanup = cleanups[inst]
		if cleanup then
			cleanups[inst] = nil
			cleanup()
		end
	end

	CollectionService:GetInstanceAddedSignal(tag):Connect(added)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(removed)
	for _, inst in CollectionService:GetTagged(tag) do
		task.spawn(added, inst)
	end
end

-- Папка баз (сервер создаёт её при старте)
local plotsFolder: Instance? = nil
function Util.plots(): Instance
	if not plotsFolder then
		plotsFolder = workspace:WaitForChild("Plots")
	end
	return plotsFolder :: Instance
end

-- Своя база: по атрибуту Plot игрока, запасной вариант — по OwnerUserId
function Util.myPlot(): Instance?
	local folder = workspace:FindFirstChild("Plots")
	if not folder then
		return nil
	end
	local index = Util.num(player, "Plot")
	if index > 0 then
		local plot = folder:FindFirstChild("Plot" .. index)
		if plot then
			return plot
		end
	end
	for _, plot in folder:GetChildren() do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			return plot
		end
	end
	return nil
end

-- Вызывает callback(plot) для каждой базы, в том числе подгруженной позже
function Util.forEachPlot(callback: (Instance) -> ())
	task.spawn(function()
		local folder = Util.plots()
		folder.ChildAdded:Connect(callback)
		for _, plot in folder:GetChildren() do
			task.spawn(callback, plot)
		end
	end)
end

-- Основная часть модели (Body по контракту, иначе PrimaryPart / первая деталь)
function Util.mainPart(model: Instance): BasePart?
	local body = model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		return body
	end
	if model:IsA("Model") and model.PrimaryPart then
		return model.PrimaryPart
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

function Util.character(): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character, (if root and root:IsA("BasePart") then root else nil), humanoid
end

-- JSON-атрибут (QuestsJson, ItemsJson, ...) -> таблица; нет атрибута или битый JSON -> nil
function Util.json(inst: Instance?, name: string): any
	local raw = Util.str(inst, name)
	if raw == "" then
		return nil
	end
	local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok then value else nil
end

-- Примерная награда «N секунд дохода, но не меньше minCoins» (точную сумму считает сервер)
function Util.coinsFor(incomeSeconds: number?, minCoins: number?): number
	return math.max(Util.num(player, "Income") * (incomeSeconds or 0), minCoins or 0)
end

-- Окно покупки геймпасса по ключу Config.GamePasses; Id = 0 -> тост «не настроено»
function Util.promptPass(passKey: string, toast: (string, string?) -> ())
	local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")) :: any
	local Locale = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Locale")) :: any
	local pass = Config.GamePasses[passKey]
	if not pass or pass.Id == 0 then
		toast(Locale.T("NotConfigured"), "error")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

return Util
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="75">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
